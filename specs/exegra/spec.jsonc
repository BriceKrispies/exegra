    },
    {
      "id": "simulation-deterministic",
      "kind": "invariant",
      "statement": "Running a scenario twice with the same model and faults gives deep-equal traces, and stepping one event at a time gives the same trace as running to the end.",
      "subjects": ["simulation-engine", "run-scenario"],
      "assumptions": ["tests-exercise-shipped-modules", "recorded-results-reflect-current-code"],
      "evaluate": { "method": "external-evidence" }
