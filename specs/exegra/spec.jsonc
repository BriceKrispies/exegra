    {
      "id": "register-importer",
      "name": "Register importer",
      "parent": "tooling",
      "category": "infrastructure",
      "runsIn": "node",
      "purpose": "A command line tool that converts one large Markdown specification file, written as headings, prose and register tables, into the specification file of a linked project: every table row becomes an entity of a kind the import map declares (or a generic table row), and every entity names the line it came from.",
      "responsibilities": [
        "Read one Markdown file and the project's import map (specs/<project>/import-map.jsonc with \"format\": \"register\"), which declares the entity kinds, the table rules (header cells, optional heading scope, the id column or id prefix, a property per column, reference columns), component categories and aliases, and which identifier patterns count as mentions",
        "Hold every line: headings become sections whose bodies keep prose verbatim, and each imported table row and table header is replaced in its section body by one {{entity:<id>}} marker line; write nothing unless the file rebuilds line for line with each marker expanded to the lines it came from",
        "Make every row entity render back to its cells: a row rendered from its properties must give the same cells as the source row, or the import fails naming the entity",
        "Give every imported entity a source property (path:line in the source repository) and, when the row carries an identifier, a ref property with the identifier as written; identifiers and citations named in a row become its mentions (references to imported entities) and citations (as written)",
        "Record what it recognised but could not map (a row whose cell count differs from its header, an unresolved mention, a duplicate identifier, a reference column naming no entity) as losses with counts and examples, printed and written into the generated specification's system notes",
        "Merge the draft fragments the map lists (\"drafts\"): authored entities that are not from the Markdown, each given origin \"draft\" and the file and line of its declaration as source, citing in basis the imported entities it answers; drafts never change the Markdown the sections render"
      ],
      "unknowns": [
        "It writes the project's specification file directly with node:fs, not through the workspace service or the transaction system, like the Markdown importer; once a map says \"authority\": \"jsonc\" it refuses to import over that file (only --out writes elsewhere), so edits made in Exegra are not overwritten.",
        "It does not analyze or validate what it writes; that the output analyzes without errors is checked by the tests and by exegra validate."
      ],
      "implementation": {
        "status": "manual",
        "modules": [
          "tools/import-register.js"
        ],
        "notes": "Run by hand when the Markdown file changes; one way, as the Markdown importer."
      }
    },
    {
      "id": "external-realisation",
      "name": "External realisation",
      "parent": "tooling",
      "category": "logical",
      "runsIn": "node",
      "purpose": "Lets a project be realised in other repositories: reads the realisation roots a project's project.jsonc names, checks modules declared in a root against that root, and turns a root's JUnit reports into pass, fail or not-run results for test evidence that points into it.",
      "responsibilities": [
        "Resolve the roots of project.jsonc (alias, path relative to the project directory or absolute, include and exclude globs, test runs, environmental patterns) and refuse a malformed declaration",
        "Check a module written <alias>:<path> against that root, report a module naming an undeclared alias as missing, and report unclaimed files only for a root that declares include globs",
        "Through `verify`: run each test command a root declares (unless --ingest-only), then read its JUnit report, and record each external test evidence as pass, fail or not-run by matching file, describe path and test name",
        "Record a test as not-run, never as failed, when it is absent from the report, skipped, reported as an error, or failed with a message matching the root's environmental patterns"
      ],
      "unknowns": [
        "Only JUnit XML is read; a root whose runner cannot write JUnit cannot provide test evidence.",
        "Results are not tied to the commit of the root they were recorded from (WK-393 follow-up)."
      ],
      "implementation": {
        "status": "manual",
        "modules": [
          "tools/realisation-roots.js",
          "tools/junit.js"
        ]
      }
    },
    {
      "id": "external-test-runner",
      "name": "Root test runner",
      "category": "external",
      "runsIn": "node",
      "purpose": "The test runner of a realisation root (bun test, for example), started by `exegra verify` through the command project.jsonc declares for that root, writing a JUnit report.",
      "responsibilities": [
        "Run a root's tests and write a JUnit XML report"
      ]
    }
  ],

  // ---- Relationships -----------------------------------------------------------------
  // Taken from the real imports and calls (module imports unless stated). The semantic
  // core imports nothing from src/app, src/render, src/ui or src/persist; the only
  // outward dependency of any core module is jsonc-parser.
  "relationships": [
    // -- Semantic core (acyclic by construction)
    { "id": "parser-reads-metamodel", "kind": "reads", "from": "parser", "to": "metamodel", "description": "Checks structure and property types against the entity definitions in metamodel.json." },
    { "id": "parser-reads-claim-method-registry", "kind": "reads", "from": "parser", "to": "claim-method-registry", "description": "Imports CLAIM_METHODS to check evaluation parameters." },
    { "id": "parser-calls-queries", "kind": "calls", "from": "parser", "to": "queries", "description": "Imports the own-property lookup that keeps spec-supplied keys from resolving inherited properties." },
    { "id": "validator-calls-queries", "kind": "calls", "from": "validator", "to": "queries", "description": "Imports the own-property lookup for the verification methods, claim methods and relationship kinds a specification names." },
    { "id": "parser-depends-on-jsonc-parser", "kind": "depends-on", "from": "parser", "to": "jsonc-parser-library", "description": "Builds the syntax tree and reports syntax errors with the library." },
    { "id": "validator-calls-parser", "kind": "calls", "from": "validator", "to": "parser", "description": "analyzeSpec calls parseSpec, then validates the model." },
    { "id": "validator-calls-expression-language", "kind": "calls", "from": "validator", "to": "expression-language", "description": "Parses guards, effect values and claim expressions and lists their references." },
    { "id": "validator-reads-claim-method-registry", "kind": "reads", "from": "validator", "to": "claim-method-registry", "description": "Checks each claim's method and parameters against the registry." },
    { "id": "transactions-calls-parser", "kind": "calls", "from": "transactions", "to": "parser", "description": "Re-derives the model after every text edit and parses a replacement source." },
    { "id": "transactions-calls-validator", "kind": "calls", "from": "transactions", "to": "validator", "description": "Project calls analyzeSpec on every candidate specification and refuses results with errors." },
    { "id": "transactions-calls-expression-language", "kind": "calls", "from": "transactions", "to": "expression-language", "description": "Operations parse expressions when renaming ids that expressions mention." },
    { "id": "transactions-calls-queries", "kind": "calls", "from": "transactions", "to": "queries", "description": "Finds declaration sites and owned entities when creating and deleting." },
    { "id": "transactions-reads-metamodel", "kind": "reads", "from": "transactions", "to": "metamodel", "description": "Reads the id pattern." },
    { "id": "transactions-calls-model-hash", "kind": "calls", "from": "transactions", "to": "model-hash", "description": "Computes the semantic hash of each committed model and the text hash of a project." },
    { "id": "transactions-depends-on-jsonc-parser", "kind": "depends-on", "from": "transactions", "to": "jsonc-parser-library", "description": "Computes and applies the minimal text edits that keep comments and formatting." },
    { "id": "claim-evaluator-reads-claim-method-registry", "kind": "reads", "from": "claim-evaluator", "to": "claim-method-registry", "description": "Dispatches only on registered methods; an unregistered method stays not evaluated." },
    { "id": "claim-evaluator-calls-queries", "kind": "calls", "from": "claim-evaluator", "to": "queries", "description": "Builds the component graph and selects components for structural claims." },
    { "id": "claim-evaluator-calls-expression-language", "kind": "calls", "from": "claim-evaluator", "to": "expression-language", "description": "Evaluates claim expressions against trace configurations." },
    { "id": "claim-evaluator-calls-model-hash", "kind": "calls", "from": "claim-evaluator", "to": "model-hash", "description": "Stamps every result with the semantic hash it was computed from." },
    { "id": "claim-evaluator-calls-simulation-engine", "kind": "calls", "from": "claim-evaluator", "to": "simulation-engine", "description": "Runs the listed scenarios for invariant and temporal claims.", "contract": "run-scenario" },

    // -- Visualization
    { "id": "projection-system-calls-queries", "kind": "calls", "from": "projection-system", "to": "queries", "description": "Resolves components, ancestors and descendants for projection." },
    { "id": "projection-system-projects-scene-renderer", "kind": "projects", "from": "projection-system", "to": "scene-renderer", "description": "Derives the scene that the renderer draws; the renderer never reads the model.", "contract": "project-scene" },
    { "id": "session-data-flow-layout-engine", "kind": "data-flow", "from": "session", "to": "layout-engine", "description": "The projected scene, the pins of the active view, the requested method (auto or one of the four) and the viewport's width-to-height ratio travel to the layout engine; the placement, the method used and, for auto, the scores come back as the return value." },
    { "id": "layout-engine-projects-scene-renderer", "kind": "projects", "from": "layout-engine", "to": "scene-renderer", "description": "Derives the placement of the scene's nodes on the ground plane." },
    { "id": "scene-renderer-depends-on-threejs", "kind": "depends-on", "from": "scene-renderer", "to": "threejs-library", "description": "Builds geometry, materials, lines and CSS2D labels with Three.js." },
    { "id": "scene-renderer-depends-on-browser-platform", "kind": "depends-on", "from": "scene-renderer", "to": "browser-platform", "description": "Uses the canvas, WebGL, pointer events, ResizeObserver and requestAnimationFrame." },
    { "id": "scene-renderer-calls-visual-interaction", "kind": "calls", "from": "scene-renderer", "to": "visual-interaction", "description": "Invokes the onSelect, onHover, onActivate, onMoveEnd and onConnect callbacks supplied when it was created; it imports nothing from the application." },
    { "id": "visual-interaction-calls-scene-renderer", "kind": "calls", "from": "visual-interaction", "to": "scene-renderer", "description": "Creates the scene view and calls setScene, setSelection, setHighlight, setMode, setCameraMode, fit, pulse and the camera accessors." },
    { "id": "visual-interaction-depends-on-threejs", "kind": "depends-on", "from": "visual-interaction", "to": "threejs-library", "description": "The camera rig builds cameras and OrbitControls." },
    { "id": "visual-interaction-depends-on-browser-platform", "kind": "depends-on", "from": "visual-interaction", "to": "browser-platform", "description": "Listens for page events and schedules fits with requestAnimationFrame." },
    { "id": "visual-interaction-calls-session", "kind": "calls", "from": "visual-interaction", "to": "session", "description": "Selects, hovers, toggles collapse, requests fits, sets mode, starts the session and reports the scene viewport's width-to-height ratio with setViewportAspect for the automatic layout." },
    { "id": "visual-interaction-subscribes-session", "kind": "subscribes", "from": "visual-interaction", "to": "session", "description": "Listens for scene, selection, ui, project, view, fit and sim events to update the renderer." },
    { "id": "visual-interaction-submits-edits-transactions", "kind": "submits-edits", "from": "visual-interaction", "to": "transactions", "description": "A drag becomes MovePresentationNode operations submitted through session.apply.", "contract": "apply-transaction" },
    { "id": "visual-interaction-calls-dialogs", "kind": "calls", "from": "visual-interaction", "to": "dialogs", "description": "Opens the connect dialog after two successive node clicks in connect mode." },
    { "id": "visual-interaction-calls-shell", "kind": "calls", "from": "visual-interaction", "to": "shell", "description": "Mounts the shell, uses its host elements, shows destinations through it and has a tap in the scene bring the inspector forward." },
    { "id": "visual-interaction-calls-inspector", "kind": "calls", "from": "visual-interaction", "to": "inspector", "description": "Mounts the inspector." },
    { "id": "visual-interaction-calls-source-editor", "kind": "calls", "from": "visual-interaction", "to": "source-editor", "description": "Mounts the source editor." },
    { "id": "visual-interaction-calls-simulator-panel", "kind": "calls", "from": "visual-interaction", "to": "simulator-panel", "description": "Mounts the simulator panel." },
    { "id": "visual-interaction-calls-verification-panel", "kind": "calls", "from": "visual-interaction", "to": "verification-panel", "description": "Mounts the verification panel." },
    { "id": "visual-interaction-calls-realisation-panel", "kind": "calls", "from": "visual-interaction", "to": "realisation-panel", "description": "Mounts the realisation panel." },
    { "id": "visual-interaction-writes-browser-storage", "kind": "writes", "from": "visual-interaction", "to": "browser-storage", "description": "Remembers the camera per project and view in sessionStorage." },

    // -- Session
    { "id": "session-calls-transactions", "kind": "calls", "from": "session", "to": "transactions", "description": "Creates a Project per opened project and forwards apply, undo, redo and reload.", "contract": "apply-transaction" },
    { "id": "session-reads-transactions", "kind": "reads", "from": "session", "to": "transactions", "description": "Reads the committed model, diagnostics, texts and revision from the project; the UI reads them through the session." },
    { "id": "session-subscribes-transactions", "kind": "subscribes", "from": "session", "to": "transactions", "description": "Registers its commit listener with Project.subscribe; the project knows it only as a callback." },
    { "id": "transactions-data-flow-session", "kind": "data-flow", "from": "transactions", "to": "session", "description": "Each commit delivers its TransactionResult and history entry to the listener the session subscribed." },
    { "id": "session-calls-claim-evaluator", "kind": "calls", "from": "session", "to": "claim-evaluator", "description": "Re-evaluates claims after a semantic change and checks the simulator's trace.", "contract": "evaluate-claims" },
    { "id": "session-calls-simulation-engine", "kind": "calls", "from": "session", "to": "simulation-engine", "description": "Runs the loaded scenario in the engine worker and steps through the finished trace with a cursor.", "contract": "run-scenario" },
    { "id": "session-calls-projection-system", "kind": "calls", "from": "session", "to": "projection-system", "description": "Lists views and projects the active view with the interaction context.", "contract": "project-scene" },
    { "id": "session-calls-layout-engine", "kind": "calls", "from": "session", "to": "layout-engine", "description": "Lays the scene out with the pins of the active view from the layout file: chooseLayout with the viewport's aspect when the view's layout is auto, layoutScene with the chosen method otherwise." },
    { "id": "session-calls-persistence-client", "kind": "calls", "from": "session", "to": "persistence-client", "description": "Lists and reads projects, writes spec and layout text after commits and watches for external changes.", "contract": "write-file" },
    { "id": "session-data-flow-persistence-client", "kind": "data-flow", "from": "session", "to": "persistence-client", "description": "Committed spec and layout text and the base hash of the last read or write travel to the persistence client, after the commit and asynchronously." },
    { "id": "persistence-client-data-flow-session", "kind": "data-flow", "from": "persistence-client", "to": "session", "description": "Project files, recorded results and change notifications arrive at the session." },
    { "id": "session-writes-browser-storage", "kind": "writes", "from": "session", "to": "browser-storage", "description": "Remembers view, selection, collapsed, hidden, isolate, camera mode, focus and the layout method chosen per view, per project, in localStorage." },

    // -- Panels
    { "id": "shell-calls-session", "kind": "calls", "from": "shell", "to": "session", "description": "Passes the session to the panels it mounts and calls select, fit, undo and redo." },
    { "id": "shell-subscribes-session", "kind": "subscribes", "from": "shell", "to": "session", "description": "Listens to session events to show toasts and keep the destination summaries current." },
    { "id": "shell-calls-toolbar", "kind": "calls", "from": "shell", "to": "toolbar", "description": "Mounts the toolbar." },
    { "id": "shell-calls-explorer", "kind": "calls", "from": "shell", "to": "explorer", "description": "Mounts the explorer." },
    { "id": "shell-calls-activity-panels", "kind": "calls", "from": "shell", "to": "activity-panels", "description": "Mounts the diagnostics and changes panels." },
    { "id": "shell-calls-overlay", "kind": "calls", "from": "shell", "to": "overlay", "description": "Mounts the viewport overlay with a provider of render statistics." },
    { "id": "shell-calls-dialogs", "kind": "calls", "from": "shell", "to": "dialogs", "description": "The Delete shortcut opens the delete dialog for the selection." },
    { "id": "shell-submits-edits-transactions", "kind": "submits-edits", "from": "shell", "to": "transactions", "description": "Ctrl+Z, Ctrl+Shift+Z and Ctrl+Y call undo and redo on the project through the session.", "contract": "apply-transaction" },
    { "id": "shell-depends-on-stylesheets", "kind": "depends-on", "from": "shell", "to": "stylesheets", "description": "index.html loads the stylesheet entry point main.css." },
    { "id": "toolbar-calls-session", "kind": "calls", "from": "toolbar", "to": "session", "description": "Switches project and view, sets modes and the camera mode, fits, chooses the layout method of the view with setLayoutMethod (a viewer preference, not an edit), selects search results, undoes and redoes, resolves save conflicts." },
    { "id": "toolbar-subscribes-session", "kind": "subscribes", "from": "toolbar", "to": "session", "description": "Updates each toolbar group from the session events it depends on." },
    { "id": "toolbar-calls-queries", "kind": "calls", "from": "toolbar", "to": "queries", "description": "Labels search results." },
    { "id": "toolbar-calls-validator", "kind": "calls", "from": "toolbar", "to": "validator", "description": "Import analyzes the bundle's spec.jsonc with analyzeSpec and refuses it when it has syntax errors." },
    { "id": "toolbar-calls-dialogs", "kind": "calls", "from": "toolbar", "to": "dialogs", "description": "Opens the create and delete dialogs." },
    { "id": "toolbar-submits-edits-transactions", "kind": "submits-edits", "from": "toolbar", "to": "transactions", "description": "Reset layout submits MovePresentationNode with reset; undo and redo go through the session.", "contract": "apply-transaction" },
    { "id": "toolbar-calls-persistence-client", "kind": "calls", "from": "toolbar", "to": "persistence-client", "description": "Export reads a project bundle and Import writes one." },
    { "id": "toolbar-data-flow-persistence-client", "kind": "data-flow", "from": "toolbar", "to": "persistence-client", "description": "An imported bundle (spec.jsonc, layout.jsonc, results.json text) is sent to the persistence service, bypassing the transaction system." },
    { "id": "explorer-calls-session", "kind": "calls", "from": "explorer", "to": "session", "description": "Selects entities and toggles collapse, hidden and isolate marks." },
    { "id": "explorer-subscribes-session", "kind": "subscribes", "from": "explorer", "to": "session", "description": "Refreshes on model, selection and ui events." },
    { "id": "explorer-calls-queries", "kind": "calls", "from": "explorer", "to": "queries", "description": "Labels entities and finds ancestors." },
    { "id": "explorer-calls-projection-system", "kind": "calls", "from": "explorer", "to": "projection-system", "description": "Imports refLabel to label entities that carry a reference." },
    { "id": "explorer-reads-claim-method-registry", "kind": "reads", "from": "explorer", "to": "claim-method-registry", "description": "Reads claim status labels." },
    { "id": "activity-panels-calls-session", "kind": "calls", "from": "activity-panels", "to": "session", "description": "Reads diagnostics and the log; selects or reveals the entity of a row." },
    { "id": "activity-panels-subscribes-session", "kind": "subscribes", "from": "activity-panels", "to": "session", "description": "Refreshes on model and log events." },
    { "id": "overlay-calls-session", "kind": "calls", "from": "overlay", "to": "session", "description": "Reads the scene's legend and notes." },
    { "id": "overlay-subscribes-session", "kind": "subscribes", "from": "overlay", "to": "session", "description": "Refreshes on scene events." },
    { "id": "overlay-observes-scene-renderer", "kind": "observes", "from": "overlay", "to": "scene-renderer", "description": "Shows the renderer's frame rate, frame time, draw calls, triangles and counts through the statistics provider." },
    { "id": "inspector-calls-session", "kind": "calls", "from": "inspector", "to": "session", "description": "Reads the selection, model and claim results, selects linked entities and reveals source." },
    { "id": "inspector-subscribes-session", "kind": "subscribes", "from": "inspector", "to": "session", "description": "Re-renders on selection, project, model and claims events." },
    { "id": "inspector-calls-queries", "kind": "calls", "from": "inspector", "to": "queries", "description": "Lists relationships, dependencies, contracts, children and references of the selection." },
    { "id": "inspector-reads-claim-method-registry", "kind": "reads", "from": "inspector", "to": "claim-method-registry", "description": "Reads claim status labels and tones." },
    { "id": "inspector-calls-property-controls", "kind": "calls", "from": "inspector", "to": "property-controls", "description": "Renders one control per meta-model property definition." },
    { "id": "inspector-calls-dialogs", "kind": "calls", "from": "inspector", "to": "dialogs", "description": "Opens connect, create and delete dialogs." },
    { "id": "inspector-submits-edits-transactions", "kind": "submits-edits", "from": "inspector", "to": "transactions", "description": "Every property change is a SetProperty operation submitted through session.apply.", "contract": "apply-transaction" },
    { "id": "property-controls-reads-claim-method-registry", "kind": "reads", "from": "property-controls", "to": "claim-method-registry", "description": "Describes claim evaluation methods in the evaluation editor." },
    { "id": "property-controls-calls-queries", "kind": "calls", "from": "property-controls", "to": "queries", "description": "Labels referenced entities and finds declaration sites." },
    { "id": "property-controls-calls-dialogs", "kind": "calls", "from": "property-controls", "to": "dialogs", "description": "Opens the rename, delete and nested-entity dialogs from a property control." },
    { "id": "dialogs-calls-session", "kind": "calls", "from": "dialogs", "to": "session", "description": "Reads the model and applies the dialog's operation." },
    { "id": "dialogs-calls-queries", "kind": "calls", "from": "dialogs", "to": "queries", "description": "Labels entities and finds references." },
    { "id": "dialogs-calls-transactions", "kind": "calls", "from": "dialogs", "to": "transactions", "description": "Imports planDelete to preview what a delete removes and repairs." },
    { "id": "dialogs-reads-metamodel", "kind": "reads", "from": "dialogs", "to": "metamodel", "description": "Reads the id pattern and checks ids with it." },
    { "id": "dialogs-calls-property-controls", "kind": "calls", "from": "dialogs", "to": "property-controls", "description": "Renders draft fields and rejections." },
    { "id": "dialogs-submits-edits-transactions", "kind": "submits-edits", "from": "dialogs", "to": "transactions", "description": "Submits CreateEntity, CreateRelationship, DeleteEntity and RenameEntity through session.apply.", "contract": "apply-transaction" },
    { "id": "source-editor-calls-session", "kind": "calls", "from": "source-editor", "to": "session", "description": "Reads the committed text and applies the draft." },
    { "id": "source-editor-subscribes-session", "kind": "subscribes", "from": "source-editor", "to": "session", "description": "Refreshes on model and project events and reveals declarations on request." },
    { "id": "source-editor-calls-validator", "kind": "calls", "from": "source-editor", "to": "validator", "description": "Analyzes the draft with analyzeSpec for its diagnostics." },
    { "id": "source-editor-calls-parser", "kind": "calls", "from": "source-editor", "to": "parser", "description": "Parses the draft to find the location of an entity to reveal." },
    { "id": "source-editor-reads-transactions", "kind": "reads", "from": "source-editor", "to": "transactions", "description": "Reads the committed spec text and revision from the project." },
    { "id": "source-editor-submits-edits-transactions", "kind": "submits-edits", "from": "source-editor", "to": "transactions", "description": "Applying a draft submits a ReplaceSource operation through session.apply.", "contract": "apply-transaction" },
    { "id": "simulator-panel-calls-session", "kind": "calls", "from": "simulator-panel", "to": "session", "description": "Loads, steps, plays, seeks and resets the session's simulation and selects entities." },
    { "id": "simulator-panel-subscribes-session", "kind": "subscribes", "from": "simulator-panel", "to": "session", "description": "Refreshes on sim, model and project events." },
    { "id": "simulator-panel-calls-queries", "kind": "calls", "from": "simulator-panel", "to": "queries", "description": "Labels entities." },
    { "id": "verification-panel-calls-session", "kind": "calls", "from": "verification-panel", "to": "session", "description": "Reads claim results and recorded results; selects claims and switches to the claims view." },
    { "id": "verification-panel-subscribes-session", "kind": "subscribes", "from": "verification-panel", "to": "session", "description": "Refreshes on claims, model, project and selection events." },
    { "id": "verification-panel-calls-queries", "kind": "calls", "from": "verification-panel", "to": "queries", "description": "Labels claims." },
    { "id": "verification-panel-reads-claim-method-registry", "kind": "reads", "from": "verification-panel", "to": "claim-method-registry", "description": "Reads claim status labels and tones." },
    { "id": "realisation-panel-calls-session", "kind": "calls", "from": "realisation-panel", "to": "session", "description": "Reads the model, claim results and recorded traceability; selects components." },
    { "id": "realisation-panel-subscribes-session", "kind": "subscribes", "from": "realisation-panel", "to": "session", "description": "Refreshes on model, project and claims events." },
    { "id": "realisation-panel-calls-queries", "kind": "calls", "from": "realisation-panel", "to": "queries", "description": "Labels components." },
    { "id": "realisation-panel-calls-generators", "kind": "calls", "from": "realisation-panel", "to": "generators", "description": "Generates the five artifacts from the session's model and results in the browser." },
    { "id": "realisation-panel-calls-persistence-client", "kind": "calls", "from": "realisation-panel", "to": "persistence-client", "description": "Writes generated artifacts to the project's generated directory (development server only)." },
    { "id": "realisation-panel-data-flow-persistence-client", "kind": "data-flow", "from": "realisation-panel", "to": "persistence-client", "description": "The generated files' text travels to the persistence service; the specification is not part of it." },
    { "id": "toolbar-calls-dom-helpers", "kind": "calls", "from": "toolbar", "to": "dom-helpers", "description": "Builds its elements with the shared helpers." },
    { "id": "shell-calls-dom-helpers", "kind": "calls", "from": "shell", "to": "dom-helpers", "description": "Builds its elements with the shared helpers." },
    { "id": "explorer-calls-dom-helpers", "kind": "calls", "from": "explorer", "to": "dom-helpers", "description": "Builds its elements with the shared helpers." },
    { "id": "activity-panels-calls-dom-helpers", "kind": "calls", "from": "activity-panels", "to": "dom-helpers", "description": "Builds its elements with the shared helpers." },
    { "id": "overlay-calls-dom-helpers", "kind": "calls", "from": "overlay", "to": "dom-helpers", "description": "Builds its elements with the shared helpers." },
    { "id": "inspector-calls-dom-helpers", "kind": "calls", "from": "inspector", "to": "dom-helpers", "description": "Builds its elements with the shared helpers." },
    { "id": "property-controls-calls-dom-helpers", "kind": "calls", "from": "property-controls", "to": "dom-helpers", "description": "Builds its elements with the shared helpers." },
    { "id": "dialogs-calls-dom-helpers", "kind": "calls", "from": "dialogs", "to": "dom-helpers", "description": "Builds its elements with the shared helpers." },
    { "id": "source-editor-calls-dom-helpers", "kind": "calls", "from": "source-editor", "to": "dom-helpers", "description": "Builds its elements with the shared helpers." },
    { "id": "simulator-panel-calls-dom-helpers", "kind": "calls", "from": "simulator-panel", "to": "dom-helpers", "description": "Builds its elements with the shared helpers." },
    { "id": "verification-panel-calls-dom-helpers", "kind": "calls", "from": "verification-panel", "to": "dom-helpers", "description": "Builds its elements with the shared helpers." },
    { "id": "realisation-panel-calls-dom-helpers", "kind": "calls", "from": "realisation-panel", "to": "dom-helpers", "description": "Builds its elements with the shared helpers." },
    { "id": "dom-helpers-depends-on-browser-platform", "kind": "depends-on", "from": "dom-helpers", "to": "browser-platform", "description": "Creates DOM and SVG elements." },

    // -- Persistence: specification file <-> workspace <-> dev-server plugin <-> client <-> session
    { "id": "persistence-client-calls-dev-server-plugin", "kind": "calls", "from": "persistence-client", "to": "dev-server-plugin", "description": "Sends HTTP requests to /__exegra/* and opens the events stream.", "contract": "write-file" },
    { "id": "persistence-client-data-flow-dev-server-plugin", "kind": "data-flow", "from": "persistence-client", "to": "dev-server-plugin", "description": "Spec and layout text with the base hash, generated files and import bundles travel in request bodies." },
    { "id": "persistence-client-depends-on-browser-platform", "kind": "depends-on", "from": "persistence-client", "to": "browser-platform", "description": "Uses fetch and EventSource." },
    { "id": "dev-server-plugin-calls-workspace-service", "kind": "calls", "from": "dev-server-plugin", "to": "workspace-service", "description": "Delegates every route to the workspace service.", "contract": "write-file" },
    { "id": "dev-server-plugin-data-flow-workspace-service", "kind": "data-flow", "from": "dev-server-plugin", "to": "workspace-service", "description": "Request bodies pass to the workspace service." },
    { "id": "workspace-service-data-flow-dev-server-plugin", "kind": "data-flow", "from": "workspace-service", "to": "dev-server-plugin", "description": "File change notifications (name and hash) pass to the plugin, which streams them as server-sent events." },
    { "id": "dev-server-plugin-data-flow-persistence-client", "kind": "data-flow", "from": "dev-server-plugin", "to": "persistence-client", "description": "Responses (file texts and hashes, write results, conflicts) and change events return to the client." },
    { "id": "dev-server-plugin-depends-on-vite", "kind": "depends-on", "from": "dev-server-plugin", "to": "vite-dev-server", "description": "Runs as middleware of the Vite development server and closes its streams when the server closes." },
    { "id": "workspace-service-writes-specification-file", "kind": "writes", "from": "workspace-service", "to": "specification-file", "description": "Replaces spec.jsonc atomically after a base-hash check, or on import." },
    { "id": "workspace-service-writes-layout-file", "kind": "writes", "from": "workspace-service", "to": "layout-file", "description": "Replaces layout.jsonc atomically after a base-hash check, or on import." },
    { "id": "workspace-service-writes-recorded-results-file", "kind": "writes", "from": "workspace-service", "to": "recorded-results-file", "description": "Replaces evidence/results.json when verification records results, or on import." },
    { "id": "workspace-service-writes-generated-artifacts", "kind": "writes", "from": "workspace-service", "to": "generated-artifacts", "description": "Writes generated files under generated/ only, skipping files whose content is unchanged." },
    { "id": "workspace-service-calls-filesystem", "kind": "calls", "from": "workspace-service", "to": "filesystem", "description": "Reads, writes, renames, appends to the journal and watches directories with node:fs." },
    { "id": "workspace-service-depends-on-jsonc-parser", "kind": "depends-on", "from": "workspace-service", "to": "jsonc-parser-library", "description": "Reads a project's title from its specification." },

    // -- Agent interface and tooling
    { "id": "ai-coding-agent-calls-agent-cli", "kind": "calls", "from": "ai-coding-agent", "to": "agent-cli", "description": "Runs one command per process and reads the JSON envelope.", "contract": "agent-command" },
    { "id": "agent-cli-submits-edits-transactions", "kind": "submits-edits", "from": "agent-cli", "to": "transactions", "description": "The apply command submits operations through Project.apply with origin cli; nothing edits specification text directly.", "contract": "apply-transaction" },
    { "id": "agent-cli-calls-workspace-service", "kind": "calls", "from": "agent-cli", "to": "workspace-service", "description": "Reads projects and writes changed files with the hashes read at the start; records verification results and generated artifacts." },
    { "id": "agent-cli-data-flow-workspace-service", "kind": "data-flow", "from": "agent-cli", "to": "workspace-service", "description": "The committed spec and layout text with their base hashes travel to the workspace service after a successful transaction." },
    { "id": "agent-cli-calls-queries", "kind": "calls", "from": "agent-cli", "to": "queries", "description": "Answers list, show, deps, contracts and plan-delete." },
    { "id": "agent-cli-calls-claim-evaluator", "kind": "calls", "from": "agent-cli", "to": "claim-evaluator", "description": "Evaluates claims for claims, evaluate, trace and verify.", "contract": "evaluate-claims" },
    { "id": "agent-cli-calls-simulation-engine", "kind": "calls", "from": "agent-cli", "to": "simulation-engine", "description": "Runs scenarios for simulate and trace.", "contract": "run-scenario" },
    { "id": "agent-cli-calls-model-hash", "kind": "calls", "from": "agent-cli", "to": "model-hash", "description": "Serialises results deterministically." },
    { "id": "agent-cli-calls-generators", "kind": "calls", "from": "agent-cli", "to": "generators", "description": "The generate command derives the artifacts." },
    { "id": "agent-cli-calls-verification-pipeline", "kind": "calls", "from": "agent-cli", "to": "verification-pipeline", "description": "The traceability and verify commands run the module-to-disk check." },
    { "id": "agent-cli-calls-test-suites", "kind": "calls", "from": "agent-cli", "to": "test-suites", "description": "verify executes test evidence by spawning node --test on a core test file." },
    { "id": "agent-cli-calls-playwright-runner", "kind": "calls", "from": "agent-cli", "to": "playwright-runner", "description": "verify executes browser test evidence by spawning Playwright, unless --skip-browser." },
    { "id": "agent-cli-calls-filesystem", "kind": "calls", "from": "agent-cli", "to": "filesystem", "description": "Reads operation files and checks paths." },
    { "id": "build-system-depends-on-vite", "kind": "depends-on", "from": "build-system", "to": "vite-dev-server", "description": "Configures the server (127.0.0.1, specs not watched) and the build." },
    { "id": "build-system-calls-dev-server-plugin", "kind": "calls", "from": "build-system", "to": "dev-server-plugin", "description": "Registers the plugin with the specs directory." },
    { "id": "generators-calls-queries", "kind": "calls", "from": "generators", "to": "queries", "description": "Lists children, relationships and contracts for the architecture document." },
    { "id": "generators-calls-model-hash", "kind": "calls", "from": "generators", "to": "model-hash", "description": "Stamps artifacts with the semantic hash." },
    { "id": "generators-reads-claim-method-registry", "kind": "reads", "from": "generators", "to": "claim-method-registry", "description": "Reads claim status labels." },
    { "id": "generators-generates-generated-artifacts", "kind": "generates", "from": "generators", "to": "generated-artifacts", "description": "Produces the text of the five generated files; the workspace service writes them." },
    { "id": "verification-pipeline-calls-filesystem", "kind": "calls", "from": "verification-pipeline", "to": "filesystem", "description": "Scans src, cli, tools and the root files and checks that declared modules exist." },
    { "id": "spec-checker-calls-validator", "kind": "calls", "from": "spec-checker", "to": "validator", "description": "Analyzes the file with analyzeSpec." },
    { "id": "spec-checker-calls-claim-evaluator", "kind": "calls", "from": "spec-checker", "to": "claim-evaluator", "description": "Prints the status of every claim." },
    { "id": "spec-checker-calls-simulation-engine", "kind": "calls", "from": "spec-checker", "to": "simulation-engine", "description": "Runs every scenario and optionally prints a trace." },
    { "id": "spec-checker-calls-model-hash", "kind": "calls", "from": "spec-checker", "to": "model-hash", "description": "Prints the semantic hash." },
    { "id": "spec-checker-reads-specification-file", "kind": "reads", "from": "spec-checker", "to": "specification-file", "description": "Reads the file given on the command line directly with node:fs." },
    { "id": "benchmark-generator-calls-validator", "kind": "calls", "from": "benchmark-generator", "to": "validator", "description": "Checks that the generated specification analyzes." },
    { "id": "benchmark-generator-writes-specification-file", "kind": "writes", "from": "benchmark-generator", "to": "specification-file", "description": "Writes specs/benchmark/spec.jsonc directly with node:fs." },
    { "id": "markdown-importer-reads-markdown-specification-source", "kind": "reads", "from": "markdown-importer", "to": "markdown-specification-source", "description": "Reads the Markdown documents and the repository's git commit; it never writes there." },
    { "id": "markdown-specification-source-data-flow-markdown-importer", "kind": "data-flow", "from": "markdown-specification-source", "to": "markdown-importer", "description": "The requirements, components, relationships, goals, decisions and roadmap stated in the Markdown travel to the importer, one way." },
    { "id": "markdown-importer-data-flow-specification-file", "kind": "data-flow", "from": "markdown-importer", "to": "specification-file", "description": "The generated text of the project's specification file travels to the file, deterministically, with the losses recorded in its system notes." },
    { "id": "markdown-importer-writes-specification-file", "kind": "writes", "from": "markdown-importer", "to": "specification-file", "description": "Writes the project's specification file directly with node:fs, bypassing the transaction system." },
    { "id": "markdown-importer-depends-on-jsonc-parser", "kind": "depends-on", "from": "markdown-importer", "to": "jsonc-parser-library", "description": "Reads the project's import map with the library." },
    { "id": "markdown-importer-calls-filesystem", "kind": "calls", "from": "markdown-importer", "to": "filesystem", "description": "Reads the Markdown tree and the import map, and writes or compares the generated file, with node:fs." },
    { "id": "screenshot-tool-depends-on-playwright", "kind": "depends-on", "from": "screenshot-tool", "to": "playwright-runner", "description": "Drives Chrome to load the page and capture it." },
    { "id": "screenshot-tool-observes-vite", "kind": "observes", "from": "screenshot-tool", "to": "vite-dev-server", "description": "Loads the application served by the development server and reports console errors." },
    { "id": "test-suites-depends-on-playwright", "kind": "depends-on", "from": "test-suites", "to": "playwright-runner", "description": "Browser tests run under Playwright." },
    { "id": "test-suites-depends-on-vite", "kind": "depends-on", "from": "test-suites", "to": "vite-dev-server", "description": "Playwright starts the Vite development server for the browser tests." },
    { "id": "test-suites-calls-transactions", "kind": "calls", "from": "test-suites", "to": "transactions", "description": "Core tests exercise Project and the operations." },
    { "id": "test-suites-calls-parser", "kind": "calls", "from": "test-suites", "to": "parser", "description": "Core tests exercise parsing and normalization." },
    { "id": "test-suites-calls-validator", "kind": "calls", "from": "test-suites", "to": "validator", "description": "Core tests exercise the validation rules." },
    { "id": "test-suites-calls-claim-evaluator", "kind": "calls", "from": "test-suites", "to": "claim-evaluator", "description": "Core tests exercise claim evaluation." },
    { "id": "test-suites-calls-simulation-engine", "kind": "calls", "from": "test-suites", "to": "simulation-engine", "description": "Core tests exercise the simulation." },
    { "id": "test-suites-calls-projection-system", "kind": "calls", "from": "test-suites", "to": "projection-system", "description": "Core tests exercise projections." },
    { "id": "test-suites-calls-layout-engine", "kind": "calls", "from": "test-suites", "to": "layout-engine", "description": "Core tests exercise the layout." },
    { "id": "test-suites-calls-generators", "kind": "calls", "from": "test-suites", "to": "generators", "description": "Core tests exercise the generators." },
    { "id": "test-suites-calls-workspace-service", "kind": "calls", "from": "test-suites", "to": "workspace-service", "description": "Core tests exercise the workspace service on temporary directories." },
    { "id": "test-suites-calls-markdown-importer", "kind": "calls", "from": "test-suites", "to": "markdown-importer", "description": "Core tests exercise the importer on fixture Markdown and analyze its output." },
    { "id": "test-suites-calls-agent-cli", "kind": "calls", "from": "test-suites", "to": "agent-cli", "description": "Core tests run commands of the agent command line." },
    {
      "id": "simulation-engine-calls-simulation-aspect-registry",
      "kind": "calls",
      "from": "simulation-engine",
      "to": "simulation-aspect-registry",
      "description": "Runs the hooks of the aspects a specification enables (planned, WG-4665)."
    },
    {
      "id": "simulation-aspect-registry-calls-chaos-aspect",
      "kind": "calls",
      "from": "simulation-aspect-registry",
      "to": "chaos-aspect",
      "description": "Registered aspect."
    },
    {
      "id": "simulation-aspect-registry-calls-load-aspect",
      "kind": "calls",
      "from": "simulation-aspect-registry",
      "to": "load-aspect",
      "description": "Registered aspect."
    },
    {
      "id": "simulation-aspect-registry-calls-cost-aspect",
      "kind": "calls",
      "from": "simulation-aspect-registry",
      "to": "cost-aspect",
      "description": "Registered aspect."
    },
    {
      "id": "cost-aspect-depends-on-load-aspect",
      "kind": "depends-on",
      "from": "cost-aspect",
      "to": "load-aspect",
      "description": "Prices the resource usage the load aspect records."
    },
    {
      "id": "refinement-checker-calls-simulation-engine",
      "kind": "calls",
      "from": "refinement-checker",
      "to": "simulation-engine",
      "description": "Runs the abstract and the refined behaviors of a component (planned, WG-4666)."
    },
    {
      "id": "claim-evaluator-calls-refinement-checker",
      "kind": "calls",
      "from": "claim-evaluator",
      "to": "refinement-checker",
      "description": "Refinement checks are claims."
    },
    {
      "id": "session-calls-simulation-overlays",
      "kind": "calls",
      "from": "session",
      "to": "simulation-overlays",
      "description": "Derives the overlays of the scrubbed time (planned, WG-4671)."
    },
    {
      "id": "simulation-overlays-projects-scene-renderer",
      "kind": "projects",
      "from": "simulation-overlays",
      "to": "scene-renderer",
      "description": "Overlay values drawn over the component view."
    },
    {
      "id": "simulation-contract-calls-simulation-engine",
      "kind": "calls",
      "from": "simulation-contract",
      "to": "simulation-engine",
      "description": "Hands the engine its input and checks the trace it returns against the golden suite (tools/conformance.js, tests/core/conformance.test.js)."
    },
    {
      "id": "session-calls-simulation-contract",
      "kind": "calls",
      "from": "session",
      "to": "simulation-contract",
      "description": "Derives the engine input for the scenario the Simulation tab loads."
    },
    {
      "id": "agent-cli-calls-simulation-contract",
      "kind": "calls",
      "from": "agent-cli",
      "to": "simulation-contract",
      "description": "simulate and trace derive the engine input the same way."
    },
    {
      "id": "shell-calls-responsive-layout",
      "kind": "calls",
      "from": "shell",
      "to": "responsive-layout",
      "description": "Creates the responsive layout, which places the panels as sheets, a side panel or columns for the viewport and shows destinations on request."
    },
    {
      "id": "responsive-layout-calls-dom-helpers",
      "kind": "calls",
      "from": "responsive-layout",
      "to": "dom-helpers",
      "description": "Builds the navigation and the More menu with the shared helpers and icons."
    },
    {
      "id": "responsive-layout-writes-browser-storage",
      "kind": "writes",
      "from": "responsive-layout",
      "to": "browser-storage",
      "description": "Remembers the context destination, the panel widths and the open state of the tablet and desktop panels in localStorage."
    },
    {
      "id": "toolbar-calls-responsive-layout",
      "kind": "calls",
      "from": "toolbar",
      "to": "responsive-layout",
      "description": "The overflow menu and the save-conflict menu use the shared menu controller."
    },
    {
      "id": "shell-calls-queries",
      "kind": "calls",
      "from": "shell",
      "to": "queries",
      "description": "Labels the selection in the inspector's summary line."
    },
    {
      "id": "shell-calls-claim-method-registry",
      "kind": "calls",
      "from": "shell",
      "to": "claim-method-registry",
      "description": "Names a selected claim's status in the inspector's summary line."
    },
    {
      "id": "shell-calls-simulator-panel",
      "kind": "calls",
      "from": "shell",
      "to": "simulator-panel",
      "description": "Mounts the simulation transport."
    },
    {
      "id": "claim-evaluator-calls-exhaustive-explorer",
      "kind": "calls",
      "from": "claim-evaluator",
      "to": "exhaustive-explorer",
      "description": "Claims evaluated exhaustively within bounds (planned, WG-4650)."
    },
    {
      "id": "exhaustive-explorer-calls-simulation-engine",
      "kind": "calls",
      "from": "exhaustive-explorer",
      "to": "simulation-engine",
      "description": "A Rust explorer with the same semantics as simulation, for state spaces too large for the Lean one, checked differentially against it (planned, WG-4650)."
    },
    {
      "id": "exhaustive-explorer-depends-on-fault-model",
      "kind": "depends-on",
      "from": "exhaustive-explorer",
      "to": "fault-model",
      "description": "Explores every subset of the scenario's faults; the concurrency bounds of its fault model are to be applied once the engine input carries them."
    },
    {
      "id": "claim-evaluator-depends-on-fault-model",
      "kind": "depends-on",
      "from": "claim-evaluator",
      "to": "fault-model",
      "description": "States the fault model in each claim result's scope."
    },
    {
      "id": "deployment-model-depends-on-exhaustive-explorer",
      "kind": "depends-on",
      "from": "deployment-model",
      "to": "exhaustive-explorer",
      "description": "Cutover, rollback and migration claims are checked exhaustively."
    },
    {
      "id": "infrastructure-generator-depends-on-deployment-model",
      "kind": "depends-on",
      "from": "infrastructure-generator",
      "to": "deployment-model",
      "description": "Generates from, and verifies against, the deployment model (planned, WG-4678)."
    },
    {
      "id": "implementation-refinement-depends-on-fault-model",
      "kind": "depends-on",
      "from": "implementation-refinement",
      "to": "fault-model",
      "description": "Implementation runs draw faults from the fault model."
    },
    {
      "id": "claim-evaluator-calls-implementation-refinement",
      "kind": "calls",
      "from": "claim-evaluator",
      "to": "implementation-refinement",
      "description": "Refinement of implementation traces is a claim (planned, WG-4679)."
    },
    {
      "id": "reality-loop-depends-on-infrastructure-generator",
      "kind": "depends-on",
      "from": "reality-loop",
      "to": "infrastructure-generator",
      "description": "Game days run on the generated infrastructure (planned, WG-4680)."
    },
    {
      "id": "reality-loop-writes-recorded-results-file",
      "kind": "writes",
      "from": "reality-loop",
      "to": "recorded-results-file",
      "description": "Game-day and monitor results recorded as evidence."
    },
    {
      "id": "validator-calls-fault-model",
      "kind": "calls",
      "from": "validator",
      "to": "fault-model",
      "description": "Runs the fault model rules (missing sources, bounds, realises outside the model) as part of validation."
    },
    {
      "id": "simulation-engine-depends-on-formal-semantics",
      "kind": "depends-on",
      "from": "simulation-engine",
      "to": "formal-semantics",
      "description": "The engine is checked against the formal semantics, which defines what it must compute (planned, WG-4685)."
    },
    {
      "id": "proof-export-depends-on-formal-semantics",
      "kind": "depends-on",
      "from": "proof-export",
      "to": "formal-semantics",
      "description": "Proofs are stated against the formal semantics."
    },
    {
      "id": "proof-export-depends-on-exhaustive-explorer",
      "kind": "depends-on",
      "from": "proof-export",
      "to": "exhaustive-explorer",
      "description": "Counterexamples to induction come from bounded exploration."
    },
    {
      "id": "claim-evaluator-calls-proof-export",
      "kind": "calls",
      "from": "claim-evaluator",
      "to": "proof-export",
      "description": "Claims proved in Lean are reported as verified by proof (planned, WG-4686)."
    },
    {
      "id": "validator-calls-contract-conformance",
      "kind": "calls",
      "from": "validator",
      "to": "contract-conformance",
      "description": "Checks the payload of every contract event against the fields, types and errors of its contract."
    },
    {
      "id": "claim-evaluator-calls-contract-conformance",
      "kind": "calls",
      "from": "claim-evaluator",
      "to": "contract-conformance",
      "description": "checkTrace adds the automatic checks of the contract events of a trace."
    },
    {
      "id": "session-calls-contract-conformance",
      "kind": "calls",
      "from": "session",
      "to": "contract-conformance",
      "description": "Derives the request log of the loaded run for the simulator panel."
    },
    {
      "id": "agent-cli-calls-contract-conformance",
      "kind": "calls",
      "from": "agent-cli",
      "to": "contract-conformance",
      "description": "simulate lists the request log of the run."
    },
    {
      "id": "test-suites-calls-contract-conformance",
      "kind": "calls",
      "from": "test-suites",
      "to": "contract-conformance",
      "description": "Core tests exercise the static and trace checks and the request log."
    },
    {
      "id": "validator-calls-data-model",
      "kind": "calls",
      "from": "validator",
      "to": "data-model",
      "description": "Runs the data rules and the record and copy consistency checks as part of validation."
    },
    {
      "id": "claim-evaluator-calls-data-model",
      "kind": "calls",
      "from": "claim-evaluator",
      "to": "data-model",
      "description": "Evaluates data-model claims from the findings of the data rules."
    },
    {
      "id": "data-model-calls-queries",
      "kind": "calls",
      "from": "data-model",
      "to": "queries",
      "description": "Builds the component graph to find a path between a copy's holder and a record's owner."
    },
    {
      "id": "data-model-reads-metamodel",
      "kind": "reads",
      "from": "data-model",
      "to": "metamodel",
      "description": "The record and copy kinds and their enums are declared in the meta-model."
    },
    {
      "id": "projection-system-calls-data-model",
      "kind": "calls",
      "from": "projection-system",
      "to": "data-model",
      "description": "The Data projection draws records, copies, owners and holders, and marks copies with findings."
    },
    {
      "id": "inspector-calls-data-model",
      "kind": "calls",
      "from": "inspector",
      "to": "data-model",
      "description": "Lists a record's fields and copies and a copy's source fields."
    },
    {
      "id": "specification-file-data-flow-generated-artifacts",
      "kind": "data-flow",
      "from": "specification-file",
      "to": "generated-artifacts",
      "description": "The generated documents are derived from the specification text (through the generators, run by the command line or the realisation panel). Declared when the data-model rule holder-reaches-owner found no path between the two stores."
    },
    {
      "id": "exhaustive-explorer-depends-on-formal-semantics",
      "kind": "depends-on",
      "from": "exhaustive-explorer",
      "to": "formal-semantics",
      "description": "The successor relation takes the semantics' deterministic step after each choice; the explorer runs the semantics' own step function."
    },
    {
      "id": "proof-export-calls-simulation-contract",
      "kind": "calls",
      "from": "proof-export",
      "to": "simulation-contract",
      "description": "Builds the scenario's engine input with simulationInput, exactly as simulate does."
    },
    {
      "id": "proof-export-calls-expression-language",
      "kind": "calls",
      "from": "proof-export",
      "to": "expression-language",
      "description": "Parses claim expressions and evaluates them on a counterexample's last configuration to explain it."
    },
    {
      "id": "proof-export-calls-contract-conformance",
      "kind": "calls",
      "from": "proof-export",
      "to": "contract-conformance",
      "description": "Renders a counterexample's contract events as request-log lines."
    },
    {
      "id": "agent-cli-calls-proof-export",
      "kind": "calls",
      "from": "agent-cli",
      "to": "proof-export",
      "description": "The prove command explores a scenario and checks its state invariants in Lean."
    },
    {
      "id": "simulation-engine-calls-resource-model",
      "kind": "calls",
      "from": "simulation-engine",
      "to": "resource-model",
      "description": "Settles resources after each step and runs service-done and wait-timeout entries (planned, WG-4664, WG-4715)."
    },
    {
      "id": "simulation-engine-calls-workload-model",
      "kind": "calls",
      "from": "simulation-engine",
      "to": "workload-model",
      "description": "Queues the next arrival of a workload when one is taken, runs link transfers and timers (planned, WG-4715)."
    },
    {
      "id": "simulation-engine-calls-performance-metrics",
      "kind": "calls",
      "from": "simulation-engine",
      "to": "performance-metrics",
      "description": "Accumulates the measured outputs of a run, in trace and metrics output modes (planned, WG-4715).",
      "contract": "trace-v2"
    },
    {
      "id": "resource-model-depends-on-formal-semantics",
      "kind": "depends-on",
      "from": "resource-model",
      "to": "formal-semantics",
      "description": "Resources, grants, bounds and their invariants are defined in Lean first (planned, WG-4664)."
    },
    {
      "id": "workload-model-depends-on-formal-semantics",
      "kind": "depends-on",
      "from": "workload-model",
      "to": "formal-semantics",
      "description": "Arrivals, links, latency, timers and the SplitMix64 streams are defined in Lean first (planned, WG-4715)."
    },
    {
      "id": "performance-metrics-depends-on-formal-semantics",
      "kind": "depends-on",
      "from": "performance-metrics",
      "to": "formal-semantics",
      "description": "Metrics are defined in Lean as a function of the run (planned, WG-4715)."
    },
    {
      "id": "simulation-contract-calls-resource-model",
      "kind": "calls",
      "from": "simulation-contract",
      "to": "resource-model",
      "description": "Lowers resources, classes and service demand into the version-2 engine input (planned).",
      "contract": "engine-input-v2"
    },
    {
      "id": "simulation-contract-calls-workload-model",
      "kind": "calls",
      "from": "simulation-contract",
      "to": "workload-model",
      "description": "Lowers workloads, rates, durations, distributions and links into the version-2 engine input (planned).",
      "contract": "engine-input-v2"
    },
    {
      "id": "metric-claims-calls-simulation-engine",
      "kind": "calls",
      "from": "metric-claims",
      "to": "simulation-engine",
      "description": "Runs the claim's scenarios once per seed in metrics mode (planned, WG-4715).",
      "contract": "run-scenario"
    },
    {
      "id": "metric-claims-reads-performance-metrics",
      "kind": "reads",
      "from": "metric-claims",
      "to": "performance-metrics",
      "description": "Takes one statistic per run from the measured outputs (planned)."
    },
    {
      "id": "claim-evaluator-calls-metric-claims",
      "kind": "calls",
      "from": "claim-evaluator",
      "to": "metric-claims",
      "description": "Metric-bound claims are evaluated by the metric claims component (planned, WG-4715)."
    },
    {
      "id": "load-aspect-depends-on-workload-model",
      "kind": "depends-on",
      "from": "load-aspect",
      "to": "workload-model",
      "description": "The load aspect drives scenarios with the workloads of format 2 (planned, WG-4668 on WG-4715)."
    },
    {
      "id": "load-aspect-depends-on-resource-model",
      "kind": "depends-on",
      "from": "load-aspect",
      "to": "resource-model",
      "description": "Saturation and backpressure are those of the resources of format 2."
    },
    {
      "id": "cost-aspect-reads-performance-metrics",
      "kind": "reads",
      "from": "cost-aspect",
      "to": "performance-metrics",
      "description": "Prices the counted quantities and reports cost per run, per bucket and per month (planned, WG-4669 on WG-4715)."
    },
    {
      "id": "register-importer-reads-markdown-specification-source",
      "kind": "reads",
      "from": "register-importer",
      "to": "markdown-specification-source",
      "description": "Reads the Markdown file and the repository's git commit; it never writes there."
    },
    {
      "id": "markdown-specification-source-data-flow-register-importer",
      "kind": "data-flow",
      "from": "markdown-specification-source",
      "to": "register-importer",
      "description": "The headings, prose and register tables of the Markdown file travel to the importer, one way."
    },
    {
      "id": "register-importer-data-flow-specification-file",
      "kind": "data-flow",
      "from": "register-importer",
      "to": "specification-file",
      "description": "The generated text of the project's specification file travels to the file, deterministically, with the losses recorded in its system notes."
    },
    {
      "id": "register-importer-writes-specification-file",
      "kind": "writes",
      "from": "register-importer",
      "to": "specification-file",
      "description": "Writes the project's specification file directly with node:fs, bypassing the transaction system."
    },
    {
      "id": "register-importer-depends-on-jsonc-parser-library",
      "kind": "depends-on",
      "from": "register-importer",
      "to": "jsonc-parser-library",
      "description": "Reads the import map and re-reads the generated text with the library."
    },
    {
      "id": "register-importer-calls-markdown-importer",
      "kind": "calls",
      "from": "register-importer",
      "to": "markdown-importer",
      "description": "Reuses the Markdown importer's text helpers, loss collection, coverage comparison and git commit reader."
    },
    {
      "id": "register-importer-calls-filesystem",
      "kind": "calls",
      "from": "register-importer",
      "to": "filesystem",
      "description": "Reads the Markdown file and the import map, and writes or compares the generated file, with node:fs."
    },
    {
      "id": "test-suites-calls-register-importer",
      "kind": "calls",
      "from": "test-suites",
      "to": "register-importer",
      "description": "Core tests exercise the register importer on a fixture and analyze its output."
    },
    {
      "id": "agent-cli-calls-external-realisation",
      "kind": "calls",
      "from": "agent-cli",
      "to": "external-realisation",
      "description": "traceability, generate and verify resolve the project's realisation roots; verify records external test evidence from their JUnit reports."
    },
    {
      "id": "verification-pipeline-calls-external-realisation",
      "kind": "calls",
      "from": "verification-pipeline",
      "to": "external-realisation",
      "description": "The traceability check delegates modules that name a root, and the scan of a root's include globs."
    },
    {
      "id": "external-realisation-calls-filesystem",
      "kind": "calls",
      "from": "external-realisation",
      "to": "filesystem",
      "description": "Checks modules and scans files in a root; reads JUnit reports."
    },
    {
      "id": "external-realisation-calls-external-test-runner",
      "kind": "calls",
      "from": "external-realisation",
      "to": "external-test-runner",
      "description": "verify spawns the test command a root declares, without a shell, unless --ingest-only."
    }
  ],

  // ---- Contracts ---------------------------------------------------------------------
  "contracts": [
    {
      "id": "apply-transaction",
      "name": "Apply a transaction",
      "description": "Project.apply: the single entry through which a project's specification or layout changes (UI, source editor, agent command line). Defined by src/core/project.js and src/core/operations.js.",
      "inputs": [
        { "name": "operations", "type": "Operation | Operation[]", "description": "Typed operations: CreateEntity, DeleteEntity, RenameEntity, SetProperty, CreateRelationship, DeleteRelationship, MovePresentationNode, AddClaim, ModifyClaim, AddState, AddTransition, ReplaceSource, ReplaceLayout." },
        { "name": "label", "type": "string", "description": "Optional history label." },
        { "name": "origin", "type": "string", "description": "Optional origin of the change (ui by default, cli, undo, redo, external)." },
        { "name": "expectRevision / expectHash", "type": "number / string", "description": "Optional optimistic concurrency guards against the project's revision or semantic hash." }
      ],
      "outputs": [
        { "name": "result", "type": "TransactionResult", "description": "ok, revision after the call, semantic hash, affected entity ids, semanticChanged and the diagnostics of the resulting (or rejected) state; on failure also code and message." },
        { "name": "commit event", "type": "{type: 'commit', result, entry}", "description": "Delivered synchronously to every subscriber after a successful commit; the history entry says whether spec and layout changed." }
      ],
      "preconditions": [
        "The operation list is not empty and every operation names a known type",
        "When expectRevision or expectHash is given, it equals the project's current revision or semantic hash",
        "A current model exists unless every operation is ReplaceSource or ReplaceLayout",
        "Each operation's own preconditions hold (the entity exists and has the right kind, new ids match the id pattern and are unused, parameters have the right shape)"
      ],
      "postconditions": [
        "Atomicity: when the result is not ok, the specification text, layout text, model, revision, history and undo stacks are exactly as before",
        "The resulting specification, if the specification text was edited, has no validation errors; a transaction whose result would have errors is rejected",
        "On success the revision has increased by exactly one, a new immutable model snapshot derived from the new text exists and the undo stack gained one entry (the redo stack is cleared)",
        "Presentation operations (MovePresentationNode, ReplaceLayout) never change the specification text or the semantic hash",
        "Existing comments and formatting outside the edited ranges are preserved"
      ],
      "errors": [
        { "name": "op.empty", "condition": "The transaction has no operation." },
        { "name": "op.unknown", "condition": "An operation has an unknown type." },
        { "name": "revision.stale", "condition": "expectRevision or expectHash does not match the project." },
        { "name": "model.unavailable", "condition": "The current source has syntax errors and an operation other than ReplaceSource or ReplaceLayout was submitted." },
        { "name": "validation.failed", "condition": "The resulting specification would have validation errors, or a replacement source has syntax errors." },
        { "name": "layout.invalid", "condition": "The resulting layout would be unreadable." },
        { "name": "op.param / op.kind", "condition": "An operation parameter is missing or has the wrong shape, or an entity kind cannot be created." },
        { "name": "entity.unknown / entity.kind", "condition": "An id names no entity, or an entity of the wrong kind." },
        { "name": "id.format / id.duplicate", "condition": "A new id breaks the id pattern or is already used." },
        { "name": "delete.system / delete.referenced", "condition": "The system entity cannot be deleted; an entity that others refer to is deleted without cascade." },
        { "name": "edit.syntax / edit.not-array", "condition": "A text edit would leave the specification syntactically invalid, or targets something that is not an array." }
      ],
      "obligations": ["Callers must show the rejection and its diagnostics to the user or agent; a rejected transaction is never retried implicitly."]
    },
    {
      "id": "write-file",
      "name": "Write a project file",
      "description": "Writing spec.jsonc or layout.jsonc of a project: persistence client, POST /__exegra/write of the development-server plugin, and the workspace service's write function in tools/workspace.js.",
      "inputs": [
        {
          "name": "name",
          "type": "string",
          "description": "Project name matching ^[a-z0-9][a-z0-9_-]{0,63}$."
        },
        {
          "name": "file",
          "type": "'spec' | 'layout'",
          "description": "Which project file."
        },
        {
          "name": "text",
          "type": "string",
          "description": "Complete new file text, at most 5 MB."
        },
        {
          "name": "baseHash",
          "type": "string | null",
          "description": "sha-256 hash of the file text the caller last read or wrote; null means the caller expects the file to be absent."
        },
        {
          "name": "meta",
          "type": "{label, origin}",
          "description": "Optional journal annotations.",
          "optional": true
        }
      ],
      "outputs": [
        { "name": "success", "type": "{ok: true, hash}", "description": "The hash of the text now on disk." },
        { "name": "conflict", "type": "{ok: false, conflict: true, current: {text, hash}}", "description": "The file's current content, returned instead of writing; HTTP status 409." },
        { "name": "failure", "type": "{ok: false, error}", "description": "Any other refusal or failure." }
      ],
      "preconditions": [
        "The project name is valid and the target path stays inside the project directory",
        "The file is spec or layout and the text is a string within the size limit",
        "Over HTTP: the Host and any Origin are loopback and the x-exegra-client header is present"
      ],
      "postconditions": [
        "Optimistic concurrency: the file is replaced only if the sha-256 of its current text equals baseHash (absent equals null); otherwise it is left untouched and the conflict result carries its current content",
        "Replacement writes a temporary sibling file and renames it over the target; writes of one project are serialized",
        "One line is appended to .history/journal.jsonl for every successful write"
      ],
      "errors": [
        { "name": "conflict", "condition": "The file on disk differs from the base hash." },
        { "name": "name.invalid / path.unsafe", "condition": "The project name is invalid or the path escapes the project." },
        { "name": "file.unknown / input.invalid / too-large", "condition": "The file is not spec or layout, an input has the wrong type, or the text exceeds 5 MB." },
        { "name": "host.forbidden / origin.forbidden / client.header", "condition": "The request is not from a loopback host or origin, or lacks the custom header (HTTP 403)." }
      ],
      "obligations": [
        "A client that receives a conflict must not overwrite silently: the session keeps the conflict until the user chooses to reload from disk or overwrite disk."
      ],
      "binding": {
        "protocol": "HTTP",
        "method": "POST",
        "path": "/__exegra/write"
      }
    },
    {
      "id": "project-scene",
      "name": "Project a model into a scene",
      "description": "project(model, viewId, ctx) in src/core/projections.js, followed by layoutScene(scene, pinned, {method, aspect}) or chooseLayout(scene, pinned, {aspect}) in src/core/layout.js.",
      "inputs": [
        { "name": "model", "type": "Model", "description": "The committed model snapshot." },
        { "name": "viewId", "type": "string", "description": "A declared view, or the id of an implicit view; an unknown id falls back to the first view." },
        { "name": "ctx", "type": "ProjectionContext", "description": "Collapsed and hidden sets, isolated subsystem, focused claim and scenario, the focused entity (for the references projection), claim results, simulation trace and step." },
        { "name": "layout options", "type": "{method?: string, aspect?: number}", "description": "The layout method (layered, layered-down, packed, radial or auto) and the target width-to-depth ratio of the view; defaults are layered and 1.6." },
        { "name": "pinned", "type": "Record<sceneNodeId, [x, z]>", "description": "Absolute positions of leaf nodes from the layout file." }
      ],
      "outputs": [
        { "name": "scene", "type": "SceneModel", "description": "Nodes, edges, legend and notes." },
        { "name": "placement", "type": "Placement", "description": "A rectangle on the ground plane for every node; chooseLayout also returns the method it chose and the score of every method." }
      ],
      "postconditions": [
        "Every node and every edge of the scene is backed by an entity of the model (it carries that entity's id)",
        "Pure and deterministic: the same inputs give the same scene and placement, and the model is not changed",
        "Position carries no meaning: containment and relationships do"
      ],
      "obligations": ["The renderer draws only what a scene and a placement contain and reads nothing from the model."]
    },
    {
      "id": "evaluate-claims",
      "name": "Evaluate claims",
      "description": "evaluateClaims, evaluateClaim and checkTrace in src/core/claims.js.",
      "inputs": [
        { "name": "model", "type": "Model", "description": "The model whose claims are evaluated." },
        { "name": "recorded", "type": "Recorded | null", "description": "Recorded execution results of evidence, keyed by evidence id." }
      ],
      "outputs": [
        { "name": "results", "type": "ClaimResult[]", "description": "One result per claim in declaration order: status, evaluator, semantic hash, scope, explanation, assumptions, involved entities, counterexample and evidence." }
      ],
      "postconditions": [
        "A status is verified only when an evaluator checked the claim on the model; a selector that selects nothing is inconclusive, not verified",
        "A claim whose method is not registered is not evaluated",
        "Trace-based statuses state that only the listed scenarios' traces were checked",
        "Evidence can only make a model-evaluated claim worse (a recorded fail or contradicting evidence turns verified into violated), never better",
        "An external-evidence claim is supported only by a recorded passing test or by non-test evidence, and says whether Exegra executed anything",
        "Deterministic: no clock, randomness or I/O"
      ],
      "errors": [
        { "name": "unknown claim", "condition": "evaluateClaim is called with an id that is not a claim; it throws." },
        { "name": "evaluator failure", "condition": "An exception while evaluating a claim becomes an inconclusive result rather than aborting the evaluation." }
      ]
    },
    {
      "id": "run-scenario",
      "name": "Run a scenario",
      "description": "runScenario, createSimulation and createTraceCursor in src/core/engine.js, on the Rust engine compiled to WebAssembly; semantics are specified in docs/module-contracts.md.",
      "inputs": [
        { "name": "model", "type": "Model", "description": "The model holding the behaviors." },
        { "name": "scenarioId", "type": "string", "description": "A scenario of the model." },
        { "name": "faults", "type": "string[]", "description": "Optional fault ids replacing the scenario's own list." }
      ],
      "outputs": [
        { "name": "trace", "type": "Trace", "description": "Initial configuration, every step with fired transitions, ignored events, faults and the configuration after it, the outcome and the final configuration." }
      ],
      "preconditions": ["The scenario, every behavior it lists and every active fault exist in the model"],
      "postconditions": [
        "Deterministic: the same inputs give deep-equal traces",
        "The run ends quiescent (queue empty), at the step limit (maxSteps, default 1000) or in error (an expression failed; the failing step carries the error)",
        "Recorded steps are not changed by later steps"
      ],
      "errors": [
        { "name": "unknown identifier", "condition": "The scenario, a listed behavior or an active fault does not exist; a plain Error is thrown." }
      ]
    },
    {
      "id": "agent-command",
      "name": "Agent command",
      "description": "One invocation of `node cli/exegra.js <command> [args] [--project <name>] [--specs <dir>] [--pretty]`; described in docs/agent-interface.md.",
      "inputs": [
        { "name": "command", "type": "string", "description": "projects, validate, list, show, deps, contracts, claims, evaluate, gaps, ops, apply, plan-delete, simulate, trace, generate, traceability, verify or help." },
        { "name": "options", "type": "flags", "description": "Command options; --project defaults to exegra and --specs to the repository's specs directory." }
      ],
      "outputs": [
        { "name": "envelope", "type": "JSON document on stdout", "description": "{ok, command, project, semanticHash?, result} or {ok: false, command, project, error: {code, message}, diagnostics}; progress notes go to stderr." },
        { "name": "exit code", "type": "number", "description": "0 ok, 1 the command failed, 2 usage error." }
      ],
      "postconditions": [
        "Every mutation is applied through Project.apply; no command edits specification text directly",
        "A rejected or stale transaction, or a disk conflict, leaves the files unchanged apart from the case noted on agent-cli (spec written, layout conflicting)"
      ],
      "errors": [
        { "name": "usage.*", "condition": "Missing or unknown command or argument (exit code 2)." },
        { "name": "revision.stale / write.conflict", "condition": "The expected hash does not match, or a file changed on disk since it was read." }
      ]
    },
    {
      "id": "engine-input-v2",
      "name": "Engine input, format version 2",
      "description": "Planned (WG-4664, WG-4715). The engine input {format: \"exegra-sim-input\", version: 2} that simulationInput derives for a specification using resources, workloads, links, instances, timers or seeded randomness. Every version-1 field keeps its meaning with times as integers of the base unit. Normative definition: docs/simulation.md, \"Planned: resources, workloads and performance\", \"Engine input and trace format version 2\".",
      "inputs": [
        {
          "name": "version",
          "type": "2",
          "description": "Version-1 inputs are still run by the version-1 semantics; any other value is refused."
        },
        {
          "name": "time",
          "type": "{unit: \"tick\" | \"s\" | \"ms\" | \"us\" | \"ns\", perSecond: null | 1 | 1000 | 1000000 | 1000000000}",
          "description": "Base unit; times and durations are integers in [0, 2^53). Unit tick allows no rate or bandwidth."
        },
        {
          "name": "scenario.seed",
          "type": "decimal string | null",
          "description": "Unsigned 64-bit seed without sign or leading zeros; required when any element draws; not needed when the only random sites are choice values."
        },
        {
          "name": "scenario.stepLimit",
          "type": "integer in [1, 2^53)",
          "description": "maxSteps of the specification."
        },
        {
          "name": "scenario.horizon / warmup / stopAt",
          "type": "integer | null",
          "description": "Horizon required with workloads; warmup < horizon <= stopAt."
        },
        {
          "name": "scenario.output",
          "type": "\"trace\" | \"metrics\"",
          "description": "Full trace, or metrics and final configuration only.",
          "optional": true
        },
        {
          "name": "scenario.steps[].target",
          "type": "{behavior, instance}",
          "description": "Optional addressee of an input step.",
          "optional": true
        },
        {
          "name": "behaviors[].instances",
          "type": "{count: integer} | {key: string, max: integer}",
          "description": "Counted or keyed instances; keyed machine keys keep the canonical JSON of the key, quotes included.",
          "optional": true
        },
        {
          "name": "transitions[].effects",
          "type": "Effect[]",
          "description": "Adds emit with after as integer or distribution, target \"reply\", via, size and fanout; use, acquire, release with class; timer, cancel; set with {sample: dist}."
        },
        {
          "name": "routes",
          "type": "{event, behavior, by: \"key\" | \"round-robin\" | \"random\" | \"any\" | \"least-busy\", field?, resource?}[]",
          "description": "Instance routing decided when the entry is created; down instances are skipped except by key; any is enumerated by the explorer."
        },
        {
          "name": "resources",
          "type": "{id, kind, capacity, discipline: \"fifo\" | \"priority\", queueBound, overflow: \"refuse\" | \"drop\" | \"shed-oldest\", demandFactor: [n, num, den][] | {usl: {alpha: [num, den], beta: [num, den]}} | null, classes: {id, priority, reserved, limit, queueBound, maxWait}[]}[]",
          "description": "Resources with capacity, request classes, queue rules and load-dependent demand (a step table whose last row holds beyond it, or USL parameters evaluated exactly at each grant)."
        },
        {
          "name": "links",
          "type": "{id, from, to, latency: Dist | null, bandwidth: integer | null, queueBound: integer | null, ordered: boolean, fanout: boolean}[]",
          "description": "Bytes per second, a latency distribution, ordering and per-receiver fan-out queues."
        },
        {
          "name": "workloads",
          "type": "{id, kind: \"open\" | \"closed\" | \"population\", ...}[]",
          "description": "Open: event, process, phases, repeat, batch, clients {count, pick, addresses}, legitimate, maxArrivals, payload. Closed: event, population, think, start, reply, timeout, payload, legitimate. Population: behavior, count, start, clients, legitimate. Phases: from < until, sorted, non-overlapping; rates count instants."
        },
        {
          "name": "unitExponential",
          "type": "[u, x][]",
          "description": "The pinned unit-mean exponential quantile table at scale 2^-64 on the standard grid (x below 2^72), present when a workload is Poisson.",
          "optional": true
        },
        {
          "name": "requests",
          "type": "{id, start: {event, workload?}, key, ends: {event, outcome: \"ok\" | \"refused\" | \"timeout\" | \"error\"}[]}[]",
          "description": "Request classes measured by the metrics."
        },
        {
          "name": "meters",
          "type": "{id, of, measure: \"count\" | \"rate\" | \"ratio\" | \"quantile\", window, q?}[]",
          "description": "Windowed measurements readable in expressions."
        },
        {
          "name": "prices",
          "type": "{id, counts, price: {num, den}, currency}[]",
          "description": "Exact rational prices per counted unit (a delivery, an ended request, a byte, a resource unit held for one second, an instance up for one second)."
        },
        {
          "name": "metrics",
          "type": "{quantiles: string[], series?: {bucket}}",
          "description": "Quantiles as exact decimals (default 0.5, 0.9, 0.99) and an optional series bucket dividing horizon - warmup.",
          "optional": true
        },
        {
          "name": "faults[]",
          "type": "Fault",
          "description": "Optional window {at, until} (not on crash-instance); adds scale-demand, set-capacity, set-class-limit, collapse-classes, replace-demand and crash-instance {behavior, instance, at, restartAfter?, notify?}."
        },
        {
          "name": "Dist",
          "type": "{kind: \"fixed\", value} | {kind: \"uniform\", lo, hi} | {kind: \"table\", points: [u, x][]} | {kind: \"choice\", values}",
          "description": "Integer distributions; continuous ones are lowered to tables with the pinned quantile tables and 96-bit fixed-point exp and ln."
        }
      ],
      "outputs": [
        {
          "name": "trace",
          "type": "Trace (version 2)",
          "description": "See contract trace-v2."
        }
      ],
      "preconditions": [
        "The input was derived from a validated specification, or is a generated input of the version-2 generator",
        "Every integer is within its bound (docs/simulation.md, Integers and bounds; distribution tables below 2^53, unitExponential below 2^72); a specification duration that is not a whole number of base units is a validation error, never rounded",
        "No reserved name is used, ids of behaviors, resources, meters, links and workloads are distinct, and every reference resolves",
        "Phases are valid: from < until, sorted, non-overlapping, and repeat at least the last until",
        "Reserved units sum to at most capacity, each class's reserved units are at most its limit, and every request can be granted, for every fault mask the scenario admits",
        "A keyed behavior's max is at least the sum of the counts of the populations on it",
        "A seed is present when any element draws"
      ],
      "postconditions": [
        "Two calls of simulationInput on the same model give identical documents",
        "A specification that uses no format-2 construct still derives a version-1 input, unchanged"
      ],
      "errors": [
        {
          "name": "refusal",
          "condition": "In order after the version-1 refusals: unknown time unit; Field \"<path>\" must be an integer in [<lo>, <hi>].; a malformed seed; a reserved name; an unknown id; a malformed table; a Poisson phase whose mean interarrival is below 100 base units; a rate or bandwidth under unit tick; reserved units above capacity or above a class limit, or a request that can never be granted; a window on crash-instance; a population larger than its behavior's max; Input samples \"<stream>\" but declares no seed.; via together with after; workloads without a horizon, warmup >= horizon or stopAt < horizon."
        }
      ]
    },
    {
      "id": "trace-v2",
      "name": "Trace, format version 2",
      "description": "Planned (WG-4664, WG-4715). The trace an engine returns for a version-2 input: the version-1 trace with integer times, instances, resource and link state, draws and metrics. A version-1 input still returns a version-1 trace. Normative definition: docs/simulation.md, \"Planned: resources, workloads and performance\".",
      "inputs": [
        {
          "name": "input",
          "type": "engine-input-v2",
          "description": "The engine input."
        }
      ],
      "outputs": [
        {
          "name": "version, timeUnit, seed",
          "type": "2, string, decimal string | null",
          "description": "Copied from the input."
        },
        {
          "name": "configuration",
          "type": "{time, machines, pending, resources, links, timers, workloads, meters, routeCounters, streams, down, incarnations}",
          "description": "Machines keyed <behavior> for a single undeclared instance, else <behavior>#<index or canonical JSON key>; holdings per instance and class; timers by stable id; draw counters per stream; pending entries carry scheduledAt and, when addressed to an instance, its incarnation."
        },
        {
          "name": "steps[].kind",
          "type": "\"deliver\" | \"drop\" | \"delay\" | \"service-done\" | \"wait-timeout\" | \"link-done\" | \"fault-edge\" | \"client-timeout\"",
          "description": "Internal entries are steps of their own and count against the step limit."
        },
        {
          "name": "steps[].event",
          "type": "{id, payload, seq, source, scheduledAt, target?, from?, routes?, timer?, incarnation?}",
          "description": "Sources add arrival, timer, resource, link and fault-edge kinds."
        },
        {
          "name": "steps[].fired[].instance / ignored[].instance",
          "type": "number | string",
          "description": "The instance the transition ran on; ignored reason adds no-instance."
        },
        {
          "name": "steps[].resources",
          "type": "{resource, class, request, action, at, waited?, served?, reason?}[]",
          "description": "enqueued, granted, completed, released, refused, shed, dropped, timed-out, in the order they happened."
        },
        {
          "name": "steps[].draws",
          "type": "{stream, index, value}[]",
          "description": "Every random draw of the step in order (for an arrival instant: arrival, batch, then client and payload per entry); value as a decimal string."
        },
        {
          "name": "steps[].faults[]",
          "type": "{fault, effect}[]",
          "description": "Adds effects scaled, capacity, limit, collapsed, replaced, crashed, stale and restarted."
        },
        {
          "name": "outcome, truncated",
          "type": "\"quiescent\" | \"step-limit\" | \"error\" | \"stopped\", boolean",
          "description": "A truncated run never satisfies a metric claim."
        },
        {
          "name": "metrics",
          "type": "Metrics",
          "description": "Integer measured outputs over [warmup, horizon), from the request lifecycle of docs/simulation.md: requests start when their start entry is first taken as head, a lost start ends as error, only ok requests are finite samples, and counts of unkeyed, duplicate and late ends are reported; nearest-rank percentiles and optional series."
        },
        {
          "name": "initialDraws",
          "type": "{stream, index, value}[]",
          "description": "Draws made at the start of the run, in order."
        }
      ],
      "preconditions": [
        "The input is a valid version-2 engine input"
      ],
      "postconditions": [
        "Deterministic: the same input, seed and faults give deep-equal traces and metrics",
        "Every number in the trace other than variable and payload values is an integer",
        "Held units stay within class limits and capacity, and waiting requests within their bounds, at every settled step (a mid-run capacity cut keeps held units until released)",
        "The lift of a version-1 input that meets the side conditions of lift_agrees gives this trace minus the version-2 fields equal to the version-1 trace",
        "With output metrics, the metrics equal those computed from the full trace of the same input"
      ],
      "errors": [
        {
          "name": "failed step",
          "condition": "Version-1 failures, plus: Value <what> exceeds 2^53.; Value demand scale of \"<r>\" exceeds 2^32.; Reference \"<path>\" is ambiguous: \"<behavior>\" has <n> instances.; Aggregate \"<path>\" needs numbers, got <type>.; Behavior \"<b>\" would exceed <M> instances.; Route of \"<event>\" to \"<behavior>\" needs payload field \"<field>\".; Instance \"<key>\" releases <n> units of \"<r>\" class \"<c>\" but holds <m>.; Effect replies to \"<event>\", which has no requester.; Size of emit \"<event>\" must be an integer in [0, 2^40), got <value>."
        }
      ]
    }
  ],

  // ---- Events (the vocabulary of Exegra's own edit flow) ---------------------------------
  "events": [
    { "id": "edit-requested", "name": "Edit requested", "description": "A gesture in the scene, inspector or a dialog asks for a change; it becomes a typed operation." },
    { "id": "source-apply-requested", "name": "Source apply requested", "description": "The user applies the draft in the source editor; it becomes a ReplaceSource operation." },
    { "id": "operation-submitted", "name": "Operation submitted", "description": "A typed operation reaches the transaction system through session.apply." },
    { "id": "text-edits-computed", "name": "Text edits computed", "description": "Preconditions held and the operation's source-preserving text edits produced a candidate specification text." },
    { "id": "model-parsed", "name": "Candidate model parsed", "description": "The candidate text was parsed into a candidate model." },
    { "id": "validation-passed", "name": "Validation passed", "description": "The candidate model has no validation errors." },
    { "id": "validation-failed", "name": "Validation failed", "description": "The candidate has validation errors; the transaction is refused." },
    { "id": "transaction-committed", "name": "Transaction committed", "description": "The revision increased and a new model snapshot exists; the commit listener of the session runs.", "payload": [{ "name": "revision", "type": "number" }] },
    { "id": "transaction-rejected", "name": "Transaction rejected", "description": "The transaction was refused; nothing changed." },
    { "id": "refresh-requested", "name": "Refresh requested", "description": "The session re-evaluates claims, re-projects and re-lays-out the scene for the committed revision.", "payload": [{ "name": "revision", "type": "number" }] },
    { "id": "projection-refreshed", "name": "Projection refreshed", "description": "The scene for the committed revision was derived and handed to the renderer.", "payload": [{ "name": "revision", "type": "number" }] },
    { "id": "model-published", "name": "Model published", "description": "The session announced the commit to the inspector and the source editor.", "payload": [{ "name": "revision", "type": "number" }] },
    { "id": "save-requested", "name": "Save requested", "description": "The session's asynchronous flush sends the committed text with its base hash to the file service, after the commit.", "payload": [{ "name": "revision", "type": "number" }] },
    { "id": "save-succeeded", "name": "Save succeeded", "description": "The file service replaced the file; its hash is the new base hash." },
    { "id": "save-conflicted", "name": "Save conflicted", "description": "The file on disk differed from the base hash; the file service returned a conflict and wrote nothing." },
    {
      "id": "write-intent",
      "name": "Write intended",
      "description": "The session decides to write the committed text of a project file to disk."
    },
    {
      "id": "write-file-request",
      "name": "Write file",
      "description": "The persistence client sends the text of a project file with the base hash it last read.",
      "contract": "write-file",
      "role": "request",
      "payload": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "file",
          "type": "'spec' | 'layout'"
        },
        {
          "name": "text",
          "type": "string"
        },
        {
          "name": "baseHash",
          "type": "string | null"
        }
      ]
    },
    {
      "id": "write-file-ok",
      "name": "Write accepted",
      "description": "The development server replaced the file and returns the hash of the text now on disk.",
      "contract": "write-file",
      "role": "response",
      "payload": [
        {
          "name": "ok",
          "type": "true"
        },
        {
          "name": "hash",
          "type": "string"
        }
      ]
    },
    {
      "id": "write-file-conflict",
      "name": "Write refused",
      "description": "The file on disk differs from the base hash: nothing is written and the current hash is returned.",
      "contract": "write-file",
      "role": "error",
      "payload": [
        {
          "name": "code",
          "type": "'conflict'"
        },
        {
          "name": "current",
          "type": "string"
        }
      ]
    }
  ],

  // ---- Behaviors: Exegra's own edit flow as state machines ---------------------------------
  // These abstract session.apply, Project.apply/#commit, the session's onCommit and flush,
  // the renderer, inspector and source editor refresh, and the write to disk. The abstraction
  // keeps the real order: the projection is refreshed when the transaction commits, and the
  // write to disk happens afterwards and asynchronously (one logical tick later). One variable
  // `revision` / `shownRevision` / `persistedRevision` stands for the revision of the model,
  // of what a view shows, and of what the file on disk holds. The correspondence between these
  // machines and the code is maintained by hand and is not checked.
  "behaviors": [
    {
      "id": "interaction-flow",
      "name": "Interaction layer: submit an edit and show its outcome",
      "subject": "visual-interaction",
      "description": "The scene, inspector or a dialog submits a typed operation and later shows the result: accepted, or the rejection with its diagnostics.",
      "initial": "interaction-idle",
      "variables": [{ "name": "refusalShown", "type": "boolean", "initial": false }],
      "states": [
        { "id": "interaction-idle", "name": "Idle" },
        { "id": "interaction-awaiting", "name": "Awaiting the transaction result" },
        { "id": "interaction-done", "name": "Edit accepted", "terminal": true },
        { "id": "interaction-refused", "name": "Edit refused and rejection shown", "terminal": true }
      ],
      "transitions": [
        { "id": "interaction-submit", "from": "interaction-idle", "to": "interaction-awaiting", "on": "edit-requested", "effects": [{ "emit": "operation-submitted" }] },
        { "id": "interaction-accept", "from": "interaction-awaiting", "to": "interaction-done", "on": "transaction-committed" },
        { "id": "interaction-refuse", "from": "interaction-awaiting", "to": "interaction-refused", "on": "transaction-rejected", "effects": [{ "set": "refusalShown", "to": true }] }
      ]
    },
    {
      "id": "source-editor-flow",
      "name": "Source editor: apply a draft and stay in sync",
      "subject": "source-editor",
      "description": "The editor shows the committed text. Applying a draft submits ReplaceSource; a rejection keeps the draft as typed. After any commit the editor shows the committed revision.",
      "initial": "source-in-sync",
      "variables": [{ "name": "shownRevision", "type": "number", "initial": 1 }],
      "states": [
        { "id": "source-in-sync", "name": "In sync with the model" },
        { "id": "source-applying", "name": "Applying a draft" },
        { "id": "source-draft-kept", "name": "Draft kept after a rejection", "terminal": true }
      ],
      "transitions": [
        { "id": "source-apply", "from": "source-in-sync", "to": "source-applying", "on": "source-apply-requested", "effects": [{ "emit": "operation-submitted" }] },
        { "id": "source-refresh-after-apply", "from": "source-applying", "to": "source-in-sync", "on": "model-published", "effects": [{ "set": "shownRevision", "to": "event.revision" }] },
        { "id": "source-keep-draft", "from": "source-applying", "to": "source-draft-kept", "on": "transaction-rejected" },
        { "id": "source-refresh-after-visual-edit", "from": "source-in-sync", "to": "source-in-sync", "on": "model-published", "effects": [{ "set": "shownRevision", "to": "event.revision" }] }
      ]
    },
    {
      "id": "transaction-flow",
      "name": "Transaction system: check, validate, commit or reject",
      "subject": "transactions",
      "description": "Preconditions are checked and text edits computed; the candidate is parsed and validated. With no errors it commits and the revision increments; otherwise it is rejected and nothing changes. Precondition failures, which reject before any text is computed, are abstracted into the rejection.",
      "initial": "tx-idle",
      "variables": [
        { "name": "revision", "type": "number", "initial": 1 },
        { "name": "rejected", "type": "boolean", "initial": false }
      ],
      "states": [
        { "id": "tx-idle", "name": "Idle" },
        { "id": "tx-validating", "name": "Candidate being parsed and validated" }
      ],
      "transitions": [
        { "id": "tx-begin", "from": "tx-idle", "to": "tx-validating", "on": "operation-submitted", "effects": [{ "emit": "text-edits-computed" }] },
        {
          "id": "tx-commit-unvalidated",
          "from": "tx-validating",
          "to": "tx-idle",
          "on": "model-parsed",
          "faultOnly": true,
          "effects": [
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "set": "rejected",
              "to": "false"
            },
            {
              "emit": "transaction-committed",
              "payload": {
                "revision": "revision"
              }
            }
          ]
        },
        {
          "id": "tx-reject-partially-applied",
          "from": "tx-validating",
          "to": "tx-idle",
          "on": "validation-failed",
          "faultOnly": true,
          "effects": [
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "set": "rejected",
              "to": "true"
            },
            {
              "emit": "transaction-rejected"
            }
          ]
        },
        { "id": "tx-commit", "from": "tx-validating", "to": "tx-idle", "on": "validation-passed", "description": "Project.#commit: swap the texts, derive the snapshot, increment the revision, record history, notify subscribers.", "effects": [{ "set": "revision", "to": "revision + 1" }, { "set": "rejected", "to": false }, { "emit": "transaction-committed", "payload": { "revision": "revision" } }] },
        { "id": "tx-reject", "from": "tx-validating", "to": "tx-idle", "on": "validation-failed", "description": "The result would have validation errors: the texts, the model, the revision and the history stay as they were.", "effects": [{ "set": "rejected", "to": true }, { "emit": "transaction-rejected" }] }
      ]
    },
    {
      "id": "parser-flow",
      "name": "Parser: derive the candidate model",
      "subject": "parser",
      "initial": "parser-ready",
      "variables": [{ "name": "runs", "type": "number", "initial": 0 }],
      "states": [{ "id": "parser-ready", "name": "Ready" }],
      "transitions": [
        { "id": "parser-parse", "from": "parser-ready", "to": "parser-ready", "on": "text-edits-computed", "effects": [{ "set": "runs", "to": "runs + 1" }, { "emit": "model-parsed" }] }
      ]
    },
    {
      "id": "validator-flow",
      "name": "Validator: judge the candidate model",
      "subject": "validator",
      "description": "The faulty-input alternative is a faultOnly transition declared before the normal one so that it takes priority while the fault is active.",
      "initial": "validator-ready",
      "variables": [{ "name": "lastResult", "type": "string", "initial": "none" }],
      "states": [{ "id": "validator-ready", "name": "Ready" }],
      "transitions": [
        { "id": "validator-reject", "from": "validator-ready", "to": "validator-ready", "on": "model-parsed", "faultOnly": true, "description": "The candidate has validation errors.", "effects": [{ "set": "lastResult", "to": "'failed'" }, { "emit": "validation-failed" }] },
        { "id": "validator-accept", "from": "validator-ready", "to": "validator-ready", "on": "model-parsed", "effects": [{ "set": "lastResult", "to": "'passed'" }, { "emit": "validation-passed" }] }
      ]
    },
    {
      "id": "session-flow",
      "name": "Session: refresh on commit, then save asynchronously",
      "subject": "session",
      "description": "onCommit re-evaluates claims, re-projects and re-lays-out the scene (the renderer receives it), then announces the model to the inspector and source editor, and starts the flush. The flush writes later and asynchronously; the save state follows its result.",
      "initial": "session-in-sync",
      "variables": [
        { "name": "saveState", "type": "string", "initial": "saved" },
        { "name": "rejectionsLogged", "type": "number", "initial": 0 }
      ],
      "states": [
        { "id": "session-in-sync", "name": "Saved and in sync" },
        { "id": "session-refreshing", "name": "Refreshing the scene" },
        { "id": "session-save-pending", "name": "Save in flight" },
        { "id": "session-conflicted", "name": "Save conflict unresolved", "terminal": true }
      ],
      "transitions": [
        {
          "id": "session-swallow-conflict",
          "from": "session-save-pending",
          "to": "session-in-sync",
          "on": "save-conflicted",
          "faultOnly": true,
          "effects": [
            {
              "set": "saveState",
              "to": "'saved'"
            }
          ]
        },
        {
          "id": "session-refresh-on-rejection",
          "from": "session-in-sync",
          "to": "session-refreshing",
          "on": "transaction-rejected",
          "faultOnly": true,
          "effects": [
            {
              "emit": "refresh-requested",
              "payload": {
                "revision": "transaction-flow.revision"
              }
            }
          ]
        },
        { "id": "session-on-commit", "from": "session-in-sync", "to": "session-refreshing", "on": "transaction-committed", "effects": [{ "emit": "refresh-requested", "payload": { "revision": "event.revision" } }] },
        { "id": "session-on-refreshed", "from": "session-refreshing", "to": "session-save-pending", "on": "projection-refreshed", "description": "The renderer already has the scene; now the model is published and the write is requested, one tick later.", "effects": [{ "set": "saveState", "to": "'saving'" }, { "emit": "model-published", "payload": { "revision": "event.revision" } }, { "emit": "save-requested", "after": 1, "payload": { "revision": "event.revision" } }] },
        { "id": "session-on-saved", "from": "session-save-pending", "to": "session-in-sync", "on": "save-succeeded", "effects": [{ "set": "saveState", "to": "'saved'" }] },
        { "id": "session-on-conflict", "from": "session-save-pending", "to": "session-conflicted", "on": "save-conflicted", "description": "Nothing was overwritten; the conflict waits for the user to reload from disk or overwrite disk.", "effects": [{ "set": "saveState", "to": "'conflict'" }] },
        { "id": "session-on-rejection", "from": "session-in-sync", "to": "session-in-sync", "on": "transaction-rejected", "description": "The rejection is logged; no refresh and no write follow.", "effects": [{ "set": "rejectionsLogged", "to": "rejectionsLogged + 1" }] }
      ]
    },
    {
      "id": "projection-flow",
      "name": "Projection: derive the scene of the committed revision",
      "subject": "projection-system",
      "initial": "projection-ready",
      "variables": [{ "name": "shownRevision", "type": "number", "initial": 1 }],
      "states": [{ "id": "projection-ready", "name": "Ready" }],
      "transitions": [
        { "id": "projection-refresh", "from": "projection-ready", "to": "projection-ready", "on": "refresh-requested", "effects": [{ "set": "shownRevision", "to": "event.revision" }, { "emit": "projection-refreshed", "payload": { "revision": "event.revision" } }] }
      ]
    },
    {
      "id": "renderer-flow",
      "name": "Renderer: draw the refreshed scene",
      "subject": "scene-renderer",
      "initial": "renderer-ready",
      "variables": [{ "name": "shownRevision", "type": "number", "initial": 1 }],
      "states": [{ "id": "renderer-ready", "name": "Ready" }],
      "transitions": [
        { "id": "renderer-draw", "from": "renderer-ready", "to": "renderer-ready", "on": "projection-refreshed", "effects": [{ "set": "shownRevision", "to": "event.revision" }] }
      ]
    },
    {
      "id": "inspector-flow",
      "name": "Inspector: refresh from the committed model",
      "subject": "inspector",
      "initial": "inspector-ready",
      "variables": [{ "name": "shownRevision", "type": "number", "initial": 1 }],
      "states": [{ "id": "inspector-ready", "name": "Ready" }],
      "transitions": [
        { "id": "inspector-refresh", "from": "inspector-ready", "to": "inspector-ready", "on": "model-published", "effects": [{ "set": "shownRevision", "to": "event.revision" }] }
      ]
    },
    {
      "id": "workspace-flow",
      "name": "File service: replace the file or report a conflict",
      "subject": "workspace-service",
      "description": "The HTTP hop between the persistence client, the plugin and the workspace service is abstracted. persistedRevision is the revision whose text the file on disk holds; conflict records that the last write was refused because the file on disk differed from the base hash.",
      "initial": "workspace-clean",
      "variables": [
        { "name": "persistedRevision", "type": "number", "initial": 1 },
        { "name": "conflict", "type": "boolean", "initial": false }
      ],
      "states": [
        { "id": "workspace-clean", "name": "File matches the base hash" },
        { "id": "workspace-conflicted", "name": "Write refused as a conflict", "terminal": true }
      ],
      "transitions": [
        {
          "id": "workspace-overwrite-on-conflict",
          "from": "workspace-clean",
          "to": "workspace-conflicted",
          "on": "save-requested",
          "faultOnly": true,
          "effects": [
            {
              "set": "conflict",
              "to": "true"
            },
            {
              "set": "persistedRevision",
              "to": "event.revision"
            },
            {
              "emit": "save-conflicted"
            }
          ]
        },
        { "id": "workspace-detect-conflict", "from": "workspace-clean", "to": "workspace-conflicted", "on": "save-requested", "faultOnly": true, "description": "The file's hash differs from the base hash: nothing is written and the current content is returned.", "effects": [{ "set": "conflict", "to": true }, { "emit": "save-conflicted" }] },
        { "id": "workspace-write", "from": "workspace-clean", "to": "workspace-clean", "on": "save-requested", "description": "The hashes match: the file is replaced atomically.", "effects": [{ "set": "persistedRevision", "to": "event.revision" }, { "emit": "save-succeeded" }] }
      ]
    },
    {
      "id": "write-client-flow",
      "name": "Persistence client: write a file, retry after a conflict",
      "subject": "persistence-client",
      "description": "Sends the text with the base hash it last read. A conflict returns the current hash, which becomes the new base hash for one more request; an accepted write ends the flow.",
      "initial": "write-client-idle",
      "variables": [
        {
          "name": "attempts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "baseHash",
          "type": "string",
          "initial": "h1"
        },
        {
          "name": "saved",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "write-client-idle",
          "name": "Idle"
        },
        {
          "id": "write-client-awaiting",
          "name": "Awaiting the answer"
        },
        {
          "id": "write-client-saved",
          "name": "Written",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "write-client-send",
          "from": "write-client-idle",
          "to": "write-client-awaiting",
          "on": "write-intent",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "emit": "write-file-request",
              "payload": {
                "name": "'exegra'",
                "file": "'spec'",
                "text": "'spec text of revision 2'",
                "baseHash": "baseHash"
              }
            }
          ]
        },
        {
          "id": "write-client-retry",
          "from": "write-client-awaiting",
          "to": "write-client-awaiting",
          "on": "write-file-conflict",
          "guard": "attempts < 3",
          "description": "The base hash was stale: adopt the current hash and send the same text again.",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "baseHash",
              "to": "event.current"
            },
            {
              "emit": "write-file-request",
              "payload": {
                "name": "'exegra'",
                "file": "'spec'",
                "text": "'spec text of revision 2'",
                "baseHash": "event.current"
              }
            }
          ]
        },
        {
          "id": "write-client-done",
          "from": "write-client-awaiting",
          "to": "write-client-saved",
          "on": "write-file-ok",
          "effects": [
            {
              "set": "saved",
              "to": true
            }
          ]
        }
      ]
    },
    {
      "id": "write-endpoint-flow",
      "name": "Development server: accept a write or refuse it as a conflict",
      "subject": "dev-server-plugin",
      "description": "POST /__exegra/write: the file is replaced only when the base hash equals the hash of the text on disk; otherwise it is left untouched and the conflict carries the current hash.",
      "initial": "write-endpoint-ready",
      "variables": [
        {
          "name": "diskHash",
          "type": "string",
          "initial": "h2"
        },
        {
          "name": "writes",
          "type": "number",
          "initial": 0
        },
        {
          "name": "conflicts",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "write-endpoint-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "write-endpoint-conflict",
          "from": "write-endpoint-ready",
          "to": "write-endpoint-ready",
          "on": "write-file-request",
          "guard": "event.baseHash != diskHash",
          "effects": [
            {
              "set": "conflicts",
              "to": "conflicts + 1"
            },
            {
              "emit": "write-file-conflict",
              "payload": {
                "code": "'conflict'",
                "current": "diskHash"
              }
            }
          ]
        },
        {
          "id": "write-endpoint-accept",
          "from": "write-endpoint-ready",
          "to": "write-endpoint-ready",
          "on": "write-file-request",
          "guard": "event.baseHash == diskHash",
          "effects": [
            {
              "set": "diskHash",
              "to": "'h3'"
            },
            {
              "set": "writes",
              "to": "writes + 1"
            },
            {
              "emit": "write-file-ok",
              "payload": {
                "ok": "true",
                "hash": "'h3'"
              }
            }
          ]
        }
      ]
    }
  ],

  // ---- Faults ----------------------------------------------------------------------------
  "faults": [
    { "id": "validation-fails", "name": "Candidate fails validation", "kind": "enable-transition", "transition": "validator-reject", "description": "The operation produces a specification with validation errors, so the validator rejects the candidate." },
    {
      "id": "disk-changed-externally",
      "name": "File changed on disk since it was read",
      "kind": "enable-transition",
      "transition": "workspace-detect-conflict",
      "description": "Another process changed spec.jsonc after the session last read or wrote it, so the base hash no longer matches.",
      "realises": "fm-concurrent-spec-edit"
    },
    {
      "id": "publish-lost",
      "name": "Model publication lost",
      "kind": "drop-event",
      "event": "model-published",
      "description": "The session never publishes the refreshed model, so the inspector and the source editor keep showing the old revision. A defect the edit flow must not have."
    },
    {
      "id": "refresh-before-commit",
      "name": "Refresh not caused by a commit",
      "kind": "inject-event",
      "event": "refresh-requested",
      "at": 0,
      "payload": {
        "revision": 2
      },
      "description": "The projection is refreshed from an uncommitted model. A defect the edit flow must not have."
    },
    {
      "id": "save-before-refresh",
      "name": "Write not caused by a refresh",
      "kind": "inject-event",
      "event": "save-requested",
      "at": 0,
      "payload": {
        "revision": 2
      },
      "description": "The file is written before the views were refreshed from the committed model. A defect the edit flow must not have."
    },
    {
      "id": "commit-skips-validation",
      "name": "Commit without validation",
      "kind": "enable-transition",
      "transition": "tx-commit-unvalidated",
      "description": "The transaction commits as soon as the candidate is parsed, before the validator has passed it. A defect the edit flow must not have."
    },
    {
      "id": "reject-partially-applied",
      "name": "Rejected operation partially applied",
      "kind": "enable-transition",
      "transition": "tx-reject-partially-applied",
      "description": "A rejected operation still advances the revision. A defect the edit flow must not have."
    },
    {
      "id": "rejection-refreshes",
      "name": "Rejection treated as a commit",
      "kind": "enable-transition",
      "transition": "session-refresh-on-rejection",
      "description": "The session refreshes, and then saves, after a rejected transaction. A defect the edit flow must not have."
    },
    {
      "id": "conflict-overwrites",
      "name": "Write despite a conflict",
      "kind": "enable-transition",
      "transition": "workspace-overwrite-on-conflict",
      "description": "The workspace detects the conflict but writes the file anyway. A defect the edit flow must not have."
    },
    {
      "id": "conflict-swallowed",
      "name": "Conflict reported as saved",
      "kind": "enable-transition",
      "transition": "session-swallow-conflict",
      "description": "The session receives the conflict and reports the edit as saved. A defect the edit flow must not have."
    }
  ],

  // ---- Scenarios -------------------------------------------------------------------------
  "scenarios": [
    {
      "id": "visual-edit-flow",
      "name": "A valid visual edit",
      "description": "A valid edit made visually: it is submitted, validated and committed (revision 2), then the projection is refreshed and shown by the renderer, inspector and source editor, and only then the file is written, asynchronously one tick later. Real order: refresh at commit, write afterwards. Ends quiescent with every representation at revision 2 and the file persisted.",
      "behaviors": ["interaction-flow", "source-editor-flow", "transaction-flow", "parser-flow", "validator-flow", "session-flow", "projection-flow", "renderer-flow", "inspector-flow", "workspace-flow"],
      "steps": [
        {
          "at": 0,
          "event": "edit-requested",
          "note": "An inspector property change, a dragged node or a dialog submission."
        }
      ],
      "faultModel": "local-workstation"
    },
    {
      "id": "source-edit-flow",
      "name": "A valid source edit",
      "description": "The same pipeline entered from the source editor as a ReplaceSource operation. The refresh and the asynchronous write follow the commit in the same order as for a visual edit.",
      "behaviors": ["interaction-flow", "source-editor-flow", "transaction-flow", "parser-flow", "validator-flow", "session-flow", "projection-flow", "renderer-flow", "inspector-flow", "workspace-flow"],
      "steps": [
        {
          "at": 0,
          "event": "source-apply-requested",
          "note": "The user applies a valid draft."
        }
      ],
      "faultModel": "local-workstation"
    },
    {
      "id": "rejected-edit",
      "name": "An edit that fails validation",
      "description": "The operation fails validation: the transaction is rejected, nothing commits, nothing refreshes and nothing is written; the interaction layer shows the rejection.",
      "behaviors": ["interaction-flow", "source-editor-flow", "transaction-flow", "parser-flow", "validator-flow", "session-flow", "projection-flow", "renderer-flow", "inspector-flow", "workspace-flow"],
      "faults": ["validation-fails"],
      "steps": [
        {
          "at": 0,
          "event": "edit-requested",
          "note": "An edit whose result would have validation errors."
        }
      ],
      "faultModel": "local-workstation"
    },
    {
      "id": "edit-with-disk-conflict",
      "name": "A valid edit whose write conflicts with the disk",
      "description": "The edit commits and every view shows revision 2, but the file on disk changed since it was read: the write reports a conflict, the file is not overwritten and the session flags the conflict.",
      "behaviors": ["interaction-flow", "source-editor-flow", "transaction-flow", "parser-flow", "validator-flow", "session-flow", "projection-flow", "renderer-flow", "inspector-flow", "workspace-flow"],
      "faults": ["disk-changed-externally"],
      "steps": [
        {
          "at": 0,
          "event": "edit-requested",
          "note": "A valid edit while the file on disk has changed."
        }
      ],
      "faultModel": "local-workstation"
    },
    {
      "id": "write-with-stale-base-hash",
      "name": "A write with a stale base hash is refused and retried",
      "description": "Contract events between the persistence client and the development server's write endpoint (contract write-file): the first request carries a stale base hash and is refused with a conflict; the client retries with the current hash and the write is accepted. The trace reads as a request log: a request, a refused write and a retry.",
      "behaviors": [
        "write-client-flow",
        "write-endpoint-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "write-intent",
          "note": "The session writes the committed text; the client's base hash is out of date."
        }
      ]
    }
  ],

  // ---- Assumptions -----------------------------------------------------------------------
  "assumptions": [
    {
      "id": "machines-abstract-the-code",
      "statement": "The scenario state machines in this file faithfully abstract the code they describe: session.apply, Project.apply and its commit, the session's onCommit and flush, the renderer, inspector and source editor refresh and the workspace write.",
      "rationale": "The correspondence between the machines and the code is maintained by hand and is not checked or generated. A behavioral claim here is true of the machines; it is true of Exegra only to the extent that this assumption holds."
    },
    {
      "id": "views-derive-from-committed-model",
      "statement": "Every representation (scene, inspector, source editor) derives its content from the committed model snapshot and from interaction state, and from nothing else.",
      "rationale": "The equivalence claims compare the revision each view shows with the revision of the transaction system. They say nothing about a view that kept private state of the specification; the session and the panels are written not to, but that is not checked."
    },
    {
      "id": "relationships-match-imports",
      "statement": "The relationships declared in this file match the real imports and calls of the code.",
      "rationale": "They are maintained by hand. The traceability check compares only the module paths that components declare with the files on disk, so a new import that is not declared here would not be noticed by any structural claim."
    },
    {
      "id": "tests-exercise-shipped-modules",
      "statement": "The core tests import and run the same modules under src/core and tools that the application and the agent command line run.",
      "rationale": "Test evidence supports a claim about the shipped code only if the test exercises the shipped code and not a copy."
    },
    {
      "id": "browser-tests-run-real-application",
      "statement": "The browser tests drive the real application served by the Vite development server, against scratch copies of this specification and of the multiplayer test fixture (and, read-only, a project linked locally), in the locally installed Chrome.",
      "rationale": "They show behaviour in one browser on one machine; other browsers are not exercised."
    },
    {
      "id": "recorded-results-reflect-current-code",
      "statement": "A recorded result of a test in evidence/results.json was produced by the code and the specification as they are now.",
      "rationale": "Recorded results carry an outcome and a timestamp but no hash of the code or the model; staleness is not detected."
    },
    {
      "id": "filesystem-honours-atomic-rename",
      "statement": "Renaming a temporary file over the target replaces the target atomically on the file system holding the project.",
      "rationale": "The workspace service relies on it for atomic replacement. On Windows it retries a blocked rename and finally writes in place, which is not atomic."
    },
    {
      "id": "single-workstation",
      "statement": "The browser, the development server and the project files run on one developer workstation: one host, one clock, loopback between browser and server, one local disk.",
      "rationale": "This is how Exegra is run today (npm run dev). It says nothing about a shared or hosted deployment."
    },
    {
      "id": "workstation-rates-assumed",
      "statement": "The rates and durations of the workstation failure modes are the author's estimates of ordinary development use, not measurements.",
      "rationale": "No telemetry exists for the development server or the browser session. A recorded measurement would replace these values; until then they only order the modes by plausibility."
    },
    {
      "id": "one-fault-at-a-time",
      "statement": "On a developer workstation at most one of the listed failures is in progress at a time; two independent failures overlapping within one save is not considered.",
      "rationale": "A single user drives one session; overlapping faults are rare enough to leave out of the fault model, and the model says so."
    },
    {
      "id": "seeded-streams-independent",
      "statement": "Draws from distinct SplitMix64 streams (distinct seeds, or distinct stream names under one seed) behave as independent uniform 64-bit values for the purposes of the simulator.",
      "rationale": "Metric claims treat runs with distinct seeds as independent and identically distributed (the exact binomial test of docs/simulation.md). This rests on the statistical quality of SplitMix64 (it passes BigCrush) and of the FNV-1a and mix64 derivation of stream keys, which is tested, not proved."
    }
  ],

  // ---- Claims ----------------------------------------------------------------------------
  "claims": [
    // ======== Structural claims (evaluated on this model's components and relationships)
    {
      "id": "core-independent-of-ui",
      "kind": "structural",
      "statement": "No component of the semantic core has a dependency relationship (depends-on, calls, subscribes, reads, writes or submits-edits), directly or through any chain of them, to the application, the visualization, the persistence subsystem, the agent interface, the tooling, the DOM and browser platform, browser storage, Three.js, Vite, the file system or the test runner.",
      "rationale": "The core must run unchanged in the browser and in Node and be testable without either. Its only declared outward dependency is the jsonc-parser library. The data-flow relationship from the transaction system to the session (the commit event handed to the listener the session registered) is not a dependency and is not followed: the core knows its listeners only as callbacks.",
      "subjects": ["semantic-core", "application", "visualization", "persistence", "threejs-library", "vite-dev-server", "browser-platform"],
      "assumptions": ["relationships-match-imports"],
      "evaluate": { "method": "no-relationship", "from": "semantic-core", "to": ["application", "visualization", "persistence", "agent-interface", "tooling", "threejs-library", "vite-dev-server", "browser-platform", "browser-storage", "filesystem", "playwright-runner", "ai-coding-agent"], "kinds": ["depends-on", "calls", "subscribes", "reads", "writes", "submits-edits"], "transitive": true }
    },
    {
      "id": "core-dependencies-acyclic",
      "kind": "structural",
      "statement": "The dependency relationships among the components of the semantic core form no cycle.",
      "rationale": "Checked on the declared component graph. At module level it holds because src/core modules import only lower-level ones: own, query, expr, hash, claim-methods and metamodel at the bottom; parse, validate, analyze, operations, project, sim and claims above them.",
      "subjects": ["semantic-core", "parser", "validator", "transactions", "claim-evaluator", "simulation-engine"],
      "assumptions": ["relationships-match-imports"],
      "evaluate": { "method": "acyclic", "within": "semantic-core" }
    },
    {
      "id": "edits-only-via-transactions",
      "kind": "structural",
      "statement": "Following relationships that carry edits and file content (submits-edits, data-flow, writes), every path from the editing surfaces (inspector, source editor, dialogs, visual interaction, toolbar, shell) to the specification file passes through the transaction system.",
      "rationale": "Control-only calls are not followed: every panel calls the session for selection and view state (including the toolbar's layout choice, a viewer preference). EXPECTED TO BE VIOLATED: the toolbar's Import sends a bundle to the persistence client, plugin and workspace service, which overwrite spec.jsonc without a transaction; the toolbar only refuses a bundle with syntax errors before sending it. This is a real discrepancy in the code, recorded in system.notes and on the toolbar.",
      "subjects": ["inspector", "source-editor", "dialogs", "visual-interaction", "toolbar", "shell", "transactions", "specification-file", "toolbar-data-flow-persistence-client"],
      "assumptions": ["relationships-match-imports"],
      "evaluate": { "method": "only-via", "from": ["inspector", "source-editor", "dialogs", "visual-interaction", "toolbar", "shell"], "to": "specification-file", "via": "transactions", "kinds": ["submits-edits", "data-flow", "writes"] }
    },
    {
      "id": "editing-surfaces-except-import-via-transactions",
      "kind": "structural",
      "statement": "Following submits-edits, data-flow and writes relationships, every path from the inspector, source editor, dialogs, visual interaction and shell to the specification file passes through the transaction system.",
      "rationale": "The same check as edits-only-via-transactions without the toolbar, whose Import is the known bypass. It shows that the bypass is confined to that one control. The toolbar's other tools (create, delete, reset layout, undo, redo) do use transactions but cannot be separated from Import at component granularity. The Markdown importer is a tool, not an editing surface, and is not in the source list.",
      "subjects": ["inspector", "source-editor", "dialogs", "visual-interaction", "shell", "transactions", "specification-file"],
      "assumptions": ["relationships-match-imports"],
      "evaluate": { "method": "only-via", "from": ["inspector", "source-editor", "dialogs", "visual-interaction", "shell"], "to": "specification-file", "via": "transactions", "kinds": ["submits-edits", "data-flow", "writes"] }
    },
    {
      "id": "renderer-does-not-own-state",
      "kind": "structural",
      "statement": "The Three.js renderer has no writes or submits-edits relationship to the specification file, the layout file, the transaction system or the session.",
      "rationale": "The renderer is a function of the scene it is given. A gesture reaches the model only through callbacks to the visual-interaction component, which submits operations.",
      "subjects": ["scene-renderer", "specification-file", "layout-file", "transactions", "session"],
      "assumptions": ["relationships-match-imports"],
      "evaluate": { "method": "no-relationship", "from": "scene-renderer", "to": ["specification-file", "layout-file", "transactions", "session"], "kinds": ["writes", "submits-edits"], "transitive": false }
    },
    {
      "id": "storage-has-owner",
      "kind": "structural",
      "statement": "Every data store (meta-model, claim method registry and the project files) declares an owner.",
      "subjects": ["metamodel", "claim-method-registry", "specification-file", "layout-file", "recorded-results-file", "generated-artifacts"],
      "assumptions": ["relationships-match-imports"],
      "evaluate": { "method": "property-defined", "select": { "category": "storage" }, "property": "owner" }
    },
    {
      "id": "agent-interface-uses-transactions",
      "kind": "structural",
      "statement": "The agent command line reaches the transaction system along its relationships.",
      "rationale": "Every mutation by an agent goes through Project.apply, the same pipeline as the UI.",
      "subjects": ["agent-cli", "transactions"],
      "assumptions": ["relationships-match-imports"],
      "evaluate": { "method": "reachable", "from": "agent-cli", "to": "transactions" }
    },
    {
      "id": "transactions-provide-apply-contract",
      "kind": "structural",
      "statement": "The transaction system provides a port with the apply-transaction contract.",
      "subjects": ["transactions", "apply-transaction"],
      "assumptions": ["relationships-match-imports"],
      "evaluate": { "method": "has-port", "select": "transactions", "direction": "provides", "contract": "apply-transaction" }
    },

    // ======== Behavioral claims over Exegra's own edit flow (traces of the listed scenarios only)
    {
      "id": "edit-representations-equivalent",
      "kind": "temporal",
      "statement": "After a valid edit, at quiescence the scene (projection and renderer), the inspector and the source editor all show the revision of the transaction system, for a visual edit and for a source edit.",
      "rationale": "The text is the single authority; the views are projections of the committed model and must not diverge from it. Checked on the final configuration of the listed traces only.",
      "subjects": ["transactions", "projection-system", "scene-renderer", "inspector", "source-editor", "visual-edit-flow", "source-edit-flow"],
      "assumptions": ["machines-abstract-the-code", "views-derive-from-committed-model", "tests-exercise-shipped-modules", "browser-tests-run-real-application", "recorded-results-reflect-current-code"],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "visual-edit-flow",
          "source-edit-flow"
        ],
        "expr": "renderer-flow.shownRevision == transaction-flow.revision && projection-flow.shownRevision == transaction-flow.revision && inspector-flow.shownRevision == transaction-flow.revision && source-editor-flow.shownRevision == transaction-flow.revision",
        "negatives": [
          {
            "scenario": "visual-edit-flow",
            "faults": [
              "publish-lost"
            ]
          },
          {
            "scenario": "source-edit-flow",
            "faults": [
              "publish-lost"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "file-matches-model-after-save",
      "kind": "temporal",
      "statement": "After a valid edit, at quiescence the file on disk holds the committed revision and the session reports saved, for a visual edit and for a source edit.",
      "subjects": ["transactions", "session", "workspace-service", "visual-edit-flow", "source-edit-flow"],
      "assumptions": ["machines-abstract-the-code", "views-derive-from-committed-model", "filesystem-honours-atomic-rename", "tests-exercise-shipped-modules", "browser-tests-run-real-application", "recorded-results-reflect-current-code"],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "visual-edit-flow",
          "source-edit-flow"
        ],
        "expr": "workspace-flow.persistedRevision == transaction-flow.revision && session-flow.saveState == 'saved'",
        "negatives": [
          {
            "scenario": "visual-edit-flow",
            "faults": [
              "disk-changed-externally"
            ]
          },
          {
            "scenario": "source-edit-flow",
            "faults": [
              "disk-changed-externally"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "refresh-follows-commit",
      "kind": "temporal",
      "statement": "Every projection refresh is preceded by a delivered transaction commit: views are refreshed from a committed model, never from a candidate.",
      "subjects": ["transactions", "projection-system", "transaction-committed", "projection-refreshed", "visual-edit-flow", "source-edit-flow"],
      "assumptions": ["machines-abstract-the-code", "views-derive-from-committed-model"],
      "evaluate": {
        "method": "precedes",
        "scenarios": [
          "visual-edit-flow",
          "source-edit-flow"
        ],
        "first": {
          "event": "transaction-committed"
        },
        "then": {
          "event": "projection-refreshed"
        },
        "negatives": [
          {
            "scenario": "visual-edit-flow",
            "faults": [
              "refresh-before-commit"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "save-follows-refresh",
      "kind": "temporal",
      "statement": "Every write request to the file service is preceded by a projection refresh: the write is asynchronous and happens after the views were refreshed, in all three edits that commit.",
      "rationale": "Records the real order, local-first and optimistic: refresh at commit, write afterwards.",
      "subjects": ["session", "projection-system", "projection-refreshed", "save-requested", "visual-edit-flow", "source-edit-flow", "edit-with-disk-conflict"],
      "assumptions": ["machines-abstract-the-code"],
      "evaluate": {
        "method": "precedes",
        "scenarios": [
          "visual-edit-flow",
          "source-edit-flow",
          "edit-with-disk-conflict"
        ],
        "first": {
          "event": "projection-refreshed"
        },
        "then": {
          "event": "save-requested"
        },
        "negatives": [
          {
            "scenario": "visual-edit-flow",
            "faults": [
              "save-before-refresh"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "commit-only-after-validation",
      "kind": "temporal",
      "statement": "Every commit of an operation transaction (the edit flows modelled here) is preceded by a delivered validation-passed: no operation transaction commits without a validation with no errors.",
      "rationale": "Scoped to operation transactions and replacement sources. Undo and redo restore text that was committed before and reload adopts any text that parses (including text with validation errors): all three commit without validating again, and the machines in this file do not model them.",
      "subjects": ["transactions", "validator", "validation-passed", "transaction-committed", "visual-edit-flow", "source-edit-flow", "edit-with-disk-conflict"],
      "assumptions": ["machines-abstract-the-code"],
      "evaluate": {
        "method": "precedes",
        "scenarios": [
          "visual-edit-flow",
          "source-edit-flow",
          "edit-with-disk-conflict"
        ],
        "first": {
          "event": "validation-passed"
        },
        "then": {
          "event": "transaction-committed"
        },
        "negatives": [
          {
            "scenario": "visual-edit-flow",
            "faults": [
              "commit-skips-validation"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "rejected-edit-changes-nothing",
      "kind": "invariant",
      "statement": "In the rejected edit, at every step the revision of the transaction system, of the projection, renderer, inspector and source editor and of the file on disk is still the initial revision, and the session still reports saved.",
      "subjects": ["transactions", "projection-system", "scene-renderer", "inspector", "source-editor", "workspace-service", "rejected-edit"],
      "assumptions": ["machines-abstract-the-code", "views-derive-from-committed-model", "tests-exercise-shipped-modules", "browser-tests-run-real-application", "recorded-results-reflect-current-code"],
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "rejected-edit"
        ],
        "expr": "transaction-flow.revision == 1 && projection-flow.shownRevision == 1 && renderer-flow.shownRevision == 1 && inspector-flow.shownRevision == 1 && source-editor-flow.shownRevision == 1 && workspace-flow.persistedRevision == 1 && session-flow.saveState == 'saved'",
        "negatives": [
          {
            "scenario": "rejected-edit",
            "faults": [
              "reject-partially-applied"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "rejected-edit-never-refreshes",
      "kind": "temporal",
      "statement": "In the rejected edit the projection is never refreshed.",
      "subjects": ["projection-system", "projection-refreshed", "rejected-edit"],
      "assumptions": ["machines-abstract-the-code", "views-derive-from-committed-model"],
      "evaluate": {
        "method": "never",
        "scenarios": [
          "rejected-edit"
        ],
        "occurs": {
          "event": "projection-refreshed"
        },
        "negatives": [
          {
            "scenario": "rejected-edit",
            "faults": [
              "rejection-refreshes"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "rejected-edit-never-persists",
      "kind": "temporal",
      "statement": "In the rejected edit no write to the file service is ever requested.",
      "subjects": ["session", "workspace-service", "save-requested", "rejected-edit"],
      "assumptions": ["machines-abstract-the-code"],
      "evaluate": {
        "method": "never",
        "scenarios": [
          "rejected-edit"
        ],
        "occurs": {
          "event": "save-requested"
        },
        "negatives": [
          {
            "scenario": "rejected-edit",
            "faults": [
              "rejection-refreshes"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "conflict-never-overwrites",
      "kind": "invariant",
      "statement": "In the edit whose write conflicts with the disk, at every step, once the conflict is flagged the revision persisted on disk is still the initial one: the conflicting file is never overwritten.",
      "subjects": ["workspace-service", "session", "edit-with-disk-conflict", "write-file"],
      "assumptions": ["machines-abstract-the-code", "filesystem-honours-atomic-rename", "tests-exercise-shipped-modules", "recorded-results-reflect-current-code"],
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "edit-with-disk-conflict"
        ],
        "expr": "workspace-flow.conflict => workspace-flow.persistedRevision == 1",
        "negatives": [
          {
            "scenario": "edit-with-disk-conflict",
            "faults": [
              "conflict-overwrites"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "conflict-is-flagged",
      "kind": "temporal",
      "statement": "In the edit whose write conflicts with the disk, at quiescence the session reports a conflict, every view shows the new revision and the file on disk is behind the model.",
      "rationale": "The edit is not lost and not forced onto the disk: the user must choose to reload from disk or overwrite disk.",
      "subjects": ["session", "transactions", "scene-renderer", "workspace-service", "edit-with-disk-conflict"],
      "assumptions": ["machines-abstract-the-code", "views-derive-from-committed-model"],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "edit-with-disk-conflict"
        ],
        "expr": "session-flow.saveState == 'conflict' && renderer-flow.shownRevision == transaction-flow.revision && workspace-flow.persistedRevision < transaction-flow.revision",
        "negatives": [
          {
            "scenario": "edit-with-disk-conflict",
            "faults": [
              "conflict-swallowed"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },

    // ======== Claims the model cannot establish; they rest on executed tests only
    {
      "id": "layout-moves-are-not-semantic",
      "kind": "invariant",
      "statement": "Moving a node changes only the layout file: the semantic hash and the specification text cannot change.",
