    // ======== Persistence ==========================================================================
    {
      "id": "persistence-client",
      "name": "Persistence client",
      "parent": "persistence",
      "category": "client",
      "runsIn": "browser",
      "purpose": "The browser side of the persistence boundary: HTTP requests to the development-server middleware and a server-sent-events subscription to file changes.",
      "responsibilities": [
        "List, read, write (with base hash), export and import projects and write generated artifacts",
        "Report unavailable persistence instead of pretending to save when the application is not served by the development server",
        "Subscribe to spec, layout and recorded-result changes of a project"
      ],
      "ports": [
        { "id": "client-write-out", "name": "Write file", "direction": "requires", "contract": "write-file", "protocol": "HTTP POST /__exegra/write", "description": "Sends spec or layout text with its base hash." }
      ],
      "unknowns": ["No retry, queue or offline buffer: a failed request is reported once to the caller."],
      "implementation": { "status": "manual", "modules": ["src/persist/client.js"] }
    },
    {
      "id": "dev-server-plugin",
      "name": "Development-server plugin",
      "parent": "persistence",
      "category": "computational",
      "runsIn": "node",
      "purpose": "Vite middleware that exposes the workspace service over HTTP and server-sent events; development only.",
      "responsibilities": [
        "Accept requests only from loopback hosts and origins carrying the x-exegra-client header (events excepted)",
        "Route projects, project, write, generated, export, import and events; map errors to JSON with an HTTP status, answering 409 for a write conflict",
        "Limit request bodies to 6 MB and keep event streams alive with periodic pings"
      ],
      "ports": [
        { "id": "plugin-write-in", "name": "Write file", "direction": "provides", "contract": "write-file", "protocol": "HTTP POST /__exegra/write", "description": "Receives a write and answers 200, 409 conflict or an error." },
        { "id": "plugin-write-out", "name": "Write file to workspace", "direction": "requires", "contract": "write-file", "protocol": "in-process call", "description": "Delegates to the workspace service." }
      ],
      "unknowns": ["Protection rests on loopback host, loopback origin and a custom header only; any local process can read and write projects while the development server runs."],
      "implementation": { "status": "manual", "modules": ["tools/vite-plugin-exegra.js"] }
    },
    {
      "id": "workspace-service",
      "name": "Workspace service",
      "parent": "persistence",
      "category": "computational",
      "runsIn": "node",
      "purpose": "The Node filesystem boundary for projects under specs/: every read, write, export, import and watch of project files goes through it.",
      "responsibilities": [
        "Validate project names and refuse any path that leaves the project directory",
        "Write spec or layout text only if the base hash equals the current file's hash, replacing the file atomically, serialized per project, appending a line to .history/journal.jsonl",
        "Read a project with the hashes of its files and its recorded results",
        "Read project.jsonc: the specification it links to and the realisation roots it declares, without ever writing it",
        "Write generated artifacts only under generated/, and record verification results",
        "Export and import project bundles, and watch a project's files for external changes"
      ],
      "ports": [
        { "id": "workspace-write-in", "name": "Write file", "direction": "provides", "contract": "write-file", "protocol": "in-process call", "description": "Guarded write of spec or layout text." }
      ],
      "unknowns": [
        "On Windows the atomic rename is retried and then replaced by an in-place write, which is not atomic.",
        "Import and recording of results write without a base-hash check, and import writes its files one after another, not as one atomic unit.",
        "The journal is read in full on every write to number its next line and is never truncated."
      ],
      "implementation": { "status": "manual", "modules": ["tools/workspace.js"] }
    },
    {
      "id": "specification-file",
      "name": "Specification file",
      "parent": "persistence",
      "category": "storage",
      "owner": "transactions",
      "purpose": "specs/<project>/spec.jsonc: the JSONC text that is the serialized authority of a project's semantic model.",
      "unknowns": ["Besides the workspace service, tools/make-benchmark.js writes specs/benchmark/spec.jsonc and tools/import-markdown.js writes the specification of a linked project directly with node:fs."],
