  "copies": [
    {
      "id": "session-model",
      "name": "Session model",
      "of": [
        "specification-text"
      ],
      "heldBy": "session",
      "scope": "per-session",
      "freshness": {
        "bound": "the last commit of this session or the last adopted file change",
        "mechanism": "the file watcher's server-sent events and Project.reload; a write with a stale base hash is refused as a conflict"
      },
      "description": "The browser session's Project (src/core/project.js, created by session.open): specText, layoutText, revision, semanticRevision, model (entities, byKind, refs with locations, expressions, effective meta-model), diagnostics and errorCount, semanticHash (cyrb53 of the normal form, src/core/hash.js), layout, history, undo and redo stacks and listeners. Replaced whole on every commit and by Project.reload. Project.textHash is a getter computed on read with no caller in src, tools or cli."
    },
    {
      "id": "cli-project",
      "name": "Agent command-line project",
      "of": [
        "specification-text"
      ],
      "heldBy": "agent-cli",
      "scope": "per-session",
      "freshness": {
        "bound": "read at the start of one invocation",
        "mechanism": "--expect-hash refuses an apply on a changed specification"
      },
      "description": "One invocation of the agent command line reads the project with tools/workspace.js read() (spec, layout and recorded results with their hashes), builds a fresh Project (cli/commands.js loadProject) and, after an apply, writes the spec and then the layout with the hashes read at the start. There is no undo history across invocations."
    },
    {
      "id": "generated-documents",
      "name": "Generated documents",
      "of": [
        "specification-text",
        "recorded-results"
      ],
      "fields": [
        "specification-text.project",
        "semantic-hash",
        "recorded-results.outcome"
      ],
      "heldBy": "generated-artifacts",
      "scope": "shared",
      "freshness": {
        "bound": "the last run of npm run generate",
        "mechanism": "npm run generate rewrites them; each document records the semantic hash it was derived from"
      },
      "description": "specs/<project>/generated/ (manifest.json, ARCHITECTURE.md, claims-report.md, claims-report.json, tasks.json): derived by generateAll (src/core/generate/index.js) from the model, the claim results evaluated with the recorded results, the diagnostics and the traceability check, and written by exegra generate --write (cli/commands.js) or the Realisation panel (POST /__exegra/generated), each through tools/workspace.js writeGenerated(), which skips files whose content is unchanged and writes no journal line."
    },
    {
      "id": "parsed-layout",
      "name": "Parsed layout",
      "of": [
        "presentation-layout"
      ],
      "heldBy": "transactions",
      "scope": "per-session",
      "freshness": {
        "bound": "the last commit or reload of this Project",
        "mechanism": "parseLayout runs in Project.#derive on every commit that changes the layout text; an unreadable layout is treated as empty"
      },
      "description": "Project.layout (src/core/operations.js parseLayout): views with positions per entity and an ok flag; the pins session.recompute applies."
    },
    {
      "id": "session-preferences",
      "name": "Session preferences",
      "of": [
        "interaction-state",
        "simulation-session"
      ],
      "fields": [
        "layout-method-by-view",
        "view-id",
        "selection",
        "collapsed",
        "hidden",
        "isolate",
        "camera-mode",
        "focus-claim",
        "focus-scenario",
        "sim-scenario",
        "interaction-state.project"
      ],
      "heldBy": "browser-storage",
      "scope": "per-principal",
      "freshness": {
        "bound": "the last interaction change of this browser profile",
        "mechanism": "session.persistUi writes the whole store on every select, view, toggle, layout-method change, simulation load and commit; session.open restores the ids that still exist"
      },
      "description": "localStorage key \"exegra.session\": {perProject: {<project>: {layoutByView, viewId, selection, collapsed, hidden, isolate, cameraMode, focusClaim, focusScenario, simScenario}}, projectName}. A failed setItem (storage unavailable) is ignored and nothing is remembered. One browser profile, not a principal of any system Exegra specifies."
    },
    {
      "id": "camera-memory",
      "name": "Camera memory",
      "of": [
        "camera-state"
      ],
      "heldBy": "browser-storage",
      "scope": "per-session",
      "freshness": {
        "bound": "the last pointer-up, wheel, view change or page hide of this tab",
        "mechanism": "saveCamera (src/app/main.js) on view change, pagehide, pointerup and wheel; pushScene restores once per project and view"
      },
      "description": "sessionStorage keys \"exegra.camera.<project>.<view>\" holding the camera rig state; gone when the tab closes."
    },
    {
      "id": "project-list",
      "name": "Project list",
      "of": [
        "specification-text",
        "project-pointer"
      ],
      "fields": [
        "specification-text.project",
        "spec"
      ],
      "heldBy": "session",
      "scope": "per-session",
      "freshness": {
        "bound": "the last session.init or refreshProjects (after an import)",
        "mechanism": "GET /__exegra/projects (tools/workspace.js listProjects: every directory with a spec.jsonc or project.jsonc); in a production build the names of the bundled shipped projects"
      },
      "description": "session.projects ({name, title}[], the title read from the specification's system name) and session.specLocation (the path from the read response). Not refreshed when another process adds a project."
    },
    {
      "id": "derived-scene",
      "name": "Derived scene and placement",
      "of": [
        "specification-text",
        "presentation-layout",
        "interaction-state"
      ],
      "fields": [
        "text",
        "x",
        "z",
        "view-id",
        "collapsed",
        "hidden",
        "isolate",
        "focus-claim",
        "focus-scenario",
        "layout-method-by-view",
        "selection"
      ],
      "heldBy": "session",
      "scope": "per-session",
      "freshness": {
        "bound": "the last commit, interaction change, selection change in the references view or viewport resize",
        "mechanism": "session.recompute: projectScene, then chooseLayout or layoutScene with the view's pins and the viewport aspect"
      },
      "description": "session.scene (SceneModel: viewId, projection, nodes, edges, legend, notes), session.placement and session.layout ({methods, requested, used, scores, aspect}), and session.views (listViews). Presentation only; position carries no meaning."
    },
    {
      "id": "scene-statistics",
      "name": "Scene statistics",
      "of": [
        "specification-text",
        "presentation-layout",
        "interaction-state"
      ],
      "fields": [
        "text",
        "x",
        "z",
        "view-id"
      ],
      "heldBy": "scene-renderer",
      "scope": "per-session",
      "freshness": {
        "bound": "the last frame",
        "mechanism": "the render loop and setScene diffs of src/render/scene-view.js"
      },
      "description": "Frame statistics (fpsAvg, frameMsAvg; counts of nodes, edges, labels, draw calls, triangles) and the redraw signature of every node and edge, shown by the overlay through shell.setStatsProvider. The renderer keeps no domain state."
    },
    {
      "id": "session-claim-results",
      "name": "Session claim results",
      "of": [
        "specification-text",
        "recorded-results",
        "external-claim-outcomes"
      ],
      "fields": [
        "text",
        "semantic-hash",
        "recorded-results.outcome",
        "recorded-results.detail",
        "external-claim-outcomes.outcome",
        "external-claim-outcomes.status"
      ],
      "heldBy": "session",
      "scope": "per-session",
      "freshness": {
        "bound": "the last semantic commit, open or recorded-results change",
        "mechanism": "session.evaluate calls evaluateClaims synchronously on the main thread inside onCommit (semantic changes only), open and onExternalChange (file recorded); each result carries the semantic hash it was evaluated at"
      },
      "description": "session.claimResults (ClaimResult[]: claimId, kind, method, status verified, supported, model-holds, violated, inconclusive or not-evaluated, evaluator, semanticHash, scope with the fault-model text, explanation, assumptions, involved, counterexample, evidence items {id, kind, ref, supports, recorded}, negatives, and for metric-bound claims runs, passes, fraction, confidence and seeds), with the data-model findings of data-model claims. Trace and metric claims run engine scenarios inside this evaluation, on the main thread, not in the engine worker (src/core/claims.js)."
    },
    {
      "id": "session-recorded-results",
      "name": "Recorded results in the session",
      "of": [
        "recorded-results",
        "external-claim-outcomes"
      ],
      "heldBy": "session",
      "scope": "per-session",
      "freshness": {
        "bound": "the last open or watcher notice of file recorded",
        "mechanism": "session.open and onExternalChange re-read GET /__exegra/project and replace session.recorded"
      },
      "description": "session.recorded: the evidence/results.json object or null; read by evaluate and the Verification panel."
    },
    {
      "id": "cli-claim-results",
      "name": "Command-line claim results",
      "of": [
        "specification-text",
        "recorded-results",
        "external-claim-outcomes"
      ],
      "heldBy": "agent-cli",
      "scope": "per-session",
      "freshness": {
        "bound": "one invocation",
        "mechanism": "claims, evaluate, generate and verify evaluate from the files read at the start; verify evaluates with the results it just recorded"
      },
      "description": "The ClaimResult list printed by exegra claims and evaluate, and the claims summary of exegra verify."
    },
    {
      "id": "simulation-run",
      "name": "Simulation run in the panel",
      "of": [
        "specification-text",
        "simulation-session"
      ],
      "fields": [
        "text",
        "scenario-id",
        "faults",
        "step-index"
      ],
      "heldBy": "session",
      "scope": "per-session",
      "freshness": {
        "bound": "the last load, fault change or semantic commit",
        "mechanism": "loadSim derives the engine input, runs it in the engine worker and wraps the trace in createTraceCursor; a run whose token is stale is discarded; updateChecks recomputes checks and the request log on every step"
      },
      "description": "session.sim: the engine input (format 1, or format 2 when needsFormat2 holds), the trace cursor (scenarioId, faults, initial, config, revealed steps, outcome running, quiescent, step-limit or error), checks (checkTrace results with the automatic contract-conformance checks), requestLog ({step, time, role, contract, event, lost, text}), and simFlow (the message flow of the step shown with its scene paths). In Live mode the cursor is the replay of the recorded real stream through live-session instead (scenarioId live-session, outcome running, steps with divergences and calibrations), with the replay's divergences added to the checks."
    },
    {
      "id": "cli-outputs",
      "name": "Command-line outputs",
      "of": [
        "specification-text",
        "presentation-layout",
        "recorded-results"
      ],
      "heldBy": "agent-cli",
      "scope": "per-session",
      "freshness": {
        "bound": "one invocation",
        "mechanism": "every command reads the files at its start and prints one envelope"
      },
      "description": "The stdout envelope {ok, command, project, semanticHash?, result} or {ok: false, command, project, error {code, message}, diagnostics}, the stderr progress notes (\"verify: running <ref>\") and the result payloads: apply {revision, semanticHashBefore, semanticHashAfter, semanticChanged, affected, written, dryRun}, verify {validation, traceability, evidence, claims summary, violated, expectedViolated, unexpectedViolated}, simulate {scenarioId, faults, outcome, stepCount, final, checks, requestLog, steps}, trace (the full trace, or {written, stepCount}), generate {files {bytes, sha256}, written}, markdown {path, text} | {documents} | {out, written}, prove (proof-outputs), and the read-only listings of projects, validate, list, show, deps, contracts, claims, evaluate, gaps, traceability, plan-delete and ops. The trace file of trace --out (stable JSON) and the documents of markdown --out are written where the caller says."
    },
    {
      "id": "proof-outputs",
      "name": "Proof outputs",
      "of": [
        "specification-text"
      ],
      "heldBy": "agent-cli",
      "scope": "per-session",
      "freshness": {
        "bound": "the last exegra prove of the scenario; a file is not checked against the current model",
        "mechanism": "tools/prove.js proveScenario rewrites formal/generated/<scenario>.lean on every run"
      },
      "description": "formal/generated/<scenario>.lean (gitignored: the engine input text, its decoded term, one theorem per claim discharged by native_decide), the explorer request written to exegra-lean explore on stdin and its result, and the prove result {scenarioId, bound, stepLimit, maxStates, faults, exploreMs, checkMs, nativeCode, claims[], note?}; exploreMs and checkMs are measured wall-clock durations. A claim is reported only when Lean accepted its theorem."
    },
    {
      "id": "markdown-export",
      "name": "Markdown export",
      "of": [
        "specification-text"
      ],
      "heldBy": "agent-cli",
      "scope": "per-session",
      "freshness": {
        "bound": "the run that wrote it",
        "mechanism": "exegra markdown --out (cli/commands.js) or tools/import-markdown.js --export-md rewrite the directory"
      },
      "description": "One Markdown file per document of a specification that holds documents (reconstructMarkdown); the importer's coverage check compares rebuilt text with the source files."
    },
    {
      "id": "markdown-import-report",
      "name": "Markdown import report",
      "of": [
        "markdown-source",
        "specification-text"
      ],
      "heldBy": "markdown-importer",
      "scope": "per-session",
      "freshness": {
        "bound": "one run",
        "mechanism": "printed by tools/import-markdown.js main on standard output and standard error"
      },
      "description": "Counts, the unmapped items and the coverage per file; when the coverage gate fails, the specification is not written."
    },
    {
      "id": "project-bundle",
      "name": "Project bundle",
      "of": [
        "specification-text",
        "presentation-layout",
        "recorded-results"
      ],
      "heldBy": "toolbar",
      "scope": "per-session",
      "freshness": {
        "bound": "the moment of export; never refreshed",
        "mechanism": "GET /__exegra/export reads the files on disk (tools/workspace.js exportProject); without persistence the toolbar builds it from the in-memory texts"
      },
      "description": "A .exegra.json download, {format: \"exegra-project\", version: 1, name, files: {\"spec.jsonc\", \"layout.jsonc\"?, \"evidence/results.json\"?}}, built in src/ui/toolbar.js (URL.createObjectURL). Exported through the server it holds the files on disk, so an edit whose save has not landed yet is not in it."
    },
    {
      "id": "shipped-specifications",
      "name": "Shipped specifications in the production bundle",
      "of": [
        "specification-text",
        "presentation-layout",
        "recorded-results"
      ],
      "heldBy": "build-system",
      "scope": "shared",
      "freshness": {
        "bound": "the last vite build",
        "mechanism": "import.meta.glob of specs/*/spec.jsonc, layout.jsonc and evidence/results.json in src/app/session.js, and the virtual module of tools/vite-plugin-exegra.js exegraLinkedSpecs for linked projects, are inlined as text by vite build"
      },
      "description": "dist/ embeds, as text, the specification, layout and recorded results of the shipped projects and the specification of every linked project whose specification lives outside specs/ (finding F11). A production build reads them and never saves (save state read-only)."
    },
    {
      "id": "engine-input",
      "name": "Engine input",
      "of": [
        "specification-text"
      ],
      "heldBy": "session",
      "scope": "per-session",
      "freshness": {
        "bound": "one run",
        "mechanism": "simulationInput (src/core/sim-input.js) derives it from the validated model at every load, fault change and semantic commit; claim evaluation and the command line derive it the same way per call and keep nothing"
      },
      "description": "Format version 1 {format: \"exegra-sim-input\", version: 1, scenario {id, steps, faults, stepLimit}, behaviors, events, faults}, or version 2 (times in base units, seed, horizon, instances, resources, workloads, routes, links) when needsFormat2 holds. Posted to the engine worker as JSON text."
    },
    {
      "id": "search-results",
      "name": "Search results",
      "of": [
        "specification-text"
      ],
      "heldBy": "toolbar",
      "scope": "per-session",
      "freshness": {
        "bound": "the last keystroke in search",
        "mechanism": "recomputed from the current model on input"
      },
      "description": "Entities ranked by id, ref, name and statement, with the active index (src/ui/toolbar.js)."
    },
    {
      "id": "changes-panel-items",
      "name": "Changes panel items",
      "of": [
        "commit-history",
        "session-log"
      ],
      "heldBy": "activity-panels",
      "scope": "per-session",
      "freshness": {
        "bound": "the last model or log event",
        "mechanism": "src/ui/activity.js renders history and log aligned by position"
      },
      "description": "The changes list, keyed by log sequence (or a negative key where no log entry is aligned). The log is capped at 400 entries and the history is not, so the alignment assumes the log holds every change."
    },
    {
      "id": "transaction-scratch",
      "name": "Transaction scratch texts",
      "of": [
        "specification-text",
        "presentation-layout"
      ],
      "fields": [
        "text",
        "x",
        "z"
      ],
      "heldBy": "transactions",
      "scope": "per-session",
      "freshness": {
        "bound": "one apply call",
        "mechanism": "Tx (src/core/operations.js) copies both texts; discarded on failure, swapped in by #commit on success"
      },
      "description": "Working copies of the specification and layout texts, the affected entity ids and the specEdited and layoutEdited flags of one transaction."
    }
  ]
}
