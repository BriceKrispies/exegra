      "name": "Conformance reported",
      "description": "Real run: tools/conformance.js prints its result and exits 0 or non-zero.",
      "payload": [
        {
          "name": "ok",
          "type": "boolean"
        }
      ]
    },
    {
      "id": "differential-run",
      "name": "Differential run",
      "description": "Real run: node tools/differential.js, the native Rust engine and exegra-lean on golden and generated inputs."
    },
    {
      "id": "differential-mismatch-saved",
      "name": "Mismatch saved",
      "description": "Real run: tools/differential.js writes the mismatching input and its result under test-results/differential/."
    },
    {
      "id": "sim-load-requested",
      "name": "Scenario loaded in the panel",
      "description": "Real run: recorded by loadSim of src/app/session.js when a scenario's engine input was derived (from session.simLoad and simSetFaults of src/ui/sim-panel.js, a remembered scenario on open, and a semantic commit while a scenario is loaded).",
      "payload": [
        {
          "name": "scenario",
          "type": "string"
        }
      ]
    },
    {
      "id": "engine-run-intent",
      "name": "Run handed to the runner",
      "description": "Real run: recorded by loadSim (src/app/session.js) just before runner.run(input); token is the session's simToken of the run.",
      "payload": [
        {
          "name": "token",
          "type": "number"
        },
        {
          "name": "scenario",
          "type": "string"
        }
      ]
    },
    {
      "id": "worker-terminated",
      "name": "Worker terminated",
      "description": "A new run while one is waiting stops the worker. Real run: recorded by stop() of src/app/engine-runner.js when a worker exists (worker.terminate(), waiting.clear())."
    },
    {
      "id": "worker-run-done",
      "name": "Worker finished the run",
      "description": "Stands for the time the worker spends in runEngineText (src/app/engine-worker.js onmessage). Real run: recorded by worker.onmessage of src/app/engine-runner.js when the reply arrives, just before the reply itself; generation counts the workers the runner terminated.",
      "payload": [
        {
          "name": "id",
          "type": "number"
        },
        {
          "name": "input",
          "type": "string"
        },
        {
          "name": "generation",
          "type": "number"
        }
      ]
    },
    {
      "id": "worker-load-failed",
      "name": "Worker could not load",
      "description": "Real run: recorded by worker.onerror in src/app/engine-runner.js; the waiting jobs rerun on the main thread from then on."
    },
    {
      "id": "sim-trace-ready",
      "name": "Trace handed to the session",
      "description": "Real run: recorded when the promise of runner.run resolves in loadSim, before the token check; steps is the length of the trace. The session keeps it only if its token is still current.",
      "payload": [
        {
          "name": "token",
          "type": "number"
        },
        {
          "name": "steps",
          "type": "number"
        }
      ]
    },
    {
      "id": "sim-run-failed",
      "name": "Run failed",
      "description": "Real run: recorded in the rejection branch of runner.run in loadSim, before the token check (session.note error).",
      "payload": [
        {
          "name": "token",
          "type": "number"
        }
      ]
    },
    {
      "id": "sim-step-requested",
      "name": "Step",
      "description": "Real run: recorded by session.simStep (src/app/session.js) from the panel, the transport or the play timer, outside Live mode."
    },
    {
      "id": "sim-back-requested",
      "name": "Step back",
      "description": "Real run: recorded by session.simBack outside Live mode."
    },
    {
      "id": "sim-run-to-end-requested",
      "name": "Run to end",
      "description": "Real run: recorded by session.simRunToEnd outside Live mode."
    },
    {
      "id": "sim-step-shown",
      "name": "Step shown",
      "description": "Real run: recorded by session.simStep when it revealed or moved to a step, before simChanged(true) emits sim with pulse true.",
      "payload": [
        {
          "name": "stepIndex",
          "type": "number"
        }
      ]
    },
    {
      "id": "step-pulsed",
      "name": "Step pulsed in the scene",
      "description": "Real run: recorded by the sim listener of src/app/main.js when it pulses the responsible entities of a simulated step and draws its message flow (view.pulse, view.flow); not in Live mode, where the pulses show recorded events.",
      "payload": [
        {
          "name": "stepIndex",
          "type": "number"
        }
      ]
    },
    {
      "id": "page-loaded",
      "name": "Page loaded",
      "description": "The application module starts. Real run: the first statement of src/app/main.js records it; persistent is PERSISTENCE_AVAILABLE (import.meta.env.DEV) of src/persist/client.js, project is the project the page asks for (requestedProject of src/app/session.js: ?project=, else the one remembered in localStorage, else exegra).",
      "payload": [
        {
          "name": "persistent",
          "type": "boolean"
        },
        {
          "name": "project",
          "type": "string"
        }
      ]
    },
    {
      "id": "engine-load-requested",
      "name": "Engine load",
      "description": "Real run: initEngine() in src/app/main.js (src/core/engine.js loads the .wasm)."
    },
    {
      "id": "engine-load-settled",
      "name": "Engine loaded or failed",
      "description": "Real run: the then of initEngine() in src/app/main.js (success, or the error noted and the session started anyway).",
      "payload": [
        {
          "name": "ok",
          "type": "boolean"
        }
      ]
    },
    {
      "id": "entity-selected",
      "name": "Entity selected",
      "description": "Real run: recorded by session.select(id) when the selection changes, from the scene, explorer, search or a link; id is none for a cleared selection.",
      "payload": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    {
      "id": "view-selected",
      "name": "View selected",
      "description": "Real run: recorded by session.setView(viewId) from the toolbar when the view changes. The switch itself is view-switched; this model reads that one.",
      "payload": [
        {
          "name": "view",
          "type": "string"
        }
      ]
    },
    {
      "id": "preferences-written",
      "name": "Session preferences written",
      "description": "Real run: persistUi in src/app/session.js, localStorage.setItem(\"exegra.session\", ...). Recorded only when the selection or the view of the open project differs from the last one written: a write that leaves both unchanged is a stutter step of this model.",
      "payload": [
        {
          "name": "selection",
          "type": "string"
        },
        {
          "name": "viewId",
          "type": "string"
        }
      ]
    },
    {
      "id": "page-reloaded",
      "name": "Page reloaded",
      "description": "The tab is (re)loaded; in-memory state is gone and session.open restores what the store remembers. Real run: recorded at the start of createSession in src/app/session.js, once per page load."
    },
    {
      "id": "preferences-read",
      "name": "Session preferences read",
      "description": "Real run: recorded at the start of createSession in src/app/session.js, just before loadStore reads localStorage.getItem(\"exegra.session\")."
    },
    {
      "id": "preferences-loaded",
      "name": "Session preferences loaded",
      "description": "Real run: recorded by session.open (src/app/session.js) after it applied store.perProject[name] (selection, view, collapsed, ...), on every open; selection is the restored selection or none.",
      "payload": [
        {
          "name": "selection",
          "type": "string"
        },
        {
          "name": "viewId",
          "type": "string"
        }
      ]
    },
    {
      "id": "panel-toggled",
      "name": "Panel opened or closed",
      "description": "Real run: recorded by persist() of src/ui/layout.js when the explorer's open state it is about to store differs from the last stored one (the responsive layout opened or closed the explorer).",
      "payload": [
        {
          "name": "open",
          "type": "boolean"
        }
      ]
    },
    {
      "id": "layout-preferences-written",
      "name": "Layout preferences written",
      "description": "Real run: persist() in src/ui/layout.js, localStorage.setItem(\"exegra.layout\", ...). Recorded only when explorerOpen changes; a write that leaves it unchanged (a resize, another panel) is a stutter step of this model.",
      "payload": [
        {
          "name": "explorerOpen",
          "type": "boolean"
        }
      ]
    },
    {
      "id": "camera-moved",
      "name": "Camera moved",
      "description": "Pointer or wheel input on the scene ends. Real run: cameraMoved, the pointerup and wheel listener of src/app/main.js, records it with the camera (JSON of view.getCamera()) and calls saveCamera.",
      "payload": [
        {
          "name": "camera",
          "type": "string"
        }
      ]
    },
    {
      "id": "view-switched",
      "name": "View switched (camera)",
      "description": "The view the scene shows changes. Real run: recorded by recompute() of src/app/session.js just before the scene is projected, once per change: after session.setView, after session.open (the opened project's view), and when the session replaces a view the specification does not declare with the first declared one. pushScene in src/app/main.js then restores the camera stored for the view, and the view listener calls saveCamera.",
      "payload": [
        {
          "name": "view",
          "type": "string"
        }
      ]
    },
    {
      "id": "camera-saved",
      "name": "Camera stored",
      "description": "Real run: saveCamera in src/app/main.js records it just before sessionStorage.setItem(\"exegra.camera.<project>.<view>\", ...); camera is the JSON of view.getCamera().",
      "payload": [
        {
          "name": "view",
          "type": "string"
        },
        {
          "name": "camera",
          "type": "string"
        }
      ]
    },
    {
      "id": "camera-restore-requested",
      "name": "Stored camera read",
      "description": "Real run: recorded by pushScene (src/app/main.js) before sessionStorage.getItem(cameraKey()), once per project and view.",
      "payload": [
        {
          "name": "view",
          "type": "string"
        }
      ]
    },
    {
      "id": "camera-restored",
      "name": "Stored camera applied",
      "description": "Real run: recorded by pushScene after view.setCamera(JSON.parse(saved)); camera is the stored text.",
      "payload": [
        {
          "name": "view",
          "type": "string"
        },
        {
          "name": "camera",
          "type": "string"
        }
      ]
    },
    {
      "id": "camera-none",
      "name": "No stored camera",
      "description": "Real run: recorded by pushScene when nothing is stored for the view; the current camera is kept.",
      "payload": [
        {
          "name": "view",
          "type": "string"
        }
      ]
    },
    {
      "id": "traffic-step-recorded",
      "name": "Traffic step recorded",
      "description": "The traffic recorder appends one event of a real run (src/app/traffic-recorder.js record). Not itself recorded: it stands for the append.",
      "payload": [
        {
          "name": "event",
          "type": "string"
        }
      ]
    },
    {
      "id": "sim-reset-requested",
      "name": "Simulation reset requested",
      "description": "Real run: recorded by session.simReset (src/app/session.js) outside Live mode; the cursor hides every step again.",
      "payload": []
    },
    {
      "id": "sim-seek-requested",
      "name": "Simulation seek requested",
      "description": "Real run: recorded by session.simSeek (src/app/session.js) outside Live mode, from a row of the timeline, a request line or a check's jump; stepIndex is the step asked for.",
      "payload": [
        {
          "name": "stepIndex",
          "type": "number"
        }
      ]
    }
  ],

  // ---- Behaviors: Exegra's own edit flow as state machines ---------------------------------
  // These abstract session.apply, Project.apply/#commit, the session's onCommit and flush,
  // the renderer, inspector and source editor refresh, and the write to disk. The abstraction
  // keeps the real order: the projection is refreshed when the transaction commits, and the
  // write to disk happens afterwards and asynchronously (one logical tick later). One variable
  // `revision` / `shownRevision` / `persistedRevision` stands for the revision of the model,
  // of what a view shows, and of what the file on disk holds. The correspondence between these
  // machines and the code is maintained by hand and is not checked.
  "behaviors": [
    {
      "id": "interaction-flow",
      "name": "Interaction layer: submit an edit and show its outcome",
      "subject": "visual-interaction",
      "description": "The scene, inspector or a dialog submits a typed operation and later shows the result: accepted, or the rejection with its diagnostics.",
      "initial": "interaction-idle",
      "variables": [{ "name": "refusalShown", "type": "boolean", "initial": false }],
      "states": [
        { "id": "interaction-idle", "name": "Idle" },
        { "id": "interaction-awaiting", "name": "Awaiting the transaction result" },
        { "id": "interaction-done", "name": "Edit accepted", "terminal": true },
        { "id": "interaction-refused", "name": "Edit refused and rejection shown", "terminal": true }
      ],
      "transitions": [
        { "id": "interaction-submit", "from": "interaction-idle", "to": "interaction-awaiting", "on": "edit-requested", "effects": [{ "emit": "operation-submitted" }] },
        { "id": "interaction-accept", "from": "interaction-awaiting", "to": "interaction-done", "on": "transaction-committed" },
        { "id": "interaction-refuse", "from": "interaction-awaiting", "to": "interaction-refused", "on": "transaction-rejected", "effects": [{ "set": "refusalShown", "to": true }] }
      ]
    },
    {
      "id": "source-editor-flow",
      "name": "Source editor: apply a draft and stay in sync",
      "subject": "source-editor",
      "description": "The editor shows the committed text. Applying a draft submits ReplaceSource; a rejection keeps the draft as typed. After any commit the editor shows the committed revision.",
      "initial": "source-in-sync",
      "variables": [{ "name": "shownRevision", "type": "number", "initial": 1 }],
      "states": [
        { "id": "source-in-sync", "name": "In sync with the model" },
        { "id": "source-applying", "name": "Applying a draft" },
        { "id": "source-draft-kept", "name": "Draft kept after a rejection", "terminal": true }
      ],
      "transitions": [
        { "id": "source-apply", "from": "source-in-sync", "to": "source-applying", "on": "source-apply-requested", "effects": [{ "emit": "operation-submitted" }] },
        { "id": "source-refresh-after-apply", "from": "source-applying", "to": "source-in-sync", "on": "model-published", "effects": [{ "set": "shownRevision", "to": "event.revision" }] },
        { "id": "source-keep-draft", "from": "source-applying", "to": "source-draft-kept", "on": "transaction-rejected" },
        { "id": "source-refresh-after-visual-edit", "from": "source-in-sync", "to": "source-in-sync", "on": "model-published", "effects": [{ "set": "shownRevision", "to": "event.revision" }] }
      ]
    },
    {
      "id": "transaction-flow",
      "name": "Transaction system: check, validate, commit or reject",
      "subject": "transactions",
      "description": "Preconditions are checked and text edits computed; the candidate is parsed and validated. With no errors it commits and the revision increments; otherwise it is rejected and nothing changes. Precondition failures, which reject before any text is computed, are abstracted into the rejection.",
      "initial": "tx-idle",
      "variables": [
        { "name": "revision", "type": "number", "initial": 1 },
        { "name": "rejected", "type": "boolean", "initial": false }
      ],
      "states": [
        { "id": "tx-idle", "name": "Idle" },
        { "id": "tx-validating", "name": "Candidate being parsed and validated" }
      ],
      "transitions": [
        { "id": "tx-begin", "from": "tx-idle", "to": "tx-validating", "on": "operation-submitted", "effects": [{ "emit": "text-edits-computed" }] },
        {
          "id": "tx-commit-unvalidated",
          "from": "tx-validating",
          "to": "tx-idle",
          "on": "model-parsed",
          "faultOnly": true,
          "effects": [
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "set": "rejected",
              "to": "false"
            },
            {
              "emit": "transaction-committed",
              "payload": {
                "revision": "revision"
              }
            }
          ]
        },
        {
          "id": "tx-reject-partially-applied",
          "from": "tx-validating",
          "to": "tx-idle",
          "on": "validation-failed",
          "faultOnly": true,
          "effects": [
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "set": "rejected",
              "to": "true"
            },
            {
              "emit": "transaction-rejected"
            }
          ]
        },
        { "id": "tx-commit", "from": "tx-validating", "to": "tx-idle", "on": "validation-passed", "description": "Project.#commit: swap the texts, derive the snapshot, increment the revision, record history, notify subscribers.", "effects": [{ "set": "revision", "to": "revision + 1" }, { "set": "rejected", "to": false }, { "emit": "transaction-committed", "payload": { "revision": "revision" } }] },
        { "id": "tx-reject", "from": "tx-validating", "to": "tx-idle", "on": "validation-failed", "description": "The result would have validation errors: the texts, the model, the revision and the history stay as they were.", "effects": [{ "set": "rejected", "to": true }, { "emit": "transaction-rejected" }] }
      ]
    },
    {
      "id": "parser-flow",
      "name": "Parser: derive the candidate model",
      "subject": "parser",
      "initial": "parser-ready",
      "variables": [{ "name": "runs", "type": "number", "initial": 0 }],
      "states": [{ "id": "parser-ready", "name": "Ready" }],
      "transitions": [
        { "id": "parser-parse", "from": "parser-ready", "to": "parser-ready", "on": "text-edits-computed", "effects": [{ "set": "runs", "to": "runs + 1" }, { "emit": "model-parsed" }] }
      ]
    },
    {
      "id": "validator-flow",
      "name": "Validator: judge the candidate model",
      "subject": "validator",
      "description": "The faulty-input alternative is a faultOnly transition declared before the normal one so that it takes priority while the fault is active.",
      "initial": "validator-ready",
      "variables": [{ "name": "lastResult", "type": "string", "initial": "none" }],
      "states": [{ "id": "validator-ready", "name": "Ready" }],
      "transitions": [
        { "id": "validator-reject", "from": "validator-ready", "to": "validator-ready", "on": "model-parsed", "faultOnly": true, "description": "The candidate has validation errors.", "effects": [{ "set": "lastResult", "to": "'failed'" }, { "emit": "validation-failed" }] },
        { "id": "validator-accept", "from": "validator-ready", "to": "validator-ready", "on": "model-parsed", "effects": [{ "set": "lastResult", "to": "'passed'" }, { "emit": "validation-passed" }] }
      ]
    },
    {
      "id": "session-flow",
      "name": "Session: refresh on commit, then save asynchronously",
      "subject": "session",
      "description": "onCommit re-evaluates claims, re-projects and re-lays-out the scene (the renderer receives it), then announces the model to the inspector and source editor, and starts the flush. The flush writes later and asynchronously; the save state follows its result.",
      "initial": "session-in-sync",
      "variables": [
        { "name": "saveState", "type": "string", "initial": "saved" },
        { "name": "rejectionsLogged", "type": "number", "initial": 0 }
      ],
      "states": [
        { "id": "session-in-sync", "name": "Saved and in sync" },
        { "id": "session-refreshing", "name": "Refreshing the scene" },
        { "id": "session-save-pending", "name": "Save in flight" },
        { "id": "session-conflicted", "name": "Save conflict unresolved", "terminal": true }
      ],
      "transitions": [
        {
          "id": "session-swallow-conflict",
          "from": "session-save-pending",
          "to": "session-in-sync",
          "on": "save-conflicted",
          "faultOnly": true,
          "effects": [
            {
              "set": "saveState",
              "to": "'saved'"
            }
          ]
        },
        {
          "id": "session-refresh-on-rejection",
          "from": "session-in-sync",
          "to": "session-refreshing",
          "on": "transaction-rejected",
          "faultOnly": true,
          "effects": [
            {
              "emit": "refresh-requested",
              "payload": {
                "revision": "transaction-flow.revision"
              }
            }
          ]
        },
        { "id": "session-on-commit", "from": "session-in-sync", "to": "session-refreshing", "on": "transaction-committed", "effects": [{ "emit": "refresh-requested", "payload": { "revision": "event.revision" } }] },
        { "id": "session-on-refreshed", "from": "session-refreshing", "to": "session-save-pending", "on": "projection-refreshed", "description": "The renderer already has the scene; now the model is published and the write is requested, one tick later.", "effects": [{ "set": "saveState", "to": "'saving'" }, { "emit": "model-published", "payload": { "revision": "event.revision" } }, { "emit": "save-requested", "after": 1, "payload": { "revision": "event.revision" } }] },
        { "id": "session-on-saved", "from": "session-save-pending", "to": "session-in-sync", "on": "save-succeeded", "effects": [{ "set": "saveState", "to": "'saved'" }] },
        { "id": "session-on-conflict", "from": "session-save-pending", "to": "session-conflicted", "on": "save-conflicted", "description": "Nothing was overwritten; the conflict waits for the user to reload from disk or overwrite disk.", "effects": [{ "set": "saveState", "to": "'conflict'" }] },
        { "id": "session-on-rejection", "from": "session-in-sync", "to": "session-in-sync", "on": "transaction-rejected", "description": "The rejection is logged; no refresh and no write follow.", "effects": [{ "set": "rejectionsLogged", "to": "rejectionsLogged + 1" }] }
      ]
    },
    {
      "id": "projection-flow",
      "name": "Projection: derive the scene of the committed revision",
      "subject": "projection-system",
      "initial": "projection-ready",
      "variables": [{ "name": "shownRevision", "type": "number", "initial": 1 }],
      "states": [{ "id": "projection-ready", "name": "Ready" }],
      "transitions": [
        { "id": "projection-refresh", "from": "projection-ready", "to": "projection-ready", "on": "refresh-requested", "effects": [{ "set": "shownRevision", "to": "event.revision" }, { "emit": "projection-refreshed", "payload": { "revision": "event.revision" } }] }
      ]
    },
    {
      "id": "renderer-flow",
      "name": "Renderer: draw the refreshed scene",
      "subject": "scene-renderer",
      "initial": "renderer-ready",
      "variables": [{ "name": "shownRevision", "type": "number", "initial": 1 }],
      "states": [{ "id": "renderer-ready", "name": "Ready" }],
      "transitions": [
        { "id": "renderer-draw", "from": "renderer-ready", "to": "renderer-ready", "on": "projection-refreshed", "effects": [{ "set": "shownRevision", "to": "event.revision" }] }
      ]
    },
    {
      "id": "inspector-flow",
      "name": "Inspector: refresh from the committed model",
      "subject": "inspector",
      "initial": "inspector-ready",
      "variables": [{ "name": "shownRevision", "type": "number", "initial": 1 }],
      "states": [{ "id": "inspector-ready", "name": "Ready" }],
      "transitions": [
        { "id": "inspector-refresh", "from": "inspector-ready", "to": "inspector-ready", "on": "model-published", "effects": [{ "set": "shownRevision", "to": "event.revision" }] }
      ]
    },
    {
      "id": "workspace-flow",
      "name": "File service: replace the file or report a conflict",
      "subject": "workspace-service",
      "description": "The HTTP hop between the persistence client, the plugin and the workspace service is abstracted. persistedRevision is the revision whose text the file on disk holds; conflict records that the last write was refused because the file on disk differed from the base hash.",
      "initial": "workspace-clean",
      "variables": [
        { "name": "persistedRevision", "type": "number", "initial": 1 },
        { "name": "conflict", "type": "boolean", "initial": false }
      ],
      "states": [
        { "id": "workspace-clean", "name": "File matches the base hash" },
        { "id": "workspace-conflicted", "name": "Write refused as a conflict", "terminal": true }
      ],
      "transitions": [
        {
          "id": "workspace-overwrite-on-conflict",
          "from": "workspace-clean",
          "to": "workspace-conflicted",
          "on": "save-requested",
          "faultOnly": true,
          "effects": [
            {
              "set": "conflict",
              "to": "true"
            },
            {
              "set": "persistedRevision",
              "to": "event.revision"
            },
            {
              "emit": "save-conflicted"
            }
          ]
        },
        { "id": "workspace-detect-conflict", "from": "workspace-clean", "to": "workspace-conflicted", "on": "save-requested", "faultOnly": true, "description": "The file's hash differs from the base hash: nothing is written and the current content is returned.", "effects": [{ "set": "conflict", "to": true }, { "emit": "save-conflicted" }] },
        { "id": "workspace-write", "from": "workspace-clean", "to": "workspace-clean", "on": "save-requested", "description": "The hashes match: the file is replaced atomically.", "effects": [{ "set": "persistedRevision", "to": "event.revision" }, { "emit": "save-succeeded" }] }
      ]
    },
    {
      "id": "write-client-flow",
      "name": "Persistence client: write a file, retry after a conflict",
      "subject": "persistence-client",
      "description": "Sends the text with the base hash it last read. A conflict returns the current hash, which becomes the new base hash for one more request; an accepted write ends the flow. The retry abstracts the user's \"Overwrite disk\" (session.resolveConflict('overwrite'), which takes the conflict's hash as base hash and flushes again): the real persistence client and the session never retry on their own. project-session-flow models that resolution as it is.",
      "initial": "write-client-idle",
      "variables": [
        {
          "name": "attempts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "baseHash",
          "type": "string",
          "initial": "h1"
        },
        {
          "name": "saved",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "write-client-idle",
          "name": "Idle"
        },
        {
          "id": "write-client-awaiting",
          "name": "Awaiting the answer"
        },
        {
          "id": "write-client-saved",
          "name": "Written",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "write-client-send",
          "from": "write-client-idle",
          "to": "write-client-awaiting",
          "on": "write-intent",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "emit": "write-file-request",
              "payload": {
                "name": "'exegra'",
                "file": "'spec'",
                "text": "'spec text of revision 2'",
                "baseHash": "baseHash"
              }
            }
          ]
        },
        {
          "id": "write-client-retry",
          "from": "write-client-awaiting",
          "to": "write-client-awaiting",
          "on": "write-file-conflict",
          "guard": "attempts < 3",
          "description": "The base hash was stale: adopt the current hash and send the same text again.",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "baseHash",
              "to": "event.current"
            },
            {
              "emit": "write-file-request",
              "payload": {
                "name": "'exegra'",
                "file": "'spec'",
                "text": "'spec text of revision 2'",
                "baseHash": "event.current"
              }
            }
          ]
        },
        {
          "id": "write-client-done",
          "from": "write-client-awaiting",
          "to": "write-client-saved",
          "on": "write-file-ok",
          "effects": [
            {
              "set": "saved",
              "to": true
            }
          ]
        }
      ]
    },
    {
      "id": "write-endpoint-flow",
      "name": "Development server: accept a write or refuse it as a conflict",
      "subject": "dev-server-plugin",
      "description": "POST /__exegra/write: the file is replaced only when the base hash equals the hash of the text on disk; otherwise it is left untouched and the conflict carries the current hash.",
      "initial": "write-endpoint-ready",
      "variables": [
        {
          "name": "diskHash",
          "type": "string",
          "initial": "h2"
        },
        {
          "name": "writes",
          "type": "number",
          "initial": 0
        },
        {
          "name": "conflicts",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "write-endpoint-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "write-endpoint-conflict",
          "from": "write-endpoint-ready",
          "to": "write-endpoint-ready",
          "on": "write-file-request",
          "guard": "event.baseHash != diskHash",
          "effects": [
            {
              "set": "conflicts",
              "to": "conflicts + 1"
            },
            {
              "emit": "write-file-conflict",
              "payload": {
                "code": "'conflict'",
                "current": "diskHash"
              }
            }
          ]
        },
        {
          "id": "write-endpoint-accept",
          "from": "write-endpoint-ready",
          "to": "write-endpoint-ready",
          "on": "write-file-request",
          "guard": "event.baseHash == diskHash",
          "effects": [
            {
              "set": "diskHash",
              "to": "'h3'"
            },
            {
              "set": "writes",
              "to": "writes + 1"
            },
            {
              "emit": "write-file-ok",
              "payload": {
                "ok": "true",
                "hash": "'h3'"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "persistence-client-flow",
      "name": "Persistence client: one HTTP call per request",
      "subject": "persistence-client",
      "description": "src/persist/client.js: each call is one fetch (request()) or the EventSource of watchProject, and each answer is handed back to its caller once, with no retry, queue or buffer. lastFile stands for the file variable of the session's flush loop, which knows which file a write answers.",
      "initial": "client-ready",
      "variables": [
        {
          "name": "lastFile",
          "type": "string",
          "initial": "spec"
        },
        {
          "name": "calls",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "client-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "client-read",
          "from": "client-ready",
          "to": "client-ready",
          "on": "read-intent",
          "effects": [
            {
              "set": "calls",
              "to": "calls + 1"
            },
            {
              "emit": "read-project-request",
              "payload": {
                "name": "event.name",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-read-ok",
          "from": "client-ready",
          "to": "client-ready",
          "on": "read-project-ok",
          "effects": [
            {
              "emit": "project-files-read",
              "payload": {
                "specHash": "event.spec",
                "layoutHash": "event.layout",
                "recorded": "event.recorded",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-read-failed",
          "from": "client-ready",
          "to": "client-ready",
          "on": "read-project-failed",
          "effects": [
            {
              "emit": "project-read-failed",
              "payload": {
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-list",
          "from": "client-ready",
          "to": "client-ready",
          "on": "list-intent",
          "effects": [
            {
              "set": "calls",
              "to": "calls + 1"
            },
            {
              "emit": "list-projects-request",
              "payload": {
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-listed",
          "from": "client-ready",
          "to": "client-ready",
          "on": "list-projects-ok",
          "effects": [
            {
              "emit": "projects-listed",
              "payload": {
                "projects": "event.projects"
              }
            }
          ]
        },
        {
          "id": "client-write",
          "from": "client-ready",
          "to": "client-ready",
          "on": "write-intent",
          "effects": [
            {
              "set": "calls",
              "to": "calls + 1"
            },
            {
              "set": "lastFile",
              "to": "event.file"
            },
            {
              "emit": "write-file-request",
              "payload": {
                "name": "event.name",
                "file": "event.file",
                "text": "event.text",
                "baseHash": "event.baseHash",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-write-ok",
          "from": "client-ready",
          "to": "client-ready",
          "on": "write-file-ok",
          "effects": [
            {
              "emit": "save-succeeded",
              "payload": {
                "file": "lastFile",
                "hash": "event.hash",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-write-conflict",
          "from": "client-ready",
          "to": "client-ready",
          "on": "write-file-conflict",
          "effects": [
            {
              "emit": "save-conflicted",
              "payload": {
                "file": "lastFile",
                "currentHash": "event.current",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-write-failed",
          "from": "client-ready",
          "to": "client-ready",
          "on": "write-file-failed",
          "effects": [
            {
              "emit": "save-failed",
              "payload": {
                "file": "lastFile",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-watch",
          "from": "client-ready",
          "to": "client-ready",
          "on": "watch-intent",
          "effects": [
            {
              "emit": "watch-project-request",
              "payload": {
                "name": "event.name"
              }
            }
          ]
        },
        {
          "id": "client-notice",
          "from": "client-ready",
          "to": "client-ready",
          "on": "file-change-notice-sent",
          "effects": [
            {
              "emit": "external-change-received",
              "payload": {
                "file": "event.file",
                "hash": "event.hash"
              }
            }
          ]
        },
        {
          "id": "client-export",
          "from": "client-ready",
          "to": "client-ready",
          "on": "export-intent",
          "effects": [
            {
              "set": "calls",
              "to": "calls + 1"
            },
            {
              "emit": "export-request",
              "payload": {
                "name": "event.name",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-export-ok",
          "from": "client-ready",
          "to": "client-ready",
          "on": "export-ok",
          "effects": [
            {
              "emit": "bundle-received",
              "payload": {
                "files": "event.files",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-export-failed",
          "from": "client-ready",
          "to": "client-ready",
          "on": "export-failed",
          "effects": [
            {
              "emit": "export-refused-received",
              "payload": {
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-import",
          "from": "client-ready",
          "to": "client-ready",
          "on": "import-intent",
          "effects": [
            {
              "set": "calls",
              "to": "calls + 1"
            },
            {
              "emit": "import-request",
              "payload": {
                "name": "event.name",
                "bundle": "event.bundle",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-import-ok",
          "from": "client-ready",
          "to": "client-ready",
          "on": "import-ok",
          "effects": [
            {
              "emit": "import-done",
              "payload": {
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-import-refused",
          "from": "client-ready",
          "to": "client-ready",
          "on": "import-refused",
          "effects": [
            {
              "emit": "import-refused-received",
              "payload": {
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-generated",
          "from": "client-ready",
          "to": "client-ready",
          "on": "generated-intent",
          "effects": [
            {
              "set": "calls",
              "to": "calls + 1"
            },
            {
              "emit": "generated-write-request",
              "payload": {
                "name": "event.name",
                "files": "event.files",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "client-generated-ok",
          "from": "client-ready",
          "to": "client-ready",
          "on": "generated-write-ok",
          "effects": [
            {
              "emit": "generated-saved",
              "payload": {
                "written": "event.written",
                "requestId": "event.requestId"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "dev-server-flow",
      "name": "Development server: route each endpoint to the workspace service",
      "subject": "dev-server-plugin",
      "description": "route() of tools/vite-plugin-exegra.js: each request becomes one call of tools/workspace.js and its result one answer (200, 409 for a write conflict, 400 for a workspace refusal); openEvents subscribes to watch() and writes each change as a server-sent event. The request guard (checkRequest) is not modelled as transitions; its refusals are errors of the contracts.",
      "initial": "dev-ready",
      "variables": [
        {
          "name": "requests",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "dev-ready",
          "name": "Listening"
        }
      ],
      "transitions": [
        {
          "id": "dev-read",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "read-project-request",
          "effects": [
            {
              "set": "requests",
              "to": "requests + 1"
            },
            {
              "emit": "ws-read",
              "payload": {
                "name": "event.name",
                "caller": "'http'",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-read-ok",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "ws-read-done",
          "guard": "event.caller == 'http'",
          "effects": [
            {
              "emit": "read-project-ok",
              "payload": {
                "spec": "event.spec",
                "layout": "event.layout",
                "recorded": "event.recorded",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-read-missing",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "ws-read-missing",
          "guard": "event.caller == 'http'",
          "effects": [
            {
              "emit": "read-project-failed",
              "payload": {
                "code": "'not-found'",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-list",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "list-projects-request",
          "effects": [
            {
              "set": "requests",
              "to": "requests + 1"
            },
            {
              "emit": "ws-list",
              "payload": {
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-listed",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "ws-list-done",
          "effects": [
            {
              "emit": "list-projects-ok",
              "payload": {
                "projects": "event.projects",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-write",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "write-file-request",
          "effects": [
            {
              "set": "requests",
              "to": "requests + 1"
            },
            {
              "emit": "ws-write",
              "payload": {
                "name": "event.name",
                "file": "event.file",
                "text": "event.text",
                "baseHash": "event.baseHash",
                "caller": "'http'",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-write-ok",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "ws-write-done",
          "guard": "event.caller == 'http'",
          "effects": [
            {
              "emit": "write-file-ok",
              "payload": {
                "ok": true,
                "hash": "event.hash",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-write-conflict",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "ws-write-conflict",
          "guard": "event.caller == 'http'",
          "description": "Answered with HTTP 409.",
          "effects": [
            {
              "emit": "write-file-conflict",
              "payload": {
                "code": "'conflict'",
                "current": "event.current",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-write-error",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "ws-write-error",
          "guard": "event.caller == 'http'",
          "description": "The exception reaches the middleware catch: HTTP 500 internal.",
          "effects": [
            {
              "emit": "write-file-failed",
              "payload": {
                "code": "'internal'",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-watch",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "watch-project-request",
          "effects": [
            {
              "emit": "ws-watch",
              "payload": {
                "name": "event.name"
              }
            }
          ]
        },
        {
          "id": "dev-change",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "ws-change",
          "effects": [
            {
              "emit": "file-change-notice-sent",
              "payload": {
                "file": "event.file",
                "hash": "event.hash"
              }
            }
          ]
        },
        {
          "id": "dev-export",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "export-request",
          "effects": [
            {
              "set": "requests",
              "to": "requests + 1"
            },
            {
              "emit": "ws-export",
              "payload": {
                "name": "event.name",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-export-ok",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "ws-export-done",
          "effects": [
            {
              "emit": "export-ok",
              "payload": {
                "format": "'exegra-project'",
                "version": 1,
                "name": "event.name",
                "files": "event.files",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-export-missing",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "ws-export-missing",
          "effects": [
            {
              "emit": "export-failed",
              "payload": {
                "code": "'not-found'",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-import",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "import-request",
          "effects": [
            {
              "set": "requests",
              "to": "requests + 1"
            },
            {
              "emit": "ws-import",
              "payload": {
                "name": "event.name",
                "bundle": "event.bundle",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-import-ok",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "ws-import-done",
          "effects": [
            {
              "emit": "import-ok",
              "payload": {
                "ok": true,
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-import-refused",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "ws-import-refused",
          "effects": [
            {
              "emit": "import-refused",
              "payload": {
                "code": "'bundle.invalid'",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-generated",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "generated-write-request",
          "effects": [
            {
              "set": "requests",
              "to": "requests + 1"
            },
            {
              "emit": "ws-write-generated",
              "payload": {
                "name": "event.name",
                "files": "event.files",
                "caller": "'http'",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "dev-generated-ok",
          "from": "dev-ready",
          "to": "dev-ready",
          "on": "ws-generated-done",
          "guard": "event.caller == 'http'",
          "effects": [
            {
              "emit": "generated-write-ok",
              "payload": {
                "ok": true,
                "written": "event.written",
                "requestId": "event.requestId"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "workspace-disk-flow",
      "name": "Workspace service: the project files on disk",
      "subject": "workspace-service",
      "description": "tools/workspace.js on one project. The variables are what the disk holds: diskSpec, diskLayout, recordedVersion and generatedHash stand for the files by their hashes; journalLines counts the lines of .history/journal.jsonl; specWrites, layoutWrites and imports count replacements by write() and importProject(). caller tells the endpoint's calls (http) from the command line's (cli), which reach the same functions.",
      "initial": "ws-ready",
      "variables": [
        {
          "name": "diskSpec",
          "type": "string",
          "initial": "h1"
        },
        {
          "name": "diskLayout",
          "type": "string",
          "initial": "L1"
        },
        {
          "name": "recordedVersion",
          "type": "string",
          "initial": "r1"
        },
        {
          "name": "generatedHash",
          "type": "string",
          "initial": "g1"
        },
        {
          "name": "journalLines",
          "type": "number",
          "initial": 0
        },
        {
          "name": "specWrites",
          "type": "number",
          "initial": 0
        },
        {
          "name": "layoutWrites",
          "type": "number",
          "initial": 0
        },
        {
          "name": "conflicts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "imports",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "ws-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "ws-read-missing-project",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-read",
          "guard": "event.name == 'missing'",
          "effects": [
            {
              "emit": "ws-read-missing",
              "payload": {
                "caller": "event.caller",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "ws-read-files",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-read",
          "effects": [
            {
              "emit": "ws-read-done",
              "payload": {
                "spec": "diskSpec",
                "layout": "diskLayout",
                "recorded": "recordedVersion",
                "caller": "event.caller",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "ws-list-projects",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-list",
          "effects": [
            {
              "emit": "ws-list-done",
              "payload": {
                "projects": [
                  "exegra",
                  "benchmark"
                ],
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "ws-conflict-spec",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-write",
          "guard": "event.file == 'spec' && event.baseHash != diskSpec",
          "description": "The current hash differs from the base hash: nothing is written and no journal line is appended.",
          "effects": [
            {
              "set": "conflicts",
              "to": "conflicts + 1"
            },
            {
              "emit": "ws-write-conflict",
              "payload": {
                "file": "'spec'",
                "current": "diskSpec",
                "caller": "event.caller",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "ws-conflict-layout",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-write",
          "guard": "event.file == 'layout' && event.baseHash != diskLayout",
          "effects": [
            {
              "set": "conflicts",
              "to": "conflicts + 1"
            },
            {
              "emit": "ws-write-conflict",
              "payload": {
                "file": "'layout'",
                "current": "diskLayout",
                "caller": "event.caller",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "ws-write-journal-append-fails",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-write",
          "guard": "event.file == 'spec' && event.baseHash == diskSpec",
          "faultOnly": true,
          "description": "atomicWrite replaced the file, then fs.appendFile of the journal fails: the file stays replaced, no line is written, and the exception makes the write a failure.",
          "effects": [
            {
              "set": "diskSpec",
              "to": "event.text"
            },
            {
              "set": "specWrites",
              "to": "specWrites + 1"
            },
            {
              "emit": "disk-file-replaced",
              "payload": {
                "file": "'spec'",
                "hash": "event.text"
              }
            },
            {
              "emit": "ws-write-error",
              "payload": {
                "file": "'spec'",
                "caller": "event.caller",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "ws-write-spec",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-write",
          "guard": "event.file == 'spec' && event.baseHash == diskSpec",
          "description": "atomicWrite (temporary sibling, rename), then one journal line, under the per-project lock.",
          "effects": [
            {
              "set": "diskSpec",
              "to": "event.text"
            },
            {
              "set": "specWrites",
              "to": "specWrites + 1"
            },
            {
              "set": "journalLines",
              "to": "journalLines + 1"
            },
            {
              "emit": "disk-file-replaced",
              "payload": {
                "file": "'spec'",
                "hash": "event.text"
              }
            },
            {
              "emit": "ws-write-done",
              "payload": {
                "file": "'spec'",
                "hash": "event.text",
                "caller": "event.caller",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "ws-write-layout",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-write",
          "guard": "event.file == 'layout' && event.baseHash == diskLayout",
          "effects": [
            {
              "set": "diskLayout",
              "to": "event.text"
            },
            {
              "set": "layoutWrites",
              "to": "layoutWrites + 1"
            },
            {
              "set": "journalLines",
              "to": "journalLines + 1"
            },
            {
              "emit": "disk-file-replaced",
              "payload": {
                "file": "'layout'",
                "hash": "event.text"
              }
            },
            {
              "emit": "ws-write-done",
              "payload": {
                "file": "'layout'",
                "hash": "event.text",
                "caller": "event.caller",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "ws-external-spec",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "disk-edited-externally",
          "guard": "event.file == 'spec'",
          "description": "Another process replaced the file: no journal line, no base-hash check.",
          "effects": [
            {
              "set": "diskSpec",
              "to": "event.hash"
            },
            {
              "emit": "disk-file-replaced",
              "payload": {
                "file": "'spec'",
                "hash": "event.hash"
              }
            }
          ]
        },
        {
          "id": "ws-external-layout",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "disk-edited-externally",
          "guard": "event.file == 'layout'",
          "effects": [
            {
              "set": "diskLayout",
              "to": "event.hash"
            },
            {
              "emit": "disk-file-replaced",
              "payload": {
                "file": "'layout'",
                "hash": "event.hash"
              }
            }
          ]
        },
        {
          "id": "ws-recorded",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-write-recorded",
          "description": "writeRecorded: atomic, no base-hash check, no journal line.",
          "effects": [
            {
              "set": "recordedVersion",
              "to": "event.version"
            },
            {
              "emit": "disk-file-replaced",
              "payload": {
                "file": "'recorded'",
                "hash": "event.version"
              }
            },
            {
              "emit": "ws-recorded-done",
              "payload": {
                "version": "event.version"
              }
            }
          ]
        },
        {
          "id": "ws-generated-unchanged",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-write-generated",
          "guard": "event.files == generatedHash",
          "description": "Files whose content is unchanged are skipped.",
          "effects": [
            {
              "emit": "ws-generated-done",
              "payload": {
                "written": [],
                "caller": "event.caller",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "ws-generated",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-write-generated",
          "description": "No journal line and no change notice: the watcher ignores generated/.",
          "effects": [
            {
              "set": "generatedHash",
              "to": "event.files"
            },
            {
              "emit": "ws-generated-done",
              "payload": {
                "written": [
                  "ARCHITECTURE.md",
                  "claims-report.json",
                  "claims-report.md",
                  "manifest.json",
                  "tasks.json"
                ],
                "caller": "event.caller",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "ws-export-missing-project",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-export",
          "guard": "event.name == 'missing'",
          "effects": [
            {
              "emit": "ws-export-missing",
              "payload": {
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "ws-export-files",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-export",
          "description": "The bundle holds the files as they are on disk.",
          "effects": [
            {
              "emit": "ws-export-done",
              "payload": {
                "name": "event.name",
                "files": "diskSpec",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "ws-import-refused-bundle",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-import",
          "guard": "event.bundle == 'malformed'",
          "effects": [
            {
              "emit": "ws-import-refused",
              "payload": {
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "ws-import-bundle",
          "from": "ws-ready",
          "to": "ws-ready",
          "on": "ws-import",
          "description": "importProject: the files of the bundle are overwritten without a base-hash check and without a journal line.",
          "effects": [
            {
              "set": "diskSpec",
              "to": "event.bundle"
            },
            {
              "set": "imports",
              "to": "imports + 1"
            },
            {
              "emit": "disk-file-replaced",
              "payload": {
                "file": "'spec'",
                "hash": "event.bundle"
              }
            },
            {
              "emit": "ws-import-done",
              "payload": {
                "requestId": "event.requestId"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "workspace-watcher-flow",
      "name": "Workspace watcher: notify hash changes of tracked files",
      "subject": "workspace-service",
      "description": "watch() of tools/workspace.js for one subscription: off until the stream subscribes, then every replacement of spec, layout or recorded results, own writes included, is notified 80 ms later (one logical tick).",
      "initial": "watcher-off",
      "variables": [
        {
          "name": "notices",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "watcher-off",
          "name": "Not subscribed"
        },
        {
          "id": "watcher-on",
          "name": "Subscribed"
        }
      ],
      "transitions": [
        {
          "id": "watcher-subscribe",
          "from": "watcher-off",
          "to": "watcher-on",
          "on": "ws-watch",
          "description": "The current hashes become the baseline; changes made before this are never notified."
        },
        {
          "id": "watcher-notify",
          "from": "watcher-on",
          "to": "watcher-on",
          "on": "disk-file-replaced",
          "effects": [
            {
              "set": "notices",
              "to": "notices + 1"
            },
            {
              "emit": "ws-change",
              "after": 1,
              "payload": {
                "file": "event.file",
                "hash": "event.hash"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "project-history-flow",
      "name": "Project: commits, undo, redo and reload",
      "subject": "transactions",
      "description": "Project in src/core/project.js seen from the texts it holds: specHash and layoutHash stand for the current texts by their hashes, undoHash and redoHash for the text one undo or redo would restore (this machine keeps one level of each). Every change is a commit that notifies subscribers (commit-notified) with its origin. Project.reload (origin external) clears both stacks.",
      "initial": "history-ready",
      "variables": [
        {
          "name": "revision",
          "type": "number",
          "initial": 1
        },
        {
          "name": "specHash",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "layoutHash",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "undoHash",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "redoHash",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "undoDepth",
          "type": "number",
          "initial": 0
        },
        {
          "name": "redoDepth",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "history-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "history-open",
          "from": "history-ready",
          "to": "history-ready",
          "on": "project-opened",
          "description": "session.open creates a new Project from the texts read.",
          "effects": [
            {
              "set": "specHash",
              "to": "event.specHash"
            },
            {
              "set": "layoutHash",
              "to": "event.layoutHash"
            },
            {
              "set": "undoDepth",
              "to": 0
            },
            {
              "set": "redoDepth",
              "to": 0
            },
            {
              "set": "revision",
              "to": 1
            }
          ]
        },
        {
          "id": "history-edit",
          "from": "history-ready",
          "to": "history-ready",
          "on": "edit-applied",
          "effects": [
            {
              "set": "undoHash",
              "to": "specHash"
            },
            {
              "set": "specHash",
              "to": "event.specHash"
            },
            {
              "set": "undoDepth",
              "to": "undoDepth + 1"
            },
            {
              "set": "redoDepth",
              "to": 0
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "emit": "commit-notified",
              "payload": {
                "origin": "event.origin",
                "file": "'spec'",
                "text": "event.specHash"
              }
            }
          ]
        },
        {
          "id": "history-move-edits-spec",
          "from": "history-ready",
          "to": "history-ready",
          "on": "node-moved",
          "faultOnly": true,
          "description": "A defect the transaction system must not have: a presentation move edits the specification text.",
          "effects": [
            {
              "set": "layoutHash",
              "to": "event.layoutHash"
            },
            {
              "set": "specHash",
              "to": "'h-moved'"
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "emit": "commit-notified",
              "payload": {
                "origin": "'ui'",
                "file": "'spec'",
                "text": "'h-moved'"
              }
            }
          ]
        },
        {
          "id": "history-move",
          "from": "history-ready",
          "to": "history-ready",
          "on": "node-moved",
          "description": "MovePresentationNode: persistence layout, semantic false; the model and the semantic hash are kept.",
          "effects": [
            {
              "set": "layoutHash",
              "to": "event.layoutHash"
            },
            {
              "set": "undoDepth",
              "to": "undoDepth + 1"
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "emit": "commit-notified",
              "payload": {
                "origin": "'ui'",
                "file": "'layout'",
                "text": "event.layoutHash"
              }
            }
          ]
        },
        {
          "id": "history-undo-keeps-text",
          "from": "history-ready",
          "to": "history-ready",
          "on": "undo-requested",
          "guard": "undoDepth > 0",
          "faultOnly": true,
          "description": "A defect Project.undo must not have: the step is recorded but the earlier text is not restored.",
          "effects": [
            {
              "set": "undoDepth",
              "to": "undoDepth - 1"
            },
            {
              "set": "redoDepth",
              "to": "redoDepth + 1"
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "emit": "commit-notified",
              "payload": {
                "origin": "'undo'",
                "file": "'spec'",
                "text": "specHash"
              }
            }
          ]
        },
        {
          "id": "history-undo",
          "from": "history-ready",
          "to": "history-ready",
          "on": "undo-requested",
          "guard": "undoDepth > 0",
          "description": "Project.undo: the whole earlier text is restored by a commit with origin undo.",
          "effects": [
            {
              "set": "redoHash",
              "to": "specHash"
            },
            {
              "set": "specHash",
              "to": "undoHash"
            },
            {
              "set": "undoDepth",
              "to": "undoDepth - 1"
            },
            {
              "set": "redoDepth",
              "to": "redoDepth + 1"
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "emit": "commit-notified",
              "payload": {
                "origin": "'undo'",
                "file": "'spec'",
                "text": "specHash"
              }
            }
          ]
        },
        {
          "id": "history-redo",
          "from": "history-ready",
          "to": "history-ready",
          "on": "redo-requested",
          "guard": "redoDepth > 0",
          "effects": [
            {
              "set": "undoHash",
              "to": "specHash"
            },
            {
              "set": "specHash",
              "to": "redoHash"
            },
            {
              "set": "undoDepth",
              "to": "undoDepth + 1"
            },
            {
              "set": "redoDepth",
              "to": "redoDepth - 1"
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "emit": "commit-notified",
              "payload": {
                "origin": "'redo'",
                "file": "'spec'",
                "text": "specHash"
              }
            }
          ]
        },
        {
          "from": "history-ready",
          "to": "history-ready",
          "id": "history-reload-layout",
          "on": "reload-requested",
          "guard": "event.file == 'layout'",
          "effects": [
            {
              "set": "layoutHash",
              "to": "event.text"
            },
            {
              "set": "undoDepth",
              "to": 0
            },
            {
              "set": "redoDepth",
              "to": 0
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "emit": "commit-notified",
              "payload": {
                "origin": "'external'",
                "file": "'layout'",
                "text": "event.text"
              }
            }
          ]
        },
        {
          "id": "history-reload",
          "from": "history-ready",
          "to": "history-ready",
          "on": "reload-requested",
          "description": "Project.reload adopts any text that parses, clears undo and redo, and is not undoable.",
          "effects": [
            {
              "set": "specHash",
              "to": "event.text"
            },
            {
              "set": "undoDepth",
              "to": 0
            },
            {
              "set": "redoDepth",
              "to": 0
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "emit": "commit-notified",
              "payload": {
                "origin": "'external'",
                "file": "'spec'",
                "text": "event.text"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "project-session-flow",
      "name": "Session: open, save, conflicts and external changes",
      "subject": "session",
      "description": "src/app/session.js from the files' point of view: init lists projects and opens one; open reads the files and takes their hashes as base hashes; onCommit marks the changed file pending and flush writes it with the base hash (a commit with origin external is not written); the answer replaces the base hash, stores a conflict or records an error; resolveConflict reloads or overwrites; onExternalChange ignores the session's own writes by hash, re-reads the project and adopts the change only when nothing is pending. textHash and layoutHash stand for the texts the session holds; reqSeq numbers its requests. persistent is false in a production build, which reads the bundled specifications and never writes.",
      "initial": "session-closed",
      "variables": [
        {
          "name": "persistent",
          "type": "boolean",
          "initial": true
        },
        {
          "name": "projectName",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "pendingName",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "baseHash",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "layoutBase",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "textHash",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "layoutHash",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "saveState",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "pendingAgain",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "conflictHash",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "reqSeq",
          "type": "number",
          "initial": 0
        },
        {
          "name": "readPurpose",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "recordedVersion",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "externalReloads",
          "type": "number",
          "initial": 0
        },
        {
          "name": "ownNotices",
          "type": "number",
          "initial": 0
        },
        {
          "name": "errorsLogged",
          "type": "number",
          "initial": 0
        },
        {
          "name": "projectsListed",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "session-closed",
          "name": "No project open"
        },
        {
          "id": "session-opening",
          "name": "Reading the project"
        },
        {
          "id": "session-open",
          "name": "Open and saved"
        },
        {
          "id": "session-saving",
          "name": "Save in flight"
        },
        {
          "id": "session-conflict",
          "name": "Save conflict unresolved"
        },
        {
          "id": "session-error",
          "name": "Save failed"
        },
        {
          "id": "session-readonly",
          "name": "Open read-only"
        }
      ],
      "transitions": [
        {
          "id": "session-init",
          "from": "session-closed",
          "to": "session-closed",
          "on": "session-init-requested",
          "guard": "event.persistent",
          "effects": [
            {
              "set": "pendingName",
              "to": "event.project"
            },
            {
              "set": "persistent",
              "to": true
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "list-intent",
              "payload": {
                "requestId": "reqSeq"
              }
            }
          ]
        },
        {
          "id": "session-init-readonly",
          "from": "session-closed",
          "to": "session-closed",
          "on": "session-init-requested",
          "guard": "!event.persistent",
          "description": "Without persistence the projects are the shipped specifications bundled in the build.",
          "effects": [
            {
              "set": "persistent",
              "to": false
            },
            {
              "emit": "project-open-requested",
              "payload": {
                "name": "event.project"
              }
            }
          ]
        },
        {
          "id": "session-listed-open",
          "from": "session-closed",
          "to": "session-closed",
          "on": "projects-listed",
          "description": "init opens the project of the URL, the remembered one, or exegra.",
          "effects": [
            {
              "set": "projectsListed",
              "to": "projectsListed + 1"
            },
            {
              "emit": "project-open-requested",
              "payload": {
                "name": "pendingName"
              }
            }
          ]
        },
        {
          "id": "session-open-read",
          "from": "session-closed",
          "to": "session-opening",
          "on": "project-open-requested",
          "guard": "persistent",
          "effects": [
            {
              "set": "pendingName",
              "to": "event.name"
            },
            {
              "set": "readPurpose",
              "to": "'open'"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "read-intent",
              "payload": {
                "name": "event.name",
                "requestId": "reqSeq",
                "purpose": "'open'"
              }
            }
          ]
        },
        {
          "id": "session-open-shipped",
          "from": "session-closed",
          "to": "session-readonly",
          "on": "project-open-requested",
          "guard": "!persistent",
          "effects": [
            {
              "set": "projectName",
              "to": "event.name"
            },
            {
              "set": "textHash",
              "to": "'shipped'"
            },
            {
              "set": "saveState",
              "to": "'readonly'"
            },
            {
              "emit": "project-opened",
              "payload": {
                "name": "event.name",
                "specHash": "'shipped'",
                "layoutHash": "'shipped-layout'"
              }
            }
          ]
        },
        {
          "id": "session-switch",
          "from": "session-open",
          "to": "session-opening",
          "on": "project-open-requested",
          "description": "Switching is allowed only when nothing is pending, in conflict or in error.",
          "effects": [
            {
              "set": "pendingName",
              "to": "event.name"
            },
            {
              "set": "readPurpose",
              "to": "'open'"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "read-intent",
              "payload": {
                "name": "event.name",
                "requestId": "reqSeq",
                "purpose": "'open'"
              }
            }
          ]
        },
        {
          "id": "session-switch-refused-saving",
          "from": "session-saving",
          "to": "session-saving",
          "on": "project-open-requested",
          "effects": [
            {
              "set": "errorsLogged",
              "to": "errorsLogged + 1"
            },
            {
              "emit": "open-refused",
              "payload": {
                "name": "event.name"
              }
            }
          ]
        },
        {
          "id": "session-switch-refused-conflict",
          "from": "session-conflict",
          "to": "session-conflict",
          "on": "project-open-requested",
          "effects": [
            {
              "set": "errorsLogged",
              "to": "errorsLogged + 1"
            },
            {
              "emit": "open-refused",
              "payload": {
                "name": "event.name"
              }
            }
          ]
        },
        {
          "id": "session-switch-refused-error",
          "from": "session-error",
          "to": "session-error",
          "on": "project-open-requested",
          "effects": [
            {
              "set": "errorsLogged",
              "to": "errorsLogged + 1"
            },
            {
              "emit": "open-refused",
              "payload": {
                "name": "event.name"
              }
            }
          ]
        },
        {
          "id": "session-opened-without-base",
          "from": "session-opening",
          "to": "session-open",
          "on": "project-files-read",
          "faultOnly": true,
          "description": "A defect open must not have: the hashes of the read are not kept as base hashes.",
          "effects": [
            {
              "set": "projectName",
              "to": "pendingName"
            },
            {
              "set": "textHash",
              "to": "event.specHash"
            },
            {
              "set": "layoutHash",
              "to": "event.layoutHash"
            },
            {
              "set": "saveState",
              "to": "'saved'"
            },
            {
              "emit": "project-opened",
              "payload": {
                "name": "pendingName",
                "specHash": "event.specHash",
                "layoutHash": "event.layoutHash"
              }
            },
            {
              "emit": "watch-intent",
              "payload": {
                "name": "pendingName"
              }
            }
          ]
        },
        {
          "id": "session-opened",
          "from": "session-opening",
          "to": "session-open",
          "on": "project-files-read",
          "effects": [
            {
              "set": "projectName",
              "to": "pendingName"
            },
            {
              "set": "baseHash",
              "to": "event.specHash"
            },
            {
              "set": "textHash",
              "to": "event.specHash"
            },
            {
              "set": "layoutBase",
              "to": "event.layoutHash"
            },
            {
              "set": "layoutHash",
              "to": "event.layoutHash"
            },
            {
              "set": "recordedVersion",
              "to": "event.recorded"
            },
            {
              "set": "saveState",
              "to": "'saved'"
            },
            {
              "set": "pendingAgain",
              "to": false
            },
            {
              "set": "conflictHash",
              "to": "'none'"
            },
            {
              "emit": "project-opened",
              "payload": {
                "name": "pendingName",
                "specHash": "event.specHash",
                "layoutHash": "event.layoutHash"
              }
            },
            {
              "emit": "watch-intent",
              "payload": {
                "name": "pendingName"
              }
            }
          ]
        },
        {
          "id": "session-open-failed",
          "from": "session-opening",
          "to": "session-closed",
          "on": "project-read-failed",
          "guard": "projectName == 'none'",
          "effects": [
            {
              "set": "errorsLogged",
              "to": "errorsLogged + 1"
            }
          ]
        },
        {
          "id": "session-open-failed-keep",
          "from": "session-opening",
          "to": "session-open",
          "on": "project-read-failed",
          "guard": "projectName != 'none'",
          "description": "The current project stays fully functional.",
          "effects": [
            {
              "set": "errorsLogged",
              "to": "errorsLogged + 1"
            }
          ]
        },
        {
          "id": "session-skip-flush-on-undo",
          "from": "session-open",
          "to": "session-open",
          "on": "commit-notified",
          "guard": "event.origin == 'undo'",
          "faultOnly": true,
          "description": "A defect onCommit must not have: an undo is treated like an adopted external change and not written.",
          "effects": [
            {
              "set": "textHash",
              "to": "event.text"
            }
          ]
        },
        {
          "id": "session-flush-external-reload",
          "from": "session-open",
          "to": "session-saving",
          "on": "commit-notified",
          "guard": "event.origin == 'external'",
          "faultOnly": true,
          "description": "A defect onCommit must not have: text adopted from disk is written back.",
          "effects": [
            {
              "set": "textHash",
              "to": "event.text"
            },
            {
              "set": "saveState",
              "to": "'saving'"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "write-intent",
              "payload": {
                "name": "projectName",
                "file": "'spec'",
                "text": "event.text",
                "baseHash": "baseHash",
                "requestId": "reqSeq"
              }
            }
          ]
        },
        {
          "id": "session-commit-external",
          "from": "session-open",
          "to": "session-open",
          "on": "commit-notified",
          "guard": "event.origin == 'external'",
          "description": "Origin external: nothing is marked pending, nothing is written.",
          "effects": [
            {
              "set": "textHash",
              "to": "event.text"
            }
          ]
        },
        {
          "id": "session-commit-spec",
          "from": "session-open",
          "to": "session-saving",
          "on": "commit-notified",
          "guard": "event.file == 'spec'",
          "effects": [
            {
              "set": "textHash",
              "to": "event.text"
            },
            {
              "set": "saveState",
              "to": "'saving'"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "write-intent",
              "payload": {
                "name": "projectName",
                "file": "'spec'",
                "text": "event.text",
                "baseHash": "baseHash",
                "requestId": "reqSeq"
              }
            }
          ]
        },
        {
          "id": "session-commit-layout",
          "from": "session-open",
          "to": "session-saving",
          "on": "commit-notified",
          "guard": "event.file == 'layout'",
          "effects": [
            {
              "set": "layoutHash",
              "to": "event.text"
            },
            {
              "set": "saveState",
              "to": "'saving'"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "write-intent",
              "payload": {
                "name": "projectName",
                "file": "'layout'",
                "text": "event.text",
                "baseHash": "layoutBase",
                "requestId": "reqSeq"
              }
            }
          ]
        },
        {
          "id": "session-readonly-flush",
          "from": "session-readonly",
          "to": "session-readonly",
          "on": "commit-notified",
          "faultOnly": true,
          "description": "A defect a production build must not have: it tries to write.",
          "effects": [
            {
              "set": "textHash",
              "to": "event.text"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "write-intent",
              "payload": {
                "name": "projectName",
                "file": "'spec'",
                "text": "event.text",
                "baseHash": "baseHash",
                "requestId": "reqSeq"
              }
            }
          ]
        },
        {
          "id": "session-readonly-commit",
          "from": "session-readonly",
          "to": "session-readonly",
          "on": "commit-notified",
          "description": "flush returns at once when persistence is unavailable; the save state stays read-only.",
          "effects": [
            {
              "set": "textHash",
              "to": "event.text"
            }
          ]
        },
        {
          "id": "session-commit-while-saving",
          "from": "session-saving",
          "to": "session-saving",
          "on": "commit-notified",
          "guard": "event.file == 'spec' && event.origin != 'external'",
          "description": "The flush loop writes the current text again after the answer: several quick commits may be saved as one write.",
          "effects": [
            {
              "set": "textHash",
              "to": "event.text"
            },
            {
              "set": "pendingAgain",
              "to": true
            }
          ]
        },
        {
          "id": "session-saved-again",
          "from": "session-saving",
          "to": "session-saving",
          "on": "save-succeeded",
          "guard": "event.file == 'spec' && pendingAgain",
          "effects": [
            {
              "set": "baseHash",
              "to": "event.hash"
            },
            {
              "set": "pendingAgain",
              "to": false
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "write-intent",
              "payload": {
                "name": "projectName",
                "file": "'spec'",
                "text": "textHash",
                "baseHash": "event.hash",
                "requestId": "reqSeq"
              }
            }
          ]
        },
        {
          "id": "session-saved",
          "from": "session-saving",
          "to": "session-open",
          "on": "save-succeeded",
          "guard": "event.file == 'spec'",
          "effects": [
            {
              "set": "baseHash",
              "to": "event.hash"
            },
            {
              "set": "saveState",
              "to": "'saved'"
            }
          ]
        },
        {
          "id": "session-layout-saved",
          "from": "session-saving",
          "to": "session-open",
          "on": "save-succeeded",
          "guard": "event.file == 'layout'",
          "effects": [
            {
              "set": "layoutBase",
              "to": "event.hash"
            },
            {
              "set": "saveState",
              "to": "'saved'"
            }
          ]
        },
        {
          "id": "session-save-conflict",
          "from": "session-saving",
          "to": "session-conflict",
          "on": "save-conflicted",
          "description": "Nothing was overwritten; the file stays pending and the conflict waits for the user.",
          "effects": [
            {
              "set": "conflictHash",
              "to": "event.currentHash"
            },
            {
              "set": "saveState",
              "to": "'conflict'"
            }
          ]
        },
        {
          "id": "session-save-failed",
          "from": "session-saving",
          "to": "session-error",
          "on": "save-failed",
          "description": "No automatic retry: the pending flag stays set until the next commit flushes.",
          "effects": [
            {
              "set": "saveState",
              "to": "'error'"
            },
            {
              "set": "errorsLogged",
              "to": "errorsLogged + 1"
            }
          ]
        },
        {
          "id": "session-retry-on-commit",
          "from": "session-error",
          "to": "session-saving",
          "on": "commit-notified",
          "guard": "event.file == 'spec' && event.origin != 'external'",
          "effects": [
            {
              "set": "textHash",
              "to": "event.text"
            },
            {
              "set": "saveState",
              "to": "'saving'"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "write-intent",
              "payload": {
                "name": "projectName",
                "file": "'spec'",
                "text": "event.text",
                "baseHash": "baseHash",
                "requestId": "reqSeq"
              }
            }
          ]
        },
        {
          "id": "session-resolve-reload-keeps-text",
          "from": "session-conflict",
          "to": "session-open",
          "on": "conflict-resolution-chosen",
          "guard": "event.how == 'reload'",
          "faultOnly": true,
          "description": "A defect resolveConflict must not have: the conflict is cleared but the disk text is not adopted.",
          "effects": [
            {
              "set": "baseHash",
              "to": "conflictHash"
            },
            {
              "set": "saveState",
              "to": "'saved'"
            }
          ]
        },
        {
          "id": "session-resolve-reload",
          "from": "session-conflict",
          "to": "session-open",
          "on": "conflict-resolution-chosen",
          "guard": "event.how == 'reload'",
          "description": "Adopt the disk text with Project.reload; the in-memory edits and the undo history are dropped.",
          "effects": [
            {
              "set": "baseHash",
              "to": "conflictHash"
            },
            {
              "set": "saveState",
              "to": "'saved'"
            },
            {
              "emit": "reload-requested",
              "payload": {
                "file": "'spec'",
                "text": "conflictHash"
              }
            }
          ]
        },
        {
          "id": "session-overwrite-stale-base",
          "from": "session-conflict",
          "to": "session-saving",
          "on": "conflict-resolution-chosen",
          "guard": "event.how == 'overwrite'",
          "faultOnly": true,
          "description": "A defect resolveConflict must not have: the overwrite keeps the stale base hash.",
          "effects": [
            {
              "set": "saveState",
              "to": "'saving'"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "write-intent",
              "payload": {
                "name": "projectName",
                "file": "'spec'",
                "text": "textHash",
                "baseHash": "baseHash",
                "requestId": "reqSeq"
              }
            }
          ]
        },
        {
          "id": "session-resolve-overwrite",
          "from": "session-conflict",
          "to": "session-saving",
          "on": "conflict-resolution-chosen",
          "guard": "event.how == 'overwrite'",
          "description": "The disk hash becomes the base hash and the in-memory text is written over it.",
          "effects": [
            {
              "set": "baseHash",
              "to": "conflictHash"
            },
            {
              "set": "saveState",
              "to": "'saving'"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "write-intent",
              "payload": {
                "name": "projectName",
                "file": "'spec'",
                "text": "textHash",
                "baseHash": "conflictHash",
                "requestId": "reqSeq"
              }
            }
          ]
        },
        {
          "id": "session-recorded-changed",
          "from": "session-open",
          "to": "session-open",
          "on": "external-change-received",
          "guard": "event.file == 'recorded'",
          "effects": [
            {
              "set": "readPurpose",
              "to": "'recorded'"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "read-intent",
              "payload": {
                "name": "projectName",
                "requestId": "reqSeq",
                "purpose": "'recorded'"
              }
            }
          ]
        },
        {
          "id": "session-reload-own-write",
          "from": "session-open",
          "to": "session-open",
          "on": "external-change-received",
          "guard": "event.file == 'spec'",
          "faultOnly": true,
          "description": "A defect onExternalChange must not have: every notice, the session's own write included, reloads the text.",
          "effects": [
            {
              "set": "externalReloads",
              "to": "externalReloads + 1"
            },
            {
              "emit": "reload-requested",
              "payload": {
                "file": "'spec'",
                "text": "event.hash"
              }
            }
          ]
        },
        {
          "id": "session-ignore-own-write",
          "from": "session-open",
          "to": "session-open",
          "on": "external-change-received",
          "guard": "event.file == 'spec' && event.hash == baseHash",
          "description": "The notice of the session's own write carries the base hash it just acknowledged.",
          "effects": [
            {
              "set": "ownNotices",
              "to": "ownNotices + 1"
            }
          ]
        },
        {
          "from": "session-open",
          "to": "session-open",
          "id": "session-ignore-own-layout-write",
          "on": "external-change-received",
          "guard": "event.file == 'layout' && event.hash == layoutBase",
          "effects": [
            {
              "set": "ownNotices",
              "to": "ownNotices + 1"
            }
          ]
        },
        {
          "from": "session-open",
          "to": "session-open",
          "id": "session-external-layout-read",
          "on": "external-change-received",
          "guard": "event.file == 'layout'",
          "effects": [
            {
              "set": "readPurpose",
              "to": "'external-layout'"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "read-intent",
              "payload": {
                "name": "projectName",
                "requestId": "reqSeq",
                "purpose": "'external'"
              }
            }
          ]
        },
        {
          "id": "session-external-read",
          "from": "session-open",
          "to": "session-open",
          "on": "external-change-received",
          "guard": "event.file == 'spec'",
          "description": "Only when nothing is saving, pending or in conflict; in those states a notice is ignored and the pending write surfaces the conflict.",
          "effects": [
            {
              "set": "readPurpose",
              "to": "'external'"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "read-intent",
              "payload": {
                "name": "projectName",
                "requestId": "reqSeq",
                "purpose": "'external'"
              }
            }
          ]
        },
        {
          "from": "session-open",
          "to": "session-open",
          "id": "session-external-layout-adopted",
          "on": "project-files-read",
          "guard": "readPurpose == 'external-layout' && event.layoutHash != layoutBase",
          "effects": [
            {
              "set": "layoutBase",
              "to": "event.layoutHash"
            },
            {
              "set": "externalReloads",
              "to": "externalReloads + 1"
            },
            {
              "emit": "reload-requested",
              "payload": {
                "file": "'layout'",
                "text": "event.layoutHash"
              }
            }
          ]
        },
        {
          "id": "session-recorded-adopted",
          "from": "session-open",
          "to": "session-open",
          "on": "project-files-read",
          "guard": "readPurpose == 'recorded'",
          "effects": [
            {
              "set": "recordedVersion",
              "to": "event.recorded"
            },
            {
              "emit": "recorded-results-adopted",
              "payload": {
                "version": "event.recorded"
              }
            }
          ]
        },
        {
          "id": "session-external-adopted",
          "from": "session-open",
          "to": "session-open",
          "on": "project-files-read",
          "guard": "readPurpose == 'external' && event.specHash != baseHash",
          "effects": [
            {
              "set": "baseHash",
              "to": "event.specHash"
            },
            {
              "set": "externalReloads",
              "to": "externalReloads + 1"
            },
            {
              "emit": "reload-requested",
              "payload": {
                "file": "'spec'",
                "text": "event.specHash"
              }
            }
          ]
        },
        {
          "id": "session-projects-refreshed",
          "from": "session-open",
          "to": "session-open",
          "on": "projects-listed",
          "description": "refreshProjects after an import.",
          "effects": [
            {
              "set": "projectsListed",
              "to": "projectsListed + 1"
            }
          ]
        },
        {
          "from": "session-open",
          "to": "session-open",
          "id": "session-external-unchanged",
          "on": "project-files-read",
          "guard": "readPurpose == 'external' || readPurpose == 'external-layout'",
          "effects": []
        },
        {
          "id": "session-notice-while-saving",
          "from": "session-saving",
          "to": "session-saving",
          "on": "external-change-received",
          "effects": [
            {
              "set": "ownNotices",
              "to": "ownNotices + 1"
            }
          ],
          "description": "onExternalChange of src/app/session.js returns while a save is in flight (saving, pending or conflict): the pending write will surface a conflict. Found by the live replay: the server's notice of the session's own write can arrive before the session has read the write's answer (write-file-ok is in the answer's headers, save-succeeded follows the body)."
        }
      ]
    },
    {
      "id": "session-claims-flow",
      "name": "Session: re-evaluate claims on open, semantic commits and recorded changes",
      "subject": "session",
      "description": "evaluate() of src/app/session.js: on open, on every commit that changed the specification (a layout-only commit only updates the highlight) and when the recorded results changed. resultsHash is the model the current claim results were evaluated at.",
      "initial": "claims-ready",
      "variables": [
        {
          "name": "modelHash",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "resultsHash",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "evaluations",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "claims-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "claims-on-open",
          "from": "claims-ready",
          "to": "claims-ready",
          "on": "project-opened",
          "effects": [
            {
              "set": "modelHash",
              "to": "event.specHash"
            },
            {
              "emit": "claims-evaluation-requested",
              "payload": {
                "modelHash": "event.specHash"
              }
            }
          ]
        },
        {
          "id": "claims-on-commit",
          "from": "claims-ready",
          "to": "claims-ready",
          "on": "commit-notified",
          "guard": "event.file == 'spec'",
          "effects": [
            {
              "set": "modelHash",
              "to": "event.text"
            },
            {
              "emit": "claims-evaluation-requested",
              "payload": {
                "modelHash": "event.text"
              }
            }
          ]
        },
        {
          "id": "claims-on-recorded",
          "from": "claims-ready",
          "to": "claims-ready",
          "on": "recorded-results-adopted",
          "effects": [
            {
              "emit": "claims-evaluation-requested",
              "payload": {
                "modelHash": "modelHash"
              }
            }
          ]
        },
        {
          "id": "claims-results",
          "from": "claims-ready",
          "to": "claims-ready",
          "on": "claims-evaluated",
          "effects": [
            {
              "set": "resultsHash",
              "to": "event.modelHash"
            },
            {
              "set": "evaluations",
              "to": "evaluations + 1"
            }
          ]
        }
      ]
    },
    {
      "id": "claim-evaluation-flow",
      "name": "Claim evaluator: evaluate every claim, synchronously",
      "subject": "claim-evaluator",
      "description": "evaluateClaims of src/core/claims.js runs on the caller's thread; in the application that is the main thread, inside the commit. Trace and metric claims run engine scenarios there (claim-scenarios-run), not in the engine worker.",
      "initial": "evaluator-ready",
      "variables": [
        {
          "name": "evaluations",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "evaluator-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "evaluator-run",
          "from": "evaluator-ready",
          "to": "evaluator-ready",
          "on": "claims-evaluation-requested",
          "effects": [
            {
              "set": "evaluations",
              "to": "evaluations + 1"
            },
            {
              "emit": "claim-scenarios-run",
              "payload": {
                "modelHash": "event.modelHash"
              }
            },
            {
              "emit": "claims-evaluated",
              "payload": {
                "modelHash": "event.modelHash"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "toolbar-exchange-flow",
      "name": "Toolbar: export and import project bundles",
      "subject": "toolbar",
      "description": "The Export and Import handlers of src/ui/toolbar.js. Export downloads what the server reads from disk. Import parses the file, refuses a specification with syntax errors (analyzeSpec) but not one with validation errors, sends the bundle, then refreshes the project list and opens the imported project.",
      "initial": "toolbar-ready",
      "variables": [
        {
          "name": "downloadedHash",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "importName",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "reqSeq",
          "type": "number",
          "initial": 100
        },
        {
          "name": "exports",
          "type": "number",
          "initial": 0
        },
        {
          "name": "imports",
          "type": "number",
          "initial": 0
        },
        {
          "name": "refusedLocally",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "toolbar-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "toolbar-export",
          "from": "toolbar-ready",
          "to": "toolbar-ready",
          "on": "export-clicked",
          "effects": [
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "export-intent",
              "payload": {
                "name": "project-session-flow.projectName",
                "requestId": "reqSeq"
              }
            }
          ]
        },
        {
          "id": "toolbar-bundle",
          "from": "toolbar-ready",
          "to": "toolbar-ready",
          "on": "bundle-received",
          "effects": [
            {
              "set": "downloadedHash",
              "to": "event.files"
            },
            {
              "set": "exports",
              "to": "exports + 1"
            },
            {
              "emit": "bundle-downloaded",
              "payload": {
                "specHash": "event.files"
              }
            }
          ]
        },
        {
          "id": "toolbar-import-unchecked",
          "from": "toolbar-ready",
          "to": "toolbar-ready",
          "on": "import-file-chosen",
          "faultOnly": true,
          "description": "A defect the import handler must not have: the syntax check is skipped.",
          "effects": [
            {
              "set": "importName",
              "to": "event.name"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "import-intent",
              "payload": {
                "name": "event.name",
                "bundle": "event.specHash",
                "requestId": "reqSeq"
              }
            }
          ]
        },
        {
          "id": "toolbar-import-refused-locally",
          "from": "toolbar-ready",
          "to": "toolbar-ready",
          "on": "import-file-chosen",
          "guard": "!event.syntaxOk",
          "description": "analyzeSpec found syntax errors: \"Import failed\", nothing is sent.",
          "effects": [
            {
              "set": "refusedLocally",
              "to": "refusedLocally + 1"
            }
          ]
        },
        {
          "id": "toolbar-import",
          "from": "toolbar-ready",
          "to": "toolbar-ready",
          "on": "import-file-chosen",
          "guard": "event.syntaxOk",
          "effects": [
            {
              "set": "importName",
              "to": "event.name"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "import-intent",
              "payload": {
                "name": "event.name",
                "bundle": "event.specHash",
                "requestId": "reqSeq"
              }
            }
          ]
        },
        {
          "id": "toolbar-import-skip-reopen",
          "from": "toolbar-ready",
          "to": "toolbar-ready",
          "on": "import-done",
          "faultOnly": true,
          "description": "A defect the import handler must not have: the imported project is not reopened.",
          "effects": [
            {
              "set": "imports",
              "to": "imports + 1"
            }
          ]
        },
        {
          "id": "toolbar-import-done",
          "from": "toolbar-ready",
          "to": "toolbar-ready",
          "on": "import-done",
          "effects": [
            {
              "set": "imports",
              "to": "imports + 1"
            },
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "list-intent",
              "payload": {
                "requestId": "reqSeq"
              }
            },
            {
              "emit": "project-open-requested",
              "payload": {
                "name": "importName"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "realisation-generate-flow",
      "name": "Realisation panel: generate and write the documents",
      "subject": "realisation-panel",
      "description": "generate() of src/ui/realisation-panel.js derives the five documents with generateAll from the session's current model and claim results and writes them through the persistence client. The documents stand for the model hash they were derived from.",
      "initial": "realisation-ready",
      "variables": [
        {
          "name": "lastGenerated",
          "type": "string",
          "initial": "g1"
        },
        {
          "name": "reqSeq",
          "type": "number",
          "initial": 200
        },
        {
          "name": "saved",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "realisation-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "realisation-generate-stale",
          "from": "realisation-ready",
          "to": "realisation-ready",
          "on": "generate-clicked",
          "faultOnly": true,
          "description": "A defect the panel must not have: it writes documents derived from an earlier model.",
          "effects": [
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "emit": "generated-intent",
              "payload": {
                "name": "project-session-flow.projectName",
                "files": "lastGenerated",
                "requestId": "reqSeq"
              }
            }
          ]
        },
        {
          "id": "realisation-generate",
          "from": "realisation-ready",
          "to": "realisation-ready",
          "on": "generate-clicked",
          "effects": [
            {
              "set": "reqSeq",
              "to": "reqSeq + 1"
            },
            {
              "set": "lastGenerated",
              "to": "project-session-flow.textHash"
            },
            {
              "emit": "generated-intent",
              "payload": {
                "name": "project-session-flow.projectName",
                "files": "project-session-flow.textHash",
                "requestId": "reqSeq"
              }
            }
          ]
        },
        {
          "id": "realisation-saved",
          "from": "realisation-ready",
          "to": "realisation-ready",
          "on": "generated-saved",
          "effects": [
            {
              "set": "saved",
              "to": "saved + 1"
            }
          ]
        }
      ]
    },
    {
      "id": "app-start-flow",
      "name": "Application start: load the engine, then start the session",
      "subject": "visual-interaction",
      "description": "The end of src/app/main.js: initEngine() is awaited, and the session starts when it has loaded or failed (a failure is noted and the session starts anyway).",
      "initial": "app-loading",
      "variables": [
        {
          "name": "persistentFlag",
          "type": "boolean",
          "initial": true
        },
        {
          "name": "project",
          "type": "string",
          "initial": "exegra"
        }
      ],
      "states": [
        {
          "id": "app-loading",
          "name": "Loading"
        },
        {
          "id": "app-waiting-engine",
          "name": "Waiting for the engine"
        },
        {
          "id": "app-started",
          "name": "Started"
        }
      ],
      "transitions": [
        {
          "id": "app-init-before-engine",
          "from": "app-loading",
          "to": "app-waiting-engine",
          "on": "page-loaded",
          "faultOnly": true,
          "description": "A defect main.js must not have: the session starts before the engine has settled.",
          "effects": [
            {
              "set": "persistentFlag",
              "to": "event.persistent"
            },
            {
              "emit": "session-init-requested",
              "payload": {
                "persistent": "event.persistent",
                "project": "event.project"
              }
            },
            {
              "emit": "engine-load-requested"
            }
          ]
        },
        {
          "id": "app-load-engine",
          "from": "app-loading",
          "to": "app-waiting-engine",
          "on": "page-loaded",
          "effects": [
            {
              "set": "persistentFlag",
              "to": "event.persistent"
            },
            {
              "set": "project",
              "to": "event.project"
            },
            {
              "emit": "engine-load-requested"
            }
          ]
        },
        {
          "id": "app-start-session",
          "from": "app-waiting-engine",
          "to": "app-started",
          "on": "engine-load-settled",
          "effects": [
            {
              "emit": "session-init-requested",
              "payload": {
                "persistent": "persistentFlag",
                "project": "project"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "engine-module-flow",
      "name": "Engine module: load the WebAssembly",
      "subject": "simulation-engine",
      "description": "initEngine of src/core/engine.js in a page: asynchronous; it fails when src/engine/pkg has not been built.",
      "initial": "engine-unloaded",
      "variables": [
        {
          "name": "built",
          "type": "boolean",
          "initial": true
        },
        {
          "name": "loaded",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "engine-unloaded",
          "name": "Not loaded"
        },
        {
          "id": "engine-settled",
          "name": "Loaded or failed"
        }
      ],
      "transitions": [
        {
          "id": "engine-module-missing",
          "from": "engine-unloaded",
          "to": "engine-unloaded",
          "on": "engine-not-built",
          "effects": [
            {
              "set": "built",
              "to": false
            }
          ]
        },
        {
          "id": "engine-module-load",
          "from": "engine-unloaded",
          "to": "engine-settled",
          "on": "engine-load-requested",
          "effects": [
            {
              "set": "loaded",
              "to": "built"
            },
            {
              "emit": "engine-load-settled",
              "payload": {
                "ok": "built"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "traffic-recorder-flow",
      "name": "Traffic recorder: count each recorded write event",
      "subject": "traffic-recorder",
      "description": "Every request and answer of a write that the persistence client sees is one recorded entry. traffic-step-recorded stands for the append to the stream; no real run produces it as an event (recording the recording would feed itself), so this machine is not part of live-session.",
      "initial": "recorder-on",
      "variables": [
        {
          "name": "lines",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "recorder-on",
          "name": "Recording"
        }
      ],
      "transitions": [
        {
          "id": "recorder-request",
          "from": "recorder-on",
          "to": "recorder-on",
          "on": "write-file-request",
          "effects": [
            {
              "set": "lines",
              "to": "lines + 1"
            },
            {
              "emit": "traffic-step-recorded",
              "payload": {
                "event": "'write-file-request'"
              }
            }
          ]
        },
        {
          "id": "recorder-ok",
          "from": "recorder-on",
          "to": "recorder-on",
          "on": "write-file-ok",
          "effects": [
            {
              "set": "lines",
              "to": "lines + 1"
            },
            {
              "emit": "traffic-step-recorded",
              "payload": {
                "event": "'write-file-ok'"
              }
            }
          ]
        },
        {
          "id": "recorder-conflict",
          "from": "recorder-on",
          "to": "recorder-on",
          "on": "write-file-conflict",
          "effects": [
            {
              "set": "lines",
              "to": "lines + 1"
            },
            {
              "emit": "traffic-step-recorded",
              "payload": {
                "event": "'write-file-conflict'"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "sim-session-flow",
      "name": "Session: load a scenario, adopt its trace, step through it",
      "subject": "session",
      "description": "loadSim and the cursor of src/app/session.js: a load takes a new token and hands the engine input to the runner; a trace is adopted only if its token is still the current one; step, back and run to end move stepIndex within the revealed steps. stepCount stands for the length of the finished trace.",
      "initial": "sim-idle",
      "variables": [
        {
          "name": "token",
          "type": "number",
          "initial": 0
        },
        {
          "name": "adoptedToken",
          "type": "number",
          "initial": 0
        },
        {
          "name": "scenarioId",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "stepIndex",
          "type": "number",
          "initial": -1
        },
        {
          "name": "stepCount",
          "type": "number",
          "initial": 0
        },
        {
          "name": "running",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "sim-idle",
          "name": "Simulation panel"
        }
      ],
      "transitions": [
        {
          "id": "sim-load",
          "from": "sim-idle",
          "to": "sim-idle",
          "on": "sim-load-requested",
          "effects": [
            {
              "set": "token",
              "to": "token + 1"
            },
            {
              "set": "scenarioId",
              "to": "event.scenario"
            },
            {
              "set": "running",
              "to": true
            },
            {
              "set": "stepIndex",
              "to": -1
            },
            {
              "set": "stepCount",
              "to": 0
            },
            {
              "emit": "engine-run-intent",
              "payload": {
                "token": "token",
                "scenario": "event.scenario"
              }
            }
          ]
        },
        {
          "id": "sim-adopt-stale",
          "from": "sim-idle",
          "to": "sim-idle",
          "on": "sim-trace-ready",
          "faultOnly": true,
          "description": "A defect the code must not have. the trace is adopted without comparing its token with the current one.",
          "effects": [
            {
              "set": "adoptedToken",
              "to": "event.token"
            },
            {
              "set": "running",
              "to": false
            },
            {
              "set": "stepCount",
              "to": "event.steps"
            },
            {
              "set": "stepIndex",
              "to": -1
            }
          ]
        },
        {
          "id": "sim-adopt",
          "from": "sim-idle",
          "to": "sim-idle",
          "on": "sim-trace-ready",
          "guard": "event.token == token",
          "description": "createTraceCursor(trace); a trace whose token is stale matches no transition and is discarded.",
          "effects": [
            {
              "set": "adoptedToken",
              "to": "event.token"
            },
            {
              "set": "running",
              "to": false
            },
            {
              "set": "stepCount",
              "to": "event.steps"
            },
            {
              "set": "stepIndex",
              "to": -1
            }
          ]
        },
        {
          "id": "sim-failed",
          "from": "sim-idle",
          "to": "sim-idle",
          "on": "sim-run-failed",
          "guard": "event.token == token",
          "effects": [
            {
              "set": "running",
              "to": false
            },
            {
              "set": "scenarioId",
              "to": "'none'"
            }
          ]
        },
        {
          "id": "sim-step-past-end",
          "from": "sim-idle",
          "to": "sim-idle",
          "on": "sim-step-requested",
          "guard": "stepCount > 0",
          "faultOnly": true,
          "description": "A defect the code must not have. a step is taken past the last recorded step.",
          "effects": [
            {
              "set": "stepIndex",
              "to": "stepIndex + 1"
            },
            {
              "emit": "sim-step-shown",
              "payload": {
                "stepIndex": "stepIndex"
              }
            }
          ]
        },
        {
          "id": "sim-step",
          "from": "sim-idle",
          "to": "sim-idle",
          "on": "sim-step-requested",
          "guard": "stepIndex < stepCount - 1",
          "effects": [
            {
              "set": "stepIndex",
              "to": "stepIndex + 1"
            },
            {
              "emit": "sim-step-shown",
              "payload": {
                "stepIndex": "stepIndex"
              }
            }
          ]
        },
        {
          "id": "sim-step-at-end",
          "from": "sim-idle",
          "to": "sim-idle",
          "on": "sim-step-requested",
          "guard": "stepCount > 0",
          "description": "At the last step simStep stops playback and changes nothing.",
          "effects": [
            {
              "set": "running",
              "to": false
            }
          ]
        },
        {
          "id": "sim-back",
          "from": "sim-idle",
          "to": "sim-idle",
          "on": "sim-back-requested",
          "guard": "stepIndex >= 0",
          "description": "No pulse: simChanged(false).",
          "effects": [
            {
              "set": "stepIndex",
              "to": "stepIndex - 1"
            }
          ]
        },
        {
          "id": "sim-run-to-end",
          "from": "sim-idle",
          "to": "sim-idle",
          "on": "sim-run-to-end-requested",
          "guard": "stepCount > 0",
          "effects": [
            {
              "set": "stepIndex",
              "to": "stepCount - 1"
            }
          ]
        },
        {
          "id": "sim-reset",
          "from": "sim-idle",
          "to": "sim-idle",
          "on": "sim-reset-requested",
          "guard": "stepCount > 0",
          "effects": [
            {
              "set": "stepIndex",
              "to": -1
            }
          ]
        },
        {
          "id": "sim-seek",
          "from": "sim-idle",
          "to": "sim-idle",
          "on": "sim-seek-requested",
          "guard": "stepCount > 0",
          "effects": [
            {
              "set": "stepIndex",
              "to": "event.stepIndex"
            }
          ]
        },
        {
          "id": "sim-project-opened",
          "from": "sim-idle",
          "to": "sim-idle",
          "on": "project-opened",
          "effects": [
            {
              "set": "token",
              "to": "token + 1"
            },
            {
              "set": "scenarioId",
              "to": "'none'"
            },
            {
              "set": "stepIndex",
              "to": -1
            },
            {
              "set": "stepCount",
              "to": 0
            }
          ]
        }
      ]
    },
    {
      "id": "engine-runner-flow",
      "name": "Engine runner: one job at a time in the worker",
      "subject": "simulation-engine",
      "description": "run() of src/app/engine-runner.js: a run while another is waiting stops the worker (terminate, waiting cleared) and starts a new one; a reply is matched by id to the waiting job; when the worker cannot load, the waiting job reruns on the main thread. prevId and prevToken exist only for the defect that keeps a replaced job.",
      "initial": "runner-ready",
      "variables": [
        {
          "name": "seq",
          "type": "number",
          "initial": 0
        },
        {
          "name": "waitingId",
          "type": "number",
          "initial": 0
        },
        {
          "name": "waitingToken",
          "type": "number",
          "initial": 0
        },
        {
          "name": "prevId",
          "type": "number",
          "initial": 0
        },
        {
          "name": "prevToken",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "runner-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "runner-keep-stale-job",
          "from": "runner-ready",
          "to": "runner-ready",
          "on": "engine-run-intent",
          "guard": "waitingId != 0",
          "faultOnly": true,
          "description": "A defect the code must not have. a new run leaves the worker running and keeps the replaced job.",
          "effects": [
            {
              "set": "prevId",
              "to": "waitingId"
            },
            {
              "set": "prevToken",
              "to": "waitingToken"
            },
            {
              "set": "seq",
              "to": "seq + 1"
            },
            {
              "set": "waitingId",
              "to": "seq"
            },
            {
              "set": "waitingToken",
              "to": "event.token"
            },
            {
              "emit": "engine-run-posted",
              "payload": {
                "id": "seq",
                "input": "event.scenario"
              }
            }
          ]
        },
        {
          "id": "runner-restart",
          "from": "runner-ready",
          "to": "runner-ready",
          "on": "engine-run-intent",
          "guard": "waitingId != 0",
          "description": "stop(): worker.terminate() and waiting.clear(), then a new worker gets the job.",
          "effects": [
            {
              "set": "seq",
              "to": "seq + 1"
            },
            {
              "set": "waitingId",
              "to": "seq"
            },
            {
              "set": "waitingToken",
              "to": "event.token"
            },
            {
              "emit": "worker-terminated"
            },
            {
              "emit": "engine-run-posted",
              "payload": {
                "id": "seq",
                "input": "event.scenario"
              }
            }
          ]
        },
        {
          "id": "runner-post",
          "from": "runner-ready",
          "to": "runner-ready",
          "on": "engine-run-intent",
          "effects": [
            {
              "set": "seq",
              "to": "seq + 1"
            },
            {
              "set": "waitingId",
              "to": "seq"
            },
            {
              "set": "waitingToken",
              "to": "event.token"
            },
            {
              "emit": "engine-run-posted",
              "payload": {
                "id": "seq",
                "input": "event.scenario"
              }
            }
          ]
        },
        {
          "id": "runner-forward-stale",
          "from": "runner-ready",
          "to": "runner-ready",
          "on": "engine-run-returned",
          "guard": "prevId != 0 && event.id == prevId",
          "faultOnly": true,
          "description": "Part of the defect runner-keeps-stale-job: the replaced job is still answered.",
          "effects": [
            {
              "emit": "sim-trace-ready",
              "payload": {
                "token": "prevToken",
                "steps": 3
              }
            }
          ]
        },
        {
          "id": "runner-forward",
          "from": "runner-ready",
          "to": "runner-ready",
          "on": "engine-run-returned",
          "guard": "event.id == waitingId",
          "description": "A reply whose id is not waiting is ignored.",
          "effects": [
            {
              "set": "waitingId",
              "to": 0
            },
            {
              "emit": "sim-trace-ready",
              "payload": {
                "token": "waitingToken",
                "steps": 3
              }
            }
          ]
        },
        {
          "id": "runner-refused",
          "from": "runner-ready",
          "to": "runner-ready",
          "on": "engine-run-refused",
          "guard": "event.id == waitingId",
          "effects": [
            {
              "set": "waitingId",
              "to": 0
            },
            {
              "emit": "sim-run-failed",
              "payload": {
                "token": "waitingToken"
              }
            }
          ]
        },
        {
          "id": "runner-main-thread",
          "from": "runner-ready",
          "to": "runner-ready",
          "on": "worker-load-failed",
          "guard": "waitingId != 0",
          "description": "worker.onerror: the waiting job reruns with runEngine on the main thread, and every later run too.",
          "effects": [
            {
              "set": "waitingId",
              "to": 0
            },
            {
              "emit": "sim-trace-ready",
              "payload": {
                "token": "waitingToken",
                "steps": 3
              }
            }
          ]
        }
      ]
    },
    {
      "id": "engine-worker-flow",
      "name": "Engine worker: run an input, reply with its trace",
      "subject": "simulation-engine",
      "description": "src/app/engine-worker.js: one run per message, answered with the same id. A terminated worker answers nothing: generation counts terminations and a run of an earlier generation is never answered.",
      "initial": "worker-ready",
      "variables": [
        {
          "name": "generation",
          "type": "number",
          "initial": 0
        },
        {
          "name": "runs",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "worker-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "worker-run",
          "from": "worker-ready",
          "to": "worker-ready",
          "on": "engine-run-posted",
          "effects": [
            {
              "set": "runs",
              "to": "runs + 1"
            },
            {
              "emit": "worker-run-done",
              "after": 2,
              "payload": {
                "id": "event.id",
                "input": "event.input",
                "generation": "generation"
              }
            }
          ]
        },
        {
          "id": "worker-terminate",
          "from": "worker-ready",
          "to": "worker-ready",
          "on": "worker-terminated",
          "effects": [
            {
              "set": "generation",
              "to": "generation + 1"
            }
          ]
        },
        {
          "id": "worker-reply",
          "from": "worker-ready",
          "to": "worker-ready",
          "on": "worker-run-done",
          "guard": "event.generation == generation",
          "effects": [
            {
              "emit": "engine-run-returned",
              "payload": {
                "id": "event.id",
                "ok": true,
                "trace": "event.input"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "scene-pulse-flow",
      "name": "Scene: pulse the step just taken",
      "subject": "visual-interaction",
      "description": "The sim listener of src/app/main.js: a step announced with pulse true pulses its responsible entities and fired transitions and draws its message flow; a step back, a seek or a run to the end does not pulse.",
      "initial": "pulse-ready",
      "variables": [
        {
          "name": "pulsedStep",
          "type": "number",
          "initial": -1
        },
        {
          "name": "pulses",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "pulse-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "pulse-step",
          "from": "pulse-ready",
          "to": "pulse-ready",
          "on": "sim-step-shown",
          "effects": [
            {
              "set": "pulsedStep",
              "to": "event.stepIndex"
            },
            {
              "set": "pulses",
              "to": "pulses + 1"
            },
            {
              "emit": "step-pulsed",
              "payload": {
                "stepIndex": "event.stepIndex"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "interaction-prefs-flow",
      "name": "Session: remember and restore interaction state",
      "subject": "session",
      "description": "persistUi and the restore in session.open (src/app/session.js): every selection or view change writes the whole store to localStorage; after a reload the remembered selection and view come back (ids that no longer exist are dropped, not modelled).",
      "initial": "prefs-live",
      "variables": [
        {
          "name": "selection",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "viewId",
          "type": "string",
          "initial": "structural"
        },
        {
          "name": "restored",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "prefs-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "prefs-select",
          "from": "prefs-live",
          "to": "prefs-live",
          "on": "entity-selected",
          "effects": [
            {
              "set": "selection",
              "to": "event.id"
            },
            {
              "emit": "preferences-written",
              "payload": {
                "selection": "event.id",
                "viewId": "viewId"
              }
            }
          ]
        },
        {
          "id": "prefs-view",
          "from": "prefs-live",
          "to": "prefs-live",
          "on": "view-switched",
          "effects": [
            {
              "set": "viewId",
              "to": "event.view"
            },
            {
              "emit": "preferences-written",
              "payload": {
                "selection": "selection",
                "viewId": "event.view"
              }
            }
          ],
          "guard": "event.view != viewId"
        },
        {
          "id": "prefs-reload",
          "from": "prefs-live",
          "to": "prefs-live",
          "on": "page-reloaded",
          "description": "In-memory state is gone; loadStore reads exegra.session.",
          "effects": [
            {
              "set": "selection",
              "to": "'none'"
            },
            {
              "set": "viewId",
              "to": "'structural'"
            },
            {
              "set": "restored",
              "to": false
            },
            {
              "emit": "preferences-read"
            }
          ]
        },
        {
          "id": "prefs-restore",
          "from": "prefs-live",
          "to": "prefs-live",
          "on": "preferences-loaded",
          "effects": [
            {
              "set": "selection",
              "to": "event.selection"
            },
            {
              "set": "viewId",
              "to": "event.viewId"
            },
            {
              "set": "restored",
              "to": true
            }
          ]
        }
      ]
    },
    {
      "id": "responsive-layout-flow",
      "name": "Responsive layout: remember the panel arrangement",
      "subject": "responsive-layout",
      "description": "persist() of src/ui/layout.js writes exegra.layout on every open, close or resize of a panel.",
      "initial": "layout-prefs-live",
      "variables": [
        {
          "name": "explorerOpen",
          "type": "boolean",
          "initial": true
        }
      ],
      "states": [
        {
          "id": "layout-prefs-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "layout-prefs-toggle",
          "from": "layout-prefs-live",
          "to": "layout-prefs-live",
          "on": "panel-toggled",
          "effects": [
            {
              "set": "explorerOpen",
              "to": "event.open"
            },
            {
              "emit": "layout-preferences-written",
              "payload": {
                "explorerOpen": "event.open"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "local-storage-flow",
      "name": "Browser localStorage: the two Exegra keys",
      "subject": "browser-storage",
      "description": "localStorage of the browser profile: exegra.session (session preferences) and exegra.layout (responsive layout). A write that the browser refuses (storage unavailable) is caught and lost.",
      "initial": "storage-ready",
      "variables": [
        {
          "name": "storedSelection",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "storedView",
          "type": "string",
          "initial": "structural"
        },
        {
          "name": "storedExplorerOpen",
          "type": "boolean",
          "initial": true
        }
      ],
      "states": [
        {
          "id": "storage-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "storage-write-session",
          "from": "storage-ready",
          "to": "storage-ready",
          "on": "preferences-written",
          "effects": [
            {
              "set": "storedSelection",
              "to": "event.selection"
            },
            {
              "set": "storedView",
              "to": "event.viewId"
            }
          ]
        },
        {
          "id": "storage-read-session",
          "from": "storage-ready",
          "to": "storage-ready",
          "on": "preferences-read",
          "effects": [
            {
              "emit": "preferences-loaded",
              "payload": {
                "selection": "storedSelection",
                "viewId": "storedView"
              }
            }
          ]
        },
        {
          "id": "storage-write-layout",
          "from": "storage-ready",
          "to": "storage-ready",
          "on": "layout-preferences-written",
          "effects": [
            {
              "set": "storedExplorerOpen",
              "to": "event.explorerOpen"
            }
          ]
        }
      ]
    },
    {
      "id": "camera-memory-flow",
      "name": "Camera memory: save per view, restore on switch",
      "subject": "visual-interaction",
      "description": "saveCamera and pushScene of src/app/main.js: pointer-up and wheel save the camera under the current project and view; a view switch first restores the camera stored for the new view (once per key), then saveCamera stores the current camera under the new view. A view with nothing stored therefore inherits, and stores, the previous view's camera.",
      "initial": "camera-live",
      "variables": [
        {
          "name": "view",
          "type": "string",
          "initial": "structural"
        },
        {
          "name": "current",
          "type": "string",
          "initial": "c0"
        }
      ],
      "states": [
        {
          "id": "camera-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "camera-move",
          "from": "camera-live",
          "to": "camera-live",
          "on": "camera-moved",
          "effects": [
            {
              "set": "current",
              "to": "event.camera"
            },
            {
              "emit": "camera-saved",
              "payload": {
                "view": "view",
                "camera": "event.camera"
              }
            }
          ]
        },
        {
          "id": "camera-switch",
          "from": "camera-live",
          "to": "camera-live",
          "on": "view-switched",
          "effects": [
            {
              "set": "view",
              "to": "event.view"
            },
            {
              "emit": "camera-restore-requested",
              "payload": {
                "view": "event.view"
              }
            }
          ]
        },
        {
          "id": "camera-apply",
          "from": "camera-live",
          "to": "camera-live",
          "on": "camera-restored",
          "effects": [
            {
              "set": "current",
              "to": "event.camera"
            },
            {
              "emit": "camera-saved",
              "payload": {
                "view": "event.view",
                "camera": "event.camera"
              }
            }
          ]
        },
        {
          "id": "camera-keep",
          "from": "camera-live",
          "to": "camera-live",
          "on": "camera-none",
          "effects": [
            {
              "emit": "camera-saved",
              "payload": {
                "view": "event.view",
                "camera": "current"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "session-storage-flow",
      "name": "Browser sessionStorage: camera per project and view",
      "subject": "browser-storage",
      "description": "sessionStorage keys exegra.camera.<project>.<view> for two views of one project; gone when the tab closes. One camera per view: structuralCamera and dataCamera for the two views the scenarios use, and one variable per view this specification declares (cameraArchitecture, ...), because the real store keys the camera by project and view.",
      "initial": "tab-storage-ready",
      "variables": [
        {
          "name": "structuralCamera",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "dataCamera",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "cameraArchitecture",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "cameraRealisation",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "cameraDataAndEditFlow",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "cameraSemanticCoreOnly",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "cameraClaims",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "cameraBehavior",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "cameraReferences",
          "type": "string",
          "initial": "none"
        }
      ],
      "states": [
        {
          "id": "tab-storage-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "tab-storage-save-structural",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-saved",
          "guard": "event.view == 'structural'",
          "effects": [
            {
              "set": "structuralCamera",
              "to": "event.camera"
            }
          ]
        },
        {
          "id": "tab-storage-save-data",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-saved",
          "guard": "event.view == 'data'",
          "effects": [
            {
              "set": "dataCamera",
              "to": "event.camera"
            }
          ]
        },
        {
          "id": "tab-storage-restore-structural",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-restore-requested",
          "guard": "event.view == 'structural' && structuralCamera != 'none'",
          "effects": [
            {
              "emit": "camera-restored",
              "payload": {
                "view": "event.view",
                "camera": "structuralCamera"
              }
            }
          ]
        },
        {
          "id": "tab-storage-restore-data",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-restore-requested",
          "guard": "event.view == 'data' && dataCamera != 'none'",
          "effects": [
            {
              "emit": "camera-restored",
              "payload": {
                "view": "event.view",
                "camera": "dataCamera"
              }
            }
          ]
        },
        {
          "id": "tab-storage-save-architecture",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-saved",
          "guard": "event.view == 'architecture'",
          "effects": [
            {
              "set": "cameraArchitecture",
              "to": "event.camera"
            }
          ]
        },
        {
          "id": "tab-storage-restore-architecture",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-restore-requested",
          "guard": "event.view == 'architecture' && cameraArchitecture != 'none'",
          "effects": [
            {
              "emit": "camera-restored",
              "payload": {
                "view": "event.view",
                "camera": "cameraArchitecture"
              }
            }
          ]
        },
        {
          "id": "tab-storage-save-realisation",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-saved",
          "guard": "event.view == 'realisation'",
          "effects": [
            {
              "set": "cameraRealisation",
              "to": "event.camera"
            }
          ]
        },
        {
          "id": "tab-storage-restore-realisation",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-restore-requested",
          "guard": "event.view == 'realisation' && cameraRealisation != 'none'",
          "effects": [
            {
              "emit": "camera-restored",
              "payload": {
                "view": "event.view",
                "camera": "cameraRealisation"
              }
            }
          ]
        },
        {
          "id": "tab-storage-save-data-and-edit-flow",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-saved",
          "guard": "event.view == 'data-and-edit-flow'",
          "effects": [
            {
              "set": "cameraDataAndEditFlow",
              "to": "event.camera"
            }
          ]
        },
        {
          "id": "tab-storage-restore-data-and-edit-flow",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-restore-requested",
          "guard": "event.view == 'data-and-edit-flow' && cameraDataAndEditFlow != 'none'",
          "effects": [
            {
              "emit": "camera-restored",
              "payload": {
                "view": "event.view",
                "camera": "cameraDataAndEditFlow"
              }
            }
          ]
        },
        {
          "id": "tab-storage-save-semantic-core-only",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-saved",
          "guard": "event.view == 'semantic-core-only'",
          "effects": [
            {
              "set": "cameraSemanticCoreOnly",
              "to": "event.camera"
            }
          ]
        },
        {
          "id": "tab-storage-restore-semantic-core-only",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-restore-requested",
          "guard": "event.view == 'semantic-core-only' && cameraSemanticCoreOnly != 'none'",
          "effects": [
            {
              "emit": "camera-restored",
              "payload": {
                "view": "event.view",
                "camera": "cameraSemanticCoreOnly"
              }
            }
          ]
        },
        {
          "id": "tab-storage-save-claims",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-saved",
          "guard": "event.view == 'claims'",
          "effects": [
            {
              "set": "cameraClaims",
              "to": "event.camera"
            }
          ]
        },
        {
          "id": "tab-storage-restore-claims",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-restore-requested",
          "guard": "event.view == 'claims' && cameraClaims != 'none'",
          "effects": [
            {
              "emit": "camera-restored",
              "payload": {
                "view": "event.view",
                "camera": "cameraClaims"
              }
            }
          ]
        },
        {
          "id": "tab-storage-save-behavior",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-saved",
          "guard": "event.view == 'behavior'",
          "effects": [
            {
              "set": "cameraBehavior",
              "to": "event.camera"
            }
          ]
        },
        {
          "id": "tab-storage-restore-behavior",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-restore-requested",
          "guard": "event.view == 'behavior' && cameraBehavior != 'none'",
          "effects": [
            {
              "emit": "camera-restored",
              "payload": {
                "view": "event.view",
                "camera": "cameraBehavior"
              }
            }
          ]
        },
        {
          "id": "tab-storage-save-references",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-saved",
          "guard": "event.view == 'references'",
          "effects": [
            {
              "set": "cameraReferences",
              "to": "event.camera"
            }
          ]
        },
        {
          "id": "tab-storage-restore-references",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-restore-requested",
          "guard": "event.view == 'references' && cameraReferences != 'none'",
          "effects": [
            {
              "emit": "camera-restored",
              "payload": {
                "view": "event.view",
                "camera": "cameraReferences"
              }
            }
          ]
        },
        {
          "id": "tab-storage-nothing",
          "from": "tab-storage-ready",
          "to": "tab-storage-ready",
          "on": "camera-restore-requested",
          "effects": [
            {
              "emit": "camera-none",
              "payload": {
                "view": "event.view"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "cli-process-flow",
      "name": "Agent command line: one command per process",
      "subject": "agent-cli",
      "description": "runCommand of cli/commands.js for apply, verify and trace: the project is read once (loadProject, tools/workspace.js read()); apply runs Project.apply in process and writes the spec, then the layout, each with the hash read at the start; verify runs the test evidence, records the results and re-evaluates the claims; trace runs the engine in process and writes the trace file. One envelope answers the invocation. The texts apply produces are fixed here (h2, L2): the transaction itself is the edit-flow model.",
      "initial": "cli-idle",
      "variables": [
        {
          "name": "command",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "option",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "reqId",
          "type": "number",
          "initial": 0
        },
        {
          "name": "specRead",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "layoutRead",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "wroteSpec",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "reportedOk",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "reportedFailure",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "failureNotesSpecWritten",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "engineOk",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "traceWritten",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "cli-idle",
          "name": "Not started"
        },
        {
          "id": "cli-loading",
          "name": "Reading the project"
        },
        {
          "id": "cli-applying",
          "name": "Writing the specification"
        },
        {
          "id": "cli-writing-layout",
          "name": "Writing the layout"
        },
        {
          "id": "cli-verifying",
          "name": "Running the evidence"
        },
        {
          "id": "cli-tracing",
          "name": "Running the engine"
        },
        {
          "id": "cli-done",
          "name": "Envelope written",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "cli-start",
          "from": "cli-idle",
          "to": "cli-loading",
          "on": "cli-command-request",
          "effects": [
            {
              "set": "command",
              "to": "event.command"
            },
            {
              "set": "option",
              "to": "event.options"
            },
            {
              "set": "reqId",
              "to": "event.requestId"
            },
            {
              "emit": "ws-read",
              "payload": {
                "name": "'exegra'",
                "caller": "'cli'",
                "requestId": "event.requestId"
              }
            }
          ]
        },
        {
          "id": "cli-apply-read",
          "from": "cli-loading",
          "to": "cli-applying",
          "on": "ws-read-done",
          "guard": "event.caller == 'cli' && command == 'apply'",
          "description": "Project.apply (origin cli) commits both texts in memory; the write follows (two ticks: the window in which another process can change the files).",
          "effects": [
            {
              "set": "specRead",
              "to": "event.spec"
            },
            {
              "set": "layoutRead",
              "to": "event.layout"
            },
            {
              "emit": "ws-write",
              "after": 2,
              "payload": {
                "name": "'exegra'",
                "file": "'spec'",
                "text": "'h2'",
                "baseHash": "event.spec",
                "caller": "'cli'",
                "requestId": "reqId"
              }
            }
          ]
        },
        {
          "id": "cli-apply-spec-written",
          "from": "cli-applying",
          "to": "cli-writing-layout",
          "on": "ws-write-done",
          "guard": "event.caller == 'cli'",
          "effects": [
            {
              "set": "wroteSpec",
              "to": true
            },
            {
              "emit": "ws-write",
              "payload": {
                "name": "'exegra'",
                "file": "'layout'",
                "text": "'L2'",
                "baseHash": "layoutRead",
                "caller": "'cli'",
                "requestId": "reqId"
              }
            }
          ]
        },
        {
          "id": "cli-apply-spec-conflict",
          "from": "cli-applying",
          "to": "cli-done",
          "on": "ws-write-conflict",
          "guard": "event.caller == 'cli'",
          "description": "Nothing was written.",
          "effects": [
            {
              "set": "reportedFailure",
              "to": true
            },
            {
              "emit": "cli-command-failed",
              "payload": {
                "code": "'write.conflict'",
                "command": "command",
                "requestId": "reqId",
                "specWritten": false
              }
            }
          ]
        },
        {
          "id": "cli-apply-written",
          "from": "cli-writing-layout",
          "to": "cli-done",
          "on": "ws-write-done",
          "guard": "event.caller == 'cli'",
          "effects": [
            {
              "set": "reportedOk",
              "to": true
            },
            {
              "emit": "cli-command-ok",
              "payload": {
                "ok": true,
                "command": "command",
                "project": "'exegra'",
                "semanticHash": "'m2'",
                "result": "'written: spec, layout'",
                "requestId": "reqId"
              }
            }
          ]
        },
        {
          "id": "cli-apply-ok-after-layout-conflict",
          "from": "cli-writing-layout",
          "to": "cli-done",
          "on": "ws-write-conflict",
          "guard": "event.caller == 'cli'",
          "faultOnly": true,
          "description": "A defect the code must not have. the apply reports success after the layout write conflicted.",
          "effects": [
            {
              "set": "reportedOk",
              "to": true
            },
            {
              "emit": "cli-command-ok",
              "payload": {
                "ok": true,
                "command": "command",
                "project": "'exegra'",
                "semanticHash": "'m2'",
                "result": "'written: spec'",
                "requestId": "reqId"
              }
            }
          ]
        },
        {
          "id": "cli-apply-failure-omits-spec",
          "from": "cli-writing-layout",
          "to": "cli-done",
          "on": "ws-write-conflict",
          "guard": "event.caller == 'cli'",
          "faultOnly": true,
          "description": "A defect the code must not have. the failure does not say that the specification was already written.",
          "effects": [
            {
              "set": "reportedFailure",
              "to": true
            },
            {
              "emit": "cli-command-failed",
              "payload": {
                "code": "'write.conflict'",
                "command": "command",
                "requestId": "reqId",
                "specWritten": false
              }
            }
          ]
        },
        {
          "id": "cli-apply-layout-conflict",
          "from": "cli-writing-layout",
          "to": "cli-done",
          "on": "ws-write-conflict",
          "guard": "event.caller == 'cli'",
          "description": "\"layout.jsonc changed on disk since it was read. The specification was already written; the layout was not.\" The spec write and its journal line stay.",
          "effects": [
            {
              "set": "reportedFailure",
              "to": true
            },
            {
              "set": "failureNotesSpecWritten",
              "to": "wroteSpec"
            },
            {
              "emit": "cli-command-failed",
              "payload": {
                "code": "'write.conflict'",
                "command": "command",
                "requestId": "reqId",
                "specWritten": "wroteSpec"
              }
            }
          ]
        },
        {
          "id": "cli-verify-read",
          "from": "cli-loading",
          "to": "cli-verifying",
          "on": "ws-read-done",
          "guard": "event.caller == 'cli' && command == 'verify'",
          "description": "Validation and traceability, then the test evidence.",
          "effects": [
            {
              "emit": "verify-tests-run",
              "payload": {
                "count": 2
              }
            }
          ]
        },
        {
          "id": "cli-verify-report-early",
          "from": "cli-verifying",
          "to": "cli-verifying",
          "on": "verify-tests-finished",
          "faultOnly": true,
          "description": "A defect the code must not have. verify reports before the results are recorded.",
          "effects": [
            {
              "set": "reportedOk",
              "to": true
            },
            {
              "emit": "cli-command-ok",
              "payload": {
                "ok": true,
                "command": "command",
                "project": "'exegra'",
                "semanticHash": "'m1'",
                "result": "'verified'",
                "requestId": "reqId"
              }
            },
            {
              "emit": "ws-write-recorded",
              "payload": {
                "version": "'r2'"
              }
            }
          ]
        },
        {
          "id": "cli-verify-record",
          "from": "cli-verifying",
          "to": "cli-verifying",
          "on": "verify-tests-finished",
          "description": "writeRecorded replaces evidence/results.json (results and traceability, the other keys kept).",
          "effects": [
            {
              "emit": "ws-write-recorded",
              "payload": {
                "version": "'r2'"
              }
            }
          ]
        },
        {
          "id": "cli-verify-recorded",
          "from": "cli-verifying",
          "to": "cli-verifying",
          "on": "ws-recorded-done",
          "guard": "!reportedOk",
          "effects": [
            {
              "emit": "verify-claims-evaluated"
            }
          ]
        },
        {
          "id": "cli-verify-done",
          "from": "cli-verifying",
          "to": "cli-done",
          "on": "verify-claims-evaluated",
          "effects": [
            {
              "set": "reportedOk",
              "to": true
            },
            {
              "emit": "cli-command-ok",
              "payload": {
                "ok": true,
                "command": "command",
                "project": "'exegra'",
                "semanticHash": "'m1'",
                "result": "'verified'",
                "requestId": "reqId"
              }
            }
          ]
        },
        {
          "id": "cli-trace-read",
          "from": "cli-loading",
          "to": "cli-tracing",
          "on": "ws-read-done",
          "guard": "event.caller == 'cli' && command == 'trace'",
          "description": "runTrace: runScenario in process.",
          "effects": [
            {
              "emit": "engine-run-called",
              "payload": {
                "scenario": "option"
              }
            }
          ]
        },
        {
          "id": "cli-trace-run",
          "from": "cli-tracing",
          "to": "cli-tracing",
          "on": "engine-run-finished",
          "effects": [
            {
              "set": "engineOk",
              "to": true
            },
            {
              "emit": "trace-file-written",
              "payload": {
                "path": "'trace.json'"
              }
            }
          ]
        },
        {
          "id": "cli-trace-written-on-refusal",
          "from": "cli-tracing",
          "to": "cli-tracing",
          "on": "engine-run-failed",
          "faultOnly": true,
          "description": "A defect the code must not have. the trace file is written although the engine refused the run.",
          "effects": [
            {
              "emit": "trace-file-written",
              "payload": {
                "path": "'trace.json'"
              }
            }
          ]
        },
        {
          "id": "cli-trace-engine-refused",
          "from": "cli-tracing",
          "to": "cli-done",
          "on": "engine-run-failed",
          "effects": [
            {
              "set": "reportedFailure",
              "to": true
            },
            {
              "emit": "cli-command-failed",
              "payload": {
                "code": "'simulate.failed'",
                "command": "command",
                "requestId": "reqId",
                "specWritten": false
              }
            }
          ]
        },
        {
          "id": "cli-trace-file",
          "from": "cli-tracing",
          "to": "cli-done",
          "on": "trace-file-written",
          "effects": [
            {
              "set": "traceWritten",
              "to": true
            },
            {
              "set": "reportedOk",
              "to": "engineOk"
            },
            {
              "emit": "cli-command-ok",
              "payload": {
                "ok": true,
                "command": "command",
                "project": "'exegra'",
                "semanticHash": "'m1'",
                "result": "'written: trace.json'",
                "requestId": "reqId"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "test-runner-flow",
      "name": "Test runner: execute the test evidence",
      "subject": "test-suites",
      "description": "runTestReference of cli/commands.js: node --test or npx playwright test per evidence reference, in a subprocess.",
      "initial": "tests-ready",
      "variables": [
        {
          "name": "runs",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "tests-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "tests-run",
          "from": "tests-ready",
          "to": "tests-ready",
          "on": "verify-tests-run",
          "effects": [
            {
              "set": "runs",
              "to": "runs + event.count"
            },
            {
              "emit": "verify-tests-finished",
              "after": 1,
              "payload": {
                "passed": "event.count",
                "failed": 0
              }
            }
          ]
        }
      ]
    },
    {
      "id": "engine-call-flow",
      "name": "Engine in process: run a scenario for the command line",
      "subject": "simulation-engine",
      "description": "runScenario of src/core/engine.js in Node: synchronous; it throws when src/engine/pkg has not been built.",
      "initial": "engine-call-ready",
      "variables": [
        {
          "name": "built",
          "type": "boolean",
          "initial": true
        },
        {
          "name": "runs",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "engine-call-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "engine-call-missing",
          "from": "engine-call-ready",
          "to": "engine-call-ready",
          "on": "engine-not-built",
          "effects": [
            {
              "set": "built",
              "to": false
            }
          ]
        },
        {
          "id": "engine-call-run",
          "from": "engine-call-ready",
          "to": "engine-call-ready",
          "on": "engine-run-called",
          "guard": "built",
          "effects": [
            {
              "set": "runs",
              "to": "runs + 1"
            },
            {
              "emit": "engine-run-finished",
              "payload": {
                "steps": 12
              }
            }
          ]
        },
        {
          "id": "engine-call-refuse",
          "from": "engine-call-ready",
          "to": "engine-call-ready",
          "on": "engine-run-called",
          "guard": "!built",
          "description": "initEngine throws \"run npm run build:engine\".",
          "effects": [
            {
              "emit": "engine-run-failed"
            }
          ]
        }
      ]
    },
    {
      "id": "prove-flow",
      "name": "exegra prove: explore in Lean, report only what Lean accepted",
      "subject": "proof-export",
      "description": "proveScenario of tools/prove.js with the pure part in src/core/proof-export.js: lake build, exegra-lean explore, the proof file formal/generated/<scenario>.lean, lake env lean, and a result per claim only when Lean accepted its theorem.",
      "initial": "prove-idle",
      "variables": [
        {
          "name": "leanAccepted",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "reported",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "fileWritten",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "prove-idle",
          "name": "Idle"
        },
        {
          "id": "prove-building",
          "name": "Building"
        },
        {
          "id": "prove-exploring",
          "name": "Exploring"
        },
        {
          "id": "prove-checking",
          "name": "Checking in Lean"
        },
        {
          "id": "prove-done",
          "name": "Done",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "prove-start",
          "from": "prove-idle",
          "to": "prove-building",
          "on": "prove-requested",
          "effects": [
            {
              "emit": "lake-build-requested"
            }
          ]
        },
        {
          "id": "prove-explore",
          "from": "prove-building",
          "to": "prove-exploring",
          "on": "lake-build-finished",
          "effects": [
            {
              "emit": "explorer-request-sent",
              "payload": {
                "bound": 20
              }
            }
          ]
        },
        {
          "id": "prove-write",
          "from": "prove-exploring",
          "to": "prove-checking",
          "on": "explorer-result-returned",
          "effects": [
            {
              "set": "fileWritten",
              "to": true
            },
            {
              "emit": "lean-file-written",
              "payload": {
                "scenario": "'race'"
              }
            },
            {
              "emit": "lean-check-requested"
            }
          ]
        },
        {
          "id": "prove-report-unchecked",
          "from": "prove-checking",
          "to": "prove-done",
          "on": "lean-check-finished",
          "faultOnly": true,
          "description": "A defect the code must not have. the explorer's result is reported without Lean's acceptance.",
          "effects": [
            {
              "set": "reported",
              "to": true
            },
            {
              "emit": "prove-finished",
              "payload": {
                "claims": 1
              }
            }
          ]
        },
        {
          "id": "prove-report",
          "from": "prove-checking",
          "to": "prove-done",
          "on": "lean-check-finished",
          "guard": "event.accepted",
          "effects": [
            {
              "set": "leanAccepted",
              "to": true
            },
            {
              "set": "reported",
              "to": true
            },
            {
              "emit": "prove-finished",
              "payload": {
                "claims": 1
              }
            }
          ]
        },
        {
          "id": "prove-report-nothing",
          "from": "prove-checking",
          "to": "prove-done",
          "on": "lean-check-finished",
          "guard": "!event.accepted",
          "effects": [
            {
              "emit": "prove-finished",
              "payload": {
                "claims": 0
              }
            }
          ]
        }
      ]
    },
    {
      "id": "lean-toolchain-flow",
      "name": "Lean toolchain: build, explore and check",
      "subject": "formal-semantics",
      "description": "lake and exegra-lean as tools/prove.js calls them; accepts is false when the proof file does not check.",
      "initial": "lean-ready",
      "variables": [
        {
          "name": "accepts",
          "type": "boolean",
          "initial": true
        }
      ],
      "states": [
        {
          "id": "lean-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "lean-broken",
          "from": "lean-ready",
          "to": "lean-ready",
          "on": "lean-rejects-proof",
          "effects": [
            {
              "set": "accepts",
              "to": false
            }
          ]
        },
        {
          "id": "lean-build",
          "from": "lean-ready",
          "to": "lean-ready",
          "on": "lake-build-requested",
          "effects": [
            {
              "emit": "lake-build-finished"
            }
          ]
        },
        {
          "id": "lean-explore",
          "from": "lean-ready",
          "to": "lean-ready",
          "on": "explorer-request-sent",
          "effects": [
            {
              "emit": "explorer-result-returned",
              "payload": {
                "result": "'holds'"
              }
            }
          ]
        },
        {
          "id": "lean-check",
          "from": "lean-ready",
          "to": "lean-ready",
          "on": "lean-check-requested",
          "effects": [
            {
              "emit": "lean-check-finished",
              "payload": {
                "accepted": "accepts"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "markdown-import-flow",
      "name": "Markdown importer: build a specification, write it past the transactions",
      "subject": "markdown-importer",
      "description": "main of tools/import-markdown.js: reads import-map.jsonc, the Markdown tree and its git HEAD, builds the specification, checks coverage, and writes the specification with node:fs only when the coverage gate passes. The write is not a transaction and has no base-hash check or journal line; to the workspace service it is a change made outside Exegra.",
      "initial": "md-idle",
      "variables": [
        {
          "name": "coverageOk",
          "type": "boolean",
          "initial": true
        },
        {
          "name": "written",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "md-idle",
          "name": "Idle"
        },
        {
          "id": "md-done",
          "name": "Done",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "md-unmapped",
          "from": "md-idle",
          "to": "md-idle",
          "on": "markdown-source-unmapped",
          "effects": [
            {
              "set": "coverageOk",
              "to": false
            }
          ]
        },
        {
          "id": "md-build",
          "from": "md-idle",
          "to": "md-idle",
          "on": "markdown-import-run",
          "effects": [
            {
              "emit": "markdown-spec-built",
              "payload": {
                "coverage": "coverageOk"
              }
            }
          ]
        },
        {
          "id": "md-write-despite-gate",
          "from": "md-idle",
          "to": "md-done",
          "on": "markdown-spec-built",
          "faultOnly": true,
          "description": "A defect the code must not have. the specification is written although the coverage gate failed.",
          "effects": [
            {
              "set": "written",
              "to": true
            },
            {
              "emit": "disk-edited-externally",
              "payload": {
                "file": "'spec'",
                "hash": "'hmd'"
              }
            },
            {
              "emit": "markdown-report-printed"
            }
          ]
        },
        {
          "id": "md-write",
          "from": "md-idle",
          "to": "md-done",
          "on": "markdown-spec-built",
          "guard": "event.coverage",
          "effects": [
            {
              "set": "written",
              "to": true
            },
            {
              "emit": "disk-edited-externally",
              "payload": {
                "file": "'spec'",
                "hash": "'hmd'"
              }
            },
            {
              "emit": "markdown-report-printed"
            }
          ]
        },
        {
          "id": "md-refuse",
          "from": "md-idle",
          "to": "md-done",
          "on": "markdown-spec-built",
          "guard": "!event.coverage",
          "description": "The coverage report lists what is not mapped; the output is not written.",
          "effects": [
            {
              "emit": "markdown-report-printed"
            }
          ]
        }
      ]
    },
    {
      "id": "conformance-flow",
      "name": "Conformance runner: replay the goldens",
      "subject": "simulation-contract",
      "description": "tools/conformance.js: runs an engine on every golden input and compares the trace with the golden one, reporting the first differing step and field; any mismatch makes the run fail.",
      "initial": "conformance-idle",
      "variables": [
        {
          "name": "mismatches",
          "type": "number",
          "initial": 0
        },
        {
          "name": "reportedAgree",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "conformance-idle",
          "name": "Idle"
        },
        {
          "id": "conformance-done",
          "name": "Reported",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "conformance-start",
          "from": "conformance-idle",
          "to": "conformance-idle",
          "on": "conformance-run",
          "effects": [
            {
              "emit": "golden-replayed"
            }
          ]
        },
        {
          "id": "conformance-ignore-mismatch",
          "from": "conformance-idle",
          "to": "conformance-done",
          "on": "golden-compared",
          "guard": "!event.matches",
          "faultOnly": true,
          "description": "A defect the code must not have. a differing trace is reported as agreement.",
          "effects": [
            {
              "set": "mismatches",
              "to": "mismatches + 1"
            },
            {
              "set": "reportedAgree",
              "to": true
            },
            {
              "emit": "conformance-reported",
              "payload": {
                "ok": true
              }
            }
          ]
        },
        {
          "id": "conformance-agree",
          "from": "conformance-idle",
          "to": "conformance-done",
          "on": "golden-compared",
          "guard": "event.matches",
          "effects": [
            {
              "set": "reportedAgree",
              "to": true
            },
            {
              "emit": "conformance-reported",
              "payload": {
                "ok": true
              }
            }
          ]
        },
        {
          "id": "conformance-mismatch",
          "from": "conformance-idle",
          "to": "conformance-done",
          "on": "golden-compared",
          "guard": "!event.matches",
          "effects": [
            {
              "set": "mismatches",
              "to": "mismatches + 1"
            },
            {
              "emit": "conformance-reported",
              "payload": {
                "ok": false
              }
            }
          ]
        }
      ]
    },
    {
      "id": "engine-under-test-flow",
      "name": "Engine under test",
      "subject": "simulation-engine",
      "description": "The engine a conformance or differential run executes (the Rust engine through src/core/engine.js, the native exegra-sim, or exegra-lean).",
      "initial": "eut-ready",
      "variables": [
        {
          "name": "agrees",
          "type": "boolean",
          "initial": true
        }
      ],
      "states": [
        {
          "id": "eut-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "eut-diverge",
          "from": "eut-ready",
          "to": "eut-ready",
          "on": "engine-diverges",
          "effects": [
            {
              "set": "agrees",
              "to": false
            }
          ]
        },
        {
          "id": "eut-replay",
          "from": "eut-ready",
          "to": "eut-ready",
          "on": "golden-replayed",
          "effects": [
            {
              "emit": "golden-compared",
              "payload": {
                "matches": "agrees"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "differential-flow",
      "name": "Differential runner: Rust engine against the Lean semantics",
      "subject": "formal-semantics",
      "description": "tools/differential.js: every golden input and the inputs generated from a seed run through the native engine and exegra-lean; each mismatching input is saved with its result under test-results/differential/.",
      "initial": "diff-idle",
      "variables": [
        {
          "name": "saved",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "diff-idle",
          "name": "Idle"
        }
      ],
      "transitions": [
        {
          "id": "diff-run-agree",
          "from": "diff-idle",
          "to": "diff-idle",
          "on": "differential-run",
          "guard": "engine-under-test-flow.agrees"
        },
        {
          "id": "diff-run-mismatch",
          "from": "diff-idle",
          "to": "diff-idle",
          "on": "differential-run",
          "guard": "!engine-under-test-flow.agrees",
          "effects": [
            {
              "set": "saved",
              "to": "saved + 1"
            },
            {
              "emit": "differential-mismatch-saved"
            }
          ]
        }
      ]
    }
  ],

  // ---- Faults ----------------------------------------------------------------------------
  "faults": [
    { "id": "validation-fails", "name": "Candidate fails validation", "kind": "enable-transition", "transition": "validator-reject", "description": "The operation produces a specification with validation errors, so the validator rejects the candidate." },
    {
      "id": "disk-changed-externally",
      "name": "File changed on disk since it was read",
      "kind": "enable-transition",
      "transition": "workspace-detect-conflict",
      "description": "Another process changed spec.jsonc after the session last read or wrote it, so the base hash no longer matches.",
      "realises": "fm-concurrent-spec-edit"
    },
    {
      "id": "publish-lost",
      "name": "Model publication lost",
      "kind": "drop-event",
      "event": "model-published",
      "description": "The session never publishes the refreshed model, so the inspector and the source editor keep showing the old revision. A defect the edit flow must not have."
    },
    {
      "id": "refresh-before-commit",
      "name": "Refresh not caused by a commit",
      "kind": "inject-event",
      "event": "refresh-requested",
      "at": 0,
      "payload": {
        "revision": 2
      },
      "description": "The projection is refreshed from an uncommitted model. A defect the edit flow must not have."
    },
    {
      "id": "save-before-refresh",
      "name": "Write not caused by a refresh",
      "kind": "inject-event",
      "event": "save-requested",
      "at": 0,
      "payload": {
        "revision": 2
      },
      "description": "The file is written before the views were refreshed from the committed model. A defect the edit flow must not have."
    },
    {
      "id": "commit-skips-validation",
      "name": "Commit without validation",
      "kind": "enable-transition",
      "transition": "tx-commit-unvalidated",
      "description": "The transaction commits as soon as the candidate is parsed, before the validator has passed it. A defect the edit flow must not have."
    },
    {
      "id": "reject-partially-applied",
      "name": "Rejected operation partially applied",
      "kind": "enable-transition",
      "transition": "tx-reject-partially-applied",
      "description": "A rejected operation still advances the revision. A defect the edit flow must not have."
    },
    {
      "id": "rejection-refreshes",
      "name": "Rejection treated as a commit",
      "kind": "enable-transition",
      "transition": "session-refresh-on-rejection",
      "description": "The session refreshes, and then saves, after a rejected transaction. A defect the edit flow must not have."
    },
    {
      "id": "conflict-overwrites",
      "name": "Write despite a conflict",
      "kind": "enable-transition",
      "transition": "workspace-overwrite-on-conflict",
      "description": "The workspace detects the conflict but writes the file anyway. A defect the edit flow must not have."
    },
    {
      "id": "conflict-swallowed",
      "name": "Conflict reported as saved",
      "kind": "enable-transition",
      "transition": "session-swallow-conflict",
      "description": "The session receives the conflict and reports the edit as saved. A defect the edit flow must not have."
    },
    {
      "id": "session-reload-keeps-text",
      "name": "Reload from disk keeps the in-memory text",
      "kind": "enable-transition",
      "transition": "session-resolve-reload-keeps-text",
      "description": "A defect the code must not have. resolveConflict('reload') clears the conflict without adopting the disk text."
    },
    {
      "id": "session-overwrite-keeps-stale-base",
      "name": "Overwrite keeps the stale base hash",
      "kind": "enable-transition",
      "transition": "session-overwrite-stale-base",
      "description": "A defect the code must not have. resolveConflict('overwrite') writes with the base hash that just conflicted."
    },
    {
      "id": "session-reloads-own-write",
      "name": "Own write reloaded as an external change",
      "kind": "enable-transition",
      "transition": "session-reload-own-write",
      "description": "A defect the code must not have. onExternalChange treats the notice of the session's own write as an external change."
    },
    {
      "id": "session-writes-back-external-change",
      "name": "Adopted change written back",
      "kind": "enable-transition",
      "transition": "session-flush-external-reload",
      "description": "A defect the code must not have. a commit with origin external is flushed to disk."
    },
    {
      "id": "session-skips-flush-on-undo",
      "name": "Undo not saved",
      "kind": "enable-transition",
      "transition": "session-skip-flush-on-undo",
      "description": "A defect the code must not have. a commit with origin undo is not written, so the file keeps the undone text."
    },
    {
      "id": "undo-keeps-text",
      "name": "Undo does not restore the text",
      "kind": "enable-transition",
      "transition": "history-undo-keeps-text",
      "description": "A defect the code must not have. Project.undo records a step without restoring the earlier text."
    },
    {
      "id": "move-edits-spec",
      "name": "Layout move edits the specification",
      "kind": "enable-transition",
      "transition": "history-move-edits-spec",
      "description": "A defect the code must not have. MovePresentationNode changes the specification text."
    },
    {
      "id": "toolbar-import-skips-syntax-check",
      "name": "Import sends unparseable text",
      "kind": "enable-transition",
      "transition": "toolbar-import-unchecked",
      "description": "A defect the code must not have. the import handler sends a bundle whose specification has syntax errors."
    },
    {
      "id": "toolbar-import-skips-reopen",
      "name": "Imported project not reopened",
      "kind": "enable-transition",
      "transition": "toolbar-import-skip-reopen",
      "description": "A defect the code must not have. the toolbar does not reopen the project after an import."
    },
    {
      "id": "generate-from-stale-model",
      "name": "Documents generated from an earlier model",
      "kind": "enable-transition",
      "transition": "realisation-generate-stale",
      "description": "A defect the code must not have. the Realisation panel writes documents derived from an earlier model."
    },
    {
      "id": "readonly-build-writes",
      "name": "Production build tries to write",
      "kind": "enable-transition",
      "transition": "session-readonly-flush",
      "description": "A defect the code must not have. a read-only build flushes a commit."
    },
    {
      "id": "session-started-before-engine",
      "name": "Session started before the engine settled",
      "kind": "enable-transition",
      "transition": "app-init-before-engine",
      "description": "A defect the code must not have. main.js starts the session before initEngine has settled."
    },
    {
      "id": "open-ignores-read-hashes",
      "name": "Open drops the hashes of the read",
      "kind": "enable-transition",
      "transition": "session-opened-without-base",
      "description": "A defect the code must not have. session.open does not keep the hashes it read as base hashes."
    },
    {
      "id": "journal-append-fails",
      "name": "Journal append fails after the replace",
      "kind": "enable-transition",
      "transition": "ws-write-journal-append-fails",
      "description": "The disk fills (or the journal cannot be written) after atomicWrite replaced the file: the file holds the new text, no journal line is written and the write is answered as a failure. Read from the code (tools/workspace.js write()); not run.",
      "realises": "fm-disk-full"
    },
    {
      "id": "change-notice-lost",
      "name": "Change notice lost",
      "kind": "drop-event",
      "event": "file-change-notice-sent",
      "description": "A change notice never reaches the session: the event stream was down, and a stream reopened afterwards takes its baseline from disk, so the change is not notified again. Read from the code (tools/workspace.js watch()); not run.",
      "realises": "fm-dev-server-stops"
    },
    {
      "id": "save-lands-after-export",
      "name": "Save lands after the export",
      "kind": "delay-event",
      "event": "write-intent",
      "description": "The write of a committed edit reaches the server only after an export has read the files.",
      "by": 5
    },
    {
      "id": "claims-reevaluation-skipped",
      "name": "Re-evaluation after a commit skipped",
      "kind": "drop-event",
      "event": "claims-evaluation-requested",
      "description": "A defect the code must not have. the commit does not re-evaluate the claims (the second request of the run, the first being the open's).",
      "occurrence": 2
    },
    {
      "id": "sim-steps-past-end",
      "name": "Step past the end of the trace",
      "kind": "enable-transition",
      "transition": "sim-step-past-end",
      "description": "A defect the code must not have. simStep moves beyond the last recorded step."
    },
    {
      "id": "sim-adopts-stale-trace",
      "name": "Stale trace adopted",
      "kind": "enable-transition",
      "transition": "sim-adopt-stale",
      "description": "A defect the code must not have. loadSim adopts a trace without checking its token."
    },
    {
      "id": "runner-keeps-stale-job",
      "name": "Replaced job still answered",
      "kind": "enable-transition",
      "transition": "runner-keep-stale-job",
      "description": "A defect the code must not have. a new run neither terminates the worker nor drops the replaced job."
    },
    {
      "id": "runner-forwards-stale-reply",
      "name": "Reply of a replaced job forwarded",
      "kind": "enable-transition",
      "transition": "runner-forward-stale",
      "description": "A defect the code must not have. the runner hands the reply of a replaced job to the session."
    },
    {
      "id": "pulse-without-step",
      "name": "Pulse not caused by a step",
      "kind": "inject-event",
      "event": "step-pulsed",
      "description": "A defect the code must not have. the scene pulses a step the session did not show.",
      "at": 0,
      "payload": {
        "stepIndex": 0
      }
    },
    {
      "id": "preferences-not-stored",
      "name": "Preferences not stored",
      "kind": "drop-event",
      "event": "preferences-written",
      "description": "localStorage refuses the write (private window, quota, storage disabled); persistUi catches the error and nothing is remembered."
    },
    {
      "id": "camera-save-lost",
      "name": "Camera not stored",
      "kind": "drop-event",
      "event": "camera-saved",
      "description": "sessionStorage refuses the first camera write; saveCamera catches the error and the camera is not remembered.",
      "occurrence": 1
    },
    {
      "id": "apply-reports-ok-after-layout-conflict",
      "name": "Apply reports success after a layout conflict",
      "kind": "enable-transition",
      "transition": "cli-apply-ok-after-layout-conflict",
      "description": "A defect the code must not have. exegra apply reports ok although the layout write conflicted."
    },
    {
      "id": "cli-failure-omits-partial-write",
      "name": "Failure hides the partial write",
      "kind": "enable-transition",
      "transition": "cli-apply-failure-omits-spec",
      "description": "A defect the code must not have. the write.conflict failure does not say that spec.jsonc was already written."
    },
    {
      "id": "verify-reports-before-recording",
      "name": "Verify reports before recording",
      "kind": "enable-transition",
      "transition": "cli-verify-report-early",
      "description": "A defect the code must not have. exegra verify prints its envelope before evidence/results.json is written."
    },
    {
      "id": "trace-written-on-refusal",
      "name": "Trace file written on refusal",
      "kind": "enable-transition",
      "transition": "cli-trace-written-on-refusal",
      "description": "A defect the code must not have. exegra trace --out writes a file although the engine refused the run."
    },
    {
      "id": "prove-reports-unchecked",
      "name": "Unchecked exploration reported",
      "kind": "enable-transition",
      "transition": "prove-report-unchecked",
      "description": "A defect the code must not have. exegra prove reports a claim result that Lean did not accept."
    },
    {
      "id": "markdown-writes-despite-gate",
      "name": "Import written past the coverage gate",
      "kind": "enable-transition",
      "transition": "md-write-despite-gate",
      "description": "A defect the code must not have. tools/import-markdown.js writes the specification although its coverage check failed."
    },
    {
      "id": "conformance-ignores-mismatch",
      "name": "Mismatch reported as agreement",
      "kind": "enable-transition",
      "transition": "conformance-ignore-mismatch",
      "description": "A defect the code must not have. tools/conformance.js reports agreement for a differing trace."
    }
  ],

  // ---- Scenarios -------------------------------------------------------------------------
  "scenarios": [
    {
      "id": "visual-edit-flow",
      "name": "A valid visual edit",
      "description": "A valid edit made visually: it is submitted, validated and committed (revision 2), then the projection is refreshed and shown by the renderer, inspector and source editor, and only then the file is written, asynchronously one tick later. Real order: refresh at commit, write afterwards. Ends quiescent with every representation at revision 2 and the file persisted.",
      "behaviors": ["interaction-flow", "source-editor-flow", "transaction-flow", "parser-flow", "validator-flow", "session-flow", "projection-flow", "renderer-flow", "inspector-flow", "workspace-flow"],
      "steps": [
        {
          "at": 0,
          "event": "edit-requested",
          "note": "An inspector property change, a dragged node or a dialog submission."
        }
      ],
      "faultModel": "local-workstation"
    },
    {
      "id": "source-edit-flow",
      "name": "A valid source edit",
      "description": "The same pipeline entered from the source editor as a ReplaceSource operation. The refresh and the asynchronous write follow the commit in the same order as for a visual edit.",
      "behaviors": ["interaction-flow", "source-editor-flow", "transaction-flow", "parser-flow", "validator-flow", "session-flow", "projection-flow", "renderer-flow", "inspector-flow", "workspace-flow"],
      "steps": [
        {
          "at": 0,
          "event": "source-apply-requested",
          "note": "The user applies a valid draft."
        }
      ],
      "faultModel": "local-workstation"
    },
    {
      "id": "rejected-edit",
      "name": "An edit that fails validation",
      "description": "The operation fails validation: the transaction is rejected, nothing commits, nothing refreshes and nothing is written; the interaction layer shows the rejection.",
      "behaviors": ["interaction-flow", "source-editor-flow", "transaction-flow", "parser-flow", "validator-flow", "session-flow", "projection-flow", "renderer-flow", "inspector-flow", "workspace-flow"],
      "faults": ["validation-fails"],
      "steps": [
        {
          "at": 0,
          "event": "edit-requested",
          "note": "An edit whose result would have validation errors."
        }
      ],
      "faultModel": "local-workstation"
    },
    {
      "id": "edit-with-disk-conflict",
      "name": "A valid edit whose write conflicts with the disk",
      "description": "The edit commits and every view shows revision 2, but the file on disk changed since it was read: the write reports a conflict, the file is not overwritten and the session flags the conflict.",
      "behaviors": ["interaction-flow", "source-editor-flow", "transaction-flow", "parser-flow", "validator-flow", "session-flow", "projection-flow", "renderer-flow", "inspector-flow", "workspace-flow"],
      "faults": ["disk-changed-externally"],
      "steps": [
        {
          "at": 0,
          "event": "edit-requested",
          "note": "A valid edit while the file on disk has changed."
        }
      ],
      "faultModel": "local-workstation"
    },
    {
      "id": "write-with-stale-base-hash",
      "name": "A write with a stale base hash is refused and retried",
      "description": "Contract events between the persistence client and the development server's write endpoint (contract write-file): the first request carries a stale base hash and is refused with a conflict; the client retries with the current hash and the write is accepted. The trace reads as a request log: a request, a refused write and a retry.",
      "behaviors": [
        "write-client-flow",
        "write-endpoint-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "write-intent",
          "note": "The session writes the committed text; the client's base hash is out of date."
        }
      ]
    },
    {
      "id": "app-start-and-open",
      "name": "Start the application and open a project",
      "description": "main.js loads the engine, then the session lists the projects, opens exegra by reading its files (GET /__exegra/projects, GET /__exegra/project), takes their hashes as base hashes, evaluates the claims and subscribes to changes (GET /__exegra/events). Pipelines P25 and P10.",
      "behaviors": [
        "app-start-flow",
        "engine-module-flow",
        "project-session-flow",
        "persistence-client-flow",
        "dev-server-flow",
        "workspace-disk-flow",
        "workspace-watcher-flow",
        "project-history-flow",
        "session-claims-flow",
        "claim-evaluation-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "page-loaded",
          "payload": {
            "persistent": true,
            "project": "exegra"
          },
          "note": "Served by the development server."
        }
      ],
      "faultModel": "local-workstation"
    },
    {
      "id": "production-read-only-edit",
      "name": "An edit in a production build is never saved",
      "description": "A production build (PERSISTENCE_AVAILABLE false) opens the shipped specification bundled in dist/ (copy shipped-specifications), reports the save state read-only, and an edit commits in memory without any write. Pipeline P26.",
      "behaviors": [
        "app-start-flow",
        "engine-module-flow",
        "project-session-flow",
        "project-history-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "page-loaded",
          "payload": {
            "persistent": false,
            "project": "exegra"
          },
          "note": "A static build."
        },
        {
          "at": 3,
          "event": "edit-applied",
          "payload": {
            "specHash": "h2",
            "origin": "ui"
          },
          "note": "A valid edit."
        }
      ],
      "faultModel": "local-workstation"
    },
    {
      "id": "conflict-resolved-by-reload",
      "name": "A save conflict resolved by reloading from disk",
      "description": "Another process replaces spec.jsonc while the session commits an edit: the write is refused as a conflict (nothing overwritten, no journal line), the change notice that follows is ignored because the save is in conflict, and the user chooses \"Reload from disk\": the disk text is adopted with Project.reload, the in-memory edit is dropped and nothing is written. Pipelines P04 and P05.",
      "behaviors": [
        "project-session-flow",
        "persistence-client-flow",
        "dev-server-flow",
        "workspace-disk-flow",
        "workspace-watcher-flow",
        "project-history-flow"
      ],
      "steps": [
        {
