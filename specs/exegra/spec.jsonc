    // ======== Measured claim without any recorded measurement
    {
      "id": "benchmark-scene-interactive",
      "kind": "measured",
      "statement": "The default structural view of specs/benchmark/spec.jsonc (396 components and 507 relationships) renders at an interactive frame rate on ordinary desktop hardware, measured as the fps reported by the scene view's getStats() while the camera orbits. The threshold for 'interactive' is not defined in this specification.",
      "rationale": "No measurement is recorded and no test measures performance, so this claim is not evaluated. It could not be settled by a measurement until the threshold is stated.",
      "subjects": ["scene-renderer", "projection-system", "layout-engine", "benchmark-generator"],
      "evaluate": { "method": "external-evidence" }
    },
    {
      "id": "sim-flow-matches-trace",
      "kind": "invariant",
      "statement": "For every simulation step, the message flow names as sender the component whose behavior emitted the delivered event (outside, for a scenario stimulus or an injected fault) and as receivers the components whose behaviors fired a transition on it.",
      "subjects": [
        "projection-system",
        "simulation-engine"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "sim-flow-never-borrows-edges",
      "kind": "invariant",
      "statement": "A simulated message is drawn along a scene edge only when that edge connects its sender's and receiver's drawn nodes; when only a relationship the view does not draw connects them the message is marked unshown, and when no relationship connects them it is marked undeclared.",
      "subjects": [
        "projection-system",
        "scene-renderer"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "sim-step-shows-message-moving",
      "kind": "temporal",
      "statement": "Stepping a simulation in a structural view moves a marker labelled with the event's name from the sender's node toward each receiver's node, and the simulator panel states who sent the event to whom.",
      "subjects": [
        "scene-renderer",
        "simulator-panel",
        "session"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code",
        "browser-tests-run-real-application"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "simulation-seeded-runs-reproducible",
      "kind": "invariant",
      "statement": "The same model, scenario, faults and seed give deep-equal traces and metrics, draws included, in the Rust engine and in the Lean semantics; on a fixture that samples, two different seeds give different draws; and the seeds of a claim's runs are the successive SplitMix64 outputs of its base seed, with arithmetic mod 2^64.",
      "rationale": "Planned (WG-4664; specified in docs/simulation.md, Randomness). Draws come from SplitMix64 streams addressed by (stream name, counter), the counters are part of the configuration, and sequence numbers increment on every creation. Negative twin: a fixture run with two seeds fails if the seed is ignored; an engine mutant that iterates a hash map of streams, or that reuses the sequence number of a removed entry, fails the deep-equality test against the Lean semantics. Not evaluated until recorded evidence exists.",
      "subjects": [
        "simulation-engine",
        "formal-semantics",
        "workload-model"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "simulation-instances-are-independent",
      "kind": "invariant",
      "statement": "N instances of one behavior keep separate state: an effect of one instance changes no variable or state of another, every fired and ignored entry of a step names its instance, and an event routed to one instance fires on that instance only.",
      "rationale": "Planned (WG-4664; specified in docs/simulation.md, Instances). Negative twin: a fixture with two instances of a counter, where an event routed by key to instance 0 must leave instance 1 unchanged; an engine mutant that shares the variable map between instances, or delivers a routed event to every instance, fails it. Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "simulation-engine",
        "formal-semantics"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "specs-declare-aspects-as-data",
      "kind": "invariant",
      "statement": "A specification names simulation aspects with versions and gives their parameters as data; an unknown aspect or version is a validation error, and no specification text is evaluated as code.",
