  // ---- Evidence --------------------------------------------------------------------------
  // Evidence of kind test is executed by `exegra verify`; until it has run it shows no recorded
  // execution. A pattern after # is matched against test titles; titles containing a comma or
  // semicolon are referenced by a prefix because verify accepts neither in a reference.
  "evidence": [
    { "id": "ev-roundtrip-core", "claim": "edit-representations-equivalent", "kind": "test", "ref": "tests/core/roundtrip.test.js", "description": "Visual and textual routes to a change yield equal semantic state; a visual edit changes exactly one value in the source; undo and redo restore the exact text." },
    { "id": "ev-browser-inspector-rename", "claim": "edit-representations-equivalent", "kind": "test", "ref": "tests/browser/exegra.spec.js#inspector rename persists to spec.jsonc and survives reload", "description": "A rename in the inspector reaches the scene, the source and the file on disk, and survives a reload." },
    { "id": "ev-browser-source-edit", "claim": "edit-representations-equivalent", "kind": "test", "ref": "tests/browser/exegra.spec.js#source edit updates the scene", "description": "A source edit updates the scene. The full title continues '; invalid source is rejected and the draft is kept'." },
    { "id": "ev-workspace-write", "claim": "file-matches-model-after-save", "kind": "test", "ref": "tests/core/workspace.test.js#write with the current baseHash succeeds", "description": "A write with the current base hash replaces the file and changes its hash." },
    { "id": "ev-browser-persists", "claim": "file-matches-model-after-save", "kind": "test", "ref": "tests/browser/exegra.spec.js#inspector rename persists to spec.jsonc and survives reload", "description": "The edited text is on disk after the edit." },
    { "id": "ev-roundtrip-rejected", "claim": "rejected-edit-changes-nothing", "kind": "test", "ref": "tests/core/roundtrip.test.js#invalid operations are rejected atomically", "description": "A rejected operation leaves the committed model untouched." },
    { "id": "ev-browser-rejected-source", "claim": "rejected-edit-changes-nothing", "kind": "test", "ref": "tests/browser/exegra.spec.js#source edit updates the scene", "description": "An invalid source draft is rejected and the scene keeps showing the committed model." },
    { "id": "ev-workspace-conflict", "claim": "conflict-never-overwrites", "kind": "test", "ref": "tests/core/workspace.test.js#write with a stale baseHash conflicts", "description": "A write with a stale base hash conflicts and leaves the file untouched." },
    { "id": "ev-layout-core", "claim": "layout-moves-are-not-semantic", "kind": "test", "ref": "tests/core/roundtrip.test.js#moving a node is presentation only", "description": "Moving a node cannot change the semantic hash or the specification text." },
    { "id": "ev-layout-browser", "claim": "layout-moves-are-not-semantic", "kind": "test", "ref": "tests/browser/exegra.spec.js#moving a node changes layout.jsonc only", "description": "Dragging a node in the real application changes only layout.jsonc." },
    { "id": "ev-simulation-core", "claim": "simulation-deterministic", "kind": "test", "ref": "tests/core/sim.test.js", "description": "Identical inputs give deep-equal traces; reset and stepwise runs equal a single run." },
    { "id": "ev-generate-core", "claim": "generation-deterministic", "kind": "test", "ref": "tests/core/generate.test.js", "description": "Two runs are byte-identical; equivalent source texts give the same artifacts." },
    { "id": "ev-workspace-confinement", "claim": "persistence-confined-to-workspace", "kind": "test", "ref": "tests/core/workspace.test.js", "description": "Invalid names, escaping paths, unknown files and generated paths outside generated/ are refused." },
    { "id": "ev-roundtrip-invalid-draft", "claim": "invalid-source-keeps-last-valid-model", "kind": "test", "ref": "tests/core/roundtrip.test.js#an invalid source draft is rejected", "description": "An invalid source draft is rejected with diagnostics and the committed model is not corrupted." },
    { "id": "ev-browser-invalid-draft", "claim": "invalid-source-keeps-last-valid-model", "kind": "test", "ref": "tests/browser/exegra.spec.js#source edit updates the scene", "description": "In the application the rejected draft is kept as typed." },
    { "id": "ev-model-unsupported", "claim": "unsupported-constructs-are-diagnosed", "kind": "test", "ref": "tests/core/model.test.js#unsupported constructs", "description": "Unsupported constructs are diagnosed, never silently dropped." },
    {
      "id": "ev-flows-trace",
      "claim": "sim-flow-matches-trace",
      "kind": "test",
      "ref": "tests/core/flows.test.js",
      "description": "Sender and receivers of every step of a scenario come from the trace; a scenario stimulus comes from outside."
    },
    {
      "id": "ev-flows-edges",
      "claim": "sim-flow-never-borrows-edges",
      "kind": "test",
      "ref": "tests/core/flows.test.js",
      "description": "Paths follow the edge between the drawn nodes in either direction; an unconnected pair is undeclared, a relationship the view hides is unshown, a collapsed subsystem stands for its members, a dropped event is lost."
    },
    {
      "id": "ev-browser-sim-flow",
      "claim": "sim-step-shows-message-moving",
      "kind": "test",
      "ref": "tests/browser/interaction.spec.js#stepping a simulation sends a labelled marker along the edge from sender to receiver",
      "description": "In the running application, stepping Exegra's own edit scenario sends a labelled marker into the interaction component from outside, then along the declared edge to the transaction system while it advances, and marks the undeclared save message; the panel names sender and receiver."
    },
    {
      "id": "ev-simulation-contract",
      "claim": "simulation-contract-pinned",
      "kind": "test",
      "ref": "tests/core/conformance.test.js",
      "description": "The WebAssembly engine reproduces every golden trace from the model and from the committed engine input alone, simulationInput derives the committed inputs, and the conformance runner reports an altered trace at the right step and path."
    },
    {
      "id": "ev-engines-agree",
      "claim": "engines-agree-on-traces",
      "kind": "test",
      "ref": "tests/core/conformance.test.js",
      "description": "The Rust engine as WebAssembly, and as the native binary when it is built, reproduces every golden trace of the conformance suite."
    },
    {
      "id": "ev-simulation-worker-responsive",
      "claim": "simulation-runs-off-main-thread",
      "kind": "test",
      "ref": "tests/browser/simulation-worker.spec.js#a long simulation runs in a worker while the page stays responsive",
      "description": "A scenario added through a transaction loops up to 20000 steps; while it runs, frames keep coming, the toolbar reacts and the tab shows it as running, and the finished trace steps as before."
    },
    {
      "id": "ev-browser-phone-touch-usable",
      "claim": "ui-touch-usable-on-phone",
      "kind": "test",
      "ref": "tests/browser/mobile.spec.js#phone layout has no horizontal scroll and 44 px targets and the scene covers most of the screen",
      "description": "At 390 by 844 with touch: no horizontal scroll, and no visible interactive control under 44 by 44 CSS px (offenders listed) with nothing open, with every destination's sheet at full height, in the More and overflow menus, in a dialog and in search; with no sheet open at least 60% of the window is uncovered scene."
    },
    {
      "id": "ev-browser-phone-every-function",
      "claim": "ui-every-function-at-every-size",
      "kind": "test",
      "ref": "tests/browser/mobile.spec.js#every function is reachable by touch on a phone",
      "description": "At 390 by 844, by taps: every destination's sheet, search, selection by tapping the canvas, a property edit, undo and redo, create, connect mode, delete with cascade, rename, explorer collapse, isolate and hide, layout, camera, legend and statistics, a scenario stepped with the docked transport, faults and the timeline, verification, source, realisation, diagnostics, changes, export, and view and project switching."
    },
    {
      "id": "ev-browser-tablet-desktop-expand",
      "claim": "ui-expands-to-desktop",
      "kind": "test",
      "ref": "tests/browser/mobile.spec.js#panels open beside the scene on a tablet and the desktop shows explorer scene and context panel side by side",
      "description": "At 820 px the inspector, explorer and verification panels open beside the scene with no overlap of their boxes; a fresh 1600 by 1000 page shows the explorer, the scene and the context panel side by side with no overlap, nothing opened by hand."
    },
    {
      "id": "ev-fault-model-core",
      "claim": "fault-model-scoped-claims",
      "kind": "test",
      "ref": "tests/core/fault-model.test.js",
      "description": "Missing sources and wrong enums are errors; renames and deletes follow references through the new properties, including the any-kind source; gap.no-fault-model and the realises-outside-model warning are reported; a claim result's scope begins with the fault model; realises never reaches the engine input."
    },
    {
      "id": "ev-formal-differential",
      "claim": "engine-matches-formal-semantics",
      "kind": "test",
      "ref": "tests/core/formal-semantics.test.js",
      "description": "The Lean executable reproduces every golden trace; the native Rust engine and the Lean executable give identical traces on every golden input and on 150 seeded generated inputs covering every fault kind, run-time and parse errors, step limits and simultaneous events. Skipped, with a message, when a binary is not built."
    },
    {
      "id": "ev-formal-proofs",
      "claim": "formal-semantics-properties-proved",
      "kind": "test",
      "ref": "tests/core/formal-semantics.test.js#the Lean proofs build with no sorry and only standard axioms",
      "description": "Builds formal/ with lake: the theorems of formal/Exegra/Properties.lean type-check, and its #guard_msgs axiom checks fail the build on sorryAx or a non-standard axiom; no Lean source uses sorry or admit or declares an axiom. Skipped, with a message, when lake is not on the PATH."
    },
    {
      "id": "ev-contract-events-static",
      "claim": "contract-events-validated",
      "kind": "test",
      "ref": "tests/core/contract-trace.test.js#validate reports contract events that do not fit their contract",
      "description": "A request with an unknown field, a missing input, a wrong type, a response with a foreign field and an error code outside the contract are each reported at the event; a conforming model has no such diagnostic."
    },
    {
      "id": "ev-contract-trace-checks",
      "claim": "trace-contract-conformance",
      "kind": "test",
      "ref": "tests/core/contract-trace.test.js#simulate checks values error codes and request response pairing",
      "description": "A wrong-typed value, an error code outside the contract and a response with no earlier request are failed automatic checks with their step; Exegra's own write-with-stale-base-hash scenario passes them."
    },
    {
      "id": "ev-contract-request-log",
      "claim": "trace-contract-conformance",
      "kind": "test",
      "ref": "tests/core/contract-trace.test.js#the request log renders contract events with binding and outcome",
      "description": "The trace of write-with-stale-base-hash renders as a request, a refused write and a retry, using the contract's binding; a trace without contract events renders no lines."
    },
    {
      "id": "ev-browser-requests-section",
      "claim": "trace-contract-conformance",
      "kind": "test",
      "ref": "tests/browser/mobile.spec.js#the simulator shows the request log of contract events on a phone",
      "description": "On a phone, the Requests section of the simulator panel lists the request, the refused write and the retry of write-with-stale-base-hash, with jump targets of at least 44 px and no horizontal scroll."
    },
    {
      "id": "ev-data-model-core",
      "claim": "data-model-rules-computed",
      "kind": "test",
      "ref": "tests/core/data-model.test.js",
      "description": "The data-model fixture validates with exactly one data-rule finding, the missing erasure point; a wrong enum and an unknown key field are errors with their positions; each rule reports its entity and field on a constructed violation; a data-model claim is violated, verified or inconclusive as the findings say; the Data projection draws records, copies and their edges."
    },
    {
      "id": "ev-formal-explore",
      "claim": "exhaustive-exploration-sound",
      "kind": "test",
      "ref": "tests/core/formal-explore.test.js",
      "description": "exegra prove on the race fixture: the lost update is a counterexample accepted by Lean, its scripted run passes the trace check, the atomic store holds for all N configurations with the same N on two runs, and its precedes claim holds on every complete run. Skipped, with a message, when lake is not on the PATH."
    },
    {
      "id": "ev-formal-explore-bounded",
      "claim": "invariants-proved-within-bounds",
      "kind": "test",
      "ref": "tests/core/formal-explore.test.js#the atomic store is verified for every configuration within the bound",
      "description": "exegra prove reports the atomic store's invariant as holding with method lean-exhaustive, the bound and N, after Lean accepted the theorem in the generated file. Skipped, with a message, when lake is not on the PATH."
    },
    {
      "id": "ev-negatives-status",
      "claim": "trace-claim-verified-needs-negative",
      "kind": "test",
      "ref": "tests/core/claims.test.js#negatives: verified needs a violating negative",
      "description": "A trace claim with a violating negative is verified; with none, with a negative that holds, or with one cut off unfinished, it is inconclusive and says why."
    },
    {
      "id": "ev-negatives-validated",
      "claim": "negatives-are-validated",
      "kind": "test",
      "ref": "tests/core/claims.test.js#negatives: malformed negatives are validation errors and follow renames",
      "description": "Each malformed negative is reported with its own diagnostic code; renaming a fault rewrites the negative."
    },
    {
      "id": "ev-own-claims-falsifiable",
      "claim": "own-behavioral-claims-falsifiable",
      "kind": "test",
      "ref": "tests/core/claims.test.js#negatives: every behavioral claim of the exegra specification is verified with a violating negative",
      "description": "Loads specs/exegra/spec.jsonc and checks that every trace claim declares negatives and is verified."
    },
    {
      "id": "ev-formal-explore-temporal",
      "claim": "temporal-claims-checked-on-all-runs",
      "kind": "test",
      "ref": "tests/core/formal-explore.test.js#temporal claims: eventually holds",
      "description": "exegra prove on the race fixture: an eventually holds on every path; an eventually fails with a counterexample run that drops the event and ends without it; a precedes that the scripted run satisfies is violated by a run that reorders simultaneous events. Skipped, with a message, when lake is not on the PATH."
    },
    {
      "id": "ev-register-import-coverage",
      "claim": "register-import-holds-every-line",
      "kind": "test",
      "ref": "tests/core/import-register.test.js#the fixture imports, validates and rebuilds line for line",
      "description": "The fixture converts with both checks passing, the output validates without errors and the sections rebuild the file exactly."
    },
    {
      "id": "ev-register-import-lost-cell",
      "claim": "register-import-holds-every-line",
      "kind": "test",
      "ref": "tests/core/import-register.test.js#a row that does not render back fails the import",
      "description": "A row whose rendering differs from its source cells fails the import and is named."
    },
    {
      "id": "ev-register-import-sources",
      "claim": "register-import-entities-cite-source",
      "kind": "test",
      "ref": "tests/core/import-register.test.js#every imported entity names its source line",
      "description": "Every document, section, table and row of the fixture output has a source whose line holds the text it came from, and keyed rows carry ref."
    },
    {
      "id": "ev-register-import-drafts",
      "claim": "register-import-drafts-are-marked",
      "kind": "test",
      "ref": "tests/core/import-register.test.js#a draft fragment is merged with origin, source and checked basis",
      "description": "A fixture draft merges with origin and source, its basis references are checked by validation, and the rendered Markdown is unchanged."
    },
    {
      "id": "ev-register-import-authority",
      "claim": "register-import-respects-authority",
      "kind": "test",
      "ref": "tests/core/import-register.test.js#a map whose JSONC is the authority refuses to import, and render needs only the JSONC",
      "description": "An authority map makes the import exit 1 without writing; --render of a written specification gives the source Markdown."
    },
    {
      "id": "ev-external-traceability",
      "claim": "realisation-roots-traced",
      "kind": "test",
      "ref": "tests/core/external-realisation.test.js#traceability",
      "description": "Modules in a fake external root are checked there; an undeclared alias is missing; only roots with include globs report unclaimed files; no roots gives the earlier result."
    },
    {
      "id": "ev-external-junit",
      "claim": "external-not-run-distinct-from-fail",
      "kind": "test",
      "ref": "tests/core/external-realisation.test.js#junit",
      "description": "A fixture JUnit report gives pass, fail and not-run per evidence entry, matched by file, describe path and name; verify --ingest-only records them and fails only on a real failure."
    }
  ],

  // ---- Views -----------------------------------------------------------------------------
  // The first declared view is the default one.
  "views": [
    { "id": "architecture", "name": "Architecture", "projection": "structural", "description": "Every component and relationship of Exegra, grouped by subsystem.", "display": { "showPorts": true } },
    { "id": "realisation", "name": "Realisation", "projection": "structural", "description": "Components coloured by how they are realised: manual, model-configured, generated, not implemented.", "display": { "colorBy": "implementation" } },
    { "id": "data-and-edit-flow", "name": "Data and edit flow", "projection": "structural", "description": "Only relationships that carry data, edits or derived content: data-flow, submits-edits, reads, writes, projects, generates.", "filter": { "relationshipKinds": ["data-flow", "submits-edits", "reads", "writes", "projects", "generates"] } },
    { "id": "semantic-core-only", "name": "Semantic core", "projection": "structural", "description": "Only the components inside the semantic core and the relationships among them.", "filter": { "within": "semantic-core" } },
    { "id": "claims", "name": "Claims", "projection": "claims", "description": "Claims, their subjects, assumptions and evidence, coloured by evaluation status." },
    { "id": "behavior", "name": "Edit flow behavior", "projection": "behavior", "description": "The state machines of Exegra's own edit flow and the scenarios that run them." },
    { "id": "references", "name": "References", "projection": "references", "description": "The selected entity and everything within one reference hop of it, in either direction, whatever its kind.", "display": { "depth": 1 } }
  ],
  "environments": [
    {
      "id": "local-workstation-env",
      "name": "Local workstation",
      "description": "A developer workstation running the Vite development server in Node, the application in one browser tab and the project files on the local file system.",
      "guarantees": [
        {
          "aspect": "zone-count",
          "value": 1,
          "source": "single-workstation"
        },
        {
          "aspect": "region-count",
          "value": 1,
          "source": "single-workstation"
        },
        {
          "aspect": "clock-skew",
          "value": 0,
          "unit": "ms",
          "source": "single-workstation"
        },
        {
          "aspect": "message-loss",
          "value": "none on loopback while both ends run",
          "source": "single-workstation"
        },
        {
          "aspect": "storage-durability",
          "value": "local disk; a rename over the target is atomic only where the file system honours it",
          "source": "filesystem-honours-atomic-rename"
        }
      ]
    }
  ],
  "failureModes": [
    {
      "id": "fm-tab-reload-during-save",
      "name": "Tab crash or reload during a save",
      "kind": "restart",
      "target": "session",
      "scope": "process",
      "description": "The browser tab crashes or is reloaded while a committed edit is being written: the in-memory model is lost and the write may or may not have reached the server.",
      "rate": {
        "value": 12,
        "per": "year",
        "source": "workstation-rates-assumed"
      },
      "duration": {
        "typical": 1,
        "max": 10,
        "unit": "second",
        "source": "workstation-rates-assumed"
      }
    },
    {
      "id": "fm-rename-not-atomic",
      "name": "Rename over the target is not atomic",
      "kind": "partial-apply",
      "target": "workspace-service",
      "scope": "host",
      "description": "On Windows the replacing rename can be blocked; the workspace service retries and finally writes in place, so a crash at that moment can leave a partly written file.",
      "rate": {
        "value": 1,
        "per": "month",
        "source": "filesystem-honours-atomic-rename"
      }
    },
    {
      "id": "fm-concurrent-spec-edit",
      "name": "Concurrent external edit of the specification",
      "kind": "concurrent-change",
      "target": "specification-file",
      "scope": "host",
      "description": "Another process (an editor, an agent command, git) changes spec.jsonc after the session last read or wrote it.",
      "rate": {
        "value": 1,
        "per": "day",
        "source": "workstation-rates-assumed"
      }
    },
    {
      "id": "fm-dev-server-stops",
      "name": "Development server stops",
      "kind": "dependency-outage",
      "target": "persistence-client-calls-dev-server-plugin",
      "scope": "process",
      "description": "The Vite development server exits or is restarted; the persistence client's requests and event stream fail until it is back.",
      "rate": {
        "value": 4,
        "per": "week",
        "source": "workstation-rates-assumed"
      },
      "duration": {
        "typical": 5,
        "max": 120,
        "unit": "second",
        "source": "workstation-rates-assumed"
      }
    },
    {
      "id": "fm-disk-full",
      "name": "Write fails because the disk is full",
      "kind": "other",
      "target": "workspace-service",
      "scope": "host",
      "description": "Writing the temporary file or renaming it fails for lack of space; the write is reported as failed and the target is not replaced.",
      "rate": {
        "value": 1,
        "per": "year",
        "source": "workstation-rates-assumed"
      },
      "duration": {
        "typical": 600,
        "max": 86400,
        "unit": "second",
        "source": "workstation-rates-assumed"
      }
    }
  ],
  "faultModels": [
    {
      "id": "local-workstation",
      "name": "Local workstation",
      "environment": "local-workstation-env",
      "description": "The failures of an ordinary development session: the tab, the development server, the file system and other processes touching the specification. One at a time.",
      "modes": [
        "fm-tab-reload-during-save",
        "fm-rename-not-atomic",
        "fm-concurrent-spec-edit",
        "fm-dev-server-stops",
        "fm-disk-full"
      ],
      "bounds": [
        {
          "maxConcurrent": 1,
          "source": "one-fault-at-a-time"
        }
      ]
    }
  ],
  "records": [
    {
      "id": "specification-text",
      "name": "Specification text",
      "owner": "specification-file",
      "key": [
        "project"
      ],
      "fields": [
        {
          "name": "project",
          "type": "project-name"
        },
        {
          "name": "text",
          "type": "jsonc-text"
        },
        {
          "name": "semantic-hash",
          "type": "hash"
        }
      ],
      "retention": "Kept in the repository; every saved write appends a line to .history/journal.jsonl.",
      "description": "The serialized authority of a project. Exegra holds no personal data: no field is personal and none refers to a principal."
    }
  ],
  "copies": [
    {
      "id": "session-model",
      "name": "Session model",
      "of": [
        "specification-text"
      ],
      "heldBy": "session",
      "scope": "per-session",
      "freshness": {
        "bound": "the last commit of this session or the last adopted file change",
        "mechanism": "the file watcher's server-sent events and Project.reload; a write with a stale base hash is refused as a conflict"
      },
      "description": "The browser session's parsed model and text."
    },
    {
      "id": "cli-project",
      "name": "Agent command-line project",
      "of": [
        "specification-text"
      ],
      "heldBy": "agent-cli",
      "scope": "per-session",
      "freshness": {
        "bound": "read at the start of one invocation",
        "mechanism": "--expect-hash refuses an apply on a changed specification"
      },
      "description": "One invocation of the agent command line reads the text once and writes it back after an apply."
    },
    {
      "id": "generated-documents",
      "name": "Generated documents",
      "of": [
        "specification-text"
      ],
      "fields": [
        "project",
        "semantic-hash"
      ],
      "heldBy": "generated-artifacts",
      "scope": "shared",
      "freshness": {
        "bound": "the last run of npm run generate",
        "mechanism": "npm run generate rewrites them; each document records the semantic hash it was derived from"
      },
      "description": "specs/<project>/generated/: derived documents anyone reading the repository sees."
    }
  ]
}
