    {
      "id": "runtime-stores-modelled",
      "kind": "invariant",
      "statement": "Every durable store Exegra's code writes (the project files and journal of the workspace service, evidence/results.json, generated/, the localStorage keys exegra.session and exegra.layout, the sessionStorage keys exegra.camera.<project>.<view>, the bundle download, and the files the command line and the tools write) is named by a record or a copy of this specification.",
      "rationale": "WG-4775. The evidence finds write sites by pattern in src/, cli/ and tools/ and resolves storage keys and workspace files from the code. It cannot see writes made by subprocesses the tools start (lake, cargo, Playwright, npm and Vite, except the --out-dir build-engine hands to wasm-bindgen), writes inside dependencies, writes through an alias of fs or of a storage object, keys computed without a literal prefix, or in-memory state; and it matches a site to its store by a needle or the enclosing function, so the store named is the author's statement. Supported, not verified: Exegra does not check its own code.",
      "subjects": [
        "data-model",
        "workspace-service",
        "session",
        "agent-cli",
        "specification-text",
        "recorded-results",
        "write-journal",
        "session-preferences",
        "camera-memory"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "verify-reuses-fresh-outcomes-only",
      "kind": "invariant",
      "statement": "A verify run takes the outcome of a test evidence entry from a recorded test run only when that run was complete, the tree did not change while it ran, and its tree stamp equals the stamp of the tree verify runs on; a reference matching no recorded test is run, never assumed to pass.",
      "subjects": [
        "verification-pipeline",
        "recorded-results-file"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "rationale": "The check ran every test twice (WG-4794). The stamp covers tracked and untracked files by content and the generated engine builds, so an edit after the run, a rebuilt engine or a different Node version makes the recorded outcomes stale and the tests run again.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "verify-skip-keeps-recorded-outcome",
      "kind": "invariant",
      "statement": "A verify run that skips a test evidence entry keeps the outcome recorded for that entry before, and records no outcome for it where none was recorded.",
      "subjects": [
        "agent-cli",
        "recorded-results-file"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "rationale": "A skipped run did not execute, so it must not erase the outcome of an earlier run. The kept outcome keeps its own ranAt, so its age stays visible.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "journal-failure-reported",
      "kind": "invariant",
      "statement": "When a spec or layout write replaces its file but the journal line cannot be appended, the write result says the journal line was not written, the CLI apply result lists it in journalWarnings, and the session reports it as an error; the replaced file is not restored.",
      "subjects": [
        "workspace-service",
        "agent-cli",
        "session"
      ],
      "assumptions": [
        "filesystem-honours-atomic-rename"
      ],
      "rationale": "The file write happens before the journal append, and nothing else checks that the append happened. A silent gap in the journal would leave an edit with no history line.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "changes-panel-pairs-by-revision",
      "kind": "invariant",
      "statement": "The changes panel pairs each history entry with the log entry of its own commit, matched by revision, so the pairing stays correct after the session log has dropped its oldest entries.",
      "subjects": [
        "activity-panels"
      ],
      "assumptions": [],
      "rationale": "The session log is capped at 400 entries and history is not. Pairing by position mislabels every entry once the cap has dropped change entries.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
