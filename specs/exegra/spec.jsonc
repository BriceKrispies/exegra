      "kind": "test",
      "ref": "tests/core/runtime-data-complete.test.js",
      "description": "Every write site found by pattern in src/, cli/ and tools/ belongs to exactly one listed store and every listed store still has a site; each store's locator, every browser storage key the code writes and every workspace project file appear in a record or a copy of specs/exegra/spec.jsonc. A new write site, key or project file fails it until its store is modelled."
    },
    {
      "id": "ev-verify-reuses-fresh-outcomes",
      "claim": "verify-reuses-fresh-outcomes-only",
      "kind": "test",
      "ref": "tests/core/outcome-reuse.test.js#outcomes are used only while the tree is the one they ran on",
      "description": "An outcome file stamped with the current tree answers a reference; with another stamp it answers nothing. Companion tests cover a reference matching no recorded test, failures, skipped tests, mixed matches and the stamp itself."
    },
    {
      "id": "ev-verify-skip-keeps-outcome",
      "claim": "verify-skip-keeps-recorded-outcome",
      "kind": "test",
      "ref": "tests/core/cli.test.js#a skipped verify run keeps the outcome recorded before instead of erasing it",
      "description": "mergeRecordedResults keeps the earlier outcome of a skipped evidence entry and records the outcomes of the runs that executed."
    },
    {
      "id": "ev-journal-append-failure",
      "claim": "journal-failure-reported",
      "kind": "test",
      "ref": "tests/core/workspace.test.js#a journal line that cannot be appended is reported and the file write still stands",
      "description": "A journal path that is a directory makes the append fail: the write still replaces the file and reports journal.written false with a message."
    },
    {
      "id": "ev-changes-pairing-by-revision",
      "claim": "changes-panel-pairs-by-revision",
      "kind": "test",
      "ref": "tests/core/activity-pairing.test.js",
      "description": "pairHistoryWithLog pairs more than 400 commits with their own log entries and leaves an entry unpaired when its log entry was dropped."
    },
    {
      "id": "ev-replay-recorded-stream-clean",
      "claim": "real-runs-replay-through-self-model",
      "kind": "test",
      "ref": "tests/core/replay.test.js#a recorded open edit and save replays through live-session without a divergence",
      "description": "A stream recorded from the running application (tests/fixtures/live/open-edit-save.json) replays through live-session with no divergence and nothing awaited; steps carry fired transitions, responsible components and calibrations, and checkTrace and requestLog read the replay."
    },
    {
      "id": "ev-replay-wrong-order",
      "claim": "real-runs-replay-through-self-model",
      "kind": "test",
      "ref": "tests/core/replay.test.js#an event in the wrong order is a divergence",
      "description": "Negative: save-succeeded moved before the request is reported as unpredicted, under the claim, with its step."
    },
    {
      "id": "ev-replay-unknown-event",
      "claim": "real-runs-replay-through-self-model",
      "kind": "test",
      "ref": "tests/core/replay.test.js#an event the specification does not name is a divergence",
      "description": "Negative: an event id the specification does not declare is reported as unknown-event."
    },
    {
      "id": "ev-replay-missing-response",
      "claim": "real-runs-replay-through-self-model",
      "kind": "test",
      "ref": "tests/core/replay.test.js#a predicted response that never comes is a divergence",
      "description": "Negative: a stream that ends after the server wrote the file is still waiting while open and reports write-file-ok missing once closed, naming the transition that predicted it."
    },
    {
      "id": "ev-replay-bound",
      "claim": "real-runs-replay-through-self-model",
      "kind": "test",
      "ref": "tests/core/replay.test.js#a predicted event not seen within the bound is missing even while the stream is open",
      "description": "Negative: a prediction older than the bound is missing on an open stream."
    },
    {
      "id": "ev-replay-payload",
      "claim": "real-runs-replay-through-self-model",
      "kind": "test",
      "ref": "tests/core/replay.test.js#a recorded payload value that differs from the prediction is a divergence",
      "description": "Negative: a doctored hash in write-file-ok is a payload divergence on that field."
    },
    {
      "id": "ev-replay-not-allowed",
      "claim": "real-runs-replay-through-self-model",
      "kind": "test",
      "ref": "tests/core/replay.test.js#a predicted event that no behavior consuming it accepts in its state is a divergence",
      "description": "Negative: a camera saved for a view the model's tab storage has no place for is not-allowed."
    },
    {
      "id": "ev-replay-incremental",
      "claim": "real-runs-replay-through-self-model",
      "kind": "test",
      "ref": "tests/core/replay.test.js#the replay is incremental and deterministic",
      "description": "Consuming events one at a time gives the same trace as replaying the whole stream."
    },
    {
      "id": "ev-live-browser",
      "claim": "real-runs-replay-through-self-model",
      "kind": "test",
      "ref": "tests/browser/live.spec.js#live mode replays an edit and its save through the self-model on the right components without divergence",
      "description": "The running application opens a copy of its own specification; with Live mode on, an edit and its save are recorded in order on the components the model names, replay without divergence and without failed checks, the request log shows the write, and the panel works at phone width with 44 px source buttons and no horizontal scroll."
    },
    {
      "id": "ev-traffic-bounded",
      "claim": "traffic-stream-bounded-and-logical",
      "kind": "test",
      "ref": "tests/core/traffic.test.js#the recorder keeps a bounded stream with logical sequence numbers and keeps wall-clock times out of the replay",
      "description": "A recorder with a limit of 3 keeps the last 3 events with their sequence numbers, counts the dropped ones, copies payloads, and forReplay carries no wall-clock time."
    },
    {
      "id": "ev-traffic-live-seq",
      "claim": "traffic-stream-bounded-and-logical",
      "kind": "test",
      "ref": "tests/browser/live.spec.js#live mode replays an edit and its save through the self-model on the right components without divergence",
      "description": "In the running application the live trace's times are the recorded sequence numbers."
    },
    {
      "id": "ev-traffic-server-events",
      "claim": "traffic-producers-name-spec-events",
      "kind": "test",
      "ref": "tests/core/traffic.test.js#the development server returns its own events with each answer stamped with the request id",
      "description": "Against the real middleware: list, read, write, conflict and a missing project each return their workspace events and answer in order with the request id; a request without an id gets none; changeTrace tells own writes from external edits."
    },
    {
      "id": "ev-traffic-engine-runner",
      "claim": "traffic-producers-name-spec-events",
      "kind": "test",
      "ref": "tests/core/traffic.test.js#the engine runner records the worker messages with the scenario standing for input and trace",
      "description": "With a stand-in Worker: posts, the termination of a waiting worker, the reply with its generation and a refusal are recorded as the contract's events."
    },
    {
      "id": "ev-traffic-sha256",
      "claim": "traffic-producers-name-spec-events",
      "kind": "test",
      "ref": "tests/core/traffic.test.js#sha256Hex agrees with the workspace hash",
      "description": "The browser's sha-256 equals the workspace hash for empty, ASCII, non-ASCII and large texts."
    },
    {
      "id": "ev-traffic-browser-producers",
      "claim": "traffic-producers-name-spec-events",
      "kind": "test",
      "ref": "tests/browser/live.spec.js#live mode replays an edit and its save through the self-model on the right components without divergence",
      "description": "The session, the persistence client and the scene record the open, the edit and the save in the running application, matching the server's events by request id."
    },
    {
      "id": "ev-evidence-ref-rule",
      "claim": "evidence-refs-validated-before-verify",
      "kind": "test",
      "ref": "tests/core/model.test.js#test evidence references: an unsafe one is a validation error",
      "description": "An unsafe test reference is a validation error and a plain one is not; validate and verify share one rule."
    },
    {
      "id": "ev-lean-boundary",
      "claim": "lean-boundary-errors-are-values",
      "kind": "test",
      "ref": "tests/core/lean.test.js",
      "description": "Calls through src/core/lean.js: the registry lists engine.run, an unknown function, a malformed request and refused arguments come back as errors, and a run returns the trace the engine returns."
    },
    {
      "id": "ev-lean-theorem-method",
      "claim": "lean-theorem-method-refuses-unsound-proofs",
      "kind": "test",
      "ref": "tests/core/lean-theorem.test.js",
      "description": "Lean proves Exegra.runInput_terminates about Exegra.runInput and refuses a sorry, a native_decide, an own axiom and an off-topic statement; the rule on recorded facts; no record gives not evaluated."
    },
    {
      "id": "ev-lean-core-browser",
      "claim": "lean-core-runs-in-browser",
      "kind": "test",
      "ref": "tests/browser/lean-core.spec.js",
      "description": "In Chrome: the page loads the Lean core through src/core/lean.js, lists its functions, gets an error value for an unknown function and reproduces two golden traces."
    }
  ],

  // ---- Views -----------------------------------------------------------------------------
  // The first declared view is the default one.
  "views": [
    { "id": "architecture", "name": "Architecture", "projection": "structural", "description": "Every component and relationship of Exegra, grouped by subsystem.", "display": { "showPorts": true } },
    { "id": "realisation", "name": "Realisation", "projection": "structural", "description": "Components coloured by how they are realised: manual, model-configured, generated, not implemented.", "display": { "colorBy": "implementation" } },
    { "id": "data-and-edit-flow", "name": "Data and edit flow", "projection": "structural", "description": "Only relationships that carry data, edits or derived content: data-flow, submits-edits, reads, writes, projects, generates.", "filter": { "relationshipKinds": ["data-flow", "submits-edits", "reads", "writes", "projects", "generates"] } },
    { "id": "semantic-core-only", "name": "Semantic core", "projection": "structural", "description": "Only the components inside the semantic core and the relationships among them.", "filter": { "within": "semantic-core" } },
    { "id": "claims", "name": "Claims", "projection": "claims", "description": "Claims, their subjects, assumptions and evidence, coloured by evaluation status." },
    { "id": "behavior", "name": "Edit flow behavior", "projection": "behavior", "description": "The state machines of Exegra's own edit flow and the scenarios that run them." },
    { "id": "references", "name": "References", "projection": "references", "description": "The selected entity and everything within one reference hop of it, in either direction, whatever its kind.", "display": { "depth": 1 } }
  ],
  "environments": [
    {
      "id": "local-workstation-env",
      "name": "Local workstation",
      "description": "A developer workstation running the Vite development server in Node, the application in one browser tab and the project files on the local file system.",
      "guarantees": [
        {
          "aspect": "zone-count",
          "value": 1,
          "source": "single-workstation"
        },
        {
          "aspect": "region-count",
          "value": 1,
          "source": "single-workstation"
        },
        {
          "aspect": "clock-skew",
          "value": 0,
          "unit": "ms",
          "source": "single-workstation"
        },
        {
          "aspect": "message-loss",
          "value": "none on loopback while both ends run",
          "source": "single-workstation"
        },
        {
          "aspect": "storage-durability",
          "value": "local disk; a rename over the target is atomic only where the file system honours it",
          "source": "filesystem-honours-atomic-rename"
        }
      ]
    }
  ],
  "failureModes": [
    {
      "id": "fm-tab-reload-during-save",
      "name": "Tab crash or reload during a save",
      "kind": "restart",
      "target": "session",
      "scope": "process",
      "description": "The browser tab crashes or is reloaded while a committed edit is being written: the in-memory model is lost and the write may or may not have reached the server.",
      "rate": {
        "value": 12,
        "per": "year",
        "source": "workstation-rates-assumed"
      },
      "duration": {
        "typical": 1,
        "max": 10,
        "unit": "second",
        "source": "workstation-rates-assumed"
      }
    },
    {
      "id": "fm-rename-not-atomic",
      "name": "Rename over the target is not atomic",
      "kind": "partial-apply",
      "target": "workspace-service",
      "scope": "host",
      "description": "On Windows the replacing rename can be blocked; the workspace service retries and finally writes in place, so a crash at that moment can leave a partly written file.",
      "rate": {
        "value": 1,
        "per": "month",
        "source": "filesystem-honours-atomic-rename"
      }
    },
    {
      "id": "fm-concurrent-spec-edit",
      "name": "Concurrent external edit of the specification",
      "kind": "concurrent-change",
      "target": "specification-file",
      "scope": "host",
      "description": "Another process (an editor, an agent command, git) changes spec.jsonc after the session last read or wrote it.",
      "rate": {
        "value": 1,
        "per": "day",
        "source": "workstation-rates-assumed"
      }
    },
    {
      "id": "fm-dev-server-stops",
      "name": "Development server stops",
      "kind": "dependency-outage",
      "target": "persistence-client-calls-dev-server-plugin",
      "scope": "process",
      "description": "The Vite development server exits or is restarted; the persistence client's requests and event stream fail until it is back.",
      "rate": {
        "value": 4,
        "per": "week",
        "source": "workstation-rates-assumed"
      },
      "duration": {
        "typical": 5,
        "max": 120,
        "unit": "second",
        "source": "workstation-rates-assumed"
      }
    },
    {
      "id": "fm-disk-full",
      "name": "Write fails because the disk is full",
      "kind": "other",
      "target": "workspace-service",
      "scope": "host",
      "description": "Writing the temporary file or renaming it fails for lack of space; the write is reported as failed and the target is not replaced. If space runs out after the rename, the journal append fails instead: the target is replaced, the write is reported as failed and it has no journal line (fault journal-append-fails).",
      "rate": {
        "value": 1,
        "per": "year",
        "source": "workstation-rates-assumed"
      },
      "duration": {
        "typical": 600,
        "max": 86400,
        "unit": "second",
        "source": "workstation-rates-assumed"
      }
    }
  ],
  "faultModels": [
    {
      "id": "local-workstation",
      "name": "Local workstation",
      "environment": "local-workstation-env",
      "description": "The failures of an ordinary development session: the tab, the development server, the file system and other processes touching the specification. One at a time.",
      "modes": [
        "fm-tab-reload-during-save",
        "fm-rename-not-atomic",
        "fm-concurrent-spec-edit",
        "fm-dev-server-stops",
        "fm-disk-full"
      ],
      "bounds": [
        {
          "maxConcurrent": 1,
          "source": "one-fault-at-a-time"
        }
      ]
    }
  ],
  "records": [
    {
      "id": "specification-text",
      "name": "Specification text",
      "owner": "specification-file",
      "key": [
        "project"
      ],
      "fields": [
        {
          "name": "project",
          "type": "project-name"
        },
        {
          "name": "text",
          "type": "jsonc-text"
        },
        {
          "name": "semantic-hash",
          "type": "hash"
        }
      ],
      "retention": "Kept in the repository; every saved write appends a line to .history/journal.jsonl.",
      "description": "The serialized authority of a project: specs/<project>/spec.jsonc, or the file that specs/<project>/project.jsonc names. Written by the workspace service (tools/workspace.js write(), under a base-hash check and atomic rename, from the session and from exegra apply) and, outside any transaction, by the bundle import (tools/workspace.js importProject()), by tools/import-markdown.js (--out) and by tools/make-benchmark.js (specs/benchmark/spec.jsonc). Exegra holds no personal data: no field is personal and none refers to a principal."
    },
    {
      "id": "presentation-layout",
      "name": "Presentation layout",
      "owner": "layout-file",
      "key": [
        "project",
        "view",
        "entity"
      ],
      "fields": [
        {
          "name": "project",
          "type": "project-name"
        },
        {
          "name": "view",
          "type": "view-id"
        },
        {
          "name": "entity",
          "type": "entity-id",
          "description": "A leaf node of the view."
        },
        {
          "name": "x",
          "type": "number",
          "description": "Absolute ground-plane position, rounded to 0.01."
        },
        {
          "name": "z",
          "type": "number",
          "description": "Absolute ground-plane position, rounded to 0.01."
        }
      ],
      "retention": "specs/<project>/layout.jsonc, {exegraLayout: \"0.1\", views: {<view>: {positions: {<entity>: [x, z]}}}}; written by the workspace service under a base-hash check, one journal line per write (file layout), and overwritten without a check by a bundle import. specs/exegra has none.",
      "description": "Presentation only: MovePresentationNode and ReplaceLayout change it with persistence \"layout\" and never change the semantic hash (src/core/operations.js). Parsed by parseLayout into Project.layout (copy parsed-layout)."
    },
    {
      "id": "recorded-results",
      "name": "Recorded verification results",
      "owner": "recorded-results-file",
      "key": [
        "project",
        "evidence-id"
      ],
      "fields": [
        {
          "name": "project",
          "type": "project-name"
        },
        {
          "name": "evidence-id",
          "type": "evidence-id"
        },
        {
          "name": "outcome",
          "type": "'pass' | 'fail'"
        },
        {
          "name": "detail",
          "type": "text",
          "description": "Up to the last 20 lines of test output for a fail; \"the reference matched no test\" for a pattern that selected nothing."
        },
        {
          "name": "ran-at",
          "type": "iso-timestamp",
          "description": "Wall-clock time of the run (new Date().toISOString() in cli/commands.js runVerify); display only, never read by the claim evaluator."
        },
        {
          "name": "traceability",
          "type": "traceability-report",
          "description": "{checkedModules, missingModules, unclaimedFiles, claimedFiles} of tools/traceability.js checkTraceability at the time of the run."
        },
        {
          "name": "kept-keys",
          "type": "json",
          "description": "tool, version, source, claims and lint of the previous file, which verify carries over unchanged."
        }
      ],
      "retention": "specs/<project>/evidence/results.json, written only by exegra verify (tools/workspace.js writeRecorded(), atomic, no base-hash check, no journal line) and replaced whole on every run; carried in a bundle by export and overwritten by import.",
      "description": "Derived from executing the test evidence; the file is the authority for what was executed. Not bound to a code or model hash (unknown on recorded-results-file). The browser re-reads it when the watcher reports file \"recorded\" (src/app/session.js onExternalChange)."
    },
    {
      "id": "external-claim-outcomes",
      "name": "External claim outcomes",
      "owner": "recorded-results-file",
      "key": [
        "project",
        "claim-id"
      ],
      "fields": [
        {
          "name": "project",
          "type": "project-name"
        },
        {
          "name": "claim-id",
          "type": "claim-id"
        },
        {
          "name": "outcome",
          "type": "'pass' | 'fail'"
        },
        {
          "name": "status",
          "type": "claim-status",
          "description": "Optional status the external tool reports."
        },
        {
          "name": "detail",
          "type": "text"
        },
        {
          "name": "proofs",
          "type": "json",
          "description": "Optional proof references."
        },
        {
          "name": "tool",
          "type": "text",
          "description": "The top-level tool key of evidence/results.json."
        }
      ],
      "retention": "The claims key of specs/<project>/evidence/results.json; exegra verify keeps it unchanged (cli/commands.js runVerify) and an import overwrites it with the rest of the file.",
      "description": "Outcomes of claims an external verification tool checked (recorded.claims). Read by evaluateOne (src/core/claims.js) and reported as supported or violated with the statement that Exegra did not check it. DISCREPANCY (WG-4775, finding F03): nothing in this repository writes it; exegra prove writes only formal/generated/<scenario>.lean (tools/prove.js). Only a tool outside Exegra can produce it."
    },
    {
      "id": "write-journal",
      "name": "Write journal",
      "owner": "workspace-service",
      "key": [
        "project",
        "seq"
      ],
      "fields": [
        {
          "name": "project",
          "type": "project-name"
        },
        {
          "name": "seq",
          "type": "number",
          "description": "Line count of the journal before the append, plus one."
        },
        {
          "name": "file",
          "type": "'spec' | 'layout'"
        },
        {
          "name": "hash",
          "type": "sha-256",
          "description": "Hash of the text written."
        },
        {
          "name": "base-hash",
          "type": "sha-256 | null",
          "description": "The base hash the write was checked against."
        },
        {
          "name": "label",
          "type": "text | null"
        },
        {
          "name": "origin",
          "type": "text | null",
          "description": "ui, source, cli, undo, redo or null; never external, since adopted changes are not written."
        },
        {
          "name": "bytes",
          "type": "number"
        }
      ],
      "retention": "specs/<project>/.history/journal.jsonl: append-only, one JSON line per accepted spec or layout write, never truncated, read in full on every write to number the next line.",
      "description": "A log of accepted writes, not an authority, and not complete. tools/workspace.js write() appends the line after the atomic replace (atomicWrite, then fs.appendFile), so a failed append leaves a replaced file without a line and the endpoint reports the write as failed. Conflicts (returned before the append), failures, bundle imports, recorded results, generated files, the Markdown importer, the benchmark generator and edits made outside Exegra write no line, and no line carries a timestamp. Observed (WG-4775 inventory): the last line's hash differs from the spec file, three lines have a base hash that is not the previous line's hash, and every line has origin cli. No product code reads it."
    },
    {
      "id": "project-pointer",
      "name": "Project pointer",
      "owner": "specification-file",
      "key": [
        "project"
      ],
      "fields": [
        {
          "name": "project",
          "type": "project-name"
        },
        {
          "name": "spec",
          "type": "relative-path",
          "description": "Path of the specification relative to the project directory, ending in .jsonc."
        }
      ],
      "retention": "specs/<project>/project.jsonc, written by hand; never written by Exegra (tools/workspace.js).",
      "description": "Chooses the file that every read and write of a linked project's specification uses (tools/workspace.js specFile()); the linked-specs plugin reads it at build time (tools/vite-plugin-exegra.js exegraLinkedSpecs). A project with both spec.jsonc and a project.jsonc is refused as project.invalid."
    },
    {
      "id": "import-map",
      "name": "Import map",
      "owner": "markdown-importer",
      "key": [
        "project"
      ],
      "fields": [
        {
          "name": "project",
          "type": "project-name"
        },
        {
          "name": "categories",
          "type": "json"
        },
        {
          "name": "identity",
          "type": "json",
          "description": "project {id, name, title}."
        },
        {
          "name": "layout",
          "type": "json"
        },
        {
          "name": "source",
          "type": "relative-path",
          "description": "The Markdown tree to import."
        }
      ],
      "retention": "specs/<project>/import-map.jsonc of a linked project, written by hand; never written by Exegra.",
      "description": "Input configuration of tools/import-markdown.js (main, buildSpec)."
    },
    {
      "id": "markdown-source",
      "name": "Markdown specification source",
      "owner": "markdown-specification-source",
      "key": [
        "path"
      ],
      "fields": [
        {
          "name": "path",
          "type": "relative-path"
        },
        {
          "name": "text",
          "type": "markdown"
        },
        {
          "name": "git-commit",
          "type": "git-object-id",
          "description": "HEAD of the source repository, printed as \"Source git commit\"; kept in no other record."
        }
      ],
      "retention": "An external repository, read only.",
      "description": "The source of a linked project's specification text; tools/import-markdown.js reads the files and the .git HEAD and refs."
    },
    {
      "id": "interaction-state",
      "name": "Interaction state",
      "owner": "session",
      "key": [
        "project"
      ],
      "fields": [
        {
