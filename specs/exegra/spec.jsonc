    {
      "id": "engine-run-terminates-proved",
      "kind": "invariant",
      "statement": "Every run of an engine input that the engine accepts stops: its outcome is never running, and it has at most stepBound(stepLimit) steps.",
      "subjects": [
        "formal-semantics",
        "simulation-engine"
      ],
      "assumptions": [
        "trusted-lean-kernel",
        "trusted-lean-compiler-runtime",
        "trusted-emscripten-toolchain",
        "trusted-libuv",
        "trusted-js-glue",
        "trusted-wasm-engine"
      ],
      "rationale": "The theorem Exegra.runInput_terminates of formal/Exegra/Properties.lean, about Exegra.runInput, the definition of a run (WG-4792). The engine runs the implementation Exegra.Impl, equal to the definition on every input by Exegra.Impl.runAnyValue_eq (claim engine-run-refines-definition), so the property holds of what runs. Proved, not tested: it covers every input, not a list of scenarios.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.runInput_terminates",
        "about": [
          "Exegra.runInput"
        ]
      }
    },
    {
      "id": "lean-engine-is-exegra-lean",
      "kind": "structural",
      "statement": "The engine the JavaScript shell calls (engine.run at the Lean call boundary) is the function the native exegra-lean runs: runAny is Json.parse followed by Exegra.Api.call \"engine.run\".",
      "subjects": [
        "lean-call-boundary",
        "formal-semantics"
      ],
      "assumptions": [
        "trusted-lean-kernel",
        "trusted-lean-compiler-runtime",
        "trusted-emscripten-toolchain",
        "trusted-libuv",
        "trusted-js-glue",
        "trusted-wasm-engine"
      ],
      "rationale": "The theorem Exegra.Api.runAny_eq_parse_call of formal/Exegra/Api.lean (WG-4792): the definition on text is Json.parse followed by engine.run. Since WG-4793 engine.run is the implementation Exegra.Impl.runAnyValue, so the proof goes through the refinement theorem Exegra.Impl.runAny_eq; Exegra.Api.implRunAny_eq_parse_call states by rfl that exegra-lean (Exegra.Impl.runAny) and the boundary run one function.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Api.runAny_eq_parse_call",
        "about": [
          "Exegra.runAny",
          "Exegra.Api.call"
        ]
      }
    },
    {
      "id": "lean-registry-names-unique",
      "kind": "structural",
      "statement": "No two functions registered at the Lean call boundary share a name, so a name selects exactly one function.",
      "subjects": [
        "lean-call-boundary"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "The theorem Exegra.Api.registry_names_nodup (by decide), about Exegra.Api.registry (WG-4792). A module port that registers a duplicate name fails lake build.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Api.registry_names_nodup",
        "about": [
          "Exegra.Api.registry"
        ]
      }
    },
    {
      "id": "lean-boundary-errors-are-values",
      "kind": "structural",
      "statement": "Every call through the Lean call boundary returns a reply: an unknown function, a malformed request and a refusal come back as an error value, and the boundary lists its registered functions.",
      "subjects": [
        "lean-call-boundary"
      ],
      "assumptions": [
        "trusted-js-glue",
        "trusted-wasm-engine"
      ],
      "rationale": "Supported by tests/core/lean.test.js (WG-4792).",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "lean-theorem-method-refuses-unsound-proofs",
      "kind": "structural",
      "statement": "A lean-theorem claim is proved only when Lean reports a kernel-checked theorem that depends on no axiom beyond propext, Classical.choice and Quot.sound and whose statement mentions every named implementation constant; sorry, native_decide, an axiom of its own and an off-topic statement are refused.",
      "subjects": [
        "claim-evaluator",
        "formal-semantics"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Supported by tests/core/lean-theorem.test.js (WG-4792).",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "core-logic-in-lean",
      "kind": "structural",
      "statement": "Every implemented component of the semantic core is implemented in Lean, so the claims about the core are theorems about the code that runs and the JavaScript shell only does I/O.",
      "subjects": [
        "semantic-core"
      ],
      "assumptions": [
        "relationships-match-imports"
      ],
      "rationale": "The goal of the programme WG-4785. Violated until the per-module ports finish: the result lists the components that are not Lean yet, and the verify script expects the violation (like edits-only-via-transactions). The subsystem itself and the meta-model and method registry (data, not logic) are left out.",
      "evaluate": {
        "method": "implementation-language",
        "select": {
          "within": "semantic-core"
        },
        "exclude": [
          "semantic-core",
          "metamodel",
          "claim-method-registry"
        ],
        "language": "lean",
        "plannedBy": "WG-4785"
      }
    },
    {
      "id": "lean-core-runs-in-browser",
      "kind": "structural",
      "statement": "The Lean core, compiled to WebAssembly (wasm64), runs in the application page and reproduces golden traces exactly.",
      "subjects": [
        "lean-call-boundary",
        "simulation-engine"
      ],
      "assumptions": [
        "trusted-wasm-engine",
        "trusted-js-glue"
      ],
      "rationale": "Supported by tests/browser/lean-core.spec.js in Chrome (WG-4792). Stable Safari is not supported until it ships Memory64.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "engine-run-refines-definition",
      "kind": "invariant",
      "statement": "The engine the application runs (Exegra.Impl.runAnyValue, registered as engine.run and run by exegra-lean) returns exactly what the definition of the semantics (Exegra.runAnyValue) returns, on every parsed engine input of format 1 and format 2.",
      "subjects": [
        "formal-semantics",
        "simulation-engine",
        "lean-call-boundary"
      ],
      "assumptions": [
        "trusted-lean-kernel",
        "trusted-lean-compiler-runtime",
        "trusted-emscripten-toolchain",
        "trusted-libuv",
        "trusted-js-glue",
        "trusted-wasm-engine"
      ],
      "rationale": "The refinement theorem Exegra.Impl.runAnyValue_eq of formal/Exegra/Impl/Refinement.lean (WG-4793), built from one lemma per function of a run (stepC_compile, evalFast_eq, write'_eq, ...). The implementation parses expressions once and evaluates arithmetic on unboxed floats; the theorem carries every theorem about Exegra.runInput over to it.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Impl.runAnyValue_eq",
        "about": [
          "Exegra.Impl.runAnyValue",
          "Exegra.runAnyValue"
        ]
      }
    },
    {
      "id": "engine-call-computes-definition",
      "kind": "structural",
      "statement": "A call of engine.run at the Lean call boundary computes the definition of the semantics, Exegra.runAnyValue, on its parsed arguments.",
      "subjects": [
        "lean-call-boundary",
        "formal-semantics"
      ],
      "assumptions": [
        "trusted-lean-kernel",
        "trusted-lean-compiler-runtime",
        "trusted-emscripten-toolchain",
        "trusted-libuv",
        "trusted-js-glue",
        "trusted-wasm-engine"
      ],
      "rationale": "The theorem Exegra.Api.call_engine_run_spec of formal/Exegra/Api.lean (WG-4793): the registered function is the implementation (call_engine_run, by rfl), equal to the definition by Exegra.Impl.runAnyValue_eq.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Api.call_engine_run_spec",
        "about": [
          "Exegra.Api.call",
          "Exegra.runAnyValue"
        ]
      }
    },
    {
      "id": "fast-json-writer-is-json-write",
      "kind": "invariant",
      "statement": "The in-place JSON writer the engine writes traces with (Exegra.Impl.JsonOut.write') gives the text of the definition Exegra.Json.write for every value.",
      "subjects": [
        "formal-semantics"
      ],
      "assumptions": [
        "trusted-lean-kernel",
        "trusted-lean-compiler-runtime"
      ],
      "rationale": "The theorem Exegra.Impl.JsonOut.write'_eq of formal/Exegra/Impl/Json.lean (WG-4793), by mutual induction over values; Json.write is total (structural recursion).",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Impl.JsonOut.write'_eq",
        "about": [
          "Exegra.Impl.JsonOut.write'",
          "Exegra.Json.write"
        ]
      }
    }
  ],

  // ---- Evidence --------------------------------------------------------------------------
  // Evidence of kind test is executed by `exegra verify`; until it has run it shows no recorded
  // execution. A pattern after # is matched against test titles; titles containing a comma or
  // semicolon are referenced by a prefix because verify accepts neither in a reference.
  "evidence": [
    { "id": "ev-roundtrip-core", "claim": "edit-representations-equivalent", "kind": "test", "ref": "tests/core/roundtrip.test.js", "description": "Visual and textual routes to a change yield equal semantic state; a visual edit changes exactly one value in the source; undo and redo restore the exact text." },
    { "id": "ev-browser-inspector-rename", "claim": "edit-representations-equivalent", "kind": "test", "ref": "tests/browser/exegra.spec.js#inspector rename persists to spec.jsonc and survives reload", "description": "A rename in the inspector reaches the scene, the source and the file on disk, and survives a reload." },
    { "id": "ev-browser-source-edit", "claim": "edit-representations-equivalent", "kind": "test", "ref": "tests/browser/exegra.spec.js#source edit updates the scene", "description": "A source edit updates the scene. The full title continues '; invalid source is rejected and the draft is kept'." },
    { "id": "ev-workspace-write", "claim": "file-matches-model-after-save", "kind": "test", "ref": "tests/core/workspace.test.js#write with the current baseHash succeeds", "description": "A write with the current base hash replaces the file and changes its hash." },
    { "id": "ev-browser-persists", "claim": "file-matches-model-after-save", "kind": "test", "ref": "tests/browser/exegra.spec.js#inspector rename persists to spec.jsonc and survives reload", "description": "The edited text is on disk after the edit." },
    { "id": "ev-roundtrip-rejected", "claim": "rejected-edit-changes-nothing", "kind": "test", "ref": "tests/core/roundtrip.test.js#invalid operations are rejected atomically", "description": "A rejected operation leaves the committed model untouched." },
    { "id": "ev-browser-rejected-source", "claim": "rejected-edit-changes-nothing", "kind": "test", "ref": "tests/browser/exegra.spec.js#source edit updates the scene", "description": "An invalid source draft is rejected and the scene keeps showing the committed model." },
    { "id": "ev-workspace-conflict", "claim": "conflict-never-overwrites", "kind": "test", "ref": "tests/core/workspace.test.js#write with a stale baseHash conflicts", "description": "A write with a stale base hash conflicts and leaves the file untouched." },
    { "id": "ev-layout-core", "claim": "layout-moves-are-not-semantic", "kind": "test", "ref": "tests/core/roundtrip.test.js#moving a node is presentation only", "description": "Moving a node cannot change the semantic hash or the specification text." },
    { "id": "ev-layout-browser", "claim": "layout-moves-are-not-semantic", "kind": "test", "ref": "tests/browser/exegra.spec.js#moving a node changes layout.jsonc only", "description": "Dragging a node in the real application changes only layout.jsonc." },
    { "id": "ev-simulation-core", "claim": "simulation-deterministic", "kind": "test", "ref": "tests/core/sim.test.js", "description": "Identical inputs give deep-equal traces; reset and stepwise runs equal a single run." },
    { "id": "ev-generate-core", "claim": "generation-deterministic", "kind": "test", "ref": "tests/core/generate.test.js", "description": "Two runs are byte-identical; equivalent source texts give the same artifacts." },
    { "id": "ev-workspace-confinement", "claim": "persistence-confined-to-workspace", "kind": "test", "ref": "tests/core/workspace.test.js", "description": "Invalid names, escaping paths, unknown files and generated paths outside generated/ are refused." },
    { "id": "ev-roundtrip-invalid-draft", "claim": "invalid-source-keeps-last-valid-model", "kind": "test", "ref": "tests/core/roundtrip.test.js#an invalid source draft is rejected", "description": "An invalid source draft is rejected with diagnostics and the committed model is not corrupted." },
    { "id": "ev-browser-invalid-draft", "claim": "invalid-source-keeps-last-valid-model", "kind": "test", "ref": "tests/browser/exegra.spec.js#source edit updates the scene", "description": "In the application the rejected draft is kept as typed." },
    { "id": "ev-model-unsupported", "claim": "unsupported-constructs-are-diagnosed", "kind": "test", "ref": "tests/core/model.test.js#unsupported constructs", "description": "Unsupported constructs are diagnosed, never silently dropped." },
