// Part of the specification: claims, evidence.
{
  "claims": [
    {
      "id": "results-report-ranges",
      "kind": "invariant",
      "statement": "A result over a parameter given as a range is reported as a spread (minimum, maximum and stated percentiles) across a seeded sweep, never as a single figure.",
      "rationale": "Planned (WG-4670). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "claim-evaluator",
        "claim-method-registry"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "statistical-claims-state-their-basis",
      "kind": "invariant",
      "statement": "Every statistical claim result names its number of runs, seed and confidence, is never shown as verified, and a statistical claim without that basis is a validation error.",
      "rationale": "Planned (WG-4670). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "claim-evaluator",
        "claim-method-registry"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "contract-events-validated",
      "kind": "invariant",
      "statement": "An event that names a contract has a role, and validation rejects, with the position of the event, a request whose payload has a field that is not an input of the contract, an input that is not optional and missing, or a field type that is not assignable to the input type; a response with a field that is not an output; an error without a code, or with a literal code that is not among the contract's errors; and a correlation field that is not a payload field.",
      "subjects": [
        "contract-conformance",
        "validator"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "trace-contract-conformance",
      "kind": "invariant",
      "statement": "On a simulated trace, every contract event's payload values fit the declared types, an error code is among the contract's errors, and every response or error answers an earlier unanswered request of the same contract (matched by the correlation field when one is declared, otherwise by count); each violation is a failed automatic check of the scenario with its step, shown by exegra simulate and the simulator panel, which also render the contract events as a request log.",
      "subjects": [
        "contract-conformance",
        "claim-evaluator",
        "simulator-panel"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "browser-tests-run-real-application",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "trace-claim-verified-needs-negative",
      "kind": "invariant",
      "statement": "A trace claim is reported verified only when it holds on every listed scenario and each of its declared negatives, of which there is at least one, violates it. A claim with no negative, or with a negative that holds or does not finish, is inconclusive.",
      "rationale": "A trace check that nothing can make fail checks how the model was written, not the design. A negative shows the claim can fail: the same script with the protection removed by a fault produces a violation.",
      "subjects": [
        "claim-evaluator",
        "claim-method-registry"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "trace-claims-state-how-decided",
      "kind": "invariant",
      "statement": "A trace claim's result says what its verdict rests on: the declaration order of two unguarded enabled transitions that decided which fired, a precedes ordering that only the scenario script witnesses (not verified), a never over an occurrence only a faultOnly transition can produce (holds for runs without the enabling fault), and an implication whose consequent names no state or variable (not exercised).",
      "rationale": "Supported by tests/core/claim-diagnostics.test.js (the ev-trace-* evidence entries). A later transition that has a guard is not examined for order: whether its guard held is not evaluated there.",
      "subjects": ["claim-evaluator"],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "models-property-evaluated",
      "kind": "invariant",
      "statement": "The models property that links a check over the behavior model to a requirement is evaluated: a requirement's result lists the claims that name it with their statuses (modelledBy, shown by claims and in the inspector), without changing the requirement's own status, and a models value that is not a requirement is a validation error.",
      "rationale": "Supported by tests/core/claim-diagnostics.test.js (ev-models-*).",
      "subjects": ["claim-evaluator","validator"],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "own-behavioral-claims-falsifiable",
      "kind": "invariant",
      "statement": "Every behavioral claim of this specification declares a negative that violates it, and every one is verified.",
      "rationale": "Exegra applies the negative rule to itself first: each edit-flow claim is shown capable of failing by a fault that models a defect the code could have.",
      "subjects": [
        "claim-evaluator",
        "visual-edit-flow",
        "source-edit-flow",
        "rejected-edit",
        "edit-with-disk-conflict"
      ],
      "assumptions": [
        "machines-abstract-the-code",
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "metric-claims-report-basis",
      "kind": "invariant",
      "statement": "Every metric-bound claim result reports its runs, seeds, passes, N', fraction, confidence, the spread of the per-run statistic and its underpowered and truncated runs; a positive result is model-holds, never verified and never supported; samples follow the request lifecycle; an underpowered run (a quantile, mean, or ratio of counts with fewer than 30 expected on its rarer side) is left out only for an open-started class and otherwise does not satisfy the bound; it reads model-holds or fails only when the exact binomial test on the N' runs kept decides it and inconclusive otherwise; and a negative that does not fail, or a control negative that does not hold, makes it inconclusive.",
      "rationale": "Planned (WG-4715; specified in docs/simulation.md, Claims over metrics and Request lifecycle). Refines statistical-claims-state-their-basis (WG-4670); the status name follows WG-4703. Negative twin: a false-positive ratio claim of at most 0.001 over 400 requests must be refused at validation rather than pass vacuously; a population-workload fixture whose collapse leaves too few samples must fail, not read inconclusive; 91 passes of 92 kept runs must be inconclusive; any path that maps a metric result to verified or supported fails the test. Not evaluated until recorded evidence exists.",
      "subjects": [
        "metric-claims",
        "claim-evaluator",
        "claim-method-registry"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code",
        "seeded-streams-independent"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "pool-classes-protect-move-db-leg-under-flood",
      "kind": "measured",
      "statement": "On the pool fixture (tests/fixtures/queueing/pool-flood.json: a 20-connection pool with classes money, moves and page-reads in front of 4 shared database I/O channels; moves at 1,000/s; a page-read flood of 5,000/s from 2 s to 6 s), the p99 of the modelled database leg of a move over the flood window is at most 30 ms in at least 95% of runs at 95% confidence over 59 runs, in the base scenario and in its control without the flood; it fails in each of its two negative twins, and each twin fault leaves the control holding.",
      "rationale": "Fixture specified in docs/simulation.md, Fixtures (database pool with classes under a page-read flood), with base, control and twins, built at the engine-input level (WG-4729) and sized so a run stays short. Parameters are assumed; a holding result is model-holds, never supported. The model covers only the database leg (pool wait and I/O). Negative twins: collapse-classes on the pool, and set-class-limit page-reads 12 (moves keep their reserved connections but queue behind page reads on the shared I/O channels): both must fail at 95% confidence and hold in the control.",
      "subjects": [
        "metric-claims",
        "resource-model",
        "workload-model",
        "performance-metrics"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code",
        "seeded-streams-independent"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "metric-claims-calibrated-or-unvalidated",
      "kind": "invariant",
      "statement": "A metric claim reads unvalidated when it names no calibration, when a calibration fails on its hold-out load runs (distinct from the fitting runs, with equal workload, capacities and window; the sign-test interval of the model median over at least 6 kept runs, with no truncated run, outside the measurement band widened over repeats), when its evidence has expired at the asOf date recorded in the result or is bound to another component revision, or when a calibration tolerance exceeds the margin computed from the beta-quantile of the per-run statistic; it is flagged extrapolated outside the convex hull of the tested points with the same fault set, decided in exact rational arithmetic; and its result lists first the assumed and to-be-measured parameters, and pairs of flagged parameters, whose variation over their declared ranges flips the verdict.",
      "rationale": "Planned (WG-4715; specified in docs/simulation.md, Calibration and sensitivity). Negative twin: a calibration whose hold-out run is also its fitting run must be refused; a hold-out run whose measured p99 is twice the model's must fail and leave the claim unvalidated; a calibration with 10% tolerance on a claim with a 5% margin must not validate it; a fixture whose verdict flips when the page-read class limit is doubled must list that parameter. Not evaluated until recorded evidence exists.",
      "subjects": [
        "metric-claims",
        "performance-metrics"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "metric-claims-in-specifications",
      "kind": "invariant",
      "statement": "A specification that declares resources, workloads, request classes and a format-2 scenario derives a version-2 engine input (times in base units, rates exact, distributions lowered), and a metric-bound claim over it evaluates to model-holds, violated or inconclusive with its run count and confidence, never verified or supported.",
      "rationale": "WG-4729, docs/simulation.md, Specification-level form and Claims over metrics. Negative: a bound the model misses must read violated with a replayable seed.",
      "subjects": [
        "metric-claims",
        "workload-model",
        "resource-model"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "recorded-results-read-stale-on-stamp-mismatch",
      "kind": "invariant",
      "statement": "exegra verify records every evidence result with the records stamp of the tree (tools/tree-stamp.js: the tree stamp without the project's results.json and generated artifacts), and the command line evaluates claims against the current stamps: an evidence result or an external tool's outcome recorded on another stamp, or on none, is stale; a stale pass establishes nothing, so a claim resting on it is not evaluated, with an explanation that starts with Stale and the diagnostic claim.stale-evidence; a stale fail still contradicts its claim.",
      "subjects": [
        "claim-evaluator",
        "verification-pipeline",
        "recorded-results-file"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "rationale": "Closes epistemics D2 and the architecture finding that recorded results carried no provenance. The status set stays closed: staleness is reported as not-evaluated with the freshness field stale and a diagnostic, not as a new status, because CLAIM_STATUSES, the admit ranks, the summaries and the generators all enumerate the seven statuses, and the status lattice that will carry freshness as its own component is milestone M3. The results file and generated artifacts are left out of the stamp so that writing them does not make the results they hold stale.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "recorded-results-unverifiable-without-stamp",
      "kind": "invariant",
      "statement": "Where no current stamp can be computed (the application in the browser), a claim status resting on recorded facts keeps its value but carries freshness unverifiable, the diagnostic claim.freshness-unverifiable and, when the status is positive, an explanation that says so; the verification panel says the recorded results' freshness is unverifiable there.",
      "subjects": [
        "claim-evaluator",
        "verification-panel"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "rationale": "The page cannot stamp the working tree, so it neither trusts recorded results silently nor hides them. The browser part (the panel line) has no browser test of its own; the evidence covers the evaluator.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "lean-theorem-requires-code-about",
      "kind": "invariant",
      "statement": "A lean-theorem claim is refused (violated) when it names no implementation constant in about, or when a named constant is opaque, or is reported implemented_by, extern or partial, because a theorem about such a constant says nothing about the code that runs.",
      "subjects": [
        "claim-evaluator"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Encodes the cases of finding L1 of docs/assessment/2026-11-26/lean.md that are reachable from the recorded facts: a claim with no about was proved, and an opaque about constant was accepted. tools/lean-theorems.js does not yet report implemented_by, extern or partial for a definition, so those refusals apply only to records that carry them; a partial def and an implemented_by opaque are opaque constants and are refused. The tautology case of L1 (a statement that mentions the code but says nothing about it) needs the statement binding of milestone M3 and is not decided here.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "lean-theorem-records-stale-on-source-change",
      "kind": "invariant",
      "statement": "Each recorded Lean theorem check carries the hash of the formal/ sources it was checked on, the records stamp of the tree and the hash of the theorem statement as Lean printed it; when Lean does not run (not installed, or EXEGRA_NO_LEAN=1) a recorded check whose formal hash differs from that of the current sources, or that carries none, does not keep its claim proved: the claim is not evaluated, with an explanation that starts with Stale and the diagnostic claim.stale-theorem.",
      "subjects": [
        "claim-evaluator",
        "verification-pipeline"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Closes epistemics D3 and lean.md L2: replacing a proof by sorry and running verify without Lean kept all lean-theorem claims proved. A refusal recorded on other sources still stands, since staleness never improves a status. The statement hash is recorded for review and for admission of statement changes (milestone M10); nothing compares it yet.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "metric-open-started-computed",
      "kind": "invariant",
      "statement": "A metric-bound claim leaves an underpowered run out only for a request class that the engine input shows to be open-started (its named workload is open, or with none named an open workload issues its start event and no closed or population workload, behavior emit or then, scenario step or injected fault can); for every other class, and for a run with duplicate starts, an underpowered run is kept and does not satisfy the bound; nothing defaults a class to open-started.",
      "subjects": [
        "metric-claims"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "rationale": "Encodes docs/assessment/2026-11-26/demos/metric-demo1.mjs and simulation.md finding F1: openStarted defaulted to true and was never computed, so 40 collapsing runs of 100 on a closed workload were left out and the claim read model-holds; it now reads violated.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "concordance-results-are-evidence",
      "kind": "structural",
      "statement": "A linked project's Concordance results (concordanceResults in project.jsonc) become derived test evidence of their claims: a pass makes a requirement supported and never verified, a fail makes it violated, a claim without an entry stays not evaluated, and a results file for another tool or specification, or an entry for an unknown claim, changes no status. A results file that names a specSha256 (the sha-256 of the specification text it was computed from) is not applied when that differs from the current text; one that names none is applied with its revision recorded as unknown, and its explanation says so.",
      "subjects": [
        "claim-evaluator",
        "workspace-service"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/concordance.test.js (the ev-concordance-* evidence entries).",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "lean-theorem-method-refuses-unsound-proofs",
      "kind": "structural",
      "statement": "A lean-theorem claim is proved only when Lean reports a kernel-checked theorem that depends on no axiom beyond propext, Classical.choice and Quot.sound and whose statement mentions every named implementation constant; sorry, native_decide, an axiom of its own and an off-topic statement are refused.",
      "subjects": [
        "claim-evaluator",
        "formal-semantics"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Supported by tests/core/lean-theorem.test.js (WG-4792).",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "refines-checks-machine-refinement",
      "kind": "invariant",
      "statement": "A refines claim is verified only when, in the traces of the scenarios that run the implementation behavior and in every execution of their inputs that delivers simultaneous entries in another order, every initial configuration and every fired transition of it maps through its refinement mapping to the step its model machine takes or to a stutter, every input it ignores is one its model ignores from the mapped configuration, and at least one step matched a model transition; a step to the wrong model state, a step whose model guard is false, a wrong mapped post-variable, a moving step mapped to a stutter, different emitted events, a wrong initial state and an ignored input the model would take (reason ignored-input) each make it violated, with the failing step as the last step of the counterexample trace. Timers the implementation sets are compared with the model's timers when the model transition sets some and are internal to the implementation otherwise; a model guard or effect that reads another behavior reads it from the same trace, through the machine that refines that behavior when it does not run itself. With refinement.timeScale, the model reads the trace time divided by it and its timer delays are compared multiplied by it. A delayed emit of the model is realised only by a delayed emit of the implementation for the same event and the payload fields the model sets, delivered after the model delay times the time scale; a timer never realises an emit, and an undelayed emit for a delayed one, or the reverse, is violated (reason emits). A failure the engine's order does not reach is violated with the delivery order in the counterexample; an exploration that reaches its configuration cap or the step limit, or a scenario with faults, sampled delays, cancellations or instances, is inconclusive and never verified.",
      "rationale": "Supported by tests/core/refinement.test.js. The engine trace of each scenario is checked, then every order of simultaneous entries of its input (WG-4852, WG-5685 criterion 10); fault masks and draws are not enumerated, so a scenario with them is inconclusive. The check is JavaScript in the verdict-kernel component claim-evaluator and is listed by core-logic-in-lean until it is ported.",
      "subjects": [
        "claim-evaluator"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "machine-transition-coverage",
      "kind": "invariant",
      "statement": "For every implementation-level machine whose realisation is shipped, exegra cover-machines reports, per machine, the transitions and guard outcomes (true and false of each guard) covered out of the total, read from the traces of the scenarios that run it; for each item they leave out it searches bounded sequences of the machine's input events with representative payloads and waits, keeps the runs that reach it as generated scenarios cover-<machine>-<n> whose traces exercise it, and writes them with --write as CreateEntity operations tagged generated-coverage that apply accepts and that, once applied, cover the same items; a transition reached by no scenario and no searched sequence is machine.transition-unreachable, a warning, or an error under system.generation.",
      "rationale": "WG-4965, item 2: every transition and guard outcome of every shipped machine should be exercised by a scenario both differentials run, and a machine with an unreachable transition reported. Evidence is tests/core/machine-coverage.test.js on tests/fixtures/machine-coverage/spec.jsonc, a door whose one scenario covers a guard false and whose jammed state nothing enters. Supported, not verified: the search is bounded and its claims of unreachability are within the bound.",
      "subjects": [
        "machine-coverage",
        "agent-cli"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "claim-strength-names-weak-checks",
      "kind": "structural",
      "statement": "claimStrength reports a state invariant whose variables only fault transitions assign as holds-by-construction, naming the variables and those transitions; a counter bound equal to the extreme of its one scenario as restated-scenario; any other trace claim as single-trace, unless the caller supplies an exploration that found it holding (explored); and never changes a status.",
      "subjects": [
        "claim-strength"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/claim-strength.test.js (WG-5274), on fixtures that reproduce hl-chk-rx-continuous-renewal, hl-chk-gf-no-creation-after-loss and hl-chk-ag-forbidden-refused of the Harbourline fold.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "claim-strength-grounding",
      "kind": "structural",
      "statement": "claimStrength reports a claim whose behaviors branch only on payload fields of contract-less events as self-contained and names those fields, a claim over a behavior that reacts to a contract event as bound with the capabilities the contract requires, an integrity rule over the real roles as bound, and under a baseline counts an entity the change adds as anchoring nothing.",
      "subjects": [
        "claim-strength"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/claim-strength.test.js (WG-5276).",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "verdict-status-partial-order",
      "kind": "invariant",
      "statement": "Status.le is a decidable partial order on statuses: reflexive, transitive and antisymmetric (two statuses each at most the other are equal).",
      "subjects": [
        "claim-verdict"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem of formal/Exegra/Verdict.lean (with Status.le_refl and Status.le_trans and the decidability instance); WG-5684 criterion 1.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Verdict.Status.le_antisymm",
        "about": [
          "Exegra.Verdict.Status.le"
        ]
      }
    },
    {
      "id": "verdict-conjunction-meet",
      "kind": "invariant",
      "statement": "The strength of the status of a conjunction is the meet of the strengths of its parts: (status (conj cs) fs).strength = meet of (status c fs).strength over c in cs.",
      "subjects": [
        "claim-verdict"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem status_conj of formal/Exegra/Verdict.lean; WG-5684 criterion 2 (a). An empty conjunction is undecided.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Verdict.status_conj",
        "about": [
          "Exegra.Verdict.status",
          "Exegra.Verdict.Strength.meetAll"
        ]
      }
    },
    {
      "id": "verdict-contradiction-lowers",
      "kind": "invariant",
      "statement": "A fact that contradicts a claim never raises its status: Contradicts f c implies status c (fs ++ [f]) <= status c fs.",
      "subjects": [
        "claim-verdict"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem contradict_lowers of formal/Exegra/Verdict.lean; WG-5684 criterion 2 (b).",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Verdict.contradict_lowers",
        "about": [
          "Exegra.Verdict.status",
          "Exegra.Verdict.Contradicts"
        ]
      }
    },
    {
      "id": "verdict-staleness-never-raises",
      "kind": "invariant",
      "statement": "Reading every fact as stale never raises a status: status c (fs.map markStale) <= status c fs.",
      "subjects": [
        "claim-verdict"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem stale_never_raises of formal/Exegra/Verdict.lean; WG-5684 criterion 2 (c).",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Verdict.stale_never_raises",
        "about": [
          "Exegra.Verdict.status",
          "Exegra.Verdict.markStale"
        ]
      }
    },
    {
      "id": "verdict-refuted-assumption-undecided",
      "kind": "invariant",
      "statement": "A claim one of whose assumptions is refuted by the facts is undecided: a in c.assumptions and assumptionRefuted a fs imply (status c fs).strength = undecided.",
      "subjects": [
        "claim-verdict"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem refuted_assumption_undecided of formal/Exegra/Verdict.lean; WG-5684 criterion 2 (d). The assumptions of a conjunction are those every part rests on.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Verdict.refuted_assumption_undecided",
        "about": [
          "Exegra.Verdict.status",
          "Exegra.Verdict.assumptionRefuted",
          "Exegra.Verdict.Claim.assumptions"
        ]
      }
    },
    {
      "id": "verdict-established-iff",
      "kind": "invariant",
      "statement": "A status is shown established exactly when its strength is proved, it is fresh and it has no open assumption.",
      "subjects": [
        "claim-verdict"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
