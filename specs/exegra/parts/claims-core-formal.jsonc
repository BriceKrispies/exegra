        ]
      }
    },
    {
      "id": "behav-exec-step-failed",
      "kind": "structural",
      "statement": "When the executable scheduler of the behaviour calculus fails a step, the calculus's transition system has a step to the explicit error state carrying the configuration before the step.",
      "subjects": [
        "lts-foundation"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem Exec.step_failed of formal/Exegra/Core/BehavExec.lean (plan-M2, M2.3): a failed step is a counterexample state of the relation, never a missing step.",
      "evaluate": {
