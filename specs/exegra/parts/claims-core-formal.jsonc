      }
    },
    {
      "id": "behav-exec-idle-deadlocked",
      "kind": "structural",
      "statement": "When the executable scheduler of the behaviour calculus is idle on a state whose queue is sorted, the calculus's transition system has no step from that state.",
      "subjects": [
        "lts-foundation"
