    {
      "id": "two-session-write",
      "name": "One conditional edit",
      "description": "A conditional write of value against base, tagged with an attempt id.",
      "payload": [
        {
          "name": "attempt",
          "type": "string"
        },
        {
          "name": "base",
          "type": "string"
        },
        {
          "name": "value",
          "type": "string"
        }
      ]
