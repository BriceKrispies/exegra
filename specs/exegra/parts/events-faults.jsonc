// Events and faults.
{
  // ---- Events (the vocabulary of Exegra's own edit flow) ---------------------------------
  "events": [
    {
      "id": "edit-requested",
      "name": "Edit requested",
      "description": "A gesture in the scene, inspector or a dialog asks for a change; it becomes a typed operation.",
      "producedBy": "browser-user",
      "payload": [
        {
          "name": "text",
          "type": "string"
        }
      ]
    },
    {
      "id": "source-apply-requested",
      "name": "Source apply requested",
      "description": "The user applies the draft in the source editor; it becomes a ReplaceSource operation.",
      "payload": [
        {
          "name": "text",
          "type": "string"
        }
      ]
    },
    {
      "id": "operation-submitted",
      "name": "Operation submitted",
      "description": "A typed operation reaches the transaction system through session.apply.",
      "payload": [
        {
          "name": "text",
          "type": "string"
        }
      ]
    },
    { "id": "text-edits-computed", "name": "Text edits computed", "description": "Preconditions held and the operation's source-preserving text edits produced a candidate specification text." },
    { "id": "model-parsed", "name": "Candidate model parsed", "description": "The candidate text was parsed into a candidate model." },
    { "id": "validation-passed", "name": "Validation passed", "description": "The candidate model has no validation errors." },
    { "id": "validation-failed", "name": "Validation failed", "description": "The candidate has validation errors; the transaction is refused." },
    { "id": "transaction-committed", "name": "Transaction committed", "description": "The revision increased and a new model snapshot exists; the commit listener of the session runs.", "payload": [
        {
          "name": "revision",
          "type": "number"
        },
        {
          "name": "text",
          "type": "string"
        }
      ] },
    { "id": "transaction-rejected", "name": "Transaction rejected", "description": "The transaction was refused; nothing changed." },
    { "id": "refresh-requested", "name": "Refresh requested", "description": "The session re-evaluates claims, re-projects and re-lays-out the scene for the committed revision.", "payload": [{ "name": "revision", "type": "number" }] },
    { "id": "projection-refreshed", "name": "Projection refreshed", "description": "The scene for the committed revision was derived and handed to the renderer.", "payload": [{ "name": "revision", "type": "number" }] },
    { "id": "model-published", "name": "Model published", "description": "The session announced the commit to the inspector and the source editor.", "payload": [{ "name": "revision", "type": "number" }] },
    {
      "id": "save-succeeded",
      "name": "Save succeeded",
      "description": "The file service replaced the file; its hash is the new base hash. Real run: recorded in the res.ok branch of flush in src/app/session.js (hashes[file] = res.hash, session.note save).",
      "payload": [
        {
          "name": "file",
          "type": "'spec' | 'layout'"
        },
        {
          "name": "hash",
          "type": "string"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ]
    },
    {
      "id": "save-conflicted",
      "name": "Save conflicted",
      "description": "The file on disk differed from the base hash; the file service returned a conflict and wrote nothing. Real run: recorded in the conflict branch of flush in src/app/session.js (conflict = {file, current}).",
      "payload": [
        {
          "name": "file",
          "type": "'spec' | 'layout'"
        },
        {
          "name": "currentHash",
          "type": "string"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ]
    },
    {
      "id": "write-intent",
      "name": "Write intended",
      "description": "The session decides to write the committed text of a project file to disk. Real run: recorded in the loop of flush (src/app/session.js) just before persist.writeFile(name, file, text, hashes[file], lastMeta, {requestId, textHash}); text is the sha-256 of the text.",
      "payload": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "file",
          "type": "'spec' | 'layout'"
        },
        {
          "name": "text",
          "type": "string"
        },
        {
          "name": "baseHash",
          "type": "string"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ]
    },
    {
      "id": "write-file-request",
      "name": "Write file",
      "description": "The persistence client sends the text of a project file with the base hash it last read. Real run: recorded by src/persist/client.js writeFile() before POST /__exegra/write; text is recorded as its sha-256.",
      "contract": "write-file",
      "role": "request",
      "payload": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "file",
          "type": "'spec' | 'layout'"
        },
        {
          "name": "text",
          "type": "string"
        },
        {
          "name": "baseHash",
          "type": "string | null"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ]
    },
    {
      "id": "write-file-ok",
      "name": "Write accepted",
      "description": "The development server replaced the file and returns the hash of the text now on disk. Real run: produced by route() of tools/vite-plugin-exegra.js after tools/workspace.js write() returned ok, sent in the x-exegra-trace header of the 200 answer and appended by src/persist/client.js request().",
      "contract": "write-file",
      "role": "response",
      "payload": [
        {
          "name": "ok",
          "type": "true"
        },
        {
          "name": "hash",
          "type": "string"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "correlation": "requestId"
    },
    {
      "id": "write-file-conflict",
      "name": "Write refused",
      "description": "The file on disk differs from the base hash: nothing is written and the current hash is returned. Real run: produced by route() of tools/vite-plugin-exegra.js for the conflict tools/workspace.js write() returned before any write or journal line, sent with the 409 answer.",
      "contract": "write-file",
      "role": "error",
      "payload": [
        {
          "name": "code",
          "type": "'conflict'"
        },
        {
          "name": "current",
          "type": "string"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "correlation": "requestId"
    },
    {
      "id": "write-file-failed",
      "name": "Write failed",
      "description": "Any other answer to a write: the request guard, an invalid body or name, or a failure inside the write. Real run: produced by the catch of the middleware in tools/vite-plugin-exegra.js exegraDevServer (failed, with the error code), sent with the answer. A journal line that cannot be appended does not produce it: write() then returns ok with journal.written false.",
      "payload": [
        {
          "name": "code",
          "type": "'internal' | 'name.invalid' | 'body.invalid' | 'host.forbidden'"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "write-file",
      "role": "error",
      "correlation": "requestId"
    },
    {
      "id": "read-project-request",
      "name": "Read project",
      "description": "The persistence client asks for a project's files. Real run: recorded by src/persist/client.js readProject() before GET /__exegra/project, called by session.open() and session.onExternalChange() (src/app/session.js).",
      "payload": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "read-project",
      "role": "request"
    },
    {
      "id": "read-project-ok",
      "name": "Project read",
      "description": "The files of the project with their hashes. Real run: produced by route() of tools/vite-plugin-exegra.js for GET /__exegra/project after tools/workspace.js read(); spec and layout are recorded as their hashes (layout null when there is none), recorded as the sha-256 of evidence/results.json or null.",
      "payload": [
        {
          "name": "spec",
          "type": "{text, hash, path}"
        },
        {
          "name": "layout",
          "type": "{text, hash} | null"
        },
        {
          "name": "recorded",
          "type": "object | null"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "read-project",
      "role": "response",
      "correlation": "requestId"
    },
    {
      "id": "read-project-failed",
      "name": "Project not read",
      "description": "The read was refused. Real run: produced by the middleware catch of tools/vite-plugin-exegra.js for the WorkspaceError of tools/workspace.js read().",
      "payload": [
        {
          "name": "code",
          "type": "'not-found' | 'project.invalid'"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "read-project",
      "role": "error",
      "correlation": "requestId"
    },
    {
      "id": "list-projects-request",
      "name": "List projects",
      "description": "Real run: recorded by src/persist/client.js listProjects() before GET /__exegra/projects, called by session.init() and session.refreshProjects().",
      "payload": [
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "list-projects",
      "role": "request"
    },
    {
      "id": "list-projects-ok",
      "name": "Projects listed",
      "description": "Real run: produced by route() of tools/vite-plugin-exegra.js for GET /__exegra/projects; projects are recorded as the names.",
      "payload": [
        {
          "name": "projects",
          "type": "{name, title}[]"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "list-projects",
      "role": "response",
      "correlation": "requestId"
    },
    {
      "id": "watch-project-request",
      "name": "Subscribe to changes",
      "description": "Real run: recorded by src/persist/client.js watchProject() before it opens the EventSource; called at the end of session.open().",
      "payload": [
        {
          "name": "name",
          "type": "string"
        }
      ],
      "contract": "watch-project",
      "role": "request"
    },
    {
      "id": "file-change-notice-sent",
      "name": "File changed",
      "description": "Real run: produced by openEvents of tools/vite-plugin-exegra.js from the onChange callback of tools/workspace.js watch() check(), sent as a trace message just before \"event: change\".",
      "payload": [
        {
          "name": "file",
          "type": "'spec' | 'layout' | 'recorded' | 'products'"
        },
        {
          "name": "hash",
          "type": "string"
        }
      ],
      "contract": "file-change-notice",
      "role": "request"
    },
    {
      "id": "export-request",
      "name": "Export project",
      "description": "Real run: recorded by src/persist/client.js exportProject() before GET /__exegra/export, called by the Export button of src/ui/toolbar.js.",
      "payload": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "export-project",
      "role": "request"
    },
    {
      "id": "export-ok",
      "name": "Bundle exported",
      "description": "Real run: produced by route() of tools/vite-plugin-exegra.js for GET /__exegra/export after tools/workspace.js exportProject(); files is recorded as the sha-256 of the bundle's spec.jsonc.",
      "payload": [
        {
          "name": "format",
          "type": "'exegra-project'"
        },
        {
          "name": "version",
          "type": "1"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "files",
          "type": "string"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "export-project",
      "role": "response",
      "correlation": "requestId"
    },
    {
      "id": "export-failed",
      "name": "Export refused",
      "description": "Real run: produced by the middleware catch of tools/vite-plugin-exegra.js (not-found).",
      "payload": [
        {
          "name": "code",
          "type": "'not-found'"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "export-project",
      "role": "error",
      "correlation": "requestId"
    },
    {
      "id": "import-request",
      "name": "Import bundle",
      "description": "Real run: recorded by src/persist/client.js importProject() before POST /__exegra/import, called by the Import file input of src/ui/toolbar.js after its syntax check and the name prompt; bundle is recorded as the sha-256 of its spec.jsonc.",
      "payload": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "bundle",
          "type": "object"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "import-project",
      "role": "request"
    },
    {
      "id": "import-ok",
      "name": "Bundle imported",
      "description": "Real run: produced by route() of tools/vite-plugin-exegra.js for POST /__exegra/import after tools/workspace.js importProject() overwrote the files.",
      "payload": [
        {
          "name": "ok",
          "type": "true"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "import-project",
      "role": "response",
      "correlation": "requestId"
    },
    {
      "id": "import-refused",
      "name": "Bundle refused",
      "description": "Real run: produced by route() of tools/vite-plugin-exegra.js when importProject returns {ok: false, error} because validateBundle refuses the bundle, and by the middleware catch for other refusals.",
      "payload": [
        {
          "name": "code",
          "type": "'bundle.invalid'"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "import-project",
      "role": "error",
      "correlation": "requestId"
    },
    {
      "id": "generated-write-request",
      "name": "Write generated documents",
      "description": "Real run: recorded by src/persist/client.js writeGenerated() before POST /__exegra/generated, called by generate() of src/ui/realisation-panel.js; files is recorded as the sha-256 of the files with sorted keys.",
      "payload": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "files",
          "type": "object"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "write-generated",
      "role": "request"
    },
    {
      "id": "generated-write-ok",
      "name": "Generated documents written",
      "description": "Real run: produced by route() of tools/vite-plugin-exegra.js for POST /__exegra/generated.",
      "payload": [
        {
          "name": "ok",
          "type": "true"
        },
        {
          "name": "written",
          "type": "string[]"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "write-generated",
      "role": "response",
      "correlation": "requestId"
    },
    {
      "id": "engine-run-posted",
      "name": "Run posted to the worker",
      "description": "Real run: run() of src/app/engine-runner.js records it just before w.postMessage({id, input}); input is recorded as the id of the scenario the engine input was derived from (the input text is not kept).",
      "payload": [
        {
          "name": "id",
          "type": "number"
        },
        {
          "name": "input",
          "type": "string"
        }
      ],
      "contract": "engine-worker-run",
      "role": "request"
    },
    {
      "id": "engine-run-returned",
      "name": "Trace returned by the worker",
      "description": "Real run: self.postMessage({id, ok: true, trace}) in src/app/engine-worker.js, recorded by worker.onmessage of src/app/engine-runner.js; trace is recorded as the id of the scenario it is a trace of (the trace text is not kept).",
      "payload": [
        {
          "name": "id",
          "type": "number"
        },
        {
          "name": "ok",
          "type": "true"
        },
        {
          "name": "trace",
          "type": "string"
        }
      ],
      "contract": "engine-worker-run",
      "role": "response",
      "correlation": "id"
    },
    {
      "id": "engine-run-refused",
      "name": "Run refused by the worker",
      "description": "Real run: self.postMessage({id, ok: false, error}) in src/app/engine-worker.js, recorded by worker.onmessage of src/app/engine-runner.js.",
      "payload": [
        {
          "name": "code",
          "type": "'engine.refused'"
        },
        {
          "name": "id",
          "type": "number"
        },
        {
          "name": "error",
          "type": "string"
        }
      ],
      "contract": "engine-worker-run",
      "role": "error",
      "correlation": "id"
    },
    {
      "id": "cli-command-request",
      "name": "Command invoked",
      "description": "An agent or a person runs node cli/exegra.js <command>. Real run: main of cli/exegra.js, runCommand in cli/commands.js.",
      "payload": [
        {
          "name": "command",
          "type": "string"
        },
        {
          "name": "options",
          "type": "flags"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "agent-command",
      "role": "request"
    },
    {
      "id": "cli-command-ok",
      "name": "Command succeeded",
      "description": "Real run: runCommand returns {ok: true, ...}; cli/exegra.js writes it to stdout and exits 0.",
      "payload": [
        {
          "name": "ok",
          "type": "true"
        },
        {
          "name": "command",
          "type": "string"
        },
        {
          "name": "project",
          "type": "string"
        },
        {
          "name": "semanticHash",
          "type": "string"
        },
        {
          "name": "result",
          "type": "string"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ],
      "contract": "agent-command",
      "role": "response",
      "correlation": "requestId"
    },
    {
      "id": "cli-command-failed",
      "name": "Command failed",
      "description": "Real run: failure() of cli/commands.js builds {ok: false, command, project, error {code, message}, diagnostics}; cli/exegra.js exits 1 (2 for usage).",
      "payload": [
        {
          "name": "code",
          "type": "'write.conflict' | 'simulate.failed' | 'verify.failed'"
        },
        {
          "name": "command",
          "type": "string"
        },
        {
          "name": "requestId",
          "type": "number"
        },
        {
          "name": "specWritten",
          "type": "boolean"
        }
      ],
      "contract": "agent-command",
      "role": "error",
      "correlation": "requestId"
    },
    {
      "id": "session-init-requested",
      "name": "Session started",
      "description": "main.js starts the session once the engine has loaded or failed to. Real run: recorded in both branches of initEngine().then(...) in src/app/main.js just before session.init(); project as for page-loaded.",
      "payload": [
        {
          "name": "persistent",
          "type": "boolean"
        },
        {
          "name": "project",
          "type": "string"
        }
      ]
    },
    {
      "id": "project-open-requested",
      "name": "Project opened by the user",
      "description": "A project is chosen: by session.init (the requested or exegra project), the toolbar's project picker, or the toolbar after an import. Real run: recorded at the entry of session.open(name) in src/app/session.js.",
      "payload": [
        {
          "name": "name",
          "type": "string"
        }
      ]
    },
    {
      "id": "open-refused",
      "name": "Project switch refused",
      "description": "The switch is refused while a save is pending, in conflict or in error. Real run: recorded by the guard at the top of session.open (session.note error \"Resolve or wait for the pending save\").",
      "payload": [
        {
          "name": "name",
          "type": "string"
        }
      ]
    },
    {
      "id": "read-intent",
      "name": "Read requested",
      "description": "The session asks the persistence client for the project files: to open it, after an external change or after a change of the recorded results. Real run: recorded just before persist.readProject(name, {requestId}) in session.open and onExternalChange.",
      "payload": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "requestId",
          "type": "number"
        },
        {
          "name": "purpose",
          "type": "'open' | 'external' | 'recorded'"
        }
      ]
    },
    {
      "id": "project-files-read",
      "name": "Project files received",
      "description": "readProject resolved with the files. Real run: recorded after the await of persist.readProject in session.open and onExternalChange (src/app/session.js); recorded is the version of the recorded results that the server reported in its read-project-ok for the same requestId.",
      "payload": [
        {
          "name": "specHash",
          "type": "string"
        },
        {
          "name": "layoutHash",
          "type": "string"
        },
        {
          "name": "recorded",
          "type": "string"
        },
        {
          "name": "requestId",
          "type": "number"
        }
      ]
    },
    {
      "id": "project-read-failed",
      "name": "Project could not be read",
      "description": "readProject threw (unwrap of a non-2xx answer). Real run: recorded in the catch of session.open, which keeps the current project fully functional.",
      "payload": [
        {
          "name": "requestId",
          "type": "number"
        }
      ]
    },
    {
      "id": "project-opened",
      "name": "Project opened",
      "description": "The new Project exists, with the hashes taken from the read and the stored preferences applied; claims are evaluated and the watcher started after it. Real run: recorded in session.open of src/app/session.js right after the Project is constructed and the preferences of store.perProject are applied, before evaluate(); specHash is the server's hash of the text read (or its sha-256 without persistence).",
      "payload": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "specHash",
          "type": "string"
        },
        {
          "name": "layoutHash",
          "type": "string"
        }
      ]
    },
    {
      "id": "list-intent",
      "name": "Project list requested",
      "description": "Real run: recorded by session.init and session.refreshProjects (src/app/session.js) just before persist.listProjects({requestId}).",
      "payload": [
        {
          "name": "requestId",
          "type": "number"
        }
      ]
    },
    {
      "id": "projects-listed",
      "name": "Project list received",
      "description": "Real run: recorded by session.init and session.refreshProjects after session.projects is assigned; projects are the names.",
      "payload": [
        {
          "name": "projects",
          "type": "string[]"
        }
      ]
    },
    {
      "id": "watch-intent",
      "name": "Watch requested",
      "description": "Real run: recorded just before persist.watchProject(name, onExternalChange) at the end of session.open.",
      "payload": [
        {
          "name": "name",
          "type": "string"
        }
      ]
    },
    {
      "id": "external-change-received",
      "name": "Change notice received",
      "description": "Real run: recorded by the \"change\" listener of src/persist/client.js watchProject, which then calls session.onExternalChange(change).",
      "payload": [
        {
          "name": "file",
          "type": "'spec' | 'layout' | 'recorded' | 'products'"
        },
        {
          "name": "hash",
          "type": "string"
        }
      ]
    },
    {
      "id": "disk-edited-externally",
      "name": "File replaced outside the session",
      "description": "Another process replaces a project file: an editor, git, an agent's exegra apply, tools/import-markdown.js or tools/make-benchmark.js. No code observes the act itself; changeTrace of tools/vite-plugin-exegra.js infers it (marked inferred) when tools/workspace.js watch() reports a hash of the spec or layout that this server did not write.",
      "payload": [
        {
          "name": "file",
          "type": "'spec' | 'layout' | 'recorded' | 'products'"
        },
        {
          "name": "hash",
          "type": "string"
        }
      ]
    },
    {
      "id": "reload-requested",
      "name": "Adopt the file on disk",
      "description": "The session adopts text from disk with Project.reload (origin external): after an external change or when the user resolves a conflict by reloading. Real run: recorded just before session.project.reload(...) in onExternalChange and resolveConflict('reload'); text is the hash of the adopted text.",
      "payload": [
        {
          "name": "file",
          "type": "'spec' | 'layout'"
        },
        {
          "name": "text",
          "type": "string"
        }
      ]
    },
    {
      "id": "commit-notified",
      "name": "Commit notified",
      "description": "Project.#commit notifies its subscribers synchronously with {type: 'commit', result, entry}; the session's onCommit runs. Real run: recorded at the top of onCommit in src/app/session.js, after the commit's cause; file is spec when the specification text changed, else layout; text is the sha-256 of that text.",
      "payload": [
        {
          "name": "origin",
          "type": "'ui' | 'source' | 'cli' | 'external' | 'undo' | 'redo'"
        },
        {
          "name": "file",
          "type": "'spec' | 'layout'"
        },
        {
          "name": "text",
          "type": "string"
        }
