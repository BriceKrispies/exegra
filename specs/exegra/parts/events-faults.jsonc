          "name": "view",
          "type": "string"
        }
      ]
    },
    {
      "id": "preferences-written",
      "name": "Session preferences written",
      "description": "Real run: persistUi in src/app/session.js, localStorage.setItem(\"exegra.session\", ...). Recorded only when the selection or the view of the open project differs from the last one written: a write that leaves both unchanged is a stutter step of this model.",
      "payload": [
        {
          "name": "selection",
          "type": "string"
        },
        {
          "name": "viewId",
          "type": "string"
        }
      ]
    },
    {
      "id": "page-reloaded",
      "name": "Page reloaded",
