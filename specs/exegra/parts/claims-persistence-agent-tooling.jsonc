// Part of the specification: claims, evidence.
{
  "claims": [
    {
      "id": "agent-interface-uses-transactions",
      "kind": "structural",
      "statement": "The agent command line reaches the transaction system along its relationships.",
      "rationale": "Every mutation by an agent goes through Project.apply, the same pipeline as the UI.",
      "subjects": ["agent-cli", "transactions"],
      "assumptions": [
        "static-extractor-sound",
        "extracted-facts-current"
      ],
      "evaluate": { "method": "reachable", "from": "agent-cli", "to": "transactions" }
    },
    {
      "id": "conflict-never-overwrites",
      "kind": "invariant",
      "statement": "In the edit whose write conflicts with the disk, at every step, once the conflict is flagged the file on disk still holds the text the other process wrote (hx): the conflicting file is never overwritten.",
      "subjects": ["workspace-service", "session", "edit-with-disk-conflict", "write-file"],
      "assumptions": ["machines-abstract-the-code", "filesystem-honours-atomic-rename", "tests-exercise-shipped-modules", "recorded-results-reflect-current-code"],
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "edit-with-disk-conflict"
        ],
        "expr": "workspace-flow.conflict => workspace-flow.diskSpec == 'hx'",
        "negatives": [
          {
            "scenario": "edit-with-disk-conflict",
            "faults": [
              "conflict-overwrites"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "generation-deterministic",
      "kind": "invariant",
      "statement": "Two runs of the generators over the same model and inputs produce byte-identical artifacts.",
      "subjects": ["generators", "generated-artifacts"],
      "assumptions": ["tests-exercise-shipped-modules", "recorded-results-reflect-current-code"],
      "evaluate": { "method": "external-evidence" }
    },
    {
      "id": "persistence-confined-to-workspace",
      "kind": "invariant",
      "statement": "Project names are validated and every path is resolved inside specs/<project>/ before any read or write; names and paths that escape that directory are refused, and generated files can only be written under generated/. The one exception is deliberate: a project.jsonc may name a specification file outside the project directory (a linked project, such as a specification kept in its own repository), which is then read and written there. project.jsonc is not writable through the workspace endpoints (write and import accept only spec.jsonc, layout.jsonc and evidence/results.json), so only a person editing the file on disk can point a project elsewhere.",
      "subjects": ["workspace-service", "write-file"],
      "assumptions": ["tests-exercise-shipped-modules", "filesystem-honours-atomic-rename", "recorded-results-reflect-current-code"],
      "evaluate": { "method": "external-evidence" }
    },
    {
      "id": "generated-infrastructure-matches-model",
      "kind": "invariant",
      "statement": "The generated infrastructure and pipeline realise exactly the modeled environments, slots, gates and transitions, deterministically, and any edit to the generated output is detected.",
      "rationale": "Planned (WG-4678). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "infrastructure-generator",
        "deployment-model"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "claims-monitored-in-production",
      "kind": "invariant",
      "statement": "Each claim with a declared observable has a generated runtime monitor, and a monitor that fires marks its claim violated with the observation; game-day results are recorded as evidence with their measurements.",
      "rationale": "Planned (WG-4680). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "reality-loop"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "accepted-writes-journaled",
      "kind": "invariant",
      "statement": "In these runs every accepted write of spec.jsonc or layout.jsonc has its journal line.",
      "subjects": [
        "workspace-service",
        "write-journal",
        "undo-restores-and-saves",
        "layout-move-saved"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "undo-restores-and-saves",
          "layout-move-saved"
        ],
        "expr": "workspace-disk-flow.journalLines == workspace-disk-flow.specWrites + workspace-disk-flow.layoutWrites",
        "negatives": [
          {
            "scenario": "undo-restores-and-saves",
            "faults": [
              "journal-append-fails"
            ]
          }
        ]
      },
      "faultModel": "local-workstation",
      "rationale": "The negative is a failure of the environment: the journal is appended after the file is replaced, so a failed append leaves an accepted write without a line. The journal is not written for imports, recorded results, generated files or changes made outside Exegra at all (record write-journal)."
    },
    {
      "id": "cli-success-means-all-written",
      "kind": "invariant",
      "statement": "Whenever exegra apply reports success, both files on disk hold the texts the transaction produced.",
      "subjects": [
        "agent-cli",
        "workspace-service",
        "agent-command",
        "cli-apply",
        "cli-apply-partial-write"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "cli-apply",
          "cli-apply-partial-write"
        ],
        "expr": "cli-process-flow.reportedOk => workspace-disk-flow.diskSpec == 'h2' && workspace-disk-flow.diskLayout == 'L2'",
        "negatives": [
          {
            "scenario": "cli-apply-partial-write",
            "faults": [
              "apply-reports-ok-after-layout-conflict"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "cli-partial-write-reported",
      "kind": "temporal",
      "statement": "When the layout write of exegra apply conflicts, the specification has already been written and the failure says so.",
      "subjects": [
        "agent-cli",
        "workspace-service",
        "specification-file",
        "cli-apply-partial-write"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "cli-apply-partial-write"
        ],
        "expr": "cli-process-flow.reportedFailure && cli-process-flow.failureNotesSpecWritten && workspace-disk-flow.diskSpec == 'h2' && workspace-disk-flow.diskLayout == 'Lx'",
        "negatives": [
          {
            "scenario": "cli-apply-partial-write",
            "faults": [
              "cli-failure-omits-partial-write"
            ]
          }
        ]
      },
      "faultModel": "local-workstation",
      "rationale": "States a weakness as it is (finding F05): the two writes are not atomic together. The claim is that the caller is told, not that the partial write cannot happen."
    },
    {
      "id": "verify-records-before-reporting",
      "kind": "temporal",
      "statement": "exegra verify prints its envelope only after the recorded results are on disk.",
      "subjects": [
        "agent-cli",
        "verification-pipeline",
        "recorded-results",
        "cli-verify-with-open-session"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "precedes",
        "scenarios": [
          "cli-verify-with-open-session"
        ],
        "first": {
          "event": "ws-recorded-done"
        },
        "then": {
          "event": "cli-command-ok"
        },
        "negatives": [
          {
            "scenario": "cli-verify-with-open-session",
            "faults": [
              "verify-reports-before-recording"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "trace-file-only-from-a-run",
      "kind": "invariant",
      "statement": "exegra trace writes a trace file only for a run the engine completed.",
      "subjects": [
        "agent-cli",
        "simulation-engine",
        "cli-outputs",
        "cli-trace-written",
        "cli-trace-refused"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "cli-trace-written",
          "cli-trace-refused"
        ],
        "expr": "cli-process-flow.traceWritten => cli-process-flow.engineOk",
        "negatives": [
          {
            "scenario": "cli-trace-refused",
            "faults": [
              "trace-written-on-refusal"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "markdown-written-only-when-covered",
      "kind": "invariant",
      "statement": "The Markdown importer writes a specification only when its coverage check passed.",
      "subjects": [
        "markdown-importer",
        "specification-file",
        "markdown-import",
        "markdown-import-coverage-fails"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "markdown-import",
          "markdown-import-coverage-fails"
        ],
        "expr": "markdown-import-flow.written => markdown-import-flow.coverageOk",
        "negatives": [
          {
            "scenario": "markdown-import-coverage-fails",
            "faults": [
              "markdown-writes-despite-gate"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "verify-reuses-fresh-outcomes-only",
      "kind": "invariant",
      "statement": "A verify run takes the outcome of a test evidence entry from a recorded test run only when that run was complete, the tree did not change while it ran, and its tree stamp equals the stamp of the tree verify runs on; a reference matching no recorded test is run, never assumed to pass.",
      "subjects": [
        "verification-pipeline",
        "recorded-results-file"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "rationale": "The check ran every test twice (WG-4794). The stamp covers tracked and untracked files by content and the generated engine builds, so an edit after the run, a rebuilt engine or a different Node version makes the recorded outcomes stale and the tests run again.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "verify-skip-records-not-run",
      "kind": "invariant",
      "statement": "A verify run in which a test evidence reference skipped (a matched test skipped itself or is a todo, wholly or in part, or a browser test was not started under --skip-browser) records that evidence as not-run, which counts as no result, and never keeps an older pass for it; the only result kept is that of a browser test not started whose earlier result was recorded on the same tree stamp.",
      "subjects": [
        "agent-cli",
        "recorded-results-file"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "rationale": "Replaces verify-skip-keeps-recorded-outcome, which kept the older pass on purpose: a pass recorded before a test started to skip kept its claim supported on code it never ran against (assessment 2026-11-26, epistemics D1 and D2; milestone M0 of docs/foundations.md). A result recorded on the same tree stamp is still a fact about the tree, so a browser test that verify did not start keeps it.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "test-evidence-skip-aware",
      "kind": "invariant",
      "statement": "A test evidence reference passes only when at least one matched leaf test executed and passed and no matched test failed, skipped itself or is a todo; a describe block is not a test of its own; the fresh path (node's TAP output) and the reuse path (outcomes recorded by npm test) decide this with the same function, and a reference whose matched tests skipped, wholly or in part, is recorded as not run on both.",
      "subjects": [
        "verification-pipeline",
        "agent-cli"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "rationale": "Encodes docs/assessment/2026-11-26/demos/skipped-test-counts-as-pass.test.js (tests/fixtures/skipped-tests/demo.test.js): the patterns inner real check, trivially|real check and publishes each counted as a pass before (a suite whose only test skipped printed a plain ok line; a todo was not filtered; a mixed match passed on the reuse path). A whole-file reference to a file with a test that skips itself, for want of Lean or a native binary, is now not a pass where that test skipped.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "admit-rejects-downgrades-and-removals",
      "kind": "invariant",
      "statement": "exegra admit ranks not-evaluated with inconclusive, so a claim that moves from a positive status to not-evaluated is the reason admit.claim-regressed (not acknowledgeable), and a claim that was proved, verified, supported or model-holds and that the change removes is the reason admit.claim-removed, which only an explicit --accept admit.claim-removed acknowledges.",
      "subjects": [
        "agent-cli"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "rationale": "Encodes the compare() demonstration of epistemics D8: supported to not-evaluated, proved to not-evaluated and a removed verified claim were all admitted with no reason.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "verify-fails-on-regression",
      "kind": "invariant",
      "statement": "exegra verify records, with each passing run, every claim's status and the fingerprint of each violated claim's counterexample (claimBaseline in results.json), and fails when, against that baseline, a positive claim falls to a lower status (inconclusive and not-evaluated included), a positive claim no longer exists, or a claim named by --expect-violated is violated with another counterexample; --accept-change names the claims whose change is accepted, and a failing run leaves the baseline as it was.",
      "subjects": [
        "agent-cli",
        "recorded-results-file"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "rationale": "Encodes epistemics D8 for verify: the expectation matched claim ids only, so a new counterexample of core-logic-in-lean or edits-only-via-transactions passed, and a claim falling to inconclusive or not-evaluated passed. Keeping the baseline on failure means running verify again does not wave the regression through.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "journal-failure-reported",
      "kind": "invariant",
      "statement": "When a spec or layout write replaces its file but the journal line cannot be appended, the write result says the journal line was not written, the CLI apply result lists it in journalWarnings, and the session reports it as an error; the replaced file is not restored.",
      "subjects": [
        "workspace-service",
        "agent-cli",
        "session"
      ],
      "assumptions": [
        "filesystem-honours-atomic-rename"
      ],
      "rationale": "The file write happens before the journal append, and nothing else checks that the append happened. A silent gap in the journal would leave an edit with no history line.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "pages-site-published-from-main",
      "kind": "structural",
      "statement": "The Pages workflow file .github/workflows/pages.yml is triggered by a push to main with no path, tag or branch filter beyond main, and grants pages: write and id-token: write; its build job, with no condition and no step whose failure is ignored, builds the Lean core, validates Exegra's own specification, builds the bundle and uploads dist, in that order; its deploy job needs the build job, runs only on main and deploys the uploaded artifact; and the Vite configuration's base is relative, so the bundle loads under the repository's sub-path.",
      "subjects": [
        "build-system"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/pages-site.test.js (the ev-pages-* evidence entries), which read the structure of vite.config.js and .github/workflows/pages.yml, and which are shown to fail on the five workflow mutants of docs/assessment/2026-11-26/demos/pages-mutants.mjs (deploy job if: false, build job if: false, || true after validate, a paths filter that never matches, needs: build removed; ev-pages-mutants-refused). It does not establish that GitHub runs the workflow (Pages enabled as the source, the workflow enabled, a push not marked to skip CI), nor that every push to main is published: under the workflow's concurrency group a queued run is replaced when a newer push arrives, so an intermediate push may never be built or deployed. The checks are structural: they catch the listed mutants, not every edit that breaks publishing (a broken build command, a wrong artifact name in a later action version, a failing deploy).",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "register-import-holds-every-line",
      "kind": "invariant",
      "statement": "The register importer writes nothing unless the Markdown file rebuilds line for line from the generated sections with every entity marker expanded to the lines it came from, and every imported table row rendered from its properties gives the cells of its source row.",
      "rationale": "A converted specification replaces its Markdown, so a line the conversion dropped or a cell it changed would be lost silently. The two checks make loss a failed import instead.",
      "subjects": [
        "register-importer"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "register-import-entities-cite-source",
      "kind": "invariant",
      "statement": "Every document, section, table and row entity the register importer writes carries a source property naming the file and line it was imported from, and every row whose rule has an identifier column carries that identifier as written in ref.",
      "rationale": "A reader of the converted specification must be able to go from any entity to the words it was made from.",
      "subjects": [
        "register-importer"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "register-import-drafts-are-marked",
      "kind": "invariant",
      "statement": "Every entity the register importer takes from a draft fragment carries origin \"draft\" and a source in that fragment, the system notes name the fragment, and the Markdown rendered from the sections is the same with or without drafts.",
      "rationale": "Authored additions sit in the same file as the converted specification; a reader must always be able to tell them from what the Markdown says.",
      "subjects": [
        "register-importer"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "register-import-respects-authority",
      "kind": "invariant",
      "statement": "When the import map says the JSONC is the authority, the register importer writes nothing to the project's specification file, and --render produces the Markdown from the specification file alone.",
      "rationale": "After the conversion the JSONC is edited in Exegra; a re-import would silently discard those edits.",
      "subjects": [
        "register-importer"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "realisation-roots-traced",
      "kind": "invariant",
      "statement": "When project.jsonc declares realisation roots, traceability checks each module written <alias>:<path> against that root's directory, reports a module naming an undeclared alias as missing, and reports unclaimed files only for roots that declare include globs (minus exclude globs); with no roots declared, the traceability result is the same as without the feature.",
      "subjects": [
        "external-realisation",
        "verification-pipeline"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "external-not-run-distinct-from-fail",
      "kind": "invariant",
      "statement": "External test evidence is recorded as fail only when a matched JUnit test case reports a failure whose text matches none of the root's environmental patterns; a test absent from the report, skipped, reported as an error, or failing for an environmental reason is recorded as not-run, which `verify` never counts as a failure and the claim evaluator treats as having no result.",
      "subjects": [
        "external-realisation",
        "recorded-results-file"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "store-export-is-byte-identical",
      "kind": "invariant",
      "statement": "Exporting a specification imported into its store gives the imported text byte for byte, and its rows cover every code unit of it exactly once: for Exegra's specification, every linked project's specification, every JSONC fixture and every parse corpus case that parses, and for CRLF line endings, a byte order mark, tabs, trailing commas, comments inside and between entities, empty sections, a missing final newline and non-ASCII text.",
      "subjects": [
        "spec-store"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "store-reimport-gives-same-rows",
      "kind": "invariant",
      "statement": "Importing the export of a store gives a store whose rows (entity, trivia, ref and meta) equal the original store's.",
      "subjects": [
        "spec-store"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "store-model-equals-text-model",
      "kind": "invariant",
      "statement": "The model read from a store has the semantic hash, diagnostics, error count and entities of the model of its exported text, and the semantic hash recorded at import is that hash.",
      "subjects": [
        "spec-store"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "store-refuses-what-it-cannot-return",
      "kind": "invariant",
      "statement": "A text that does not parse, is not well-formed Unicode or is not valid UTF-8 is refused by import with a StoreError naming the problem, and the store keeps the rows it held.",
      "subjects": [
        "spec-store"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "store-export-never-overwrites-stale-specification",
      "kind": "invariant",
      "statement": "exegra store export replaces the specification only when the file is still the text the store last synchronised with, or is already the exported text; otherwise it fails with store.stale and leaves the file unchanged.",
      "subjects": [
        "spec-store"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "cli-registers-projects-from-scripts",
      "kind": "structural",
      "statement": "A script can register a spec file (and product files) as a project in one command, and can run read-only commands on one without registering it: project add writes specs/<name>/project.jsonc with paths relative to the project directory, refuses an existing project unless --force, a name that is not a valid project name, a project that keeps its own spec.jsonc and files that cannot be read (writing nothing); project remove deletes the link; validate and the other read-only commands take --spec and --product inline and write nothing.",
      "subjects": [
        "agent-cli",
        "workspace-service"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/cli-project.test.js (the ev-cli-project-* evidence entries). WG-5041.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "admit-never-writes-a-rejected-change",
      "kind": "structural",
      "statement": "The admit command never writes the specification for a rejected verdict, even with --write, and reports every reason for the rejection (each claim that moved to a worse status, each new validation error, each new integrity violation, each new claim that is not verified or proved, a refused transaction), not only the first.",
      "subjects": [
        "agent-cli",
        "transactions"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/admit.test.js (the ev-admit-* evidence entries).",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "admit-privilege-and-guarantee-changes-need-acknowledgement",
      "kind": "structural",
      "statement": "The admit command reports every capability a change adds to a role, grant, delegation or token scope, every new or changed grant or delegation without maxDuration, every copy class looser than another of the same record, and every changed integrity rule, claim or retention, each as a reason that blocks admission until its code is accepted with --accept; a reason that is not acknowledgeable cannot be accepted, and an accepted reason is listed under acknowledged.",
      "subjects": [
        "agent-cli"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/admit.test.js (the ev-admit-privilege-*, ev-admit-weakened-* and ev-admit-accept-* evidence entries). WG-5275.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "admit-requirement-claims-pend-on-realisation",
      "kind": "structural",
      "statement": "The admit command admits a new claim that is realised by code (a requirement, or a claim of an external verification method or of external-evidence) when it names a milestone and has no result yet, and lists it under pendingRealisation; a new requirement without a milestone is rejected as admit.requirement-without-milestone; a new claim a model method can decide (structural, data-model, integrity, lean-theorem and the other methods Exegra evaluates) must still be verified or proved.",
      "subjects": [
        "agent-cli",
        "claim-method-registry"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/admit.test.js (the ev-admit-pending-* evidence entries). WG-5273.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "admit-flags-weak-new-claims",
      "kind": "structural",
      "statement": "admit rejects a claim the change creates that is holds-by-construction or restated-scenario (admit.claim-vacuous), single-trace (admit.claim-single-trace) or self-contained (admit.claim-self-contained), each reason carrying acknowledgeable: true, reports the counts by check and grounding before and after, and never makes an existing claim a reason.",
      "subjects": [
        "agent-cli",
        "claim-strength"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/claim-strength.test.js (WG-5274, WG-5276).",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "specification-manifest-parts",
      "kind": "structural",
      "statement": "A specification may be a manifest (specParts) listing part files, and Exegra reads it as the one document the parts make: array sections are concatenated in manifest order, a section that is not an array may be in one part only, and a missing part, a part that is itself a manifest, a manifest with sections of its own, a section two parts both hold and an id two parts give one section are refused with an error that names the files. The semantic hash is that of the one-file specification. exegra apply writes each changed entity back to the part that holds it, and a new entity to the part the manifest's specSections table names for its section (else beside its section, else the first part).",
      "subjects": [
        "workspace-service"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/spec-manifest.test.js (the ev-spec-manifest-* evidence entries). WG-5386.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "module-to-element-map-is-a-function",
      "kind": "structural",
      "statement": "Every file of the traceability surface belongs to exactly one module element, and each module element to exactly one element, from the system exegra through its subsystems and components: a file covered by two module elements is the traceability error traceability.multiple-owners, src/core/builtin-types.js belongs to generation-readiness only, and src/app/main.js is the composition-root element directly under exegra.",
      "subjects": [
        "verification-pipeline",
        "queries",
        "composition-root",
        "generation-readiness"
      ],
      "assumptions": [
        "static-extractor-sound",
        "extracted-facts-current"
      ],
      "rationale": "Supported by tests/core/multiscale.test.js: the traceability check on a fixture with a file claimed twice and a directory overlapping a file, and on this repository.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "cli-get-prints-entities-with-references",
      "kind": "invariant",
      "statement": "exegra get prints exactly the named entities, each with its declaration, owner, source line and the references it holds and receives, and fails on an unknown id.",
      "subjects": [
        "agent-cli"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "cli-find-filters-entities",
      "kind": "invariant",
      "statement": "exegra find returns only the entities matching every given filter (kind, property, refers-to, referenced-by, text), only the requested fields, and at most the limit while reporting the total.",
      "subjects": [
        "agent-cli"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "cli-refs-equals-model-refs",
      "kind": "invariant",
      "statement": "exegra refs lists, for an entity, the outbound and inbound references exactly as the model holds them.",
      "subjects": [
        "agent-cli"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "guard-refuses-direct-spec-access",
      "kind": "invariant",
      "statement": "The guard refuses Read, Edit, Write, MultiEdit, an explicit Grep and a printing or editing shell command aimed at a specification file or a manifest part file, with a message naming get, find, refs and apply.",
      "subjects": [
        "spec-guard"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "guard-leaves-other-calls-alone",
      "kind": "invariant",
      "statement": "The guard allows a Read of the header, a Read of any other file, a repository-wide Grep, the exegra command line and scripts that parse with jsonc-parser, and exits silently with 0.",
      "subjects": [
        "spec-guard"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "capability-matrix-generated",
      "kind": "invariant",
      "statement": "exegra generate writes generated/capabilities.md with one row per guarantee class, whose established cell lists exactly the claims of that class Lean shows established (proved, fresh, no open assumption).",
      "subjects": [
        "generators"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "verify-reruns-only-impacted-evidence",
      "kind": "invariant",
      "statement": "With a change set, verify runs the evidence of exactly the claims the change re-marks and reuses the results the last verification recorded fresh for the others.",
      "subjects": [
        "verification-pipeline",
        "change-impact"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "evaluate": {
        "method": "external-evidence"
      },
      "guaranteeClass": "change-impact"
    },
    {
      "id": "admit-takes-change-sets",
      "kind": "invariant",
      "statement": "admit accepts a change set touching the specification, Lean, test and measurement files, reports the claims it re-marks and lists the changes to guarantees in a separate section.",
      "subjects": [
        "agent-cli",
        "change-impact"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "evaluate": {
        "method": "external-evidence"
      },
      "guaranteeClass": "change-impact"
    },
    {
      "id": "admit-refuses-theorem-weakening",
      "kind": "invariant",
      "statement": "admit refuses a change that weakens the theorem of a lean-theorem claim (removed, axioms gained, about changed, or statement changed without a superseding implication that passes the Lean gate) unless --accept names the claim, and admits a proof-only change, a dropped hypothesis conjunct and a strengthened conclusion with their implications.",
      "subjects": [
        "agent-cli",
        "claim-verdict",
        "verification-pipeline"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "evaluate": {
        "method": "external-evidence"
      },
      "guaranteeClass": "change-impact"
    },
    {
      "id": "import-scan-checks-relationships",
      "kind": "invariant",
      "statement": "The import scan checks extracted-facts-current: it re-reads the digest of every file of the implementation surface against the recorded fact file, and checks the file-system imports that no extracted element stands for; on the current tree a stale fact file, or src/core/derivation-cache.js importing node:fs with no declared relationship to the file system, refutes the assumption, and the claims that rest on it are then not verified.",
      "subjects": [
        "verification-pipeline",
        "claim-evaluator"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "self-specification-split-by-area",
      "kind": "structural",
      "statement": "Exegra's own specification is a manifest of part files grouped by area, none over 120 KB. Splitting it left the semantic hash and the document unchanged (entities of a section compared by id), a new component, relationship, claim, evidence record or behaviour that apply creates is written to the part the placement table computes from the entity (a component by its nearest named ancestor, a claim by the subsystem of its first subject, evidence where its claim is), one transaction's undo and redo restore every part byte for byte, the commands print the part file and line of a source location, and the specification guard refuses the part files and the directory that holds them.",
      "rationale": "Supported by tests/core/spec-split.test.js (the ev-self-spec-split-* evidence entries). WG-5704.",
      "subjects": [
        "workspace-service",
        "spec-guard"
      ],
      "assumptions": [],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "extraction-reconciles-with-declarations",
      "kind": "structural",
      "statement": "Inside the extraction surface, static dependencies are derived from the facts extracted from the implementation and no declared static dependency stands beside them: no declared relationship of class static between components of the surface is redundant with an extracted fact, unwitnessed by one, reversed against one or of another kind than one, and every file of the extracted facts belongs to a module element. An extracted dependency with no declared counterpart is not a discrepancy, since it is the dependency. Runtime wiring stays declared and is not compared with the extraction.",
      "rationale": "This replaces the assumption that the hand-declared relationships match the real imports (relationships-match-imports), which recorded counts of 12 and 121 and had drifted with nothing to check it. The check now reads the extracted facts: static structure only, never runtime behavioural fidelity.",
      "subjects": [
        "verification-pipeline",
        "semantic-abstraction"
      ],
      "assumptions": [
        "static-extractor-sound",
        "extracted-facts-current"
      ],
      "evaluate": {
        "method": "extraction-reconciled"
      }
    },
    {
      "id": "static-extractor-reads-exact-imports",
      "kind": "invariant",
      "statement": "The static extractor reports the static imports, re-exports and dynamic imports of JavaScript files, the import lines of Lean files and the module-level mod and use of Rust files, resolved to the files they name, marks dynamic imports as such, ignores imports written in comments, and gives for an unchanged file the same facts and digest (a fact is a function of the file bytes and the extractor version).",
      "subjects": [
        "verification-pipeline"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "levels-zero-and-one-state-purposes",
      "kind": "structural",
      "statement": "Levels 0 and 1 of this specification are independently understandable: the system and every block of the cuts l0 and l1 (the system, its subsystems, the composition root and the people and systems around it) state a purpose and responsibilities.",
      "subjects": [
        "agent-interface",
        "application",
        "persistence",
        "semantic-core",
        "tooling",
        "visualization",
        "composition-root"
      ],
      "rationale": "Supported by the core test that reads the block report of every block of l0 and l1.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "shared-base-single-commit",
      "kind": "invariant",
      "statement": "At most one of the two writes from the same initial revision commits.",
      "subjects": [
        "workspace-service",
        "two-session-edit-race"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "two-session-edit-race"
        ],
        "expr": "shared-base-write-flow.accepted <= 1",
        "negatives": [
          {
            "scenario": "two-session-edit-race",
            "faults": [
              "stale-write-accepted"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "product-installation-checks-composition",
      "kind": "invariant",
      "statement": "Installing a product checks the state-invariant claims of every installed product and of the candidate over every execution of the composed scenario of the installation; a claim that holds on its own scenario but fails composed refuses the installation, naming the composed scenario and the values at the failing configuration (the two-product ledger: held = 2 in {ledger, badges__awarder, promotions__awarder}).",
      "subjects": [
        "agent-cli"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/two-product-ledger.test.js over tests/fixtures/two-product-ledger. Each product claim is shown to hold by complete exploration of its own scenario (JavaScript explorer, every delivery order), not by a Lean theorem. WG-5685 criterion 7.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "verify-batches-test-runs",
      "kind": "invariant",
      "statement": "A verify run starts one node process per test file, never more than two test processes at a time, and one Playwright run for all browser references; each reference gets the outcome of its own tests: a reference whose name matches no test fails, a failing test fails only the references that match it, and a skipped test stays skipped.",
      "subjects": [
        "verification-pipeline"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "rationale": "The run took 1,412 s with one process per reference (WG-5717), most of it process start-up. The outcome is read from the runner's per-test output with the rule the reuse path applies to recorded outcomes (testsVerdict), so the batch cannot pass a reference the old run failed.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "verify-reuses-unchanged-passes",
      "kind": "invariant",
      "statement": "A verify run reuses a recorded pass or skip, and reports it as reused, only when its reference is unchanged and the content of every file and directory listing its test file's run covered still hashes to the recorded value; a changed covered file, a reference with no recorded coverage, a changed reference and a recorded failure are run again.",
      "subjects": [
        "verification-pipeline"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "rationale": "Coverage is recorded once per test file run (the modules it loaded and the files it read), so each reference of a file is taken to depend on all of them; this over-runs, never under-runs, for what the run touched through fs and module loading. What a program Exegra starts reads is covered by the sources of that program (formal/ for lake, the whole tree for others).",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "evidence-ref-names-a-test",
      "kind": "invariant",
      "statement": "validate refuses a test evidence reference file#name whose name matches no test the file declares (a static scan of its test, it and describe calls); a file that names tests at run time is not refused.",
      "subjects": [
        "verification-pipeline"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "rationale": "A reference to a renamed or deleted test can never pass, and verify only discovers it after a run; the scan finds it before.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "persistence-abstraction-refined",
      "kind": "temporal",
      "statement": "The save path's abstract behaviour workspace-flow is refined by its members, the persistence client and the write endpoint's abstraction: in the visual, source and rejected edits, running the members in its place, with the write-file hop hidden, gives the same boundary trace (events, payloads, times, outcome and the final state of every other machine).",
      "rationale": "WG-5697 criterion 3 and 4 (V6). The two cuts of the visual edit agree on the boundary only because this refinement holds; before WG-5729 the abstraction took save-requested, which no member consumes, and the refinement check returned a boundary counterexample.",
      "subjects": [
        "persistence",
        "workspace-flow",
        "persistence-client-flow",
        "write-endpoint-flow",
        "visual-edit-flow"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "refines-composition",
        "behavior": "workspace-flow",
        "scenarios": [
          "visual-edit-flow",
          "source-edit-flow",
          "rejected-edit"
        ],
        "negatives": [
          {
            "scenario": "visual-edit-flow",
            "faults": [
              "disk-changed-externally"
            ],
            "note": "The abstraction flags a conflict the members, on an unchanged disk, do not."
          }
        ]
      }
    },
    {
      "id": "persistence-abstraction-refined-finest",
      "kind": "temporal",
      "statement": "workspace-flow is refined by the finest members of the save path, two levels down: the persistence client, the development-server plugin and the workspace service (with its watcher), with the write-file and ws-* hops hidden, in the visual, source and rejected edits.",
      "rationale": "WG-5697 criterion 4: refinement across multiple levels. workspace-flow abstracts persistence-client-flow and write-endpoint-flow; write-endpoint-flow abstracts dev-server-flow, workspace-disk-flow and workspace-watcher-flow.",
      "subjects": [
        "persistence",
        "workspace-flow",
        "dev-server-flow",
        "workspace-disk-flow",
        "visual-edit-flow"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "refines-composition",
        "behavior": "workspace-flow",
        "finest": true,
        "scenarios": [
          "visual-edit-flow",
          "source-edit-flow",
          "rejected-edit"
        ],
        "negatives": [
          {
            "scenario": "visual-edit-flow",
            "faults": [
              "disk-changed-externally"
            ]
          }
        ]
      }
    },
    {
      "id": "write-endpoint-abstraction-refined",
      "kind": "temporal",
      "statement": "The write endpoint's abstract behaviour write-endpoint-flow is refined by the development-server plugin and the workspace service: in the stale-base write, running them in its place with the ws-* hop hidden gives the same boundary trace.",
      "rationale": "WG-5697 criterion 3: before WG-5729 write-endpoint-flow started with the disk at h2 while the workspace service starts at h1, and the refinement check returned the boundary counterexample write-file-conflict {current: h2} against {current: h1}.",
      "subjects": [
        "dev-server-plugin",
        "workspace-service",
        "write-endpoint-flow",
        "write-with-stale-base-hash"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "refines-composition",
        "behavior": "write-endpoint-flow",
        "scenarios": [
          "write-with-stale-base-hash"
        ],
        "negatives": [
          {
            "scenario": "write-with-stale-base-hash",
            "faults": [
              "endpoint-ignores-base-hash"
            ]
          }
        ]
      }
    },
    {
      "id": "persistence-alternatives-reconciled",
      "kind": "structural",
      "statement": "The persistence client, the development-server plugin and the workspace service each have one behaviour per level: no two of their behaviours share an event without running together or being related by a declared, checked abstraction.",
      "rationale": "WG-5697 criterion 9. write-client-flow (a retrying client, which abstracted the session's overwrite) was removed; write-endpoint-flow and workspace-flow are declared abstractions whose refinement is checked (write-endpoint-abstraction-refined, persistence-abstraction-refined). session-flow and project-session-flow are still alternative machines of the session (refinement-checker unknowns).",
      "subjects": [
        "persistence-client",
        "dev-server-plugin",
        "workspace-service"
      ],
      "evaluate": {
        "method": "alternatives-reconciled",
        "subjects": [
          "persistence-client",
          "dev-server-plugin",
          "workspace-service"
        ]
      }
    },
    {
      "id": "save-order-transfers-to-persistence-members",
      "kind": "temporal",
      "statement": "That every write request follows a projection refresh, established where the save path runs as workspace-flow, holds with the persistence client and the write endpoint in its place, by the preservation rule for safety over the boundary down a certified refinement.",
      "rationale": "WG-5697 criterion 8, invariant I6.",
      "subjects": [
        "workspace-flow",
        "persistence"
      ],
      "evaluate": {
        "method": "transfers",
        "claim": "save-follows-refresh",
        "abstraction": "workspace-flow"
      }
    },
    {
      "id": "save-liveness-not-transferred",
      "kind": "temporal",
      "statement": "That the file eventually matches the model after a valid edit, established where the save path runs as workspace-flow, is not transferred to its members: a liveness claim never transfers without a declared fairness hypothesis, and the reason is shown.",
      "rationale": "WG-5697 criterion 8, invariant I6: trace inclusion on the boundary preserves safety, not liveness.",
      "subjects": [
        "workspace-flow",
        "persistence"
      ],
      "evaluate": {
        "method": "transfers",
        "claim": "file-matches-model-after-save",
        "abstraction": "workspace-flow",
        "expect": "not-transferred"
      }
    }
  ],
  // ---- Evidence --------------------------------------------------------------------------
  // Evidence of kind test is executed by `exegra verify`; until it has run it shows no recorded
  // execution. A pattern after # is matched against test titles; titles containing a comma or
  // semicolon are referenced by a prefix because verify accepts neither in a reference.
  "evidence": [
    { "id": "ev-pages-relative-base", "claim": "pages-site-published-from-main", "kind": "test", "ref": "tests/core/pages-site.test.js#the production build uses relative asset URLs so it loads under a sub-path", "description": "The Vite configuration's base is relative." },
    { "id": "ev-pages-on-push-to-main", "claim": "pages-site-published-from-main", "kind": "test", "ref": "tests/core/pages-site.test.js#the Pages workflow is triggered by a push to main with no path or tag filter and may deploy to Pages", "description": "The workflow's push trigger names exactly the branch main and no other filter, and it grants pages: write and id-token: write." },
    { "id": "ev-pages-validate-before-deploy", "claim": "pages-site-published-from-main", "kind": "test", "ref": "tests/core/pages-site.test.js#the Pages workflow builds the Lean core and validates the specification before it builds and deploys dist", "description": "Read structurally: the build job has no condition and builds the Lean core, validates specs/exegra/spec.jsonc, builds and uploads dist in that order, none of these steps conditional or able to hide a failure; the deploy job needs build, runs only on main and deploys." },
    { "id": "ev-pages-mutants-refused", "claim": "pages-site-published-from-main", "kind": "test", "ref": "tests/core/pages-site.test.js#the workflow checks fail on each of the five publishing mutants", "description": "The checks of the two workflow tests fail on each of the five mutants of docs/assessment/2026-11-26/demos/pages-mutants.mjs applied to the workflow as it is: if: false on the deploy or the build job, || true after validate, a never-matching paths filter, needs: build removed." },
    { "id": "ev-workspace-conflict", "claim": "conflict-never-overwrites", "kind": "test", "ref": "tests/core/workspace.test.js#write with a stale baseHash conflicts", "description": "A write with a stale base hash conflicts and leaves the file untouched." },
    { "id": "ev-generate-core", "claim": "generation-deterministic", "kind": "test", "ref": "tests/core/generate.test.js", "description": "Two runs are byte-identical; equivalent source texts give the same artifacts." },
    { "id": "ev-workspace-confinement", "claim": "persistence-confined-to-workspace", "kind": "test", "ref": "tests/core/workspace.test.js", "description": "Invalid names, escaping paths, unknown files and generated paths outside generated/ are refused." },
    {
      "id": "ev-verify-reuses-fresh-outcomes",
      "claim": "verify-reuses-fresh-outcomes-only",
      "kind": "test",
      "ref": "tests/core/outcome-reuse.test.js#outcomes are used only while the tree is the one they ran on",
      "description": "An outcome file stamped with the current tree answers a reference; with another stamp it answers nothing. Companion tests cover a reference matching no recorded test, failures, skipped tests, mixed matches and the stamp itself."
    },
    {
      "id": "ev-verify-skip-records-not-run",
      "claim": "verify-skip-records-not-run",
      "kind": "test",
      "ref": "tests/core/cli.test.js#a skipped verify run records the evidence as not run instead of keeping an older pass",
      "description": "mergeRecordedResults records a skipped entry as not-run with the current stamp instead of its older pass, records the runs that executed, and keeps a result of a browser test not started only when it was recorded on the same stamp."
    },
    {
      "id": "ev-skip-not-supporting",
      "claim": "verify-skip-records-not-run",
      "kind": "test",
      "ref": "tests/core/fact-producers.test.js#a test that skipped now is recorded as not run and no older pass supports its claim",
      "description": "An older pass followed by a skip is recorded as not-run, and the external-evidence claim resting on it is inconclusive, not supported."
    },
    {
      "id": "ev-skip-aware-fresh",
      "claim": "test-evidence-skip-aware",
