// Part of the specification: claims, evidence.
{
  "claims": [
    {
      "id": "simulation-deterministic",
      "kind": "invariant",
      "statement": "Running a scenario twice with the same model and faults gives deep-equal traces, and stepping one event at a time gives the same trace as running to the end.",
      "subjects": ["simulation-engine", "run-scenario"],
      "assumptions": ["tests-exercise-shipped-modules", "recorded-results-reflect-current-code"],
      "evaluate": { "method": "external-evidence" }
    },
    {
      "id": "simulation-seeded-runs-reproducible",
      "kind": "invariant",
      "statement": "The same model, scenario, faults and seed give deep-equal traces and metrics, draws included, in the Rust engine and in the Lean semantics; on a fixture that samples, two different seeds give different draws; and the seeds of a claim's runs are the successive SplitMix64 outputs of its base seed, with arithmetic mod 2^64.",
      "rationale": "Planned (WG-4664; specified in docs/simulation.md, Randomness). Draws come from SplitMix64 streams addressed by (stream name, counter), the counters are part of the configuration, and sequence numbers increment on every creation. Negative twin: a fixture run with two seeds fails if the seed is ignored; an engine mutant that iterates a hash map of streams, or that reuses the sequence number of a removed entry, fails the deep-equality test against the Lean semantics. Not evaluated until recorded evidence exists.",
      "subjects": [
        "simulation-engine",
        "formal-semantics",
        "workload-model"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "simulation-instances-are-independent",
      "kind": "invariant",
      "statement": "N instances of one behavior keep separate state: an effect of one instance changes no variable or state of another, every fired and ignored entry of a step names its instance, and an event routed to one instance fires on that instance only.",
      "rationale": "Planned (WG-4664; specified in docs/simulation.md, Instances). Negative twin: a fixture with two instances of a counter, where an event routed by key to instance 0 must leave instance 1 unchanged; an engine mutant that shares the variable map between instances, or delivers a routed event to every instance, fails it. Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "simulation-engine",
        "formal-semantics"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "specs-declare-aspects-as-data",
      "kind": "invariant",
      "statement": "A specification names simulation aspects with versions and gives their parameters as data; an unknown aspect or version is a validation error, and no specification text is evaluated as code.",
      "rationale": "Planned (WG-4665). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "simulation-aspect-registry",
        "validator"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "aspect-runs-reproducible",
      "kind": "invariant",
      "statement": "The same specification, aspect versions, parameters and seed give deep-equal traces, including every aspect metric.",
      "rationale": "Planned (WG-4665). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "simulation-aspect-registry",
        "simulation-engine"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "refinement-agrees-at-boundary",
      "kind": "invariant",
      "statement": "When a behaviour is declared as an abstraction of a set of member behaviours (of a composite or of any member set, at any level), the members run in its place with their internal events hidden give the same boundary trace as the abstraction, as a step correspondence; otherwise the first diverging boundary step is reported as a counterexample, with the strength of the result (exact, conservative or incomplete).",
      "rationale": "Built by WG-5729 (refinement-checker, docs/composition.md); the self-specification's own abstractions are checked by persistence-abstraction-refined and write-endpoint-abstraction-refined.",
      "subjects": [
        "refinement-checker"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "simulation-depth-follows-collapse",
      "kind": "temporal",
      "statement": "No collapse or view state changes a trace, a refinement verdict or a claim verdict: the level each region of a simulation runs at is the scenario's declared behavioural cut (or a level given on the command line), and a view may display that cut but never chooses it.",
      "rationale": "WG-5697 criterion 5 and invariant I4; supersedes the plan of WG-4666 (a run choosing the level per region from the view's collapse state), which would have made presentation state part of the semantics. Built by WG-5729.",
      "subjects": [
        "refinement-checker",
        "session",
        "simulator-panel"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "chaos-campaigns-reproducible",
      "kind": "invariant",
      "statement": "The same campaign and seed give deep-equal sets of runs, and every run's check results are reported.",
      "rationale": "Planned (WG-4667). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "chaos-aspect"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "chaos-failures-only-as-declared",
      "kind": "invariant",
      "statement": "A chaos campaign injects only the failure kinds and targets its parameters name, and records each injected failure in the trace.",
      "rationale": "Planned (WG-4667). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "chaos-aspect"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "load-matches-queueing-theory",
      "kind": "measured",
      "statement": "Single-station M/M/1 and M/M/c queues reproduce the analytic mean waiting time and utilisation within the tolerance and number of seeded runs stated by the test.",
      "rationale": "Planned (WG-4668). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "load-aspect",
        "simulation-engine"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
