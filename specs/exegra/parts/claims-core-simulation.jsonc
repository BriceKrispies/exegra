      }
    },
    {
      "id": "cost-prices-sourced",
      "kind": "invariant",
      "statement": "Every price names a source and a date, and a cost that would use an unsourced price is reported as not computed, naming the price.",
      "rationale": "Planned (WG-4669). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "cost-aspect"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
