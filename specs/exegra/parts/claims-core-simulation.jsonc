      }
    },
    {
      "id": "load-parameters-sourced",
      "kind": "invariant",
      "statement": "Every load parameter (arrival rate, service time, capacity) names its source, a requirement, a measurement or an assumption, and a parameter without one is a validation error.",
      "rationale": "Planned (WG-4668). Not evaluated until recorded evidence of its test exists.",
