      }
    },
    {
      "id": "cost-follows-usage",
      "kind": "invariant",
      "statement": "A reported cost equals the recorded resource usage multiplied by the price profile, line by line.",
      "rationale": "Planned (WG-4669). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "cost-aspect",
        "load-aspect"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "engines-agree-on-traces",
      "kind": "invariant",
      "statement": "The Rust simulation engine, the differential oracle, native and WebAssembly, reproduces every golden trace of the conformance suite exactly, as the Lean engine does.",
      "rationale": "Supported by tests/core/conformance.test.js (WG-4672): it runs the Lean WebAssembly engine and the Rust WebAssembly engine (tools/rust-engine.js) against every golden under tests/conformance/goldens, from the model and from the input file alone, compares the Rust and Lean traces byte for byte, and runs the native binary engine/target/release/exegra-sim when it is built (skipped with a message otherwise). The claim that the application and the CLI run only the Lean engine is not tested here: it is a separate claim, app-and-cli-run-lean-engine-only, which has no evidence.",
      "subjects": [
        "simulation-engine",
        "simulation-contract"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "simulation-contract-pinned",
      "kind": "invariant",
      "statement": "For every scenario of the golden conformance suite, the simulation engine reproduces the committed trace exactly, both from the model and from the committed engine input alone, and simulationInput derives exactly the committed input.",
      "rationale": "Pinned by tests/core/conformance.test.js (WG-4674): the goldens under tests/conformance/goldens were recorded with the former JavaScript engine and stay as committed; the test runs the engine against every one of them, from the model and from the input file alone, and compares the derived inputs, so a change of the engine's behavior fails it until the goldens are re-recorded on purpose with tools/record-goldens.js --force.",
      "subjects": [
        "simulation-contract",
        "simulation-engine"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "simulation-runs-off-main-thread",
      "kind": "invariant",
      "statement": "The Simulation tab runs a scenario in a Web Worker: while a long run is in progress the page keeps drawing frames and reacting to input, the tab shows the run as running, and the finished trace is then stepped exactly as before.",
      "rationale": "Supported by the browser test that loads a scenario looping up to a large step limit and checks that animation frames keep coming and the toolbar reacts while the run is in progress (WG-4672). It shows responsiveness for that run in the test browser; it says nothing about the cost of handing a very large finished trace to the page, which still happens on the main thread.",
      "subjects": [
        "simulation-engine",
        "session"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "fault-model-scoped-claims",
      "kind": "invariant",
      "statement": "Every behavioral or reliability claim names the fault model it is evaluated under, every failure-mode rate, duration and bound names its source, and the fault model appears in each such claim result's scope.",
      "rationale": "A claim that names a fault model says in its result's scope what it holds under: the model, its failure modes and its concurrency bounds. Evidence is the core test; the claim is supported, not verified, because Exegra does not check its own validation rules.",
      "subjects": [
        "fault-model",
        "claim-evaluator"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "deployment-cutover-safe",
      "kind": "invariant",
      "statement": "Under the fault model and within the stated bounds, no request is served by a version that failed its health gate during a blue-green cutover, and old and new versions are compatible with the schema at every step of an expand/contract migration.",
      "rationale": "Planned (WG-4677). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "deployment-model"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "deployment-rollback-durable",
      "kind": "invariant",
      "statement": "Under the fault model and within the stated bounds, a rollback loses no committed transaction and returns traffic only to a version that passed its gate.",
      "rationale": "Planned (WG-4677). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "deployment-model"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "implementation-refines-model",
      "kind": "invariant",
      "statement": "Every implementation trace of a checked system, projected onto the model's boundary events, is allowed by the model, or the first disallowed boundary event is reported.",
      "rationale": "Planned (WG-4679). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "implementation-refinement"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
