    },
    {
      "id": "composition-order-independent",
      "kind": "invariant",
      "statement": "No verdict of a scenario depends on the order in which it lists its behaviours: every scenario, and every negative run of its claims, run with its behaviours reversed and in every rotation, gives each of its invariant and temporal claims the verdict of the scenario's own order.",
      "rationale": "WG-5697 criterion 7, invariant I2. invariant_rename (behav-invariant-rename) proves it for every interleaving in the calculus; the evidence checks the scheduler's runs of every scenario in every rotation. That is several hundred engine runs, so it runs with the proof checks (tests/proofs) and backs this claim as evidence rather than being re-evaluated live in the application. It exposed the negative of commit-only-after-validation, whose verdict depended on whether transaction-flow was listed before validator-flow (fixed in WG-5729).",
      "subjects": [
        "refinement-checker",
        "simulation-engine"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "alternatives-reconciled-everywhere",
      "kind": "structural",
      "statement": "No element of the self-specification has alternative machines: any two behaviours of one subject that consume a common event run together in a scenario or are related by a declared, checked abstraction.",
      "rationale": "WG-5697 criterion 9, WG-5733. The session is the commit pipeline (session-flow) and the save (project-session-flow), run together in the edit scenarios; the engine module and the engine call are one behaviour (engine-flow).",
      "subjects": [
        "simulation-engine",
        "session",
        "persistence-client",
        "dev-server-plugin",
        "workspace-service"
      ],
      "evaluate": {
        "method": "alternatives-reconciled"
      }
    },
    {
      "id": "declared-abstractions-refined-over-interleavings",
      "kind": "invariant",
      "statement": "Every declared abstraction a refines-composition claim of the self-specification names is refined over every interleaving and fault mask of the claim's scenarios: exploring it with its members (refine --explore) ends with a certificate and strength explored; an abstraction the scripted run certifies but another interleaving refutes is reported as a counterexample with that interleaving.",
      "rationale": "WG-5734 (in WG-5740) criteria 2 and 3. The explorations visit every product node of each scenario, so they run with the proof checks (tests/proofs) and back this claim as evidence rather than being re-evaluated live, as composition-order-independent is.",
      "subjects": [
        "refinement-checker",
        "simulation-engine"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    }
  ]
