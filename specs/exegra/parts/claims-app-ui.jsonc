// Part of the specification: claims, evidence.
{
  "claims": [
    {
      "id": "edits-only-via-transactions",
      "kind": "structural",
      "statement": "Following relationships that carry edits and file content (submits-edits, data-flow, writes), every path from the editing surfaces (inspector, source editor, dialogs, the composition root that turns scene drags into operations, toolbar, shell) to the specification file passes through the transaction system.",
      "rationale": "Control-only calls are not followed: every panel calls the session for selection and view state (including the toolbar's layout choice, a viewer preference). EXPECTED TO BE VIOLATED: the toolbar's Import sends a bundle to the persistence client, plugin and workspace service, which overwrite spec.jsonc without a transaction; the toolbar only refuses a bundle with syntax errors before sending it. This is a real discrepancy in the code, recorded in system.notes and on the toolbar.",
      "subjects": [
        "inspector",
        "source-editor",
        "dialogs",
        "composition-root",
        "toolbar",
        "shell",
        "transactions",
        "specification-file",
        "toolbar-data-flow-persistence-client"
      ],
      "assumptions": [
        "static-extractor-sound",
        "extracted-facts-current"
      ],
      "evaluate": { "method": "only-via", "from": [
          "inspector",
          "source-editor",
          "dialogs",
          "composition-root",
          "toolbar",
          "shell"
        ], "to": "specification-file", "via": "transactions", "kinds": ["submits-edits", "data-flow", "writes"] }
    },
    {
      "id": "editing-surfaces-except-import-via-transactions",
      "kind": "structural",
      "statement": "Following submits-edits, data-flow and writes relationships, every path from the inspector, source editor, dialogs, the composition root (scene drags) and shell to the specification file passes through the transaction system.",
      "rationale": "The same check as edits-only-via-transactions without the toolbar, whose Import is the known bypass. It shows that the bypass is confined to that one control. The toolbar's other tools (create, delete, reset layout, undo, redo) do use transactions but cannot be separated from Import at component granularity. The Markdown importer is a tool, not an editing surface, and is not in the source list.",
      "subjects": [
        "inspector",
        "source-editor",
        "dialogs",
        "composition-root",
        "shell",
        "transactions",
        "specification-file"
      ],
      "assumptions": [
        "static-extractor-sound",
        "extracted-facts-current"
      ],
      "evaluate": { "method": "only-via", "from": [
          "inspector",
          "source-editor",
          "dialogs",
          "composition-root",
          "shell"
        ], "to": "specification-file", "via": "transactions", "kinds": ["submits-edits", "data-flow", "writes"] }
    },
    {
      "id": "renderer-does-not-own-state",
      "kind": "structural",
      "statement": "The Three.js renderer has no writes or submits-edits relationship to the specification file, the layout file, the transaction system or the session.",
      "rationale": "The renderer is a function of the scene it is given. A gesture reaches the model only through the callbacks the composition root (src/app/main.js) supplied, which submit operations.",
      "subjects": ["scene-renderer", "specification-file", "layout-file", "transactions", "session"],
      "assumptions": [
        "static-extractor-sound",
        "extracted-facts-current"
      ],
      "evaluate": { "method": "no-relationship", "from": "scene-renderer", "to": ["specification-file", "layout-file", "transactions", "session"], "kinds": ["writes", "submits-edits"], "transitive": false }
    },
    {
      "id": "save-follows-refresh",
      "kind": "temporal",
      "statement": "Every write request to the file service is preceded by a projection refresh: the write is asynchronous and happens after the views were refreshed, in all three edits that commit.",
      "rationale": "Records the real order, local-first and optimistic: refresh at commit, write afterwards.",
      "subjects": [
        "session",
        "projection-system",
        "projection-refreshed",
        "write-intent",
        "visual-edit-flow",
        "source-edit-flow",
        "edit-with-disk-conflict"
      ],
      "assumptions": ["machines-abstract-the-code"],
      "evaluate": {
        "method": "precedes",
        "scenarios": [
          "visual-edit-flow",
          "source-edit-flow",
          "edit-with-disk-conflict"
        ],
        "first": {
          "event": "projection-refreshed"
        },
        "then": {
          "event": "write-intent"
        },
        "negatives": [
          {
            "scenario": "visual-edit-flow",
            "faults": [
              "save-before-refresh"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "rejected-edit-never-refreshes",
      "kind": "temporal",
      "statement": "In the rejected edit the projection is never refreshed.",
      "subjects": ["projection-system", "projection-refreshed", "rejected-edit"],
      "assumptions": ["machines-abstract-the-code", "views-derive-from-committed-model"],
      "evaluate": {
        "method": "never",
        "scenarios": [
          "rejected-edit"
        ],
        "occurs": {
          "event": "projection-refreshed"
        },
        "negatives": [
          {
            "scenario": "rejected-edit",
            "faults": [
              "rejection-refreshes"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "rejected-edit-never-persists",
      "kind": "temporal",
      "statement": "In the rejected edit no write to the file service is ever requested.",
      "subjects": [
        "session",
        "workspace-service",
        "write-intent",
        "rejected-edit"
      ],
      "assumptions": ["machines-abstract-the-code"],
      "evaluate": {
        "method": "never",
        "scenarios": [
          "rejected-edit"
        ],
        "occurs": {
          "event": "write-intent"
        },
        "negatives": [
          {
            "scenario": "rejected-edit",
            "faults": [
              "rejection-refreshes"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "conflict-is-flagged",
      "kind": "temporal",
      "statement": "In the edit whose write conflicts with the disk, at quiescence the session reports a conflict, every view shows the new revision and the file on disk is behind the model.",
      "rationale": "The edit is not lost and not forced onto the disk: the user must choose to reload from disk or overwrite disk.",
      "subjects": ["session", "transactions", "scene-renderer", "workspace-service", "edit-with-disk-conflict"],
      "assumptions": ["machines-abstract-the-code", "views-derive-from-committed-model"],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "edit-with-disk-conflict"
        ],
        "expr": "session-flow.saveState == 'conflict' && renderer-flow.shownRevision == transaction-flow.revision && workspace-flow.diskSpec != transaction-flow.textHash",
        "negatives": [
          {
            "scenario": "edit-with-disk-conflict",
            "faults": [
              "conflict-swallowed"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "invalid-source-keeps-last-valid-model",
      "kind": "invariant",
      "statement": "An invalid source draft is rejected with diagnostics, the committed model is not changed and the draft stays as typed in the source editor.",
      "subjects": ["source-editor", "transactions", "apply-transaction"],
      "assumptions": ["tests-exercise-shipped-modules", "browser-tests-run-real-application", "recorded-results-reflect-current-code"],
      "evaluate": { "method": "external-evidence" }
    },
    // ======== Measured claim without any recorded measurement
    {
      "id": "benchmark-scene-interactive",
      "kind": "measured",
      "statement": "The default structural view of specs/benchmark/spec.jsonc (396 components and 507 relationships) renders at an interactive frame rate on ordinary desktop hardware, measured as the fps reported by the scene view's getStats() while the camera orbits. The threshold for 'interactive' is not defined in this specification.",
      "rationale": "No measurement is recorded and no test measures performance, so this claim is not evaluated. It could not be settled by a measurement until the threshold is stated.",
      "subjects": ["scene-renderer", "projection-system", "layout-engine", "benchmark-generator"],
      "evaluate": { "method": "external-evidence" }
    },
    {
      "id": "sim-flow-matches-trace",
      "kind": "invariant",
      "statement": "For every simulation step, the message flow names as sender the component whose behavior emitted the delivered event (outside, for a scenario stimulus or an injected fault) and as receivers the components whose behaviors fired a transition on it.",
      "subjects": [
        "projection-system",
        "simulation-engine"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "sim-flow-never-borrows-edges",
      "kind": "invariant",
      "statement": "A simulated message is drawn along a scene edge only when that edge connects its sender's and receiver's drawn nodes; when only a relationship the view does not draw connects them the message is marked unshown, and when no relationship connects them it is marked undeclared.",
      "subjects": [
        "projection-system",
        "scene-renderer"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "sim-step-shows-message-moving",
      "kind": "temporal",
      "statement": "Stepping a simulation in a structural view moves a marker labelled with the event's name from the sender's node toward each receiver's node, and the simulator panel states who sent the event to whom.",
      "subjects": [
        "scene-renderer",
        "simulator-panel",
        "session"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code",
        "browser-tests-run-real-application"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "overlays-follow-trace",
      "kind": "invariant",
      "statement": "Each overlay value shown at a time equals the trace's value for that component at that time, and a component without data shows nothing.",
      "rationale": "Planned (WG-4671). Not evaluated until recorded evidence of its test exists.",
      "subjects": [
        "simulation-overlays",
        "scene-renderer"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "ui-touch-usable-on-phone",
      "kind": "invariant",
      "statement": "At a 390 by 844 touch viewport the page never scrolls horizontally, every visible interactive control is at least 44 by 44 CSS pixels, and with no panel expanded the 3D scene covers at least 60% of the screen.",
      "rationale": "Rests on its browser test in tests/browser/mobile.spec.js (WG-4675); not evaluated until a recorded result of that test exists.",
      "subjects": [
        "responsive-layout",
        "shell",
        "toolbar",
        "stylesheets"
      ],
      "assumptions": [
        "browser-tests-run-real-application",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "ui-expands-to-desktop",
      "kind": "invariant",
      "statement": "From 768 CSS pixels wide panels open beside the scene instead of over it, and from 1200 CSS pixels the explorer, the scene and the context panel are visible side by side without opening anything.",
      "rationale": "Rests on its browser test in tests/browser/mobile.spec.js (WG-4675); not evaluated until a recorded result of that test exists.",
      "subjects": [
        "responsive-layout",
        "shell"
      ],
      "assumptions": [
        "browser-tests-run-real-application",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "session-starts-after-engine",
      "kind": "temporal",
      "statement": "At start-up the session is started only after the engine has loaded or failed to load.",
      "subjects": [
        "composition-root",
        "simulation-engine",
        "session",
        "app-start-and-open"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "precedes",
        "scenarios": [
          "app-start-and-open"
        ],
        "first": {
          "event": "engine-load-settled"
        },
        "then": {
          "event": "session-init-requested"
        },
        "negatives": [
          {
            "scenario": "app-start-and-open",
            "faults": [
              "session-started-before-engine"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "open-takes-disk-hashes",
      "kind": "temporal",
      "statement": "After start-up the opened project is saved and its base hash is the hash of the file on disk, so the first write is checked against what was read.",
      "subjects": [
        "session",
        "persistence-client",
        "workspace-service",
        "read-project",
        "app-start-and-open"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "app-start-and-open"
        ],
        "expr": "project-session-flow.projectName == 'exegra' && project-session-flow.baseHash == workspace-disk-flow.diskSpec && project-session-flow.saveState == 'saved'",
        "negatives": [
          {
            "scenario": "app-start-and-open",
            "faults": [
              "open-ignores-read-hashes"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "read-only-build-never-writes",
      "kind": "temporal",
      "statement": "A production build never asks to write a project file, even after an edit.",
      "subjects": [
        "session",
        "build-system",
        "production-read-only-edit"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "never",
        "scenarios": [
          "production-read-only-edit"
        ],
        "occurs": {
          "event": "write-intent"
        },
        "negatives": [
          {
            "scenario": "production-read-only-edit",
            "faults": [
              "readonly-build-writes"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "reload-adopts-disk-text",
      "kind": "temporal",
      "statement": "After a conflict resolved by reloading, the session holds the text on disk, reports saved, and the other process's change was never overwritten.",
      "subjects": [
        "session",
        "workspace-service",
        "conflict-resolved-by-reload"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "conflict-resolved-by-reload"
        ],
        "expr": "project-session-flow.textHash == workspace-disk-flow.diskSpec && project-session-flow.saveState == 'saved' && workspace-disk-flow.specWrites == 0",
        "negatives": [
          {
            "scenario": "conflict-resolved-by-reload",
            "faults": [
              "session-reload-keeps-text"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "overwrite-writes-session-text",
      "kind": "temporal",
      "statement": "After a conflict resolved by overwriting, the file on disk holds the session's text and the session reports saved.",
      "subjects": [
        "session",
        "workspace-service",
        "write-file",
        "conflict-resolved-by-overwrite"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "conflict-resolved-by-overwrite"
        ],
        "expr": "workspace-disk-flow.diskSpec == project-session-flow.textHash && project-session-flow.saveState == 'saved'",
        "negatives": [
          {
            "scenario": "conflict-resolved-by-overwrite",
            "faults": [
              "session-overwrite-keeps-stale-base"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "external-change-is-adopted",
      "kind": "temporal",
      "statement": "A change made on disk by another process while nothing is pending is adopted: the session ends holding the text on disk with that text as its base hash.",
      "subjects": [
        "session",
        "workspace-service",
        "file-change-notice",
        "external-change-adopted"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "external-change-adopted"
        ],
        "expr": "project-session-flow.textHash == workspace-disk-flow.diskSpec && project-session-flow.baseHash == workspace-disk-flow.diskSpec",
        "negatives": [
          {
            "scenario": "external-change-adopted",
            "faults": [
              "change-notice-lost"
            ]
          }
        ]
      },
      "faultModel": "local-workstation",
      "rationale": "The negative is a lost notice, a failure of the environment, not a defect: it shows that adoption rests on the change stream, which does not re-send a change made while it was down."
    },
    {
      "id": "adopted-change-never-written-back",
      "kind": "temporal",
      "statement": "Text adopted from disk is never written back by the session.",
      "subjects": [
        "session",
        "external-change-adopted"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "never",
        "scenarios": [
          "external-change-adopted"
        ],
        "occurs": {
          "event": "write-intent"
        },
        "negatives": [
          {
            "scenario": "external-change-adopted",
            "faults": [
              "session-writes-back-external-change"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "own-write-never-reloaded",
      "kind": "temporal",
      "statement": "The notice of the session's own write never makes it reload the project.",
      "subjects": [
        "session",
        "workspace-service",
        "own-write-notice-ignored"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "never",
        "scenarios": [
          "own-write-notice-ignored"
        ],
        "occurs": {
          "event": "reload-requested"
        },
        "negatives": [
          {
            "scenario": "own-write-notice-ignored",
            "faults": [
              "session-reloads-own-write"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "claim-results-follow-commits",
      "kind": "temporal",
      "statement": "After a semantic commit the claim results are those of the committed model.",
      "subjects": [
        "session",
        "claim-evaluator",
        "commit-reevaluates-claims"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "commit-reevaluates-claims"
        ],
        "expr": "session-claims-flow.resultsHash == project-history-flow.specHash && session-claims-flow.resultsHash == 'h2'",
        "negatives": [
          {
            "scenario": "commit-reevaluates-claims",
            "faults": [
              "claims-reevaluation-skipped"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "export-holds-saved-text",
      "kind": "temporal",
      "statement": "An export made after an edit was saved holds the session's text.",
      "subjects": [
        "toolbar",
        "workspace-service",
        "export-project",
        "project-bundle",
        "export-after-save"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "export-after-save"
        ],
        "expr": "toolbar-exchange-flow.downloadedHash == project-session-flow.textHash",
        "negatives": [
          {
            "scenario": "export-after-save",
            "faults": [
              "save-lands-after-export"
            ]
          }
        ]
      },
      "faultModel": "local-workstation",
      "rationale": "The negative delays the save past the export: the bundle is read from disk, so an export made before the save lands does not hold the edit. The claim is true only of saved text."
    },
    {
      "id": "import-shows-imported-text",
      "kind": "temporal",
      "statement": "After an import into the open project's name, the session shows the imported text, which is what is on disk.",
      "subjects": [
        "toolbar",
        "session",
        "workspace-service",
        "import-project",
        "import-bundle"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "import-bundle"
        ],
        "expr": "project-session-flow.textHash == 'hb' && workspace-disk-flow.diskSpec == 'hb'",
        "negatives": [
          {
            "scenario": "import-bundle",
            "faults": [
              "toolbar-import-skips-reopen",
              "change-notice-lost"
            ]
          }
        ]
      },
      "faultModel": "local-workstation",
      "rationale": "Two paths bring the imported text in: the toolbar reopens the project, and the watcher notifies the change. The negative removes both; either one alone keeps the claim."
    },
    {
      "id": "unparseable-bundle-never-sent",
      "kind": "temporal",
      "statement": "A bundle whose specification has syntax errors is never sent to the server.",
      "subjects": [
        "toolbar",
        "import-project",
        "import-unparseable-bundle"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "never",
        "scenarios": [
          "import-unparseable-bundle"
        ],
        "occurs": {
          "event": "import-request"
        },
        "negatives": [
          {
            "scenario": "import-unparseable-bundle",
            "faults": [
              "toolbar-import-skips-syntax-check"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "generated-documents-match-model",
      "kind": "temporal",
      "statement": "Documents generated from the Realisation panel are derived from the session's current model.",
      "subjects": [
        "realisation-panel",
        "generators",
        "generated-documents",
        "write-generated",
        "generate-from-panel"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "generate-from-panel"
        ],
        "expr": "workspace-disk-flow.generatedHash == project-session-flow.textHash",
        "negatives": [
          {
            "scenario": "generate-from-panel",
            "faults": [
              "generate-from-stale-model"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "real-runs-replay-through-self-model",
      "kind": "invariant",
      "statement": "The events a running Exegra really produces (requests and answers of the persistence client with the development server's own events, change notices, engine-worker messages, commits, claim evaluations, simulator controls, preference and camera storage writes) are recorded with their requestId and a logical sequence number and replayed through the behaviors of the scenario live-session; every divergence from the self-model (an event the specification does not name, an event the model does not predict at that point, an event some behavior consumes that no behavior accepts in its state, whether predicted or from outside, a payload value that differs or a predicted field the recording lacks, a predicted event not seen within 200 recorded events or by the end of a closed stream) is reported as a failed check at its step and listed in the simulator panel's Live mode, and a real open, edit and save replays without one. Only variables declared environment are calibrated from the first recorded value; any other difference is a divergence (WG-5685).",
      "rationale": "Built in WG-4777. Supported, not verified: the evidence is a recorded real stream replayed in a unit test with doctored copies as negatives, and a browser test of the running application. A clean replay shows that the code and the model agree on the runs recorded, not on every run; divergences found on longer real sessions are recorded in the unknowns of self-model-replay.",
      "subjects": [
        "traffic-recorder",
        "self-model-replay",
        "live-session",
        "simulator-panel"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "browser-tests-run-real-application",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "sim-cursor-stays-in-trace",
      "kind": "invariant",
      "statement": "The step shown in the Simulation panel is always a recorded step of the trace (or none before the first), however often the user presses step.",
      "subjects": [
        "session",
        "simulator-panel",
        "simulation-panel-run"
