    {
      "id": "browser-reloads-product-files",
      "kind": "structural",
      "statement": "When a product file of the open project changes, is added or is removed on disk (or the products list of project.jsonc changes), the application's session re-derives its model from the product layers on disk: the workspace watcher reports the change as the file products, the session reads the project again, and the platform text and layout in memory are kept. A product file that does not parse keeps the last valid model.",
      "subjects": [
        "session",
        "workspace-service",
        "persistence-client"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/disk-reload.test.js (the ev-product-reload-* evidence entries). WG-5041.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "structural-scene-draws-derived-model",
      "kind": "invariant",
      "statement": "The structural projection computes no lifting or bundling: for every view and every collapse set of this specification, its edges are the derived interactions of the cut the collapse set corresponds to, restricted by the view filters, each carrying its complete witness list.",
      "subjects": [
        "projection-system",
        "semantic-abstraction"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "flows-classified-on-derived-model",
      "kind": "invariant",
      "statement": "Message hops are classified against the derived model: a hop follows an edge only when a relationship between the two components is a witness of it, so the save hop of visual-edit-flow is classified the same with the subsystems collapsed and expanded.",
      "subjects": [
        "projection-system",
        "semantic-abstraction"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "navigation-scene-is-derived-model",
      "kind": "structural",
      "statement": "A structural view draws exactly the derived model of the cut it shows: its blocks are the derived blocks of that cut and its edges are the derived interactions with their complete witness sets, at every step of the walk from the system in its environment (L0) through the subsystems, persistence expanded, a component expanded to its module elements, and the semantic core expanded with persistence collapsed, and for every declared cut of the logical and runtime hierarchies; the scene equals what exegra derive prints for the same cut.",
      "subjects": [
        "projection-system",
        "semantic-abstraction",
        "session"
      ],
      "rationale": "Supported by the core test over the self-specification and by the browser walk, which compares a semantic dump of the scene with the command line at each step (WG-5695, invariant I1). tools/walk-shots.mjs records the same comparison with screenshots on phone and desktop.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "navigation-one-block-changes-alone",
      "kind": "structural",
      "statement": "Expanding or collapsing one block changes only the blocks inside it: every other node of the scene is drawn as it was, and collapsing it again restores the cut exactly. A view's cut is interaction state per view (the elements the viewer expanded), and a view may declare its default cut.",
      "subjects": [
        "session",
        "semantic-abstraction",
        "projection-system"
      ],
      "rationale": "Supported by the core test, which toggles blocks at every step of the walk, and by the browser walk, which compares the scene before and after expanding persistence.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "navigation-facts-are-inspectable",
      "kind": "structural",
      "statement": "Selecting a derived edge lists its complete witness set, equal to the derived model's, each witness with its kind, contract, carried data and provenance and a link to the relationship; selecting a block shows its purpose, responsibilities, knowledge status, boundary, derived interface, declared interface with the agreement result, and the findings about it at the current cut, on phone and desktop.",
      "subjects": [
        "inspector",
        "semantic-abstraction"
      ],
      "rationale": "Supported by the browser walk, which checks the witness list against exegra derive at every step and the block panel against the derived boundaries and interfaces, and by the phone test.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "navigation-filters-report-removals",
      "kind": "structural",
      "statement": "Nothing a view's filter or the viewer's hiding removes is silently lost: a connection through hidden blocks is drawn as a labelled derived path summary (a may-path) carrying the relationships along it, and every other removed interaction, relationship or path is counted in the scene's notes; the \"N inside\" badge counts only what the filter keeps. Opaque, external, planned and unknown elements, blocks without a purpose, interface disagreements and unwitnessed or wrongly kinded coarse facts are each marked in the scene and named in text.",
      "subjects": [
        "projection-system",
        "semantic-abstraction",
        "scene-renderer"
      ],
      "rationale": "Supported by the core tests (hidden persistence, the semantic-core view, the kind filter of the data-and-edit-flow view, a hidden member of a collapsed block) and the browser test of a hidden block.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "presentation-holds-no-abstraction",
      "kind": "structural",
      "statement": "No module under src/ui, src/render or src/app lifts, bundles or maps entities to elements: they ask src/core/abstraction.js and src/core/query.js. Changing the cut, the hidden elements, the layout method, the pins or the camera changes no derived fact, no claim verdict and not the semantic hash.",
      "subjects": [
        "projection-system",
        "inspector",
        "session",
        "scene-renderer",
        "layout-engine"
      ],
      "rationale": "Supported by the core test that reads the presentation modules for the abstraction primitives, the core test that lays out every step of the walk by every method with pins and compares derived models, verdicts and the hash, and the browser walk, which ends with the hash and every verdict unchanged.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "layout-auto-reads-multiscale",
      "kind": "structural",
      "statement": "The automatic layout scores lines drawn through unrelated nodes as well as crossings, counts parallel edges between two nodes once, scores whitespace on a log scale, and scores labels that collide when the placement is fitted into a nominal viewport; interchangeable leaves take the slots that make edges leaving containers cross least, and around a hub much larger than its neighbours (an opened system) the radial method places the neighbours on rectangular rings hugging it. A hub with its neighbours is therefore not drawn as a grid with spokes through other nodes, an opened system with its environment gets most of the picture, and the layout stays deterministic and keeps pins.",
      "subjects": [
        "layout-engine"
      ],
      "rationale": "Supported by the layout tests (a hub of fourteen neighbours on a wide and a tall view; a line through a node and a parallel edge) and by the navigation test of L1 of the self-specification, where the opened system spans more than half of the picture with its members' labels apart.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "camera-restored-in-model",
      "kind": "temporal",
      "statement": "In the camera-memory model, coming back to a view restores the camera the user left it with.",
      "subjects": [
        "composition-root",
        "browser-storage",
        "camera-memory",
        "camera-remembered"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "camera-remembered"
        ],
