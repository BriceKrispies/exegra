    {
      "id": "register-importer",
      "name": "Register importer",
      "parent": "tooling",
      "category": "infrastructure",
      "runsIn": "node",
      "purpose": "A command line tool that converts one large Markdown specification file, written as headings, prose and register tables, into the specification file of a linked project: every table row becomes an entity of a kind the import map declares (or a generic table row), and every entity names the line it came from.",
      "responsibilities": [
        "Read one Markdown file and the project's import map (specs/<project>/import-map.jsonc with \"format\": \"register\"), which declares the entity kinds, the table rules (header cells, optional heading scope, the id column or id prefix, a property per column, reference columns), component categories and aliases, and which identifier patterns count as mentions",
        "Hold every line: headings become sections whose bodies keep prose verbatim, and each imported table row and table header is replaced in its section body by one {{entity:<id>}} marker line; write nothing unless the file rebuilds line for line with each marker expanded to the lines it came from",
        "Make every row entity render back to its cells: a row rendered from its properties must give the same cells as the source row, or the import fails naming the entity",
        "Give every imported entity a source property (path:line in the source repository) and, when the row carries an identifier, a ref property with the identifier as written; identifiers and citations named in a row become its mentions (references to imported entities) and citations (as written)",
        "Record what it recognised but could not map (a row whose cell count differs from its header, an unresolved mention, a duplicate identifier, a reference column naming no entity) as losses with counts and examples, printed and written into the generated specification's system notes",
        "Merge the draft fragments the map lists (\"drafts\"): authored entities that are not from the Markdown, each given origin \"draft\" and the file and line of its declaration as source, citing in basis the imported entities it answers; drafts never change the Markdown the sections render"
      ],
      "unknowns": [
        "It writes the project's specification file directly with node:fs, not through the workspace service or the transaction system, like the Markdown importer; once a map says \"authority\": \"jsonc\" it refuses to import over that file (only --out writes elsewhere), so edits made in Exegra are not overwritten.",
        "It does not analyze or validate what it writes; that the output analyzes without errors is checked by the tests and by exegra validate."
      ],
      "implementation": {
        "status": "manual",
        "modules": [
          "tools/import-register.js"
        ],
        "notes": "Run by hand when the Markdown file changes; one way, as the Markdown importer."
      }
    },
    {
      "id": "external-realisation",
      "name": "External realisation",
      "parent": "tooling",
      "category": "logical",
      "runsIn": "node",
      "purpose": "Lets a project be realised in other repositories: reads the realisation roots a project's project.jsonc names, checks modules declared in a root against that root, and turns a root's JUnit reports into pass, fail or not-run results for test evidence that points into it.",
      "responsibilities": [
        "Resolve the roots of project.jsonc (alias, path relative to the project directory or absolute, include and exclude globs, test runs, environmental patterns) and refuse a malformed declaration",
        "Check a module written <alias>:<path> against that root, report a module naming an undeclared alias as missing, and report unclaimed files only for a root that declares include globs",
        "Through `verify`: run each test command a root declares (unless --ingest-only), then read its JUnit report, and record each external test evidence as pass, fail or not-run by matching file, describe path and test name",
        "Record a test as not-run, never as failed, when it is absent from the report, skipped, reported as an error, or failed with a message matching the root's environmental patterns"
      ],
      "unknowns": [
        "Only JUnit XML is read; a root whose runner cannot write JUnit cannot provide test evidence.",
        "Results are not tied to the commit of the root they were recorded from (WK-393 follow-up)."
      ],
      "implementation": {
        "status": "manual",
        "modules": [
          "tools/realisation-roots.js",
          "tools/junit.js"
        ]
      }
    }
  ],
  "relationships": [
    { "id": "build-system-depends-on-vite", "kind": "depends-on", "from": "build-system", "to": "vite-dev-server", "description": "Configures the server (127.0.0.1, specs not watched) and the build." },
    { "id": "build-system-calls-dev-server-plugin", "kind": "composes", "from": "build-system", "to": "dev-server-plugin", "description": "Registers the plugin with the specs directory." },
    { "id": "generators-calls-queries", "kind": "invokes", "from": "generators", "to": "queries", "description": "Lists children, relationships and contracts for the architecture document." },
    {
      "id": "generators-reads-claim-method-registry",
      "kind": "reads",
      "from": "generators",
      "to": "claim-method-registry",
      "description": "Reads claim status labels."
    },
    { "id": "generators-generates-generated-artifacts", "kind": "generates", "from": "generators", "to": "generated-artifacts", "description": "Produces the text of the five generated files; the workspace service writes them." },
    { "id": "verification-pipeline-calls-filesystem", "kind": "invokes", "from": "verification-pipeline", "to": "filesystem", "description": "Scans src, cli, tools and the root files and checks that declared modules exist." },
    { "id": "spec-checker-calls-validator", "kind": "invokes", "from": "spec-checker", "to": "validator", "description": "Analyzes the file with analyzeSpec." },
    { "id": "spec-checker-calls-claim-evaluator", "kind": "invokes", "from": "spec-checker", "to": "claim-evaluator", "description": "Prints the status of every claim." },
    { "id": "spec-checker-calls-simulation-engine", "kind": "invokes", "from": "spec-checker", "to": "simulation-engine", "description": "Runs every scenario and optionally prints a trace." },
    {
      "id": "spec-checker-reads-specification-file",
      "kind": "reads",
      "from": "spec-checker",
      "to": "specification-file",
      "description": "Reads the file given on the command line directly with node:fs."
    },
    { "id": "benchmark-generator-calls-validator", "kind": "invokes", "from": "benchmark-generator", "to": "validator", "description": "Checks that the generated specification analyzes." },
    { "id": "benchmark-generator-writes-specification-file", "kind": "writes", "from": "benchmark-generator", "to": "specification-file", "description": "Writes specs/benchmark/spec.jsonc directly with node:fs." },
    { "id": "markdown-importer-reads-markdown-specification-source", "kind": "reads", "from": "markdown-importer", "to": "markdown-specification-source", "description": "Reads the Markdown documents and the repository's git commit; it never writes there." },
    { "id": "markdown-importer-data-flow-specification-file", "kind": "data-flow", "from": "markdown-importer", "to": "specification-file", "description": "The generated text of the project's specification file travels to the file, deterministically, with the losses recorded in its system notes." },
    { "id": "markdown-importer-writes-specification-file", "kind": "writes", "from": "markdown-importer", "to": "specification-file", "description": "Writes the project's specification file directly with node:fs, bypassing the transaction system." },
