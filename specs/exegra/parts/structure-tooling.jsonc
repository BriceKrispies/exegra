      "id": "rust-engine-oracle",
      "name": "Rust engine (differential oracle)",
      "parent": "tooling",
      "category": "logical",
      "runsIn": "node",
      "purpose": "The former simulation engine, the Rust crate engine/exegra-engine, kept as an independent implementation the Lean engine is compared against: as WebAssembly in the conformance tests and as the native exegra-sim in the differential check.",
