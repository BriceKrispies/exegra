// Part of the specification: claims, evidence.
{
  // ---- Claims ----------------------------------------------------------------------------
  "claims": [
    // ======== Structural claims (evaluated on this model's components and relationships)
    {
      "id": "core-independent-of-ui",
      "kind": "structural",
      "statement": "At cut l1 no block outside the semantic core is reached from the semantic core by a dependency relationship (depends-on, imports, invokes, composes, notifies, exercises, subscribes, reads, writes or submits-edits), directly or through any chain of them, except the JSONC parser library and the JavaScript runtime, which the core uses on purpose. The targets are everything outside the semantic core at that level, so a new top-level element is covered without being listed.",
      "rationale": "The core must run unchanged in the browser and in Node and be testable without either. Stated at l1 with a complement selector, the claim covers every top-level element, including the markdown specification source, the external test runner, the SQLite engine, the composition root, the browser user and the Node.js runtime, which the earlier hand-written list of 12 targets omitted. Absence of a path between blocks transfers exactly to the components inside them. Two exceptions are stated with their reasons: the parser, the transactions and the spec layers parse JSONC with the jsonc-parser library, and the Lean call boundary runs the kernel on the JavaScript runtime. The data-flow relationship from the transaction system to the session (the commit event handed to the listener the session registered) is not a dependency and is not followed: the core knows its listeners only as callbacks.",
      "subjects": ["semantic-core", "application", "visualization", "persistence", "threejs-library", "vite-dev-server", "browser-platform"],
      "assumptions": [
        "static-extractor-sound",
        "extracted-facts-current"
      ],
      "evaluate": {
        "method": "no-relationship",
        "cut": "l1",
        "from": "semantic-core",
        "to": {
          "outside": "semantic-core",
          "except": [
            {
              "id": "jsonc-parser-library",
              "reason": "A real dependency: the parser, the transactions and the spec layers parse JSONC with it (parser-depends-on-jsonc-parser, transactions-depends-on-jsonc-parser, spec-layers-depends-on-jsonc-parser)."
            },
            {
              "id": "javascript-runtime",
              "reason": "A real dependency: the Lean call boundary runs the kernel, compiled to WebAssembly, on the JavaScript runtime (lean-call-boundary-depends-on-javascript-runtime)."
            }
          ]
        },
        "kinds": [
          "depends-on",
          "imports",
          "invokes",
          "composes",
          "notifies",
          "exercises",
          "subscribes",
          "reads",
          "writes",
          "submits-edits"
        ],
        "transitive": true
      }
    },
    {
      "id": "core-dependencies-acyclic",
      "kind": "structural",
      "statement": "The dependency relationships among the components of the semantic core, of every kind that was a dependency before the interaction taxonomy and every kind that replaced calls (depends-on, imports, invokes, composes, notifies, exercises, subscribes, reads, writes, submits-edits), form no cycle.",
      "rationale": "Checked on the declared component graph. This claim was violated on the previous declaration: the Lean call boundary dispatches model.derive and hash.semantic to the Lean definitions (lean-call-boundary-calls-model-derivation, lean-call-boundary-calls-model-hash), and the semantic hash component also held the JavaScript binding that calls the boundary (src/core/hash.js). The binding is now its own component, hash-binding, so the Lean kernel component model-hash no longer calls the boundary. The module graph of src/core (44 modules) has no cycle, checked by a script when this was corrected; that is not a checked claim, and the match between the declared edges and the imports is the assumption relationships-match-imports.",
      "subjects": [
        "semantic-core",
        "parser",
        "validator",
        "transactions",
        "claim-evaluator",
        "simulation-engine"
      ],
      "assumptions": [
        "static-extractor-sound",
        "extracted-facts-current"
      ],
      "evaluate": {
        "method": "acyclic",
        "within": "semantic-core",
        "kinds": [
          "depends-on",
          "imports",
          "invokes",
          "composes",
          "notifies",
          "exercises",
          "subscribes",
          "reads",
          "writes",
          "submits-edits"
        ]
      }
    },
    {
      "id": "transactions-provide-apply-contract",
      "kind": "structural",
      "statement": "The transaction system provides a port with the apply-transaction contract.",
      "subjects": ["transactions", "apply-transaction"],
      "assumptions": [
        "static-extractor-sound",
        "extracted-facts-current"
      ],
      "evaluate": { "method": "has-port", "select": "transactions", "direction": "provides", "contract": "apply-transaction" }
    },
    // ======== Behavioral claims over Exegra's own edit flow (traces of the listed scenarios only)
    {
      "id": "edit-representations-equivalent",
      "kind": "temporal",
      "statement": "After a valid edit, at quiescence the scene (projection and renderer), the inspector and the source editor all show the revision of the transaction system, for a visual edit and for a source edit.",
      "rationale": "The text is the single authority; the views are projections of the committed model and must not diverge from it. Checked on the final configuration of the listed traces only.",
      "subjects": ["transactions", "projection-system", "scene-renderer", "inspector", "source-editor", "visual-edit-flow", "source-edit-flow"],
      "assumptions": ["machines-abstract-the-code", "views-derive-from-committed-model", "tests-exercise-shipped-modules", "browser-tests-run-real-application", "recorded-results-reflect-current-code"],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "visual-edit-flow",
          "source-edit-flow"
        ],
        "expr": "renderer-flow.shownRevision == transaction-flow.revision && projection-flow.shownRevision == transaction-flow.revision && inspector-flow.shownRevision == transaction-flow.revision && source-editor-flow.shownRevision == transaction-flow.revision",
        "negatives": [
          {
            "scenario": "visual-edit-flow",
            "faults": [
              "publish-lost"
            ]
          },
          {
            "scenario": "source-edit-flow",
            "faults": [
              "publish-lost"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "file-matches-model-after-save",
      "kind": "temporal",
      "statement": "After a valid edit, at quiescence the file on disk holds the committed revision and the session reports saved, for a visual edit and for a source edit.",
      "subjects": ["transactions", "session", "workspace-service", "visual-edit-flow", "source-edit-flow"],
      "assumptions": ["machines-abstract-the-code", "views-derive-from-committed-model", "filesystem-honours-atomic-rename", "tests-exercise-shipped-modules", "browser-tests-run-real-application", "recorded-results-reflect-current-code"],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "visual-edit-flow",
          "source-edit-flow"
        ],
        "expr": "workspace-flow.diskSpec == transaction-flow.textHash && project-session-flow.saveState == 'saved'",
        "negatives": [
          {
            "scenario": "visual-edit-flow",
            "faults": [
              "disk-changed-externally"
            ]
          },
          {
            "scenario": "source-edit-flow",
            "faults": [
              "disk-changed-externally"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "refresh-follows-commit",
      "kind": "temporal",
      "statement": "Every projection refresh is preceded by a delivered transaction commit: views are refreshed from a committed model, never from a candidate.",
      "subjects": ["transactions", "projection-system", "transaction-committed", "projection-refreshed", "visual-edit-flow", "source-edit-flow"],
      "assumptions": ["machines-abstract-the-code", "views-derive-from-committed-model"],
      "evaluate": {
        "method": "precedes",
        "scenarios": [
          "visual-edit-flow",
          "source-edit-flow"
        ],
        "first": {
          "event": "transaction-committed"
        },
        "then": {
          "event": "projection-refreshed"
        },
        "negatives": [
          {
            "scenario": "visual-edit-flow",
            "faults": [
              "refresh-before-commit"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "commit-only-after-validation",
      "kind": "temporal",
      "statement": "Every commit of an operation transaction (the edit flows modelled here) is preceded by a delivered validation-passed: no operation transaction commits without a validation with no errors.",
      "rationale": "Scoped to operation transactions and replacement sources. Undo and redo restore text that was committed before and reload adopts any text that parses (including text with validation errors): all three commit without validating again, and the machines in this file do not model them.",
      "subjects": ["transactions", "validator", "validation-passed", "transaction-committed", "visual-edit-flow", "source-edit-flow", "edit-with-disk-conflict"],
      "assumptions": ["machines-abstract-the-code"],
      "evaluate": {
        "method": "precedes",
        "scenarios": [
          "visual-edit-flow",
          "source-edit-flow",
          "edit-with-disk-conflict"
        ],
        "first": {
          "event": "validation-passed"
        },
        "then": {
          "event": "transaction-committed"
        },
        "negatives": [
          {
            "scenario": "visual-edit-flow",
            "faults": [
              "commit-skips-validation"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "rejected-edit-changes-nothing",
      "kind": "invariant",
      "statement": "In the rejected edit, at every step the revision of the transaction system, of the projection, renderer, inspector and source editor and of the file on disk is still the initial revision, and the session still reports saved.",
      "subjects": ["transactions", "projection-system", "scene-renderer", "inspector", "source-editor", "workspace-service", "rejected-edit"],
      "assumptions": ["machines-abstract-the-code", "views-derive-from-committed-model", "tests-exercise-shipped-modules", "browser-tests-run-real-application", "recorded-results-reflect-current-code"],
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "rejected-edit"
        ],
        "expr": "transaction-flow.revision == 1 && projection-flow.shownRevision == 1 && renderer-flow.shownRevision == 1 && inspector-flow.shownRevision == 1 && source-editor-flow.shownRevision == 1 && workspace-flow.diskSpec == 'h1' && project-session-flow.saveState != 'saving' && project-session-flow.saveState != 'conflict' && project-session-flow.saveState != 'error'",
        "negatives": [
          {
            "scenario": "rejected-edit",
            "faults": [
              "reject-partially-applied"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    // ======== Claims the model cannot establish; they rest on executed tests only
    {
      "id": "layout-moves-are-not-semantic",
      "kind": "invariant",
      "statement": "Moving a node changes only the layout file: the semantic hash and the specification text cannot change.",
      "subjects": [
        "transactions",
        "layout-file",
        "specification-file",
        "composition-root"
      ],
      "assumptions": ["tests-exercise-shipped-modules", "browser-tests-run-real-application", "recorded-results-reflect-current-code"],
      "evaluate": { "method": "external-evidence" }
    },
    {
      "id": "undo-saved-to-disk",
      "kind": "temporal",
      "statement": "After an edit and its undo, the model holds the original text, the file on disk holds it too and the session reports saved.",
      "subjects": [
        "transactions",
        "session",
        "workspace-service",
        "undo-restores-and-saves"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "undo-restores-and-saves"
        ],
        "expr": "project-history-flow.specHash == 'h1' && workspace-disk-flow.diskSpec == project-history-flow.specHash && project-session-flow.saveState == 'saved'",
        "negatives": [
          {
            "scenario": "undo-restores-and-saves",
            "faults": [
              "session-skips-flush-on-undo"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "undo-restores-earlier-text",
      "kind": "invariant",
      "statement": "Whenever a step can be redone, the model holds the text from before the undone edit.",
      "subjects": [
        "transactions",
        "undo-restores-and-saves"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "undo-restores-and-saves"
        ],
        "expr": "project-history-flow.redoDepth == 1 => project-history-flow.specHash == 'h1'",
        "negatives": [
          {
            "scenario": "undo-restores-and-saves",
            "faults": [
              "undo-keeps-text"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "layout-move-writes-layout-only",
      "kind": "temporal",
      "statement": "A dragged node is saved to layout.jsonc and spec.jsonc is not written.",
      "subjects": [
        "transactions",
        "session",
        "layout-file",
        "layout-move-saved"
      ],
      "assumptions": [
        "machines-abstract-the-code"
      ],
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "layout-move-saved"
        ],
        "expr": "workspace-disk-flow.diskLayout == 'L2' && workspace-disk-flow.specWrites == 0 && project-session-flow.saveState == 'saved'",
        "negatives": [
          {
            "scenario": "layout-move-saved",
            "faults": [
              "move-edits-spec"
            ]
          }
        ]
      },
      "faultModel": "local-workstation"
    },
    {
      "id": "core-logic-in-lean",
      "kind": "structural",
      "statement": "Every implemented component of the verified kernel (facet verdict-kernel, the components tagged verdict-kernel: the code that decides whether a claim holds, namely model derivation, the semantic hash, engine-input derivation, the engine, the explorer and temporal checker, claim verdicts and their helpers, and transactions) is implemented in Lean, so the claims about the kernel are theorems about the code that runs. Everything else (layout, projections, scene, generators, UI, live replay, request-log rendering, command-line arguments, workspace I/O, the JSONC text layer) is JavaScript outside the verdict path.",
      "subjects": [
        "semantic-core"
      ],
      "assumptions": [
        "static-extractor-sound",
        "extracted-facts-current"
      ],
      "rationale": "Decision of 2026-11-18 (WG-4799, programme WG-4785): a small verified kernel. Violated until every kernel component is Lean: the result lists the ones that are not (claim verdicts WG-4801, engine-input derivation WG-4800, transactions WG-4802). The JavaScript outside the kernel is named in the trusted base (trusted-js-shell) as outside the verdict path, not as a gap.",
      "evaluate": {
        "method": "implementation-language",
        "select": {
          "facet": "verdict-kernel"
        },
        "language": "lean",
        "plannedBy": "WG-4785"
      }
    },
    {
      "id": "model-references-resolve",
      "kind": "invariant",
      "statement": "In a derived model whose diagnostics contain no reference diagnostic (ref.unresolved, ref.kind), every reference names an entity of the model whose kind the reference allows.",
      "subjects": [
        "model-derivation"
      ],
      "assumptions": [
        "trusted-lean-kernel",
        "trusted-lean-compiler-runtime",
        "trusted-emscripten-toolchain",
        "trusted-libuv",
        "trusted-js-glue",
        "trusted-wasm-engine"
      ],
      "rationale": "Theorem of formal/Exegra/ModelProps.lean (WG-4799) about the derivation that runs: the diagnostics are the derivation's own followed by one per reference that does not resolve.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Model.derive_refs_resolve",
        "about": [
          "Exegra.Model.derive"
        ]
      }
    },
    {
      "id": "model-derivation-total",
      "kind": "structural",
      "statement": "Model derivation at the Lean call boundary (model.derive) answers every argument value with a result, never with an error, and always returns.",
      "subjects": [
        "model-derivation",
        "lean-call-boundary"
      ],
      "assumptions": [
        "trusted-lean-kernel",
        "trusted-lean-compiler-runtime",
        "trusted-emscripten-toolchain",
        "trusted-libuv",
        "trusted-js-glue",
        "trusted-wasm-engine"
      ],
      "rationale": "Theorem of formal/Exegra/Api.lean (WG-4799). Every definition of the derivation is total (none is partial); recursion over the document is bounded by fuel (see the unknowns of model-derivation).",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Api.call_model_derive_total",
        "about": [
          "Exegra.Api.call"
        ]
      }
    },
    {
      "id": "model-derivation-matches-javascript",
      "kind": "structural",
      "statement": "The Lean model derivation and semantic hash give the diagnostics, model and hash of the JavaScript parser they replaced on every specification the tests read (specs/exegra, specs/benchmark, tests/fixtures) and on every specification text the core tests parse, the invalid ones included.",
      "subjects": [
        "model-derivation",
        "model-hash",
        "parser"
      ],
      "assumptions": [
        "trusted-lean-kernel",
        "trusted-lean-compiler-runtime",
        "trusted-emscripten-toolchain",
        "trusted-libuv",
        "trusted-js-glue",
        "trusted-wasm-engine"
      ],
      "rationale": "Differential test against the JavaScript kept as an oracle in tests/oracle/parse-reference.js (WG-4799): 206 captured texts, 81 of them with diagnostics, plus edge cases for repeated keys, array-index keys, non-ASCII keys and unusual numbers. Checked once by hand against the 28 semantic hashes stored in specs/exegra/generated/manifest.json over its history and the 63 versions of the specifications in git: all equal.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "product-layers-checked",
      "kind": "structural",
      "statement": "A project's product files (project.jsonc \"products\") are validated together with the platform specification: a product that imports the platform and declares only the allowed sections passes, and each of these is refused with its own named rule, whose message names the offending id or section and says how to fix it: an imported id the platform does not declare (layer.import-unknown), a redefinition of a platform entity or of another product's (layer.redefines-entity), a section a product may not declare (layer.kind-not-allowed), a platform entity used without being imported (layer.import-missing), a reference nothing declares (layer.reference-unknown), a missing header (layer.header-missing), an import of another platform file (layer.import-mismatch) a reference into another product (layer.cross-product-reference), two product files with one product id (layer.product-id-duplicate), an entity id that fails the id pattern or is missing (layer.entity-id-invalid, layer.entity-id-missing) and a platform entity that names a product entity (layer.platform-references-product). A platform entity named under any reference key of the meta-model requires an import. Transactions edit only the platform text and refuse a product's entities (layer.product-entity).",
      "subjects": [
        "spec-layers",
        "workspace-service",
        "transactions"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/layers.test.js (the ev-layers-* evidence entries) over the fixtures in tests/fixtures/layers.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "product-layers-leave-platform-unchanged",
      "kind": "structural",
      "statement": "Adding product files to a project changes neither the platform's parsed model (every platform entity keeps its data, path and location) nor its semantic hash: validate reports the hash of the platform text alone as semanticHash, and the combined model's hash as layeredHash.",
      "subjects": [
        "spec-layers",
        "transactions"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/layers.test.js (the ev-layers-platform-* evidence entries). Code generated from the platform carries this hash in its headers, so it stays byte-identical when a product is added.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "product-layers-no-platform-power",
      "kind": "structural",
      "statement": "A product file cannot claim what only the platform may have: a role at platform level or with anonymous, service or external holders, a contract that is public with the anonymous scheme, is implemented by a platform component or carries a realisation of generated, hand or derived, a behavior at implementation level, an event that is a domain event, an elapsed-time event or states a delivery guarantee, a capability that is core and a setting that is set at or locked by the platform level are each refused with layer.platform-power, naming the entity and the fix. specc refuses the same product files with the same rule codes.",
      "subjects": [
        "spec-layers"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/layers.test.js (the ev-layers-power evidence entry) over the negative fixtures in tests/fixtures/layers/refused.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "product-layers-typed-sections",
      "kind": "structural",
      "statement": "A product file may declare the typed sections objects, policies, queries, views, workflows, segments, settings, ledgerUnits, ledgerPools, ledgerLimits, mailTemplates, noticeTemplates, tokens, triggers, automations and operations, each value of which is checked against the platform type its section maps to (object-type-def, policy-def, query-def, view-def, workflow-def, segment-decl, setting-def, ledger-unit-decl, ledger-pool-decl, ledger-limit, mail-template-decl, notice-template-decl, token-decl, trigger-def, automation-def, tenant-operation-def): a value that does not have the shape of its type is refused with layer.value-invalid, a union value the platform union lacks with layer.outside-catalogue, and a name in the product namespace that no product entity declares with layer.reference-unknown or that another product declares with layer.cross-product-reference. The typed sections are not entities of the combined model and do not change the platform semantic hash. specc reads the same table and gives the same rule codes.",
      "subjects": [
        "spec-layers"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/layers.test.js and tests/core/layer-values.test.js (the ev-layers-typed-* evidence entries) over the complete products tests/fixtures/layers/typed and the negative fixtures in tests/fixtures/layers/refused.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "product-layers-namespace",
      "kind": "structural",
      "statement": "Every entity id of a product file begins with the namespace of its product, the product id with each hyphen replaced by an underscore followed by two underscores, and a local name; an id outside it is refused with layer.namespace-missing. A capability a product declares is confined to that product: another product file that names it is refused with layer.cross-product-reference, and a product capability is reported unreachable only when no role or grant confers it.",
      "subjects": [
        "spec-layers"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/layers.test.js (the ev-layers-namespace and ev-layers-capability evidence entries); D-6582, D-6590 and D-6597 of the platform specification.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "product-layers-expressions",
      "kind": "structural",
      "statement": "An expression written as text in a typed section of a product file (a policy condition, a trigger condition, an operation's check, a field default or read rule, a constraint, a segment predicate, an automation's expression) is parsed and checked with the tenant rule language in the scope it is written in: a text that does not parse, or uses a name or call the language lacks, is refused with layer.expr-syntax; a record field the object type of the scope lacks with layer.expr-unknown-field; a role neither the platform nor the product declares with layer.expr-unknown-role; a param the scope does not bind with layer.expr-unknown-param; and an operand of a shape its operator does not accept, a comparison of two shapes, or a hop through a field that is not a single reference with layer.expr-type. The nine operators of the language (checked + - *, a timestamp plus or minus milliseconds, ms_between, days, hours, minutes, concat, text) are parsed and typed as the language declares them, with the sign rule for a - before a digit. Each refusal names the product entity, the place and text, and the position in the text. specc gives the same rule codes.",
      "subjects": [
        "spec-layers"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/layer-expr.test.js and tests/core/layers.test.js (the ev-layers-expressions-* evidence entries) over the refused fixtures tests/fixtures/layers/refused/expression-*.jsonc and the complete products tests/fixtures/layers/typed.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "product-layers-retention",
      "kind": "structural",
      "statement": "An object type of a product file that has a field with a personal declaration and no retention rule is refused with layer.retention-missing (D-6584); a type without a personal field needs none. specc gives the same rule code.",
      "subjects": [
        "spec-layers"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/layers.test.js (ev-layers-retention) over tests/fixtures/layers/refused/retention-missing.jsonc and the complete products.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "batched-transaction-equals-per-operation",
      "kind": "invariant",
      "statement": "For the same operations, a transaction that re-derives the model once produces byte for byte the specification and layout text, the failure, the affected ids, the verdict and the diagnostics of a transaction that re-derives the model after every edit, and its index of declarations never differs from the model it describes.",
      "rationale": "Evidence is a differential test over seeded random operation sequences (property edits and removals, creations, nested declarations, relationships, renames, deletions, claim edits, layout moves, failing operations) on a hand-written JSONC specification with comments and trailing commas, the benchmark specification and Exegra's own; EXEGRA_TX_DIFF_SPEC adds a large linked specification.",
      "subjects": [
        "transactions"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "transaction-derives-model-once",
      "kind": "invariant",
      "statement": "A transaction of property edits, creations, relationships, nested declarations and replacements of nested declarations derives the model of the specification once, when its result is analysed; a deletion or rename derives it once more, before its edits, and the operations after it need no further derivation.",
      "rationale": "The derivation of a 7 MB specification takes about 2.6 s; re-deriving after every operation made a 100-operation apply take about 9 minutes.",
      "subjects": [
        "transactions"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules",
        "recorded-results-reflect-current-code"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "derivation-cache-transparent",
      "kind": "structural",
      "statement": "A derivation served from the cache is observably identical to one computed: validate and claims print byte-identical output on a hit and on a miss, the encoding rebuilds Maps, Sets, objects without a prototype, -0, shared references and cycles exactly, and with EXEGRA_NO_CACHE set nothing is read or written.",
      "subjects": [
        "derivation-cache"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/derivation-cache.test.js (the ev-derivation-cache-* evidence entries). WG-5636.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "derivation-cache-keyed-by-content",
      "kind": "structural",
      "statement": "A cached derivation is reused only for the same input contents and the same Exegra derivation sources: changing a specification file, the file the project config names or any source under src/core or src/engine/lean is a miss, and a missing, truncated or altered entry is a miss that is replaced, never an error.",
      "subjects": [
        "derivation-cache"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/derivation-cache.test.js (the ev-derivation-cache-* evidence entries). WG-5636.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "derivation-cache-concurrent-safe",
      "kind": "structural",
      "statement": "Processes sharing one cache directory at the same time all succeed with the same output and leave only whole entries: a write is a temporary file renamed into place.",
      "subjects": [
        "derivation-cache"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/derivation-cache.test.js (the ev-derivation-cache-* evidence entries). WG-5636.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "product-layers-share-platform-analysis",
      "kind": "structural",
      "statement": "Validating several sets of product files over one platform text in one process parses the platform text once, and every validation reports exactly what a validation of that set alone reports: the same errors, warnings, gaps, semantic hash and layered hash. The shared platform analysis is read-only, so no validation can alter what the next one sees.",
      "subjects": [
        "spec-layers"
      ],
      "assumptions": [],
      "rationale": "Supported by tests/core/layers-cache.test.js (the ev-layers-cache-* evidence entries). The platform's parse, syntax tree and line index depend on its text alone; the combined text is still analysed in full for every set of product files.",
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "core-static-dependencies-acyclic",
      "kind": "structural",
      "statement": "The static dependencies (relationship kinds of class static: depends-on, imports) among the components of the semantic core form no cycle.",
      "rationale": "The class-restricted companion of core-dependencies-acyclic: it follows only what a component names in its own code, so a cycle here is a real import cycle, not a call cycle.",
      "subjects": [
        "semantic-core"
      ],
      "assumptions": [
        "static-extractor-sound",
        "extracted-facts-current"
      ],
      "evaluate": {
        "method": "acyclic",
        "within": "semantic-core",
        "classes": [
          "static"
        ]
      }
    },
    {
      "id": "core-runtime-dependencies-acyclic",
      "kind": "structural",
      "statement": "The runtime dependencies (relationship kinds of class runtime: invokes, calls, reads, writes, subscribes, submits-edits) among the components of the semantic core form no cycle.",
      "rationale": "The runtime-control companion of core-dependencies-acyclic. Lifecycle composition, notification, data flow and test-harness relationships are not followed: they are not runtime dependencies of the target.",
      "subjects": [
        "semantic-core"
      ],
      "assumptions": [
        "static-extractor-sound",
        "extracted-facts-current"
      ],
      "evaluate": {
        "method": "acyclic",
        "within": "semantic-core",
        "classes": [
          "runtime"
        ]
      }
    },
    {
      "id": "change-impact-remarks-dependents",
      "kind": "invariant",
      "statement": "For each change of the change-impact fixture alone, the claims re-marked are exactly the expected set, a statement edit is listed as a guarantee change, and exegra impact --change prints them.",
      "subjects": [
        "change-impact",
        "claim-verdict",
        "agent-cli"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "evaluate": {
        "method": "external-evidence"
      },
      "guaranteeClass": "change-impact"
    },
    {
      "id": "abstraction-witness-completeness",
      "kind": "structural",
      "statement": "Every derived interaction of every declared cut of this specification, with kinds as declared and coarsened to the top kinds, has a non-empty witness set, and re-lifting each of its witnesses gives exactly that interaction (I1).",
      "rationale": "Decided by the model: src/core/abstraction.js recomputes the invariant from the relationships independently of how the derived model is assembled (abstractionInvariants). The same checks run over generated fact bases and hierarchies in tests/core/abstraction.test.js.",
      "subjects": [
        "semantic-abstraction"
      ],
      "evaluate": {
        "method": "abstraction-invariants",
        "invariants": [
          "witness-completeness"
        ]
      }
    },
    {
      "id": "abstraction-boundary-accounting",
      "kind": "structural",
      "statement": "At every declared cut, with and without coarsening, every relationship whose ends lie in different blocks is a witness of exactly one derived interaction, of its own kind or its coarsening (I2).",
      "rationale": "Decided by the model: src/core/abstraction.js recomputes the invariant from the relationships independently of how the derived model is assembled (abstractionInvariants). The same checks run over generated fact bases and hierarchies in tests/core/abstraction.test.js.",
      "subjects": [
        "semantic-abstraction"
      ],
      "evaluate": {
        "method": "abstraction-invariants",
        "invariants": [
          "boundary-accounting"
        ]
      }
    },
    {
      "id": "abstraction-recoverability",
      "kind": "structural",
      "statement": "At every declared cut the fibres of the blocks together with the witness sets of the derived interactions are exactly the relationships of this specification, each once, so expanding recovers the facts a level omits (I3).",
      "rationale": "Decided by the model: src/core/abstraction.js recomputes the invariant from the relationships independently of how the derived model is assembled (abstractionInvariants). The same checks run over generated fact bases and hierarchies in tests/core/abstraction.test.js.",
      "subjects": [
        "semantic-abstraction"
      ],
      "evaluate": {
        "method": "abstraction-invariants",
        "invariants": [
          "recoverability"
        ]
      }
    },
    {
      "id": "abstraction-interfaces-from-boundaries",
      "kind": "structural",
      "statement": "At every declared cut the boundary of each block is the set of relationships with exactly one end in it, and its derived interface is the grouping of that boundary by direction, kind and contract alone (I4).",
      "rationale": "Decided by the model: src/core/abstraction.js recomputes the invariant from the relationships independently of how the derived model is assembled (abstractionInvariants). The same checks run over generated fact bases and hierarchies in tests/core/abstraction.test.js.",
      "subjects": [
        "semantic-abstraction"
      ],
      "evaluate": {
        "method": "abstraction-invariants",
        "invariants": [
          "interfaces-from-boundaries"
        ]
      }
    },
    {
      "id": "abstraction-functoriality",
      "kind": "structural",
      "statement": "For every pair of declared cuts of one hierarchy where one refines the other, deriving straight to the coarser cut equals deriving to the finer one and lifting from there, on interactions, witness sets, every summary attribute and fibres, also with kinds coarsened (I5).",
      "rationale": "Decided by the model: src/core/abstraction.js recomputes the invariant from the relationships independently of how the derived model is assembled (abstractionInvariants). The same checks run over generated fact bases and hierarchies in tests/core/abstraction.test.js.",
      "subjects": [
        "semantic-abstraction"
      ],
      "evaluate": {
        "method": "abstraction-invariants",
        "invariants": [
          "functoriality"
        ]
      }
    },
    {
      "id": "abstraction-kind-preservation",
      "kind": "structural",
      "statement": "At every declared cut every derived kind is the kind of each of its witnesses or the declared coarsening of it (I6).",
      "rationale": "Decided by the model: src/core/abstraction.js recomputes the invariant from the relationships independently of how the derived model is assembled (abstractionInvariants). The same checks run over generated fact bases and hierarchies in tests/core/abstraction.test.js.",
      "subjects": [
        "semantic-abstraction"
      ],
      "evaluate": {
        "method": "abstraction-invariants",
        "invariants": [
          "kind-preservation"
        ]
      }
    },
    {
      "id": "abstraction-determinism",
      "kind": "structural",
      "statement": "The derived model of every declared cut does not depend on the order the relationships are declared in (I7).",
      "rationale": "Decided by the model: src/core/abstraction.js recomputes the invariant from the relationships independently of how the derived model is assembled (abstractionInvariants). The same checks run over generated fact bases and hierarchies in tests/core/abstraction.test.js.",
      "subjects": [
        "semantic-abstraction"
      ],
      "evaluate": {
        "method": "abstraction-invariants",
        "invariants": [
          "determinism"
        ]
      }
    },
    {
      "id": "derived-model-goldens",
      "kind": "invariant",
      "statement": "Through the command line, with no renderer code loaded, Exegra derives the architectural model of the cuts l0, l1, persistence-expanded, semantic-core-expanded and module-level of this specification; the outputs equal the recorded goldens and an independent recomputation of the lift from the relationships and component parents.",
      "subjects": [
        "semantic-abstraction",
        "agent-cli"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "abstraction-no-silent-dropping",
      "kind": "invariant",
      "statement": "An invalid abstraction always produces an explicit diagnostic: a coarse fact with no witness at a transparent block, a declared interface that omits a boundary interaction, a declared port nothing realises, a coarse kind that is not a coarsening of its witnesses, a realisation map whose path does not exist, an incompatible port connection, and a level-bound claim naming an element hidden at its cut (I8).",
      "subjects": [
        "semantic-abstraction",
        "validator",
        "claim-evaluator"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "footprint-incremental-equals-full",
      "kind": "invariant",
      "statement": "Every derived fact and every structural claim result carries a footprint; after an edit, re-deriving only the facts and re-evaluating only the claims whose footprint the edit touches gives the same derived models and claim results as recomputing everything, over a randomised sequence of at least 200 relationship edits of this specification (P13).",
      "subjects": [
        "semantic-abstraction",
        "claim-evaluator"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "interfaces-reconciled",
      "kind": "invariant",
      "statement": "Every declared port is reported as matching a derived boundary group of its owner or as unmatched, and the realisation path of every contract is reported hop by hop with the hops whose events carry no contract flagged; for write-file the in-process hop to the workspace service is flagged.",
      "subjects": [
        "semantic-abstraction"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "realisation-maps-checked",
      "kind": "invariant",
      "statement": "A logical interaction declared as realised by a path in another hierarchy is checked as a fact: the path exists, runs head to tail and connects the placements of the interaction ends; and producer to consumer pairs contract only through declared connector elements.",
      "subjects": [
        "semantic-abstraction",
        "validator"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "extracted-changes-propagate",
      "kind": "invariant",
      "statement": "In a fixture repository, adding, removing or retargeting an import updates the extracted facts, then the derived interaction at the module, component, subsystem and system cuts, then the verdict of a dependent claim; the propagated derived model equals the model derived from scratch on the new facts, and touching one file changes only the facts of that file.",
      "subjects": [
        "semantic-abstraction",
        "verification-pipeline"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "observed-facts-reconcile",
      "kind": "invariant",
      "statement": "Observed facts from a recorded session enter the model as relationships with provenance observed, naming the recording; an observed interaction between components with no declared relationship is reported, and a declared runtime interaction no recording shows is reported as not observed, never as false.",
      "subjects": [
        "semantic-abstraction"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "edit-history-checks-observers",
      "kind": "invariant",
      "statement": "The replay rejects a crossed reply or inconsistent stored value, accepts either valid serial order and distinguishes witnessed reply loss from incomplete capture.",
      "subjects": [
        "self-model-replay",
        "workspace-service",
        "two-session-edit-race"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "two-browser-writes-match-model",
      "kind": "invariant",
      "statement": "Two Exegra sessions submitting changes from the same hash see the replies predicted by the shared-base scenario, for either forced order, and a separate read of the file confirms the winning change.",
      "subjects": [
        "self-model-replay",
        "workspace-service",
        "two-session-edit-race"
      ],
      "assumptions": [
        "tests-exercise-shipped-modules"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "visual-edit-views-not-ahead-of-commit",
      "kind": "invariant",
      "statement": "In every reachable configuration of a valid visual edit, under every fault mask of the scenario and every order of simultaneous events, the projection never shows a revision later than the committed one, and the file holds either the text it started with or the committed text, never a text not yet committed.",
      "subjects": [
        "transactions",
        "projection-system",
        "visual-edit-flow"
      ],
      "assumptions": [
        "machines-abstract-the-code",
        "views-derive-from-committed-model",
        "trusted-lean-kernel"
      ],
      "rationale": "exegra prove visual-edit-flow reports holds on an empty frontier; exegra prove visual-edit-flow --module writes formal/Exegra/Proofs/VisualEditFlow.lean, the scenario's calculus system written out and the invariant proved by a closed-set certificate the kernel checks with decide, with the standard axioms only. WG-5682 criterion 5.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "visual-edit-flow"
        ],
        "negatives": [
          {
            "scenario": "visual-edit-flow",
            "faults": [
              "refresh-before-commit"
            ],
            "note": "A refresh of revision 2 delivered before the commit: the projection shows a revision not yet committed."
          },
          {
            "scenario": "visual-edit-flow",
            "faults": [
              "save-before-refresh"
            ],
            "note": "A save of revision 2 delivered before the commit: the file holds a revision not yet committed."
          }
        ],
        "expr": "projection-flow.shownRevision <= transaction-flow.revision && (workspace-flow.diskSpec == 'h1' || workspace-flow.diskSpec == transaction-flow.textHash)",
        "theorem": "Exegra.Proofs.VisualEditFlow.visual_edit_views_not_ahead_of_commit",
        "about": [
          "Exegra.Proofs.VisualEditFlow.visualEditFlowSys",
          "Exegra.Core.Behav.Sys.lts"
        ]
      }
    },
    {
      "id": "comp-compose-comm",
      "kind": "invariant",
      "statement": "Parallel composition of components is commutative up to isomorphism: compose A B and compose B A are related by a bijection on states that maps initial states to initial states and steps to steps with the same label, both ways.",
      "subjects": [
        "lts-composition"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem of formal/Exegra/Core/Compose.lean. WG-5685.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Core.Comp.compose_comm",
        "about": [
          "Exegra.Core.Comp.Iso",
          "Exegra.Core.Comp.compose"
        ]
      }
    },
    {
      "id": "comp-compose-assoc",
      "kind": "invariant",
      "statement": "Parallel composition of components is associative up to isomorphism: compose (compose A B) C and compose A (compose B C) are isomorphic.",
      "subjects": [
        "lts-composition"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem of formal/Exegra/Core/Compose.lean. WG-5685.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Core.Comp.compose_assoc",
        "about": [
          "Exegra.Core.Comp.Iso",
          "Exegra.Core.Comp.compose"
        ]
      }
    },
    {
      "id": "comp-traces-compose",
      "kind": "invariant",
      "statement": "A sequence is a trace of compose A B exactly when its labels lie in the union of the two alphabets and its restrictions to each alphabet are traces of the corresponding side.",
      "subjects": [
        "lts-composition"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem of formal/Exegra/Core/Compose.lean. WG-5685.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Core.Comp.traces_compose",
        "about": [
          "Exegra.Core.Comp.Traces",
          "Exegra.Core.Comp.compose",
          "Exegra.Core.restrict"
        ]
      }
    },
    {
      "id": "contract-ag-compose",
      "kind": "invariant",
      "statement": "For prefix-closed assumptions and guarantees, if M1 satisfies (A1, G1), M2 satisfies (A2, G2), each guarantee implies the other side's assumption under A, and each assumption is implied by the other guarantee on every strict prefix (non-circularity), then compose M1 M2 satisfies (A, G1 ∩ G2).",
      "subjects": [
        "lts-composition"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem of formal/Exegra/Core/Contract.lean. WG-5685.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Core.Comp.ag_compose",
        "about": [
          "Exegra.Core.Comp.Sat",
          "Exegra.Core.Comp.NonCircular",
          "Exegra.Core.Comp.compose"
        ]
      }
    },
    {
      "id": "contract-ag-circular-unsound",
      "kind": "invariant",
      "statement": "Without the non-circularity condition circular assume-guarantee reasoning is unsound: two components satisfy every other hypothesis of ag_compose while their composition does not satisfy the derived contract.",
      "subjects": [
        "lts-composition"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem of formal/Exegra/Core/Contract.lean. WG-5685.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Core.Comp.ag_circular_unsound",
        "about": [
          "Exegra.Core.Comp.Sat",
          "Exegra.Core.Comp.NonCircular",
          "Exegra.Core.Comp.compose"
        ]
      }
    },
    {
      "id": "contract-discharge-sound",
      "kind": "invariant",
      "statement": "If the discharge graph of assumptions is acyclic, every assumption is implied by the guarantee of the claim that discharges it, and every guarantee holds under its assumptions, then every guarantee holds.",
      "subjects": [
        "lts-composition"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem of formal/Exegra/Core/Contract.lean. WG-5685.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Core.discharge_sound",
        "about": [
          "Exegra.Core.DischargeGraph.Acyclic"
        ]
      }
    },
    {
      "id": "refine-traces",
      "kind": "invariant",
      "statement": "A stuttering simulation of spec by impl through abs makes every observable finite trace of impl an observable trace of spec.",
      "subjects": [
        "lts-composition"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem of formal/Exegra/Core/Refine.lean. WG-5685.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Core.LTS.refines_traces",
        "about": [
          "Exegra.Core.LTS.Simulates",
          "Exegra.Core.LTS.ObsTraces"
        ]
      }
    },
    {
      "id": "refine-safety",
      "kind": "invariant",
      "statement": "A stuttering simulation of spec by impl through abs makes every invariant P of spec, read through abs, an invariant of impl.",
      "subjects": [
        "lts-composition"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem of formal/Exegra/Core/Refine.lean. WG-5685.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Core.LTS.refines_safety",
        "about": [
          "Exegra.Core.LTS.Simulates",
          "Exegra.Core.LTS.Invariant"
        ]
      }
    },
    {
      "id": "refine-liveness",
      "kind": "invariant",
      "statement": "Given a stuttering simulation, no infinite stuttering of weakly fair implementation runs and a mapping of fair actions, a property of the weakly fair runs of spec holds of the abstraction, stutters removed, of every weakly fair run of impl.",
      "subjects": [
        "lts-composition"
      ],
      "assumptions": [
        "trusted-lean-kernel"
      ],
      "rationale": "Theorem of formal/Exegra/Core/Refine.lean. WG-5685.",
      "evaluate": {
        "method": "lean-theorem",
        "theorem": "Exegra.Core.LTS.refines_liveness",
        "about": [
          "Exegra.Core.LTS.Simulates",
          "Exegra.Core.LTS.NoInfiniteStutter",
          "Exegra.Core.LTS.MapsFair",
          "Exegra.Core.LTS.Run.map",
          "Exegra.Core.LTS.Run.WeakFair"
        ]
      }
    },
    {
      "id": "message-interactions-witnessed",
      "kind": "invariant",
      "statement": "Every cross-element message of the behaviors (an event emitted by a behavior of one element and consumed by a behavior of another) is witnessed at the base by a relationship of message class between the same two elements, and at every declared cut where its ends lie in different blocks by a derived interaction made by such a relationship, never by a different witness (V5, I5). A coarse edge over a different witness is reported, and the self-specification reports none.",
      "subjects": [
        "semantic-abstraction"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "boundary-contracts-typed",
      "kind": "invariant",
      "statement": "A relationship that declares a contract has the events that cross it typed by that contract (V7): the write-file contract types the events of the in-process workspace hops (ws-write, ws-write-done, ws-write-error), and a hop whose events carry no contract is reported by the boundary-contracts command.",
      "subjects": [
        "semantic-abstraction"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "function-composition-along-hierarchy",
      "kind": "invariant",
      "statement": "A function attached to an element composes along the hierarchy: a function attached to a composite element that declares a composition has a signature equal to the composition of its stages' signatures (the first stage's parameters, the last stage's returns, a chain of single parameters, one shared error union), through every level; any difference is a function.composition-* diagnostic at the composite, and the compiler fixture validates while its mismatched variant is diagnosed.",
      "subjects": [
        "semantic-abstraction",
        "validator"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "fault-lifting-through-realisation",
      "kind": "invariant",
      "statement": "A failure mode located at an element or an interaction lifts to the logical interactions it fails, directly and through realisation maps (a hop of a path, or an element of the realisation's hierarchy that a hop runs through), and with a cut to the derived interactions and the block-internal failures; without a realisation map a deployment-level fault lifts to no logical interaction; the result does not depend on declaration order. The lift-faults command reports it.",
      "subjects": [
        "semantic-abstraction",
        "agent-cli"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "decomposition-evaluation-pure",
      "kind": "invariant",
      "statement": "Evaluating any number of candidate decompositions, and generating candidates, changes no relationship, entity or the semantic hash of the model: a candidate is a hierarchy over the same elements and a measurement never changes a fact (M7 I1).",
      "rationale": "Decided by the tests: the model, its base facts and its hash are compared before and after, and no report holds a score, a rank or a recommendation.",
      "subjects": [
        "decomposition-evaluator"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "decomposition-invalid-diagnosed",
      "kind": "invariant",
      "statement": "A candidate decomposition that is not a laminar covering partition of its scope (an element in two blocks, an element in none, an unknown or misplaced member, a colliding block id) is rejected with its failing condition and witnesses and is not measured; a candidate is reported valid only when every registered condition V1 to V7 holds (M7 I2).",
      "rationale": "Decided by the tests over a small system and over semantic-core. The registry VALIDITY_CONDITIONS is the one place the conditions plug in; a registry without V5 to V7 reports them as not evaluated and never calls a candidate valid.",
      "subjects": [
        "decomposition-evaluator"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "decomposition-measurements-deterministic",
      "kind": "invariant",
      "statement": "The measurements of a valid candidate (boundary size, cohesion, coupling, cycles by class with back edges, interface size, contract coverage, redundancy, knowledge and provenance mix) and the evidence of its boundaries are deterministic functions of the fact base and the candidate: repeated runs and any order of blocks and members give byte-identical reports, and on the facts the audit used the audit's section 5.3 figures are reproduced (53 crossing relationships, the four-block cycle, the named back edges) (M7 I3).",
      "rationale": "Decided by the tests, which recompute the audit groupings on the audit-time facts (tests/fixtures/decomposition/audit-semantic-core.json) and on today's specification.",
      "subjects": [
        "decomposition-evaluator"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "decomposition-behavioural-validity",
      "kind": "invariant",
      "statement": "A candidate decomposition whose blocks, read as the composites of a cut, carry a message that no relationship between the two elements witnesses (V5), a declared abstraction that does not refine its members (V6), or a contract on a boundary between two blocks that the events crossing it do not type (V7) is rejected with the failing condition and its witnesses; where no block declares abstract behaviour V6 is reported as not applicable, with the reason, and not as a pass; a hop between a block and the outside of the scope is the scope's boundary and no candidate's (M7 criterion 3).",
      "rationale": "Decided by the tests: a negative fixture for each condition, the positive that clears it, and the not-applicable report.",
      "subjects": [
        "decomposition-evaluator"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "decomposition-acceptance-transaction",
      "kind": "invariant",
      "statement": "Accepting a valid candidate is one transaction of the project that records the components its blocks need, a named hierarchy and two cuts of it; undo reverses it as one step; a candidate that is not valid, or whose blocks cannot be recorded, is refused and changes nothing; the application navigates the recorded hierarchy at once and a level-bound structural claim evaluates at its cuts (M7 criterion 6, invariants I4 and I5).",
      "rationale": "Decided by the tests: the transaction and its undo on a small system, the refusals, the module elements a hierarchy cannot move, and in the browser the scene at each cut against the command line, with the claim stated at l1 evaluated at the accepted cuts.",
      "subjects": [
        "decomposition-evaluator"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    },
    {
      "id": "decomposition-external-fixtures",
      "kind": "invariant",
      "statement": "Generate, evaluate and accept run on a compiler, a distributed application with realisation maps and an event-driven system with connectors, each with a recorded report of its candidates, their validity, measurements and the multiscale requirements the run exercised; the fact base and its hash are unchanged by evaluation (M7 criteria 4 and 7).",
      "rationale": "Decided by the tests over tests/fixtures/multiscale-external and the reports under docs/assessment/2026-11-27/m7.",
      "subjects": [
        "decomposition-evaluator"
      ],
      "evaluate": {
        "method": "external-evidence"
      }
    }
  ],
  "evidence": [
    { "id": "ev-roundtrip-core", "claim": "edit-representations-equivalent", "kind": "test", "ref": "tests/core/roundtrip.test.js", "description": "Visual and textual routes to a change yield equal semantic state; a visual edit changes exactly one value in the source; undo and redo restore the exact text." },
    { "id": "ev-browser-inspector-rename", "claim": "edit-representations-equivalent", "kind": "test", "ref": "tests/browser/exegra.spec.js#inspector rename persists to spec.jsonc and survives reload", "description": "A rename in the inspector reaches the scene, the source and the file on disk, and survives a reload." },
    { "id": "ev-browser-source-edit", "claim": "edit-representations-equivalent", "kind": "test", "ref": "tests/browser/exegra.spec.js#source edit updates the scene", "description": "A source edit updates the scene. The full title continues '; invalid source is rejected and the draft is kept'." },
    { "id": "ev-workspace-write", "claim": "file-matches-model-after-save", "kind": "test", "ref": "tests/core/workspace.test.js#write with the current baseHash succeeds", "description": "A write with the current base hash replaces the file and changes its hash." },
    { "id": "ev-browser-persists", "claim": "file-matches-model-after-save", "kind": "test", "ref": "tests/browser/exegra.spec.js#inspector rename persists to spec.jsonc and survives reload", "description": "The edited text is on disk after the edit." },
    { "id": "ev-roundtrip-rejected", "claim": "rejected-edit-changes-nothing", "kind": "test", "ref": "tests/core/roundtrip.test.js#invalid operations are rejected atomically", "description": "A rejected operation leaves the committed model untouched." },
    { "id": "ev-browser-rejected-source", "claim": "rejected-edit-changes-nothing", "kind": "test", "ref": "tests/browser/exegra.spec.js#source edit updates the scene", "description": "An invalid source draft is rejected and the scene keeps showing the committed model." },
