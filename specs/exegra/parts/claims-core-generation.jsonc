    {
      "id": "route-ambiguous-rule",
      "kind": "invariant",
      "statement": "Two screens whose routes tie are refused with route.ambiguous: both routes are non-catch-all, have the same number of segments, agree at every position (equal literals, or a parameter on either side), and have the same number of literal segments. Screens whose routes do not tie that way are not refused.",
      "rationale": "Evidence is the consistency rule's negative fixture (two tying screens, reported once) and its passing case (screens whose routes differ), in tests/core/ui.test.js (WG-4955). Supported, not verified.",
      "subjects": [
        "generation-readiness",
        "validator"
      ],
      "assumptions": [
