    {
      "id": "decomposition-evaluator",
      "name": "Decomposition candidates",
      "parent": "semantic-core",
      "category": "logical",
      "runsIn": "both",
      "purpose": "Proposes candidate decompositions of an element from the established semantics (the declared hierarchy, module directories, cycles of the dependency classes, contract-bounded and connector-bounded regions, split, merge and move refinements, or data given by a person), checks each against the validity conditions V1 to V7 through one registry, measures the valid ones deterministically with the evidence behind every boundary, and records a candidate a person accepts as a named hierarchy through a transaction. A candidate is a hierarchy over the same elements: evaluating it never changes a fact. Valid is not meaningful: it reports measurements side by side and never ranks, scores or accepts a candidate.",
      "responsibilities": [
        "Generate candidates from declared structure, extracted module paths, cycle condensation, contract and connector regions and refinements, and read candidates given as data",
        "Reject a candidate that is not a laminar covering partition of its scope's grain (an overlap, an uncovered element, an unknown or misplaced member, a block id that collides with an element), naming the failing condition and its witnesses",
        "Run the validity conditions of one registry in order: V1 partition, V2 witnessed coarse facts, V3 interface agreement, V4 kind preservation, and the behavioural conditions the candidate's blocks are read as the composites of a cut for: V5 every message between blocks witnessed structurally (a path through a declared connector counts), V6 refinement where a block declares abstract behaviour (reported as not applicable, with the reason, where none does), V7 every contract on a boundary between blocks typed by the events that cross it",
        "Measure a valid candidate: boundary size, cohesion, coupling, dependency cycles by class with their back edges, interface size, contract coverage of boundary interactions, redundancy of declared facts, and the knowledge-status and provenance mix; compare candidates side by side without ranking them",
        "List per boundary its crossing witnesses, the back edges of cycles and the interactions no contract covers",
        "Accept a candidate only when every condition holds, and only as one transaction of the project (acceptCandidate): the components its blocks need, the named hierarchy (the logical placement with the blocks under the scope) and two cuts of it, so the application navigates it at once and a claim stated at a cut evaluates at them; undo reverses it as one step"
      ],
      "implementation": {
        "status": "manual",
        "modules": [
          "src/core/decomposition.js"
        ],
        "language": "js",
        "notes": "Pure functions of a model snapshot and a candidate, apart from acceptCandidate, which applies the operations of the acceptance to a Project. The derivation is semantic-abstraction's (deriveLevel); V5 and V7 are decided from semantic-abstraction's coherence checks (coherenceAtLevel, contractPaths) and V6 by the refinement checker. A module element a candidate places in a block stays with its component in the recorded hierarchy and is listed as unrecorded."
      }
    }
  ],
  // ---- Relationships -----------------------------------------------------------------
  // Taken from the real imports and calls (module imports unless stated). The semantic
  // core imports nothing from src/app, src/render, src/ui or src/persist; the only
  // outward dependency of any core module is jsonc-parser.
  "relationships": [
    // -- Semantic core (acyclic by construction)
    { "id": "parser-calls-derivation-cache", "kind": "invokes", "from": "parser", "to": "derivation-cache", "description": "parseSpec asks the cache for the derived model of a text before deriving it." },
    { "id": "validator-calls-derivation-cache", "kind": "invokes", "from": "validator", "to": "derivation-cache", "description": "analyzeSpec asks the cache for the semantic diagnostics of a text before validating it." },
    { "id": "parser-reads-metamodel", "kind": "reads", "from": "parser", "to": "metamodel", "description": "Checks structure and property types against the entity definitions in metamodel.json." },
    { "id": "parser-reads-claim-method-registry", "kind": "reads", "from": "parser", "to": "claim-method-registry", "description": "Imports CLAIM_METHODS to check evaluation parameters." },
    { "id": "parser-depends-on-jsonc-parser", "kind": "depends-on", "from": "parser", "to": "jsonc-parser-library", "description": "Builds the syntax tree and reports syntax errors with the library." },
    { "id": "validator-calls-parser", "kind": "invokes", "from": "validator", "to": "parser", "description": "analyzeSpec calls parseSpec, then validates the model." },
    { "id": "validator-calls-expression-language", "kind": "invokes", "from": "validator", "to": "expression-language", "description": "Parses guards, effect values and claim expressions and lists their references." },
    { "id": "validator-reads-claim-method-registry", "kind": "reads", "from": "validator", "to": "claim-method-registry", "description": "Checks each claim's method and parameters against the registry." },
    { "id": "transactions-calls-parser", "kind": "invokes", "from": "transactions", "to": "parser", "description": "Re-derives the model after every text edit and parses a replacement source." },
    { "id": "transactions-calls-validator", "kind": "invokes", "from": "transactions", "to": "validator", "description": "Project calls analyzeSpec on every candidate specification and refuses results with errors." },
    { "id": "transactions-calls-expression-language", "kind": "invokes", "from": "transactions", "to": "expression-language", "description": "Operations parse expressions when renaming ids that expressions mention." },
    { "id": "transactions-calls-queries", "kind": "invokes", "from": "transactions", "to": "queries", "description": "Finds declaration sites and owned entities when creating and deleting." },
    { "id": "transactions-reads-metamodel", "kind": "reads", "from": "transactions", "to": "metamodel", "description": "Reads the id pattern." },
    {
      "id": "transactions-depends-on-jsonc-parser",
      "kind": "depends-on",
      "from": "transactions",
      "to": "jsonc-parser-library",
      "description": "Computes and applies the minimal text edits that keep comments and formatting."
    },
    { "id": "claim-evaluator-reads-claim-method-registry", "kind": "reads", "from": "claim-evaluator", "to": "claim-method-registry", "description": "Dispatches only on registered methods; an unregistered method stays not evaluated." },
    { "id": "claim-evaluator-calls-queries", "kind": "invokes", "from": "claim-evaluator", "to": "queries", "description": "Builds the component graph and selects components for structural claims." },
    { "id": "claim-evaluator-calls-expression-language", "kind": "invokes", "from": "claim-evaluator", "to": "expression-language", "description": "Evaluates claim expressions against trace configurations." },
    {
      "id": "claim-evaluator-calls-simulation-engine",
      "kind": "invokes",
      "from": "claim-evaluator",
      "to": "simulation-engine",
      "description": "Runs the listed scenarios for invariant and temporal claims.",
      "contract": "run-scenario"
    },
    { "id": "transactions-data-flow-session", "kind": "data-flow", "from": "transactions", "to": "session", "description": "Each commit delivers its TransactionResult and history entry to the listener the session subscribed." },
    {
      "id": "claim-evaluator-calls-refinement-checker",
      "kind": "invokes",
      "from": "claim-evaluator",
      "to": "refinement-checker",
      "description": "Refinement checks are claims."
    },
    {
      "id": "claim-evaluator-calls-exhaustive-explorer",
      "kind": "invokes",
      "from": "claim-evaluator",
      "to": "exhaustive-explorer",
      "description": "Claims evaluated exhaustively within bounds (planned, WG-4650)."
    },
    {
      "id": "claim-evaluator-calls-implementation-refinement",
      "kind": "invokes",
      "from": "claim-evaluator",
      "to": "implementation-refinement",
      "description": "Refinement of implementation traces is a claim (planned, WG-4679)."
    },
    {
      "id": "validator-calls-fault-model",
      "kind": "invokes",
      "from": "validator",
      "to": "fault-model",
      "description": "Runs the fault model rules (missing sources, bounds, realises outside the model) as part of validation."
    },
    {
      "id": "claim-evaluator-calls-proof-export",
      "kind": "invokes",
      "from": "claim-evaluator",
      "to": "proof-export",
      "description": "Claims proved in Lean are reported as verified by proof (planned, WG-4686)."
    },
    {
      "id": "validator-calls-contract-conformance",
      "kind": "invokes",
      "from": "validator",
      "to": "contract-conformance",
      "description": "Checks the payload of every contract event against the fields, types and errors of its contract."
    },
    {
      "id": "claim-evaluator-calls-contract-conformance",
      "kind": "invokes",
      "from": "claim-evaluator",
      "to": "contract-conformance",
      "description": "checkTrace adds the automatic checks of the contract events of a trace."
    },
    {
      "id": "validator-calls-data-model",
      "kind": "invokes",
      "from": "validator",
      "to": "data-model",
      "description": "Runs the data rules and the record and copy consistency checks as part of validation."
    },
    {
      "id": "claim-evaluator-calls-data-model",
      "kind": "invokes",
      "from": "claim-evaluator",
      "to": "data-model",
      "description": "Evaluates data-model claims from the findings of the data rules."
    },
    {
      "id": "data-model-calls-queries",
      "kind": "invokes",
      "from": "data-model",
      "to": "queries",
      "description": "Builds the component graph to find a path between a copy's holder and a record's owner."
    },
    {
      "id": "data-model-reads-metamodel",
      "kind": "reads",
      "from": "data-model",
      "to": "metamodel",
      "description": "The record and copy kinds and their enums are declared in the meta-model."
    },
    {
      "id": "metric-claims-calls-simulation-engine",
      "kind": "invokes",
      "from": "metric-claims",
      "to": "simulation-engine",
      "description": "Runs the claim's scenarios once per seed in metrics mode (planned, WG-4715).",
      "contract": "run-scenario"
    },
    {
      "id": "metric-claims-reads-performance-metrics",
      "kind": "reads",
      "from": "metric-claims",
      "to": "performance-metrics",
      "description": "Takes one statistic per run from the measured outputs (planned)."
    },
    {
      "id": "claim-evaluator-calls-metric-claims",
      "kind": "invokes",
      "from": "claim-evaluator",
      "to": "metric-claims",
      "description": "Metric-bound claims are evaluated by the metric claims component (planned, WG-4715)."
    },
    {
      "id": "self-model-replay-calls-simulation-contract",
      "kind": "invokes",
      "from": "self-model-replay",
      "to": "simulation-contract",
      "description": "Reads the behaviors of the scenario from the engine input (simulationInput)."
    },
    {
      "id": "self-model-replay-calls-expression-language",
      "kind": "invokes",
      "from": "self-model-replay",
      "to": "expression-language",
      "description": "Evaluates guards, effect values and emitted payloads."
    },
    {
      "id": "validator-calls-integrity-rules",
      "kind": "invokes",
      "from": "validator",
      "to": "integrity-rules",
      "description": "Reports invalid rules, vacuous rules and every current violation as diagnostics."
    },
    {
      "id": "transactions-calls-integrity-rules",
      "kind": "invokes",
      "from": "transactions",
      "to": "integrity-rules",
      "description": "Project.apply refuses a transaction that adds a violation of an error rule (the ratchet)."
    },
    {
      "id": "integrity-rules-calls-proof-export",
      "kind": "invokes",
      "from": "integrity-rules",
      "to": "proof-export",
      "description": "prove-integrity uses the Lake runner of exegra prove (lakeAvailable, the exegra-lean binary)."
    },
    {
      "id": "parser-calls-lean-call-boundary",
      "kind": "invokes",
      "from": "parser",
      "to": "lean-call-boundary",
      "description": "Derives every model with the Lean function model.derive."
    },
    {
      "id": "model-derivation-calls-model-hash",
      "kind": "invokes",
      "from": "model-derivation",
      "to": "model-hash",
      "description": "Computes the semantic hash of every derived model."
    },
    {
      "id": "claim-evaluator-calls-simulation-contract",
      "kind": "invokes",
      "from": "claim-evaluator",
      "to": "simulation-contract",
      "description": "Derives the engine input of a scenario from the model before a trace claim runs it."
    },
    {
      "id": "validator-calls-metric-claims",
      "kind": "invokes",
      "from": "validator",
      "to": "metric-claims",
      "description": "Validates metric-bound claims with the statistics of src/core/metric-stats.js."
    },
    {
      "id": "transactions-calls-hash-binding",
      "kind": "invokes",
      "from": "transactions",
      "to": "hash-binding",
      "description": "Computes the semantic hash of each committed model and the text hash of a project."
    },
    {
      "id": "claim-evaluator-calls-hash-binding",
      "kind": "invokes",
      "from": "claim-evaluator",
      "to": "hash-binding",
      "description": "Stamps every result with the semantic hash it was computed from."
    },
    {
      "id": "hash-binding-calls-lean-call-boundary",
      "kind": "invokes",
      "from": "hash-binding",
      "to": "lean-call-boundary",
      "description": "Hashes and normalizes a model that does not carry its hash with hash.semantic and hash.normalize."
    },
    {
      "id": "validator-calls-generation-readiness",
      "kind": "invokes",
      "from": "validator",
      "to": "generation-readiness",
      "description": "Runs the type, record and realisation consistency checks, and the readiness rules when system.generation is set."
    },
    {
      "id": "machine-coverage-calls-simulation-engine",
      "kind": "invokes",
      "from": "machine-coverage",
      "to": "simulation-engine",
      "description": "Runs each scenario of a shipped machine, and each searched sequence, through runEngine."
    },
    {
      "id": "machine-coverage-calls-simulation-contract",
      "kind": "invokes",
      "from": "machine-coverage",
      "to": "simulation-contract",
      "description": "Derives the engine input of a scenario, and of the machine alone with its routes, with simulationInput."
    },
    {
      "id": "machine-coverage-calls-validator",
      "kind": "invokes",
      "from": "machine-coverage",
      "to": "validator",
      "description": "Reads whether a machine is shipped (effectiveRealisation)."
    },
    {
      "id": "machine-coverage-calls-expression-language",
      "kind": "invokes",
      "from": "machine-coverage",
      "to": "expression-language",
      "description": "Parses guards and effect values for their literals, their references to time and the variables guards read."
    },
    {
      "id": "machine-coverage-calls-generation-readiness",
      "kind": "invokes",
      "from": "machine-coverage",
      "to": "generation-readiness",
      "description": "Resolves the declared type of a payload field (typeStructure) to choose representative values."
    },
    {
      "id": "spec-layers-calls-parser",
      "kind": "invokes",
      "from": "spec-layers",
      "to": "parser",
      "description": "Parses the platform text alone for its model and semantic hash."
    },
    {
      "id": "spec-layers-calls-validator",
      "kind": "invokes",
      "from": "spec-layers",
      "to": "validator",
      "description": "analyzeSpec derives and validates the combined text."
    },
    {
      "id": "spec-layers-calls-generation-readiness",
      "kind": "invokes",
      "from": "spec-layers",
      "to": "generation-readiness",
      "description": "Reads type texts with parseTypeName to find the platform types a product names."
    },
    {
      "id": "spec-layers-reads-metamodel",
      "kind": "reads",
      "from": "spec-layers",
      "to": "metamodel",
      "description": "Reads the id pattern and the sections of the specification format."
    },
    {
      "id": "spec-layers-depends-on-jsonc-parser",
      "kind": "depends-on",
      "from": "spec-layers",
      "to": "jsonc-parser-library",
      "description": "Parses product files and the platform's syntax tree with the library."
    },
    {
      "id": "transactions-calls-spec-layers",
      "kind": "invokes",
      "from": "transactions",
      "to": "spec-layers",
      "description": "A Project with product files analyses every candidate platform text with its product files layered on it."
    },
    {
      "id": "claim-strength-calls-simulation-engine",
      "kind": "invokes",
      "from": "claim-strength",
      "to": "simulation-engine",
      "description": "Runs the one scenario of a counter bound to decide restated-scenario."
    },
    {
      "id": "claim-strength-calls-expression-language",
      "kind": "invokes",
      "from": "claim-strength",
      "to": "expression-language",
      "description": "Parses claim expressions, guards and effect values for the value analysis and the grounding."
    },
    {
      "id": "claim-strength-calls-integrity-rules",
      "kind": "invokes",
      "from": "claim-strength",
      "to": "integrity-rules",
      "description": "Parses integrity rules to find the kinds they quantify over."
    },
    {
      "id": "claim-evaluator-calls-verdict-boundary",
      "kind": "invokes",
      "from": "claim-evaluator",
      "to": "verdict-boundary",
      "description": "Sends every claim with its facts for the Lean verdict and builds the facts with the fact constructors."
    },
    {
      "id": "metric-claims-calls-verdict-boundary",
      "kind": "invokes",
      "from": "metric-claims",
      "to": "verdict-boundary",
      "description": "Turns the statistical results of a metric claim into facts and asks the Lean verdict (metricVerdict)."
    },
    {
      "id": "verdict-boundary-calls-lean-call-boundary",
      "kind": "invokes",
      "from": "verdict-boundary",
      "to": "lean-call-boundary",
      "description": "Calls claims.status, verdict.isRegression and facts.decode."
    },
    {
      "id": "change-impact-calls-lean-call-boundary",
      "kind": "invokes",
      "from": "change-impact",
      "to": "lean-call-boundary",
      "description": "Calls impact.claims."
    },
    {
      "id": "semantic-abstraction-invokes-queries",
      "kind": "invokes",
      "from": "semantic-abstraction",
      "to": "queries",
      "description": "Reads elements, hierarchies, cuts and their abstraction maps, knowledge status, the interaction taxonomy and connector pairs."
    },
    {
      "id": "claim-evaluator-invokes-semantic-abstraction",
      "kind": "invokes",
      "from": "claim-evaluator",
      "to": "semantic-abstraction",
      "description": "Evaluates graph claims stated at a cut on the derived model of that cut, and checks the abstraction invariants."
    },
    {
      "id": "validator-invokes-semantic-abstraction",
      "kind": "invokes",
      "from": "validator",
      "to": "semantic-abstraction",
      "description": "Reports incompatible port connections and broken realisation maps on every transaction."
    },
    {
      "id": "self-model-replay-runs-edit-orders",
      "kind": "invokes",
      "from": "self-model-replay",
      "to": "simulation-engine",
      "description": "Run both serial orders of the specified shared-base write protocol."
    },
    {
      "id": "decomposition-evaluator-calls-semantic-abstraction",
      "kind": "invokes",
      "from": "decomposition-evaluator",
      "to": "semantic-abstraction",
      "description": "Derives the model at each candidate's level (deriveLevel) and reads the base facts and the extraction reconciliation."
    },
    {
      "id": "decomposition-evaluator-calls-queries",
      "kind": "invokes",
      "from": "decomposition-evaluator",
      "to": "queries",
      "description": "Reads the logical hierarchy, the elements, the module declarations and the knowledge status of elements."
    },
    {
      "id": "decomposition-evaluator-calls-refinement-checker",
      "kind": "invokes",
      "from": "decomposition-evaluator",
      "to": "refinement-checker",
      "description": "V6: the abstraction a block declares is checked against its members (checkAbstraction)."
    },
    {
      "id": "decomposition-evaluator-calls-transactions",
      "kind": "invokes",
      "from": "decomposition-evaluator",
      "to": "transactions",
      "description": "Accepting a candidate applies its operations as one transaction of the project (Project.apply)."
    }
  ]
}
