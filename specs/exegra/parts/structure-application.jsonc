    { "id": "realisation-panel-calls-session", "kind": "invokes", "from": "realisation-panel", "to": "session", "description": "Reads the model, claim results and recorded traceability; selects components." },
    { "id": "realisation-panel-subscribes-session", "kind": "subscribes", "from": "realisation-panel", "to": "session", "description": "Refreshes on model, project and claims events." },
