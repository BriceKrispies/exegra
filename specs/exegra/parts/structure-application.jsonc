    { "id": "activity-panels-subscribes-session", "kind": "subscribes", "from": "activity-panels", "to": "session", "description": "Refreshes on model and log events." },
    { "id": "overlay-calls-session", "kind": "invokes", "from": "overlay", "to": "session", "description": "Reads the scene's legend and notes." },
    { "id": "overlay-subscribes-session", "kind": "subscribes", "from": "overlay", "to": "session", "description": "Refreshes on scene events." },
    { "id": "overlay-observes-scene-renderer", "kind": "observes", "from": "overlay", "to": "scene-renderer", "description": "Shows the renderer's frame rate, frame time, draw calls, triangles and counts through the statistics provider." },
    { "id": "inspector-calls-session", "kind": "invokes", "from": "inspector", "to": "session", "description": "Reads the selection, model and claim results, selects linked entities and reveals source." },
    { "id": "inspector-subscribes-session", "kind": "subscribes", "from": "inspector", "to": "session", "description": "Re-renders on selection, project, model and claims events." },
