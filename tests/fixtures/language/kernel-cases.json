    {"name": "in with no list on the right", "source": "(1 in 2)", "expr": {"In": {"item": {"Lit": {"Int": 1}}, "list": {"Lit": {"Int": 2}}}}, "env": {}, "result": {"Err": "in does not apply to a int"}},
