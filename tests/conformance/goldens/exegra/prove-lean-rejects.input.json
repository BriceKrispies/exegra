{
 "behaviors": [
  {
   "id": "prove-flow",
   "initial": "prove-idle",
   "states": [
    "prove-idle",
    "prove-building",
    "prove-exploring",
    "prove-checking",
    "prove-done"
   ],
   "subject": "proof-export",
   "transitions": [
    {
     "effects": [
      {
       "emit": "lake-build-requested"
      }
     ],
     "faultOnly": false,
     "from": "prove-idle",
     "guard": null,
     "id": "prove-start",
     "on": "prove-requested",
     "to": "prove-building"
    },
    {
     "effects": [
      {
       "emit": "explorer-request-sent",
       "payload": {
        "bound": 20
       }
      }
     ],
     "faultOnly": false,
     "from": "prove-building",
     "guard": null,
     "id": "prove-explore",
     "on": "lake-build-finished",
     "to": "prove-exploring"
    },
    {
     "effects": [
      {
       "set": "fileWritten",
       "to": true
      },
      {
       "emit": "lean-file-written",
       "payload": {
        "scenario": "'race'"
       }
      },
      {
       "emit": "lean-check-requested"
      }
     ],
     "faultOnly": false,
     "from": "prove-exploring",
     "guard": null,
     "id": "prove-write",
     "on": "explorer-result-returned",
     "to": "prove-checking"
    },
    {
     "effects": [
      {
       "set": "reported",
       "to": true
      },
      {
       "emit": "prove-finished",
       "payload": {
        "claims": 1
       }
      }
     ],
     "faultOnly": true,
     "from": "prove-checking",
     "guard": null,
     "id": "prove-report-unchecked",
     "on": "lean-check-finished",
     "to": "prove-done"
    },
    {
     "effects": [
      {
       "set": "leanAccepted",
       "to": true
      },
      {
       "set": "reported",
       "to": true
      },
      {
       "emit": "prove-finished",
       "payload": {
        "claims": 1
       }
      }
     ],
     "faultOnly": false,
     "from": "prove-checking",
     "guard": "event.accepted",
     "id": "prove-report",
     "on": "lean-check-finished",
     "to": "prove-done"
    },
    {
     "effects": [
      {
       "emit": "prove-finished",
       "payload": {
        "claims": 0
       }
      }
     ],
     "faultOnly": false,
     "from": "prove-checking",
     "guard": "!event.accepted",
     "id": "prove-report-nothing",
     "on": "lean-check-finished",
     "to": "prove-done"
    }
   ],
   "variables": [
    {
     "initial": false,
     "name": "leanAccepted"
    },
    {
     "initial": false,
     "name": "reported"
    },
    {
     "initial": false,
     "name": "fileWritten"
    }
   ]
  },
  {
   "id": "lean-toolchain-flow",
   "initial": "lean-ready",
   "states": [
    "lean-ready"
   ],
   "subject": "formal-semantics",
   "transitions": [
    {
     "effects": [
      {
       "set": "accepts",
       "to": false
      }
     ],
     "faultOnly": false,
     "from": "lean-ready",
     "guard": null,
     "id": "lean-broken",
     "on": "lean-rejects-proof",
     "to": "lean-ready"
    },
    {
     "effects": [
      {
       "emit": "lake-build-finished"
      }
     ],
     "faultOnly": false,
     "from": "lean-ready",
     "guard": null,
     "id": "lean-build",
     "on": "lake-build-requested",
     "to": "lean-ready"
    },
    {
     "effects": [
      {
       "emit": "explorer-result-returned",
       "payload": {
        "result": "'holds'"
       }
      }
     ],
     "faultOnly": false,
     "from": "lean-ready",
     "guard": null,
     "id": "lean-explore",
     "on": "explorer-request-sent",
     "to": "lean-ready"
    },
    {
     "effects": [
      {
       "emit": "lean-check-finished",
       "payload": {
        "accepted": "accepts"
       }
      }
     ],
     "faultOnly": false,
     "from": "lean-ready",
     "guard": null,
     "id": "lean-check",
     "on": "lean-check-requested",
     "to": "lean-ready"
    }
   ],
   "variables": [
    {
     "initial": true,
     "name": "accepts"
    }
   ]
  }
 ],
