{
 "behaviors": [
  {
   "id": "interaction-prefs-flow",
   "initial": "prefs-live",
   "states": [
    "prefs-live"
   ],
   "subject": "session",
   "transitions": [
    {
     "effects": [
      {
       "set": "selection",
       "to": "event.id"
      },
      {
       "emit": "preferences-written",
       "payload": {
        "selection": "event.id",
        "viewId": "viewId"
       }
      }
     ],
     "faultOnly": false,
     "from": "prefs-live",
     "guard": null,
     "id": "prefs-select",
     "on": "entity-selected",
     "to": "prefs-live"
    },
    {
     "effects": [
      {
       "set": "viewId",
       "to": "event.view"
      },
      {
       "emit": "preferences-written",
       "payload": {
        "selection": "selection",
        "viewId": "event.view"
       }
      }
     ],
     "faultOnly": false,
     "from": "prefs-live",
     "guard": "event.view != viewId",
     "id": "prefs-view",
     "on": "view-switched",
     "to": "prefs-live"
    },
    {
     "effects": [
      {
       "set": "selection",
       "to": "'none'"
      },
      {
       "set": "viewId",
       "to": "'structural'"
      },
      {
       "set": "restored",
       "to": false
      },
      {
       "emit": "preferences-read"
      }
     ],
     "faultOnly": false,
     "from": "prefs-live",
     "guard": null,
     "id": "prefs-reload",
     "on": "page-reloaded",
     "to": "prefs-live"
    },
    {
     "effects": [
      {
       "set": "selection",
       "to": "event.selection"
      },
      {
       "set": "viewId",
       "to": "event.viewId"
      },
      {
       "set": "restored",
       "to": true
      }
     ],
     "faultOnly": false,
     "from": "prefs-live",
     "guard": null,
     "id": "prefs-restore",
     "on": "preferences-loaded",
     "to": "prefs-live"
    }
   ],
   "variables": [
    {
     "initial": "none",
     "name": "selection"
    },
    {
     "initial": "structural",
     "name": "viewId"
    },
    {
     "initial": false,
     "name": "restored"
    }
   ]
  },
  {
   "id": "responsive-layout-flow",
   "initial": "layout-prefs-live",
   "states": [
    "layout-prefs-live"
   ],
   "subject": "responsive-layout",
   "transitions": [
    {
     "effects": [
      {
       "set": "explorerOpen",
       "to": "event.open"
      },
      {
       "emit": "layout-preferences-written",
       "payload": {
        "explorerOpen": "event.open"
       }
      }
     ],
     "faultOnly": false,
     "from": "layout-prefs-live",
     "guard": null,
     "id": "layout-prefs-toggle",
     "on": "panel-toggled",
     "to": "layout-prefs-live"
    }
   ],
   "variables": [
    {
     "initial": true,
     "name": "explorerOpen"
    }
   ]
  },
  {
   "id": "local-storage-flow",
   "initial": "storage-ready",
   "states": [
    "storage-ready"
   ],
   "subject": "browser-storage",
   "transitions": [
    {
     "effects": [
      {
       "set": "storedSelection",
       "to": "event.selection"
      },
      {
       "set": "storedView",
       "to": "event.viewId"
      }
     ],
     "faultOnly": false,
     "from": "storage-ready",
     "guard": null,
     "id": "storage-write-session",
     "on": "preferences-written",
     "to": "storage-ready"
    },
    {
     "effects": [
      {
       "emit": "preferences-loaded",
       "payload": {
        "selection": "storedSelection",
        "viewId": "storedView"
       }
      }
     ],
     "faultOnly": false,
     "from": "storage-ready",
     "guard": null,
     "id": "storage-read-session",
     "on": "preferences-read",
     "to": "storage-ready"
    },
    {
     "effects": [
      {
       "set": "storedExplorerOpen",
       "to": "event.explorerOpen"
      }
     ],
     "faultOnly": false,
     "from": "storage-ready",
     "guard": null,
     "id": "storage-write-layout",
     "on": "layout-preferences-written",
     "to": "storage-ready"
    }
   ],
   "variables": [
    {
     "initial": "none",
     "name": "storedSelection"
    },
    {
     "initial": "structural",
     "name": "storedView"
    },
    {
     "initial": true,
     "name": "storedExplorerOpen"
    }
   ]
  }
 ],
