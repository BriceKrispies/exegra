{
 "behaviors": [
  {
   "id": "shared-base-write-flow",
   "initial": "edit-writer-ready",
   "states": [
    "edit-writer-ready"
   ],
   "subject": "workspace-service",
   "transitions": [
    {
     "effects": [
      {
       "set": "stored",
       "to": "event.value"
      },
      {
       "set": "decision",
       "to": "'accepted'"
      },
      {
       "set": "accepted",
       "to": "accepted + 1"
      }
     ],
     "faultOnly": false,
     "from": "edit-writer-ready",
     "guard": "event.base == stored",
     "id": "shared-edit-accept",
     "on": "two-session-write",
     "to": "edit-writer-ready"
    },
    {
     "effects": [
      {
       "set": "stored",
       "to": "event.value"
      },
      {
       "set": "decision",
       "to": "'accepted'"
      },
      {
       "set": "accepted",
       "to": "accepted + 1"
      }
     ],
     "faultOnly": true,
     "from": "edit-writer-ready",
     "guard": null,
     "id": "shared-edit-accept-unchecked",
     "on": "two-session-write",
     "to": "edit-writer-ready"
    },
    {
     "effects": [
      {
       "set": "decision",
       "to": "'conflict'"
      }
     ],
     "faultOnly": false,
     "from": "edit-writer-ready",
     "guard": "event.base != stored",
     "id": "shared-edit-refuse",
     "on": "two-session-write",
     "to": "edit-writer-ready"
    }
   ],
   "variables": [
    {
     "initial": "initial",
     "name": "stored"
    },
    {
     "initial": "pending",
     "name": "decision"
    },
    {
     "initial": 0,
     "name": "accepted"
    }
   ]
  }
