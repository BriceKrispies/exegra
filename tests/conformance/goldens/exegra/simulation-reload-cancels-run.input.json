{
 "behaviors": [
  {
   "id": "sim-session-flow",
   "initial": "sim-idle",
   "states": [
    "sim-idle"
   ],
   "subject": "session",
   "transitions": [
    {
     "effects": [
      {
       "set": "token",
       "to": "token + 1"
      },
      {
       "set": "scenarioId",
       "to": "event.scenario"
      },
      {
       "set": "running",
       "to": true
      },
      {
       "set": "stepIndex",
       "to": -1
      },
      {
       "set": "stepCount",
       "to": 0
      },
      {
       "emit": "engine-run-intent",
       "payload": {
        "scenario": "event.scenario",
        "token": "token"
       }
      }
     ],
     "faultOnly": false,
     "from": "sim-idle",
     "guard": null,
     "id": "sim-load",
     "on": "sim-load-requested",
     "to": "sim-idle"
    },
    {
     "effects": [
      {
       "set": "adoptedToken",
       "to": "event.token"
      },
      {
       "set": "running",
       "to": false
      },
      {
       "set": "stepCount",
       "to": "event.steps"
      },
      {
       "set": "stepIndex",
       "to": -1
      }
     ],
     "faultOnly": true,
     "from": "sim-idle",
     "guard": null,
     "id": "sim-adopt-stale",
     "on": "sim-trace-ready",
     "to": "sim-idle"
    },
    {
     "effects": [
      {
       "set": "adoptedToken",
       "to": "event.token"
      },
      {
       "set": "running",
       "to": false
      },
      {
       "set": "stepCount",
       "to": "event.steps"
      },
      {
       "set": "stepIndex",
       "to": -1
      }
     ],
     "faultOnly": false,
     "from": "sim-idle",
     "guard": "event.token == token",
     "id": "sim-adopt",
     "on": "sim-trace-ready",
     "to": "sim-idle"
    },
    {
     "effects": [
      {
       "set": "running",
       "to": false
      },
      {
       "set": "scenarioId",
       "to": "'none'"
      }
     ],
     "faultOnly": false,
     "from": "sim-idle",
     "guard": "event.token == token",
     "id": "sim-failed",
     "on": "sim-run-failed",
     "to": "sim-idle"
    },
    {
     "effects": [
      {
       "set": "stepIndex",
       "to": "stepIndex + 1"
      },
      {
       "emit": "sim-step-shown",
       "payload": {
        "stepIndex": "stepIndex"
       }
      }
     ],
     "faultOnly": true,
     "from": "sim-idle",
     "guard": "stepCount > 0",
     "id": "sim-step-past-end",
     "on": "sim-step-requested",
     "to": "sim-idle"
    },
    {
     "effects": [
      {
       "set": "stepIndex",
       "to": "stepIndex + 1"
      },
      {
       "emit": "sim-step-shown",
       "payload": {
        "stepIndex": "stepIndex"
       }
      }
     ],
     "faultOnly": false,
     "from": "sim-idle",
     "guard": "stepIndex < stepCount - 1",
     "id": "sim-step",
     "on": "sim-step-requested",
     "to": "sim-idle"
    },
    {
     "effects": [
      {
       "set": "running",
       "to": false
      }
     ],
     "faultOnly": false,
     "from": "sim-idle",
     "guard": "stepCount > 0",
     "id": "sim-step-at-end",
     "on": "sim-step-requested",
     "to": "sim-idle"
    },
    {
     "effects": [
      {
       "set": "stepIndex",
       "to": "stepIndex - 1"
      }
     ],
     "faultOnly": false,
     "from": "sim-idle",
     "guard": "stepIndex >= 0",
     "id": "sim-back",
     "on": "sim-back-requested",
     "to": "sim-idle"
    },
    {
     "effects": [
      {
       "set": "stepIndex",
       "to": "stepCount - 1"
      }
     ],
     "faultOnly": false,
     "from": "sim-idle",
     "guard": "stepCount > 0",
     "id": "sim-run-to-end",
     "on": "sim-run-to-end-requested",
     "to": "sim-idle"
    },
    {
     "effects": [
      {
       "set": "stepIndex",
       "to": -1
      }
     ],
     "faultOnly": false,
     "from": "sim-idle",
     "guard": "stepCount > 0",
     "id": "sim-reset",
     "on": "sim-reset-requested",
     "to": "sim-idle"
    },
    {
     "effects": [
      {
       "set": "stepIndex",
       "to": "event.stepIndex"
      }
     ],
     "faultOnly": false,
     "from": "sim-idle",
     "guard": "stepCount > 0",
     "id": "sim-seek",
     "on": "sim-seek-requested",
     "to": "sim-idle"
    },
    {
     "effects": [
      {
       "set": "token",
       "to": "token + 1"
      },
      {
       "set": "scenarioId",
       "to": "'none'"
      },
      {
       "set": "stepIndex",
       "to": -1
      },
      {
       "set": "stepCount",
       "to": 0
      }
     ],
     "faultOnly": false,
     "from": "sim-idle",
     "guard": null,
     "id": "sim-project-opened",
     "on": "project-opened",
     "to": "sim-idle"
    }
   ],
   "variables": [
    {
     "initial": 0,
     "name": "token"
    },
    {
     "initial": 0,
     "name": "adoptedToken"
    },
    {
     "initial": "none",
     "name": "scenarioId"
    },
    {
     "initial": -1,
     "name": "stepIndex"
    },
    {
     "initial": 0,
     "name": "stepCount"
    },
    {
     "initial": false,
     "name": "running"
    }
   ]
  },
  {
   "id": "engine-runner-flow",
   "initial": "runner-ready",
   "states": [
    "runner-ready"
   ],
   "subject": "simulation-engine",
   "transitions": [
    {
     "effects": [
      {
       "set": "prevId",
       "to": "waitingId"
      },
      {
       "set": "prevToken",
       "to": "waitingToken"
      },
      {
       "set": "seq",
       "to": "seq + 1"
      },
      {
       "set": "waitingId",
       "to": "seq"
      },
      {
       "set": "waitingToken",
       "to": "event.token"
      },
      {
       "emit": "engine-run-posted",
       "payload": {
        "id": "seq",
        "input": "event.scenario"
       }
      }
     ],
     "faultOnly": true,
     "from": "runner-ready",
     "guard": "waitingId != 0",
     "id": "runner-keep-stale-job",
     "on": "engine-run-intent",
     "to": "runner-ready"
    },
    {
     "effects": [
      {
       "set": "seq",
       "to": "seq + 1"
      },
      {
       "set": "waitingId",
       "to": "seq"
      },
      {
       "set": "waitingToken",
       "to": "event.token"
      },
      {
       "emit": "worker-terminated"
      },
      {
       "emit": "engine-run-posted",
       "payload": {
        "id": "seq",
        "input": "event.scenario"
       }
      }
     ],
     "faultOnly": false,
     "from": "runner-ready",
     "guard": "waitingId != 0",
     "id": "runner-restart",
     "on": "engine-run-intent",
     "to": "runner-ready"
    },
    {
     "effects": [
      {
       "set": "seq",
       "to": "seq + 1"
      },
      {
       "set": "waitingId",
       "to": "seq"
      },
      {
       "set": "waitingToken",
       "to": "event.token"
      },
      {
       "emit": "engine-run-posted",
       "payload": {
        "id": "seq",
        "input": "event.scenario"
       }
      }
     ],
     "faultOnly": false,
     "from": "runner-ready",
     "guard": null,
     "id": "runner-post",
     "on": "engine-run-intent",
     "to": "runner-ready"
    },
    {
     "effects": [
      {
       "emit": "sim-trace-ready",
       "payload": {
        "steps": 3,
        "token": "prevToken"
       }
      }
     ],
     "faultOnly": true,
     "from": "runner-ready",
     "guard": "prevId != 0 && event.id == prevId",
     "id": "runner-forward-stale",
     "on": "engine-run-returned",
     "to": "runner-ready"
    },
    {
     "effects": [
      {
       "set": "waitingId",
       "to": 0
      },
      {
       "emit": "sim-trace-ready",
       "payload": {
        "steps": 3,
        "token": "waitingToken"
       }
      }
     ],
     "faultOnly": false,
     "from": "runner-ready",
     "guard": "event.id == waitingId",
     "id": "runner-forward",
     "on": "engine-run-returned",
     "to": "runner-ready"
    },
    {
     "effects": [
      {
       "set": "waitingId",
       "to": 0
      },
      {
       "emit": "sim-run-failed",
       "payload": {
        "token": "waitingToken"
       }
      }
     ],
     "faultOnly": false,
     "from": "runner-ready",
     "guard": "event.id == waitingId",
     "id": "runner-refused",
     "on": "engine-run-refused",
     "to": "runner-ready"
    },
    {
     "effects": [
      {
       "set": "waitingId",
       "to": 0
      },
      {
       "emit": "sim-trace-ready",
       "payload": {
        "steps": 3,
        "token": "waitingToken"
       }
      }
     ],
     "faultOnly": false,
     "from": "runner-ready",
     "guard": "waitingId != 0",
     "id": "runner-main-thread",
     "on": "worker-load-failed",
     "to": "runner-ready"
    }
   ],
   "variables": [
    {
     "initial": 0,
     "name": "seq"
    },
    {
     "initial": 0,
     "name": "waitingId"
    },
    {
     "initial": 0,
     "name": "waitingToken"
    },
    {
     "initial": 0,
     "name": "prevId"
    },
    {
     "initial": 0,
     "name": "prevToken"
    }
   ]
  },
  {
   "id": "engine-worker-flow",
   "initial": "worker-ready",
   "states": [
    "worker-ready"
   ],
   "subject": "simulation-engine",
   "transitions": [
    {
     "effects": [
      {
       "set": "runs",
       "to": "runs + 1"
      },
      {
       "after": 2,
       "emit": "worker-run-done",
       "payload": {
        "generation": "generation",
        "id": "event.id",
        "input": "event.input"
       }
      }
     ],
     "faultOnly": false,
     "from": "worker-ready",
     "guard": null,
     "id": "worker-run",
     "on": "engine-run-posted",
     "to": "worker-ready"
    },
    {
     "effects": [
      {
       "set": "generation",
       "to": "generation + 1"
      }
     ],
     "faultOnly": false,
     "from": "worker-ready",
     "guard": null,
     "id": "worker-terminate",
     "on": "worker-terminated",
     "to": "worker-ready"
    },
    {
     "effects": [
      {
       "emit": "engine-run-returned",
       "payload": {
        "id": "event.id",
        "ok": true,
        "trace": "event.input"
       }
      }
     ],
     "faultOnly": false,
     "from": "worker-ready",
     "guard": "event.generation == generation",
     "id": "worker-reply",
     "on": "worker-run-done",
     "to": "worker-ready"
    }
   ],
   "variables": [
    {
     "initial": 0,
     "name": "generation"
    },
    {
     "initial": 0,
     "name": "runs"
    }
   ]
  }
 ],
