  },
  {
   "id": "save-conflicted"
  },
  {
   "id": "write-intent"
  },
  {
   "id": "write-file-request"
  },
  {
   "id": "write-file-ok"
  },
  {
   "id": "write-file-conflict"
  }
 ],
 "faults": [],
 "format": "exegra-sim-input",
 "scenario": {
