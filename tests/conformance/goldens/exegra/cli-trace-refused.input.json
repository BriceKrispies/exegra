  {
   "id": "engine-flow",
   "initial": "engine-ready",
   "states": [
    "engine-ready"
   ],
   "subject": "simulation-engine",
   "transitions": [
    {
     "effects": [
      {
       "set": "built",
       "to": false
      }
     ],
     "faultOnly": false,
     "from": "engine-ready",
     "guard": null,
     "id": "engine-missing",
     "on": "engine-not-built",
     "to": "engine-ready"
    },
    {
     "effects": [
      {
       "set": "loaded",
