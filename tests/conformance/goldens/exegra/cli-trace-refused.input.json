{
 "behaviors": [
  {
   "id": "cli-process-flow",
   "initial": "cli-idle",
   "states": [
    "cli-idle",
    "cli-loading",
    "cli-applying",
    "cli-writing-layout",
    "cli-verifying",
    "cli-tracing",
    "cli-done"
   ],
   "subject": "agent-cli",
   "transitions": [
    {
     "effects": [
      {
       "set": "command",
       "to": "event.command"
      },
      {
       "set": "option",
       "to": "event.options"
      },
      {
       "set": "reqId",
       "to": "event.requestId"
      },
      {
       "emit": "ws-read",
       "payload": {
        "caller": "'cli'",
        "name": "'exegra'",
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": false,
     "from": "cli-idle",
     "guard": null,
     "id": "cli-start",
     "on": "cli-command-request",
     "to": "cli-loading"
    },
    {
     "effects": [
      {
       "set": "specRead",
       "to": "event.spec"
      },
      {
       "set": "layoutRead",
       "to": "event.layout"
      },
      {
       "after": 2,
       "emit": "ws-write",
       "payload": {
        "baseHash": "event.spec",
        "caller": "'cli'",
        "file": "'spec'",
        "name": "'exegra'",
        "requestId": "reqId",
        "text": "'h2'"
       }
      }
     ],
     "faultOnly": false,
     "from": "cli-loading",
     "guard": "event.caller == 'cli' && command == 'apply'",
     "id": "cli-apply-read",
     "on": "ws-read-done",
     "to": "cli-applying"
    },
    {
     "effects": [
      {
       "set": "wroteSpec",
       "to": true
      },
      {
       "emit": "ws-write",
       "payload": {
        "baseHash": "layoutRead",
        "caller": "'cli'",
        "file": "'layout'",
        "name": "'exegra'",
        "requestId": "reqId",
        "text": "'L2'"
       }
      }
     ],
     "faultOnly": false,
     "from": "cli-applying",
     "guard": "event.caller == 'cli'",
     "id": "cli-apply-spec-written",
     "on": "ws-write-done",
     "to": "cli-writing-layout"
    },
    {
     "effects": [
      {
       "set": "reportedFailure",
       "to": true
      },
      {
       "emit": "cli-command-failed",
       "payload": {
        "code": "'write.conflict'",
        "command": "command",
        "requestId": "reqId",
        "specWritten": false
       }
      }
     ],
     "faultOnly": false,
     "from": "cli-applying",
     "guard": "event.caller == 'cli'",
     "id": "cli-apply-spec-conflict",
     "on": "ws-write-conflict",
     "to": "cli-done"
    },
    {
     "effects": [
      {
       "set": "reportedOk",
       "to": true
      },
      {
       "emit": "cli-command-ok",
       "payload": {
        "command": "command",
        "ok": true,
        "project": "'exegra'",
        "requestId": "reqId",
        "result": "'written: spec, layout'",
        "semanticHash": "'m2'"
       }
      }
     ],
     "faultOnly": false,
     "from": "cli-writing-layout",
     "guard": "event.caller == 'cli'",
     "id": "cli-apply-written",
     "on": "ws-write-done",
     "to": "cli-done"
    },
    {
     "effects": [
      {
       "set": "reportedOk",
       "to": true
      },
      {
       "emit": "cli-command-ok",
       "payload": {
        "command": "command",
        "ok": true,
        "project": "'exegra'",
        "requestId": "reqId",
        "result": "'written: spec'",
        "semanticHash": "'m2'"
       }
      }
     ],
     "faultOnly": true,
     "from": "cli-writing-layout",
     "guard": "event.caller == 'cli'",
     "id": "cli-apply-ok-after-layout-conflict",
     "on": "ws-write-conflict",
     "to": "cli-done"
    },
    {
     "effects": [
      {
       "set": "reportedFailure",
       "to": true
      },
      {
       "emit": "cli-command-failed",
       "payload": {
        "code": "'write.conflict'",
        "command": "command",
        "requestId": "reqId",
        "specWritten": false
       }
      }
     ],
     "faultOnly": true,
     "from": "cli-writing-layout",
     "guard": "event.caller == 'cli'",
     "id": "cli-apply-failure-omits-spec",
     "on": "ws-write-conflict",
     "to": "cli-done"
    },
    {
     "effects": [
      {
       "set": "reportedFailure",
       "to": true
      },
      {
       "set": "failureNotesSpecWritten",
       "to": "wroteSpec"
      },
      {
       "emit": "cli-command-failed",
       "payload": {
        "code": "'write.conflict'",
        "command": "command",
        "requestId": "reqId",
        "specWritten": "wroteSpec"
       }
      }
     ],
     "faultOnly": false,
     "from": "cli-writing-layout",
     "guard": "event.caller == 'cli'",
     "id": "cli-apply-layout-conflict",
     "on": "ws-write-conflict",
     "to": "cli-done"
    },
    {
     "effects": [
      {
       "emit": "verify-tests-run",
       "payload": {
        "count": 2
       }
      }
     ],
     "faultOnly": false,
     "from": "cli-loading",
     "guard": "event.caller == 'cli' && command == 'verify'",
     "id": "cli-verify-read",
     "on": "ws-read-done",
     "to": "cli-verifying"
    },
    {
     "effects": [
      {
       "set": "reportedOk",
       "to": true
      },
      {
       "emit": "cli-command-ok",
       "payload": {
        "command": "command",
        "ok": true,
        "project": "'exegra'",
        "requestId": "reqId",
        "result": "'verified'",
        "semanticHash": "'m1'"
       }
      },
      {
       "emit": "ws-write-recorded",
       "payload": {
        "version": "'r2'"
       }
      }
     ],
     "faultOnly": true,
     "from": "cli-verifying",
     "guard": null,
     "id": "cli-verify-report-early",
     "on": "verify-tests-finished",
     "to": "cli-verifying"
    },
    {
     "effects": [
      {
       "emit": "ws-write-recorded",
       "payload": {
        "version": "'r2'"
       }
      }
     ],
     "faultOnly": false,
     "from": "cli-verifying",
     "guard": null,
     "id": "cli-verify-record",
     "on": "verify-tests-finished",
     "to": "cli-verifying"
    },
    {
     "effects": [
      {
       "emit": "verify-claims-evaluated"
      }
     ],
     "faultOnly": false,
     "from": "cli-verifying",
     "guard": "!reportedOk",
     "id": "cli-verify-recorded",
     "on": "ws-recorded-done",
     "to": "cli-verifying"
    },
    {
     "effects": [
      {
       "set": "reportedOk",
       "to": true
      },
      {
       "emit": "cli-command-ok",
       "payload": {
        "command": "command",
        "ok": true,
        "project": "'exegra'",
        "requestId": "reqId",
        "result": "'verified'",
        "semanticHash": "'m1'"
       }
      }
     ],
     "faultOnly": false,
     "from": "cli-verifying",
     "guard": null,
     "id": "cli-verify-done",
     "on": "verify-claims-evaluated",
     "to": "cli-done"
    },
    {
     "effects": [
      {
       "emit": "engine-run-called",
       "payload": {
        "scenario": "option"
       }
      }
     ],
     "faultOnly": false,
     "from": "cli-loading",
     "guard": "event.caller == 'cli' && command == 'trace'",
     "id": "cli-trace-read",
     "on": "ws-read-done",
     "to": "cli-tracing"
    },
    {
     "effects": [
      {
       "set": "engineOk",
       "to": true
      },
      {
       "emit": "trace-file-written",
       "payload": {
        "path": "'trace.json'"
       }
      }
     ],
     "faultOnly": false,
     "from": "cli-tracing",
     "guard": null,
     "id": "cli-trace-run",
     "on": "engine-run-finished",
     "to": "cli-tracing"
    },
    {
     "effects": [
      {
       "emit": "trace-file-written",
       "payload": {
        "path": "'trace.json'"
       }
      }
     ],
     "faultOnly": true,
     "from": "cli-tracing",
     "guard": null,
     "id": "cli-trace-written-on-refusal",
     "on": "engine-run-failed",
     "to": "cli-tracing"
    },
    {
     "effects": [
      {
       "set": "reportedFailure",
       "to": true
      },
      {
       "emit": "cli-command-failed",
       "payload": {
        "code": "'simulate.failed'",
        "command": "command",
        "requestId": "reqId",
        "specWritten": false
       }
      }
     ],
     "faultOnly": false,
     "from": "cli-tracing",
     "guard": null,
     "id": "cli-trace-engine-refused",
     "on": "engine-run-failed",
     "to": "cli-done"
    },
    {
     "effects": [
      {
       "set": "traceWritten",
       "to": true
      },
      {
       "set": "reportedOk",
       "to": "engineOk"
      },
      {
       "emit": "cli-command-ok",
       "payload": {
        "command": "command",
        "ok": true,
        "project": "'exegra'",
        "requestId": "reqId",
        "result": "'written: trace.json'",
        "semanticHash": "'m1'"
       }
      }
     ],
     "faultOnly": false,
     "from": "cli-tracing",
     "guard": null,
     "id": "cli-trace-file",
     "on": "trace-file-written",
     "to": "cli-done"
    }
   ],
   "variables": [
    {
     "initial": "none",
     "name": "command"
    },
    {
     "initial": "none",
     "name": "option"
    },
    {
     "initial": 0,
     "name": "reqId"
    },
    {
     "initial": "none",
     "name": "specRead"
    },
    {
     "initial": "none",
     "name": "layoutRead"
    },
    {
     "initial": false,
     "name": "wroteSpec"
    },
    {
     "initial": false,
     "name": "reportedOk"
    },
    {
     "initial": false,
     "name": "reportedFailure"
    },
    {
     "initial": false,
     "name": "failureNotesSpecWritten"
    },
    {
     "initial": false,
     "name": "engineOk"
    },
    {
     "initial": false,
     "name": "traceWritten"
    }
   ]
  },
  {
   "id": "workspace-disk-flow",
   "initial": "ws-ready",
   "states": [
    "ws-ready"
   ],
   "subject": "workspace-service",
   "transitions": [
    {
     "effects": [
      {
       "emit": "ws-read-missing",
       "payload": {
        "caller": "event.caller",
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": "event.name == 'missing'",
     "id": "ws-read-missing-project",
     "on": "ws-read",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "emit": "ws-read-done",
       "payload": {
        "caller": "event.caller",
        "layout": "diskLayout",
        "recorded": "recordedVersion",
        "requestId": "event.requestId",
        "spec": "diskSpec"
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": null,
     "id": "ws-read-files",
     "on": "ws-read",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "emit": "ws-list-done",
       "payload": {
        "projects": [
         "exegra",
         "benchmark"
        ],
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": null,
     "id": "ws-list-projects",
     "on": "ws-list",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "set": "conflicts",
       "to": "conflicts + 1"
      },
      {
       "emit": "ws-write-conflict",
       "payload": {
        "caller": "event.caller",
        "code": "'conflict'",
        "current": "diskSpec",
        "file": "'spec'",
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": "event.file == 'spec' && event.baseHash != diskSpec",
     "id": "ws-conflict-spec",
     "on": "ws-write",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "set": "conflicts",
       "to": "conflicts + 1"
      },
      {
       "emit": "ws-write-conflict",
       "payload": {
        "caller": "event.caller",
        "code": "'conflict'",
        "current": "diskLayout",
        "file": "'layout'",
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": "event.file == 'layout' && event.baseHash != diskLayout",
     "id": "ws-conflict-layout",
     "on": "ws-write",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "set": "diskSpec",
       "to": "event.text"
      },
      {
       "set": "specWrites",
       "to": "specWrites + 1"
      },
      {
       "emit": "disk-file-replaced",
       "payload": {
        "file": "'spec'",
        "hash": "event.text"
       }
      },
      {
       "emit": "ws-write-error",
       "payload": {
        "caller": "event.caller",
        "file": "'spec'",
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": true,
     "from": "ws-ready",
     "guard": "event.file == 'spec' && event.baseHash == diskSpec",
     "id": "ws-write-journal-append-fails",
     "on": "ws-write",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "set": "diskSpec",
       "to": "event.text"
      },
      {
       "set": "specWrites",
       "to": "specWrites + 1"
      },
      {
       "set": "journalLines",
       "to": "journalLines + 1"
      },
      {
       "emit": "disk-file-replaced",
       "payload": {
        "file": "'spec'",
        "hash": "event.text"
       }
      },
      {
       "emit": "ws-write-done",
       "payload": {
        "caller": "event.caller",
        "file": "'spec'",
        "hash": "event.text",
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": "event.file == 'spec' && event.baseHash == diskSpec",
     "id": "ws-write-spec",
     "on": "ws-write",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "set": "diskLayout",
       "to": "event.text"
      },
      {
       "set": "layoutWrites",
       "to": "layoutWrites + 1"
      },
      {
       "set": "journalLines",
       "to": "journalLines + 1"
      },
      {
       "emit": "disk-file-replaced",
       "payload": {
        "file": "'layout'",
        "hash": "event.text"
       }
      },
      {
       "emit": "ws-write-done",
       "payload": {
        "caller": "event.caller",
        "file": "'layout'",
        "hash": "event.text",
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": "event.file == 'layout' && event.baseHash == diskLayout",
     "id": "ws-write-layout",
     "on": "ws-write",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "set": "diskSpec",
       "to": "event.hash"
      },
      {
       "emit": "disk-file-replaced",
       "payload": {
        "file": "'spec'",
        "hash": "event.hash"
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": "event.file == 'spec'",
     "id": "ws-external-spec",
     "on": "disk-edited-externally",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "set": "diskLayout",
       "to": "event.hash"
      },
      {
       "emit": "disk-file-replaced",
       "payload": {
        "file": "'layout'",
        "hash": "event.hash"
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": "event.file == 'layout'",
     "id": "ws-external-layout",
     "on": "disk-edited-externally",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "set": "recordedVersion",
       "to": "event.version"
      },
      {
       "emit": "disk-file-replaced",
       "payload": {
        "file": "'recorded'",
        "hash": "event.version"
       }
      },
      {
       "emit": "ws-recorded-done",
       "payload": {
        "version": "event.version"
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": null,
     "id": "ws-recorded",
     "on": "ws-write-recorded",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "emit": "ws-generated-done",
       "payload": {
        "caller": "event.caller",
        "requestId": "event.requestId",
        "written": []
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": "event.files == generatedHash",
     "id": "ws-generated-unchanged",
     "on": "ws-write-generated",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "set": "generatedHash",
       "to": "event.files"
      },
      {
       "emit": "ws-generated-done",
       "payload": {
        "caller": "event.caller",
        "requestId": "event.requestId",
        "written": [
         "ARCHITECTURE.md",
         "claims-report.json",
         "claims-report.md",
         "manifest.json",
         "tasks.json"
        ]
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": null,
     "id": "ws-generated",
     "on": "ws-write-generated",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "emit": "ws-export-missing",
       "payload": {
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": "event.name == 'missing'",
     "id": "ws-export-missing-project",
     "on": "ws-export",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "emit": "ws-export-done",
       "payload": {
        "files": "diskSpec",
        "name": "event.name",
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": null,
     "id": "ws-export-files",
     "on": "ws-export",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "emit": "ws-import-refused",
       "payload": {
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": false,
     "from": "ws-ready",
     "guard": "event.bundle == 'malformed'",
     "id": "ws-import-refused-bundle",
     "on": "ws-import",
     "to": "ws-ready"
    },
    {
     "effects": [
      {
       "set": "diskSpec",
