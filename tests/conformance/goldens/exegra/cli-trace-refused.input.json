        "ok": "built"
       }
      }
     ],
     "faultOnly": false,
     "from": "engine-ready",
     "guard": null,
     "id": "engine-load",
     "on": "engine-load-requested",
     "to": "engine-ready"
    },
    {
     "effects": [
      {
       "set": "runs",
