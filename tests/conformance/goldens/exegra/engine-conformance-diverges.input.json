{
 "behaviors": [
  {
   "id": "conformance-flow",
   "initial": "conformance-idle",
   "states": [
    "conformance-idle",
    "conformance-done"
   ],
   "subject": "simulation-contract",
   "transitions": [
    {
     "effects": [
      {
       "emit": "golden-replayed"
      }
     ],
     "faultOnly": false,
     "from": "conformance-idle",
     "guard": null,
     "id": "conformance-start",
     "on": "conformance-run",
     "to": "conformance-idle"
    },
    {
     "effects": [
      {
       "set": "mismatches",
       "to": "mismatches + 1"
      },
      {
       "set": "reportedAgree",
       "to": true
      },
      {
       "emit": "conformance-reported",
       "payload": {
        "ok": true
       }
      }
     ],
     "faultOnly": true,
     "from": "conformance-idle",
     "guard": "!event.matches",
     "id": "conformance-ignore-mismatch",
     "on": "golden-compared",
     "to": "conformance-done"
    },
    {
     "effects": [
      {
       "set": "reportedAgree",
       "to": true
      },
      {
       "emit": "conformance-reported",
       "payload": {
        "ok": true
       }
      }
     ],
     "faultOnly": false,
     "from": "conformance-idle",
     "guard": "event.matches",
     "id": "conformance-agree",
     "on": "golden-compared",
     "to": "conformance-done"
    },
    {
     "effects": [
      {
       "set": "mismatches",
       "to": "mismatches + 1"
      },
      {
       "emit": "conformance-reported",
       "payload": {
        "ok": false
       }
      }
     ],
     "faultOnly": false,
     "from": "conformance-idle",
     "guard": "!event.matches",
     "id": "conformance-mismatch",
     "on": "golden-compared",
     "to": "conformance-done"
    }
   ],
   "variables": [
    {
     "initial": 0,
     "name": "mismatches"
    },
    {
     "initial": false,
     "name": "reportedAgree"
    }
   ]
  },
  {
   "id": "engine-under-test-flow",
   "initial": "eut-ready",
   "states": [
    "eut-ready"
   ],
   "subject": "simulation-engine",
   "transitions": [
    {
     "effects": [
      {
       "set": "agrees",
       "to": false
      }
     ],
     "faultOnly": false,
     "from": "eut-ready",
     "guard": null,
     "id": "eut-diverge",
     "on": "engine-diverges",
     "to": "eut-ready"
    },
    {
     "effects": [
      {
       "emit": "golden-compared",
       "payload": {
        "matches": "agrees"
       }
      }
     ],
     "faultOnly": false,
     "from": "eut-ready",
     "guard": null,
     "id": "eut-replay",
     "on": "golden-replayed",
     "to": "eut-ready"
    }
   ],
   "variables": [
    {
     "initial": true,
     "name": "agrees"
    }
   ]
  },
  {
   "id": "differential-flow",
   "initial": "diff-idle",
   "states": [
    "diff-idle"
   ],
   "subject": "formal-semantics",
   "transitions": [
    {
     "effects": [],
     "faultOnly": false,
     "from": "diff-idle",
     "guard": "engine-under-test-flow.agrees",
     "id": "diff-run-agree",
     "on": "differential-run",
     "to": "diff-idle"
    },
    {
     "effects": [
      {
       "set": "saved",
       "to": "saved + 1"
      },
      {
       "emit": "differential-mismatch-saved"
      }
     ],
     "faultOnly": false,
     "from": "diff-idle",
     "guard": "!engine-under-test-flow.agrees",
     "id": "diff-run-mismatch",
     "on": "differential-run",
     "to": "diff-idle"
    }
   ],
   "variables": [
    {
     "initial": 0,
     "name": "saved"
    }
   ]
  }
 ],
