  {
   "id": "write-endpoint-flow",
   "initial": "write-endpoint-ready",
   "states": [
    "write-endpoint-ready"
   ],
   "subject": "dev-server-plugin",
   "transitions": [
    {
     "effects": [
      {
       "set": "diskHash",
       "to": "event.text"
      },
      {
       "set": "writes",
       "to": "writes + 1"
      },
      {
       "emit": "write-file-ok",
       "payload": {
        "hash": "event.text",
        "ok": true,
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": true,
     "from": "write-endpoint-ready",
     "guard": "event.file == 'spec'",
     "id": "write-endpoint-accept-stale",
     "on": "write-file-request",
     "to": "write-endpoint-ready"
    },
    {
     "effects": [
      {
       "set": "conflicts",
       "to": "conflicts + 1"
      },
      {
       "emit": "write-file-conflict",
       "payload": {
        "code": "'conflict'",
        "current": "diskHash",
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": false,
     "from": "write-endpoint-ready",
     "guard": "event.file == 'spec' && event.baseHash != diskHash",
     "id": "write-endpoint-conflict",
     "on": "write-file-request",
     "to": "write-endpoint-ready"
    },
    {
     "effects": [
      {
       "set": "diskHash",
       "to": "event.text"
      },
      {
       "set": "writes",
       "to": "writes + 1"
      },
      {
       "emit": "write-file-ok",
       "payload": {
        "hash": "event.text",
        "ok": true,
        "requestId": "event.requestId"
       }
      },
      {
       "after": 1,
       "emit": "file-change-notice-sent",
       "payload": {
        "file": "event.file",
        "hash": "event.text"
       }
      }
     ],
     "faultOnly": false,
     "from": "write-endpoint-ready",
     "guard": "event.file == 'spec' && event.baseHash == diskHash && watching",
     "id": "write-endpoint-accept-watched",
     "on": "write-file-request",
     "to": "write-endpoint-ready"
    },
    {
     "effects": [
      {
       "set": "diskHash",
       "to": "event.text"
      },
      {
       "set": "writes",
       "to": "writes + 1"
      },
      {
       "emit": "write-file-ok",
       "payload": {
        "hash": "event.text",
        "ok": true,
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": false,
     "from": "write-endpoint-ready",
     "guard": "event.file == 'spec' && event.baseHash == diskHash",
     "id": "write-endpoint-accept",
     "on": "write-file-request",
     "to": "write-endpoint-ready"
    },
    {
     "effects": [
      {
       "set": "conflicts",
       "to": "conflicts + 1"
      },
      {
       "emit": "write-file-conflict",
       "payload": {
        "code": "'conflict'",
        "current": "diskLayout",
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": false,
     "from": "write-endpoint-ready",
     "guard": "event.file == 'layout' && event.baseHash != diskLayout",
     "id": "write-endpoint-conflict-layout",
     "on": "write-file-request",
     "to": "write-endpoint-ready"
    },
    {
     "effects": [
      {
       "set": "diskLayout",
       "to": "event.text"
      },
      {
       "set": "writes",
       "to": "writes + 1"
      },
      {
       "emit": "write-file-ok",
       "payload": {
        "hash": "event.text",
        "ok": true,
        "requestId": "event.requestId"
       }
      },
      {
       "after": 1,
       "emit": "file-change-notice-sent",
       "payload": {
        "file": "event.file",
        "hash": "event.text"
       }
      }
     ],
     "faultOnly": false,
     "from": "write-endpoint-ready",
     "guard": "event.file == 'layout' && event.baseHash == diskLayout && watching",
     "id": "write-endpoint-accept-layout-watched",
     "on": "write-file-request",
     "to": "write-endpoint-ready"
    },
    {
     "effects": [
      {
       "set": "diskLayout",
       "to": "event.text"
      },
      {
       "set": "writes",
       "to": "writes + 1"
      },
      {
       "emit": "write-file-ok",
       "payload": {
        "hash": "event.text",
        "ok": true,
        "requestId": "event.requestId"
       }
      }
     ],
     "faultOnly": false,
     "from": "write-endpoint-ready",
     "guard": "event.file == 'layout' && event.baseHash == diskLayout",
     "id": "write-endpoint-accept-layout",
     "on": "write-file-request",
     "to": "write-endpoint-ready"
    },
    {
     "effects": [
      {
       "emit": "read-project-ok",
       "payload": {
        "layout": "diskLayout",
        "recorded": "'r1'",
        "requestId": "event.requestId",
        "spec": "diskHash"
       }
      }
     ],
     "faultOnly": false,
     "from": "write-endpoint-ready",
     "guard": null,
     "id": "write-endpoint-read",
     "on": "read-project-request",
     "to": "write-endpoint-ready"
    },
    {
     "effects": [
      {
       "set": "watching",
       "to": "true"
      }
     ],
     "faultOnly": false,
     "from": "write-endpoint-ready",
     "guard": null,
     "id": "write-endpoint-watch",
     "on": "watch-project-request",
     "to": "write-endpoint-ready"
    }
   ],
