  },
  {
   "id": "model-parsed"
  },
  {
   "id": "validation-passed"
  },
  {
   "id": "validation-failed"
  },
  {
   "id": "transaction-committed"
  },
  {
   "id": "transaction-rejected"
  },
  {
   "id": "refresh-requested"
  },
  {
   "id": "projection-refreshed"
  },
  {
   "id": "model-published"
  },
  {
   "id": "save-requested"
  },
  {
   "id": "save-succeeded"
  },
  {
   "id": "save-conflicted"
  },
  {
   "id": "write-intent"
  },
  {
   "id": "write-file-request"
  },
  {
   "id": "write-file-ok"
  },
  {
   "id": "write-file-conflict"
  }
 ],
 "faults": [],
 "format": "exegra-sim-input",
 "scenario": {
  "faults": [],
  "id": "write-with-stale-base-hash",
  "stepLimit": 1000,
  "steps": [
   {
    "at": 0,
    "event": "write-intent",
    "payload": {}
   }
  ]
 },
 "version": 1
}
